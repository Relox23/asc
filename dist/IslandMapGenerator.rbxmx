<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="ModuleScript" referent="RBX00000011">
		<Properties>
			<string name="Name">IslandMapGenerator</string>
			<ProtectedString name="Source"><![CDATA[--[[
	IslandMapGenerator
	Builds the whole island map inside Roblox Studio.

	How to use (Studio, edit mode, NOT while playtesting):
	  1. Put this ModuleScript in ServerStorage (Insert from File... -> IslandMapGenerator.rbxmx)
	  2. Open View > Command Bar and run:
	         require(game.ServerStorage.IslandMapGenerator).Build()
	  3. Wait for "[IslandMap] Done" in the Output window (a few minutes).

	Rebuild only some parts:
	         require(game.ServerStorage.IslandMapGenerator).Build({ "Snow", "Atmosphere" })
	Remove everything it made:
	         require(game.ServerStorage.IslandMapGenerator).Clear()
]]

local Config = require(script.Config)
local Layout = require(script.IslandLayout)
local Landscape = require(script.Landscape)
local TerrainWriter = require(script.TerrainWriter)
local Atmosphere = require(script.Atmosphere)
local Util = require(script.Util)

local Generator = {}

local ZONE_STEPS = { "Hub", "Forest", "Snow", "Hollow", "Dunes", "Ruins", "Coast" }

local function islandFolder()
	return Util.folder(workspace, "Island")
end

local function removeDefaults()
	if not Config.REMOVE_DEFAULT_BASEPLATE then
		return
	end
	for _, name in ipairs({ "Baseplate", "SpawnLocation" }) do
		local obj = workspace:FindFirstChild(name)
		if obj and obj:IsA("BasePart") then
			obj:Destroy()
		end
	end
end

local function setupStreaming()
	if not Config.STREAMING then
		return
	end
	local ok, err = pcall(function()
		workspace.StreamingEnabled = true
		workspace.StreamingMinRadius = 256
		workspace.StreamingTargetRadius = 2048
	end)
	if not ok then
		warn("[IslandMap] Could not enable streaming automatically (" .. tostring(err) .. "). Turn on Workspace.StreamingEnabled by hand.")
	end
end

function Generator.Clear()
	local island = workspace:FindFirstChild("Island")
	if island then
		island:Destroy()
	end
	workspace.Terrain:Clear()
	Util.log("Cleared the island")
end

-- steps: optional list like { "Terrain", "Snow" }; nil builds everything enabled in Config.Build
function Generator.Build(steps)
	local started = os.clock()
	local wanted = {}
	if steps then
		for _, s in ipairs(steps) do
			wanted[s] = true
		end
	else
		for name, enabled in pairs(Config.Build) do
			wanted[name] = enabled
		end
	end

	Util.log(string.format("Building island (radius %d studs)...", Layout.ISLAND_RADIUS))
	Landscape.init()
	removeDefaults()
	local island = islandFolder()

	if wanted.Terrain then
		if Config.CLEAR_EXISTING then
			workspace.Terrain:Clear()
		end
		TerrainWriter.Generate()
	end

	local failures = {}
	for i, name in ipairs(ZONE_STEPS) do
		if wanted[name] then
			if Config.CLEAR_EXISTING then
				local old = island:FindFirstChild(name)
				if old then
					old:Destroy()
				end
			end
			local folder = Util.folder(island, name)
			local rng = Random.new(Layout.SEED + i * 1000)
			local ok, err = xpcall(function()
				require(script.Zones[name]).Build(folder, rng)
			end, debug.traceback)
			if not ok then
				table.insert(failures, name)
				warn("[IslandMap] " .. name .. " failed:\n" .. tostring(err))
			end
			task.wait()
		end
	end

	if wanted.Atmosphere then
		Atmosphere.Build()
	end
	setupStreaming()

	pcall(function()
		game:GetService("ChangeHistoryService"):SetWaypoint("Island map generated")
	end)

	local parts = 0
	for _, d in ipairs(island:GetDescendants()) do
		if d:IsA("BasePart") then
			parts += 1
		end
	end
	if #failures > 0 then
		warn("[IslandMap] Finished with errors in: " .. table.concat(failures, ", "))
	end
	Util.log(string.format("Done in %.0fs. %d parts. Press Play to explore!", os.clock() - started, parts))
end

return Generator
]]></ProtectedString>
		</Properties>
		<Item class="ModuleScript" referent="RBX00000000">
			<Properties>
				<string name="Name">Atmosphere</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Atmosphere
	Sets up Lighting (Future lighting, sky, atmosphere, bloom, colour grading,
	sun rays, clouds) and installs the client script that changes the mood
	region by region.
]]

local Util = require(script.Parent.Util)

local Atmosphere = {}

local rgb = Color3.fromRGB

local function replace(parent, className, name)
	local old = parent:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local obj = Instance.new(className)
	obj.Name = name
	obj.Parent = parent
	return obj
end

function Atmosphere.Build()
	Util.log("Setting up lighting and atmosphere...")
	local Lighting = game:GetService("Lighting")

	-- remove default effects so ours are the only ones
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("BloomEffect") or child:IsA("SunRaysEffect") or child:IsA("ColorCorrectionEffect") then
			child:Destroy()
		end
	end

	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	Lighting.GlobalShadows = true
	Lighting.Brightness = 2.8
	Lighting.ClockTime = 15.2
	Lighting.GeographicLatitude = 28
	Lighting.Ambient = rgb(80, 95, 80)
	Lighting.OutdoorAmbient = rgb(130, 150, 125)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.25
	Lighting.ExposureCompensation = 0

	local sky = replace(Lighting, "Sky", "Sky")
	sky.CelestialBodiesShown = true
	sky.StarCount = 3000
	sky.MoonAngularSize = 11
	sky.SunAngularSize = 14

	local atmosphere = replace(Lighting, "Atmosphere", "Atmosphere")
	atmosphere.Density = 0.33
	atmosphere.Offset = 0.3
	atmosphere.Color = rgb(200, 225, 200)
	atmosphere.Decay = rgb(110, 140, 100)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.2

	local grade = replace(Lighting, "ColorCorrectionEffect", "IslandGrade")
	grade.TintColor = rgb(246, 255, 240)
	grade.Saturation = 0.18
	grade.Contrast = 0.06
	grade.Brightness = 0.02

	local bloom = replace(Lighting, "BloomEffect", "IslandBloom")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.3

	local rays = replace(Lighting, "SunRaysEffect", "IslandSunRays")
	rays.Intensity = 0.12
	rays.Spread = 0.8

	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or replace(workspace.Terrain, "Clouds", "Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.55
	clouds.Color = rgb(255, 255, 250)

	-- shared layout for the client
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local oldLayout = ReplicatedStorage:FindFirstChild("IslandLayout")
	if oldLayout then
		oldLayout:Destroy()
	end
	script.Parent.IslandLayout:Clone().Parent = ReplicatedStorage

	-- client mood script
	local starterScripts = game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts")
	if starterScripts then
		local old = starterScripts:FindFirstChild("IslandAtmosphere")
		if old then
			old:Destroy()
		end
		script.Parent.Client.IslandAtmosphere:Clone().Parent = starterScripts
	else
		warn("[IslandMap] StarterPlayerScripts not found; the region atmosphere script was not installed")
	end
end

return Atmosphere
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX00000002">
			<Properties>
				<string name="Name">Client</string>
			</Properties>
			<Item class="LocalScript" referent="RBX00000001">
				<Properties>
					<string name="Name">IslandAtmosphere</string>
					<ProtectedString name="Source"><![CDATA[--[[
	IslandAtmosphere (LocalScript, installed into StarterPlayerScripts)
	Gives every region its own sky, light, fog, colour grading and weather,
	blending smoothly as the player walks between them, and shows the region's
	name when they arrive.
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Layout = require(ReplicatedStorage:WaitForChild("IslandLayout"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local rgb = Color3.fromRGB

-- Optional ambient loops: paste a sound asset id (e.g. "rbxassetid://123") per region.
local AMBIENT_SOUNDS = {
	Hub = "",
	Forest = "",
	Snow = "",
	Hollow = "",
	Ruins = "",
	Dunes = "",
}

local PROFILES = {
