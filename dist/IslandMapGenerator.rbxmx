	},
	Hollow = {
		lighting = { ClockTime = 0, Brightness = 1.4, ExposureCompensation = 0.35, Ambient = rgb(60, 66, 90), OutdoorAmbient = rgb(125, 135, 175) },
		atmosphere = { Density = 0.3, Offset = 0, Color = rgb(60, 70, 100), Decay = rgb(20, 24, 40), Glare = 0, Haze = 0.8 },
		grade = { TintColor = rgb(210, 220, 255), Saturation = -0.4, Contrast = 0.12, Brightness = 0 },
		bloom = { Intensity = 0.9, Size = 34, Threshold = 1.1 },
		rays = { Intensity = 0 },
		clouds = { Cover = 0, Density = 0.2, Color = rgb(120, 130, 160) },
		sky = { MoonAngularSize = 11, StarCount = 5000 },
		celestial = false,
		weather = "motes",
	},
	Ruins = {
		lighting = { ClockTime = 17.6, Brightness = 1.8, ExposureCompensation = 0, Ambient = rgb(70, 60, 60), OutdoorAmbient = rgb(120, 100, 95) },
		atmosphere = { Density = 0.5, Offset = 0.15, Color = rgb(120, 100, 95), Decay = rgb(70, 50, 45), Glare = 0.2, Haze = 2.8 },
		grade = { TintColor = rgb(255, 225, 210), Saturation = -0.35, Contrast = 0.15, Brightness = -0.02 },
		bloom = { Intensity = 0.5, Size = 24, Threshold = 1.5 },
		rays = { Intensity = 0.05 },
		clouds = { Cover = 0.9, Density = 0.9, Color = rgb(90, 85, 85) },
		sky = { MoonAngularSize = 11, StarCount = 1000 },
		celestial = true,
		weather = "ash",
	},
	Dunes = {
		lighting = { ClockTime = 12.8, Brightness = 3.6, ExposureCompensation = 0, Ambient = rgb(110, 90, 70), OutdoorAmbient = rgb(180, 150, 110) },
		atmosphere = { Density = 0.38, Offset = 0.25, Color = rgb(240, 205, 150), Decay = rgb(210, 140, 80), Glare = 0.8, Haze = 2.2 },
		grade = { TintColor = rgb(255, 236, 210), Saturation = 0.05, Contrast = 0.1, Brightness = 0.02 },
		bloom = { Intensity = 0.5, Size = 26, Threshold = 1.4 },
		rays = { Intensity = 0.1 },
		clouds = { Cover = 0.1, Density = 0.3, Color = rgb(255, 245, 230) },
		sky = { MoonAngularSize = 11, StarCount = 3000 },
		celestial = true,
		weather = "sand",
	},
}

local BLEND = TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

-- Effects (created by the generator; made here if missing) --------------------------------------
local function ensure(className, parent, name)
	local obj = parent:FindFirstChild(name)
	if not obj then
		obj = Instance.new(className)
		obj.Name = name
		obj.Parent = parent
	end
	return obj
end

local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or ensure("Atmosphere", Lighting, "Atmosphere")
local sky = Lighting:FindFirstChildOfClass("Sky") or ensure("Sky", Lighting, "Sky")
local grade = ensure("ColorCorrectionEffect", Lighting, "IslandGrade")
local bloom = ensure("BloomEffect", Lighting, "IslandBloom")
local rays = ensure("SunRaysEffect", Lighting, "IslandSunRays")
local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or ensure("Clouds", workspace.Terrain, "Clouds")

-- Weather ----------------------------------------------------------------------------------------
local weatherPart = Instance.new("Part")
weatherPart.Name = "LocalWeather"
weatherPart.Anchored = true
weatherPart.CanCollide = false
weatherPart.CanQuery = false
weatherPart.CanTouch = false
weatherPart.CastShadow = false
weatherPart.Transparency = 1
weatherPart.Size = Vector3.new(240, 1, 240)
weatherPart.Parent = workspace

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function emitter(props)
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.LightInfluence = 0
	e.Shape = Enum.ParticleEmitterShape.Box
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = weatherPart
	return e
end

local WEATHER = {
	snow = {
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(Color3.new(1, 1, 1)),
			LightInfluence = 0.6,
			Size = NumberSequence.new(0.35),
			Transparency = NumberSequence.new(0.1),
			Lifetime = NumberRange.new(7, 9),
			Rate = 420,
			Speed = NumberRange.new(6, 10),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(20, 20),
			Acceleration = Vector3.new(2, 0, 1),
			RotSpeed = NumberRange.new(-90, 90),
		}),
	},
	ash = {
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(rgb(70, 66, 66), rgb(140, 136, 132)),
			LightInfluence = 1,
			Size = NumberSequence.new(0.3),
			Lifetime = NumberRange.new(8, 12),
			Rate = 160,
			Speed = NumberRange.new(2, 4),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(40, 40),
			Acceleration = Vector3.new(3, 0, 0),
		}),
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(rgb(255, 140, 50), rgb(255, 60, 20)),
			LightEmission = 1,
			Size = NumberSequence.new(0.2),
			Lifetime = NumberRange.new(6, 9),
			Rate = 12,
			Speed = NumberRange.new(1, 2),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(60, 60),
		}),
	},
	sand = {
		emitter({
			Texture = SMOKE,
			Color = ColorSequence.new(rgb(236, 200, 140)),
			LightInfluence = 1,
			Size = NumberSequence.new(6, 14),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.3, 0.82),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(4, 6),
			Rate = 40,
			Speed = NumberRange.new(2, 4),
			EmissionDirection = Enum.NormalId.Bottom,
			Acceleration = Vector3.new(26, 0, 8),
			RotSpeed = NumberRange.new(-30, 30),
		}),
	},
	motes = {
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(rgb(210, 230, 255)),
			LightEmission = 1,
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.3, 0.5),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Lifetime = NumberRange.new(6, 9),
			Rate = 60,
			Speed = NumberRange.new(1, 2),
			EmissionDirection = Enum.NormalId.Bottom,
			Acceleration = Vector3.new(0, 1.2, 0),
		}),
	},
	pollen = {
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(rgb(255, 236, 140), rgb(190, 255, 150)),
			LightEmission = 1,
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.5, 0.35),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Lifetime = NumberRange.new(5, 8),
			Rate = 45,
			Speed = NumberRange.new(0.5, 1.5),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(180, 180),
		}),
	},
	dust = {
		emitter({
			Texture = SPARKLE,
			Color = ColorSequence.new(rgb(255, 236, 200)),
			LightInfluence = 1,
			Size = NumberSequence.new(0.15),
			Lifetime = NumberRange.new(6, 9),
			Rate = 20,
			Speed = NumberRange.new(0.5, 1),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(180, 180),
		}),
	},
}
local weatherHeight = { snow = 55, ash = 55, sand = 30, motes = -25, pollen = -20, dust = -10 }
local currentWeather = nil

local function setWeather(kind)
	for name, list in pairs(WEATHER) do
		for _, e in ipairs(list) do
			e.Enabled = name == kind
		end
	end
	currentWeather = kind
end

-- Region banner -------------------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "RegionBanner"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function makeLabel(y, size, font)
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Position = UDim2.fromScale(0.5, y)
	l.Size = UDim2.new(0.8, 0, 0, size)
	l.BackgroundTransparency = 1
	l.Font = font
	l.TextScaled = true
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.TextTransparency = 1
	l.TextStrokeTransparency = 1
	l.Parent = gui
	return l
end
local title = makeLabel(0.17, 54, Enum.Font.Garamond)
local subtitle = makeLabel(0.17 + 0.065, 26, Enum.Font.Garamond)
local bannerToken = 0

local function showBanner(zone)
	local info = Layout.ZoneInfo[zone]
	if not info then
		return
	end
	bannerToken += 1
	local token = bannerToken
	title.Text = string.upper(info.name)
	subtitle.Text = info.subtitle
	local fadeIn = TweenInfo.new(1.2, Enum.EasingStyle.Sine)
	for _, l in ipairs({ title, subtitle }) do
		TweenService:Create(l, fadeIn, { TextTransparency = 0, TextStrokeTransparency = 0.6 }):Play()
	end
	task.delay(4, function()
		if token ~= bannerToken then
			return
		end
		local fadeOut = TweenInfo.new(1.6, Enum.EasingStyle.Sine)
		for _, l in ipairs({ title, subtitle }) do
			TweenService:Create(l, fadeOut, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

-- Ambient sound -----------------------------------------------------------------------------------------
local ambient = Instance.new("Sound")
ambient.Name = "RegionAmbience"
ambient.Looped = true
ambient.Volume = 0
ambient.Parent = SoundService

local function setAmbient(zone)
	local id = AMBIENT_SOUNDS[zone]
	TweenService:Create(ambient, TweenInfo.new(1.5), { Volume = 0 }):Play()
	task.delay(1.6, function()
		if id and id ~= "" then
			ambient.SoundId = id
			ambient:Play()
			TweenService:Create(ambient, TweenInfo.new(2), { Volume = 0.5 }):Play()
		else
			ambient:Stop()
		end
	end)
end

-- The Hollow's moon only shows its crescent at night -------------------------------------------------------
local function moonParts()
	local island = workspace:FindFirstChild("Island")
	local hollow = island and island:FindFirstChild("Hollow")
	local moon = hollow and hollow:FindFirstChild("HollowMoon")
	if moon then
		return moon:FindFirstChild("Moon"), moon:FindFirstChild("MoonShadow")
	end
	return nil, nil
end

-- Applying a region ----------------------------------------------------------------------------------------
local function apply(zone, instant)
	local p = PROFILES[zone]
	if not p then
		return
	end
	local info = instant and TweenInfo.new(0) or BLEND
	TweenService:Create(Lighting, info, p.lighting):Play()
	TweenService:Create(atmosphere, info, p.atmosphere):Play()
	TweenService:Create(grade, info, p.grade):Play()
	TweenService:Create(bloom, info, p.bloom):Play()
	TweenService:Create(rays, info, p.rays):Play()
	TweenService:Create(clouds, info, p.clouds):Play()
	TweenService:Create(sky, info, p.sky):Play()
	sky.CelestialBodiesShown = p.celestial
	setWeather(p.weather)
	local moon, shadow = moonParts()
	if moon and shadow then
		local night = zone == "Hollow"
		TweenService:Create(moon, info, { Transparency = night and 0 or 0.55 }):Play()
		TweenService:Create(shadow, info, { Transparency = night and 0 or 1 }):Play()
	end
end

local currentZone = nil
local pending, pendingSince = nil, 0

local function focusPosition()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		return root.Position
	end
	return camera.Focus.Position
end

local function update()
	local pos = focusPosition()
	local zone = Layout.getZone(pos.X, pos.Z)
	if zone == "Coast" then
		zone = currentZone or "Forest" -- out at sea, keep the last region's mood
	end
	if zone ~= currentZone then
		-- require the player to stay in the new region briefly, so borders don't flicker
		if pending ~= zone then
			pending, pendingSince = zone, os.clock()
		elseif os.clock() - pendingSince > 0.6 or currentZone == nil then
			local first = currentZone == nil
			currentZone = zone
			pending = nil
			apply(zone, first)
			showBanner(zone)
			setAmbient(zone)
		end
	else
		pending = nil
	end
end

task.spawn(function()
	while true do
		local ok, err = pcall(update)
		if not ok then
			warn("[IslandAtmosphere]", err)
		end
		task.wait(0.3)
	end
end)

-- keep the weather volume above the camera
game:GetService("RunService").RenderStepped:Connect(function()
	local cf = camera.CFrame
	local offset = currentWeather and weatherHeight[currentWeather] or 50
	weatherPart.CFrame = CFrame.new(cf.Position + Vector3.new(0, offset, 0))
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX00000003">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Config
	Settings for the map generator. Change these before running Build().
	Island size and region layout live in IslandLayout.
]]

local Config = {}

-- Which parts of the map to build. Turn one off to rebuild only the rest.
Config.Build = {
	Terrain = true,
	Hub = true,
	Forest = true,
	Snow = true,
	Hollow = true,
	Dunes = true,
	Ruins = true,
	Coast = true,
	Atmosphere = true,
}

-- Where players spawn: "Forest" (the Eloria Wildwood clearing) or "Hub" (the capital).
-- Both spawn pads are always built; this picks which one is enabled.
Config.PLAYER_START = "Forest"

-- Multiplies how many trees, bushes and rocks are scattered.
-- 1 = full forests (~150k parts in total). Lower it on weaker PCs or for mobile.
Config.FOLIAGE_DENSITY = 1

-- Delete the existing terrain and the previously generated map before building.
Config.CLEAR_EXISTING = true

-- Remove the default "Baseplate" and "SpawnLocation" from a fresh place.
Config.REMOVE_DEFAULT_BASEPLATE = true

-- Turn on instance streaming. Strongly recommended for a map this size.
Config.STREAMING = true

-- Keep Studio responsive: yield after this many seconds of work.
Config.YIELD_EVERY = 0.12

-- Print progress to the Output window.
Config.VERBOSE = true

return Config
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000004">
			<Properties>
				<string name="Name">IslandLayout</string>
				<ProtectedString name="Source"><![CDATA[--[[
	IslandLayout
	Shared description of the island: size, where every region sits and where
	the landmarks are. The generator uses it to build the map and the client
	uses it (from ReplicatedStorage) to know which region the player is in.

	Change ISLAND_RADIUS to scale the whole map. Every landmark is placed as a
	fraction of the radius so the layout keeps its shape at any size.
]]

local Layout = {}

-- Size --------------------------------------------------------------------
Layout.ISLAND_RADIUS = 6000 -- coastline radius in studs (island is ~12,000 studs across)
Layout.WORLD_BORDER = math.floor(Layout.ISLAND_RADIUS * 1.23) -- invisible wall out at sea
Layout.OCEAN_EXTENT = math.ceil(Layout.ISLAND_RADIUS * 1.45 / 256) * 256 -- sea is drawn out to this half-width
Layout.SEA_LEVEL = 0
Layout.SEED = 20261017

-- Central capital ------------------------------------------------------------
Layout.HUB_RADIUS = 640 -- radius of the mesa the capital is built on
Layout.HUB_HEIGHT = 150 -- height of the mesa top
Layout.HUB_APRON = 760 -- sandy foothills around the mesa
Layout.RAMP_LENGTH = 560 -- grand causeways from the city gates down to each region
Layout.ROAD_WIDTH = 40

-- Coast -------------------------------------------------------------------
Layout.BEACH_WIDTH = 240 -- width of the sand strip around the whole island
Layout.ZONE_BLEND = 380 -- width of the soft border between two regions

-- Regions, in order around the island. Each owns a 72 degree slice.
Layout.ZONE_ORDER = { "Forest", "Snow", "Hollow", "Ruins", "Dunes" }

Layout.ZoneInfo = {
	Hub = { name = "Solkhar", subtitle = "Citadel of the Sun Throne" },
	Forest = { name = "Eloria Wildwood", subtitle = "Where the old magic still breathes" },
	Snow = { name = "Shirayuki Vale", subtitle = "A village asleep beneath the snow" },
	Hollow = { name = "The Hollow Expanse", subtitle = "Under a moon that never sets" },
	Ruins = { name = "Ashen Remnant", subtitle = "What is left of the old world" },
	Dunes = { name = "Sea of Whispering Dunes", subtitle = "The Starwarden Watchtower waits" },
	Coast = { name = "The Endless Shore", subtitle = "Nothing lies beyond the sea" },
}

local TAU = math.pi * 2
local FIRST_ANGLE = -math.pi / 2

Layout.ZoneAngle = {}
for i, id in ipairs(Layout.ZONE_ORDER) do
	local a = FIRST_ANGLE + (i - 1) * TAU / #Layout.ZONE_ORDER
	Layout.ZoneAngle[id] = math.atan2(math.sin(a), math.cos(a))
end
Layout.HALF_SECTOR = math.pi / #Layout.ZONE_ORDER

local function wrap(a)
	return (a + math.pi) % TAU - math.pi
end
Layout.wrapAngle = wrap

-- Point on the ground plane at an angle and distance from the island center.
function Layout.polar(angle, radius)
	return Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

-- Unit direction pointing from the center towards a region.
function Layout.zoneDirection(id)
	local a = Layout.ZoneAngle[id]
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

-- Landmarks -----------------------------------------------------------------
local R = Layout.ISLAND_RADIUS
local A = Layout.ZoneAngle
local polar = Layout.polar

Layout.Landmarks = {
	ForestSpawn = polar(A.Forest + 0.04, Layout.HUB_RADIUS + Layout.RAMP_LENGTH + 560),
	WorldTree = polar(A.Forest + 0.1, R * 0.6),
	ForestLake = polar(A.Forest - 0.24, R * 0.43),
	SnowVillage = polar(A.Snow - 0.13, R * 0.42),
	Temple = polar(A.Snow + 0.17, R * 0.72),
	Bastion = polar(A.Hollow + 0.02, R * 0.6),
	RuinsCenter = polar(A.Ruins, R * 0.55),
	Watchtower = polar(A.Dunes, R * 0.57),
}
Layout.Landmarks.SnowPond = Layout.Landmarks.SnowVillage
	+ (Layout.Landmarks.Temple - Layout.Landmarks.SnowVillage).Unit:Cross(Vector3.new(0, 1, 0)) * 330

-- Where each causeway from the capital reaches the ground.
function Layout.rampFoot(id)
	return polar(A[id], Layout.HUB_RADIUS + Layout.RAMP_LENGTH + 40)
end

-- The temple staircase climbs from here to the temple courtyard.
do
	local temple = Layout.Landmarks.Temple
	local toVillage = (Layout.Landmarks.SnowVillage - temple).Unit
	Layout.Landmarks.TempleStairsTop = temple + toVillage * 130
	Layout.Landmarks.TempleStairsFoot = temple + toVillage * 860
	-- the village street runs towards the stairs; the trail from the capital enters at its far end
	local street = (Layout.Landmarks.TempleStairsFoot - Layout.Landmarks.SnowVillage).Unit
	Layout.Landmarks.SnowVillageGate = Layout.Landmarks.SnowVillage - street * 175
end

-- Trails drawn into the terrain (material only).
Layout.Paths = {
	{
		zone = "Forest",
		material = "Ground",
		width = 16,
		points = { Layout.rampFoot("Forest"), Layout.Landmarks.ForestSpawn, Layout.Landmarks.WorldTree },
	},
	{
		zone = "Snow",
		material = "Ground",
		width = 14,
		points = {
			Layout.rampFoot("Snow"),
			Layout.Landmarks.SnowVillageGate,
			Layout.Landmarks.SnowVillage,
			Layout.Landmarks.TempleStairsFoot,
		},
	},
}

-- A handful of rare cottages hidden in the forest. Deterministic so the
-- terrain generator and the builder agree on where they are.
local cottageCache
function Layout.forestCottages()
	if cottageCache then
		return cottageCache
	end
	cottageCache = {}
	local rng = Random.new(Layout.SEED + 77)
	local avoid = { Layout.Landmarks.ForestSpawn, Layout.Landmarks.WorldTree, Layout.Landmarks.ForestLake }
	local tries = 0
	while #cottageCache < 7 and tries < 500 do
		tries += 1
		local a = A.Forest + rng:NextNumber(-0.85, 0.85) * Layout.HALF_SECTOR
		local p = polar(a, rng:NextNumber(R * 0.3, R * 0.86))
		local ok = true
		for _, q in ipairs(avoid) do
			if (p - q).Magnitude < 650 then
				ok = false
				break
			end
		end
		for _, q in ipairs(cottageCache) do
			if (p - q).Magnitude < 900 then
				ok = false
				break
			end
		end
		if ok then
			table.insert(cottageCache, p)
		end
	end
	return cottageCache
end

-- Region lookup ---------------------------------------------------------------
local noise = math.noise

-- Border wobble so regions don't meet along straight lines.
function Layout.warpedAngle(x, z)
	return math.atan2(z, x) + 0.11 * noise(x / 1500 + 3.1, z / 1500 - 1.7, 0.5)
end

-- Which region a world position belongs to ("Hub", one of ZONE_ORDER, or "Coast").
function Layout.getZone(x, z)
	local d = math.sqrt(x * x + z * z)
	if d < Layout.HUB_RADIUS + 60 then
		return "Hub"
	end
	if d > R + 120 then
		return "Coast"
	end
	local theta = Layout.warpedAngle(x, z)
	local best, bestDist = nil, math.huge
	for _, id in ipairs(Layout.ZONE_ORDER) do
		local ad = math.abs(wrap(theta - A[id]))
		if ad < bestDist then
			best, bestDist = id, ad
		end
	end
	return best
end

return Layout
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000005">
			<Properties>
				<string name="Name">Landscape</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Landscape
	The shape of the island. heightAt(x, z) gives the ground height anywhere;
	sample(x, z) also decides the terrain materials. Every builder asks this
	module where the ground is, so props always sit on the terrain.
]]

local Layout = require(script.Parent.IslandLayout)

local Landscape = {}

local noise = math.noise
local abs, sqrt, exp, floor, min, max = math.abs, math.sqrt, math.exp, math.floor, math.min, math.max
local cos, sin, atan2, pi = math.cos, math.sin, math.atan2, math.pi
local clamp = math.clamp

local R = Layout.ISLAND_RADIUS
local HUB_R, HUB_H = Layout.HUB_RADIUS, Layout.HUB_HEIGHT
local APRON = Layout.HUB_APRON
local RAMP = Layout.RAMP_LENGTH
local ROAD = Layout.ROAD_WIDTH
local BEACH = Layout.BEACH_WIDTH
local BLEND = Layout.ZONE_BLEND
local HALF = Layout.HALF_SECTOR
local ORDER = Layout.ZONE_ORDER
local NZ = #ORDER
local wrap = Layout.wrapAngle
local L = Layout.Landmarks

local ZA = {}
local ZI = {}
for i, id in ipairs(ORDER) do
	ZA[i] = Layout.ZoneAngle[id]
	ZI[id] = i
end

Landscape.SEABED = -72
Landscape.BOTTOM = -96

local S0 = (Layout.SEED % 9973) * 0.0131 + 0.377

local function n2(x, z, f, o)
	return noise(x * f + o * 13.37, z * f - o * 7.91, S0 + o * 0.173)
end

-- Fractal noise, roughly in -1..1.
local function fbm(x, z, f, octaves, o)
	local sum, amp, norm = 0, 1, 0
	for i = 1, octaves do
		sum += n2(x, z, f, o + i * 3) * amp
		norm += amp
		amp *= 0.5
		f *= 2.03
	end
	return sum / norm * 2.2
end

local function smooth(e0, e1, x)
	local t = clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

-- Asymmetric dune cross-section: long windward slope, short steep lee face.
local function duneProfile(p)
	if p < 0.74 then
		local t = p / 0.74
		return t * t * (3 - 2 * t)
	end
	local t = (p - 0.74) / 0.26
	return 1 - t * t * (3 - 2 * t)
end

Landscape.noise2 = n2
Landscape.fbm = fbm
Landscape.smooth = smooth

-- Region height functions -----------------------------------------------------
local VX, VZ = L.SnowVillage.X, L.SnowVillage.Z
local TX, TZ = L.Temple.X, L.Temple.Z

local function forestH(x, z)
	local h = 36 + 20 * fbm(x, z, 1 / 1100, 4, 1) + 6 * fbm(x, z, 1 / 260, 3, 2)
	local ridge = 1 - abs(n2(x, z, 1 / 1700, 3)) * 2.4
	h += 60 * max(0, ridge - 0.45)
	return h
end

local function snowH(x, z)
	local h = 52 + 24 * fbm(x, z, 1 / 1000, 4, 11)
	local ridged, amp, f = 0, 1, 1 / 950
	for i = 1, 4 do
		local v = max(0, 1 - abs(n2(x, z, f, 12 + i)) * 2.2)
		ridged += v * v * amp
		amp *= 0.5
		f *= 2.07
	end
	local mask = smooth(-0.15, 0.25, n2(x, z, 1 / 2600, 19))
	local dv = sqrt((x - VX) ^ 2 + (z - VZ) ^ 2)
	mask *= smooth(520, 1350, dv)
	h += ridged * 140 * mask
	h += 270 * exp(-((x - TX) ^ 2 + (z - TZ) ^ 2) / (640 * 640))
	return h
end

local function hollowH(x, z)
	local h = 26 + 14 * fbm(x, z, 1 / 900, 3, 21)
	local u = x * 0.8 + z * 0.6 + 170 * n2(x, z, 1 / 1300, 22)
	h += 10 * duneProfile((u / 430) % 1)
	return h
end

local function ruinsH(x, z)
	local h = 22 + 18 * fbm(x, z, 1 / 800, 4, 41)
	local u = -x * 0.6 + z * 0.8 + 150 * n2(x, z, 1 / 1000, 42)
	h += 16 * duneProfile((u / 260) % 1) * (0.6 + n2(x, z, 1 / 1500, 43))
	return h
end

local function dunesH(x, z)
	local h = 30 + 26 * fbm(x, z, 1 / 1800, 3, 31)
	local u = x * 0.34 + z * 0.94 + 280 * n2(x, z, 1 / 1500, 32)
	local amp = 52 + 40 * n2(x, z, 1 / 2200, 33)
	h += amp * duneProfile((u / 400) % 1)
	local u2 = x * 0.9 - z * 0.43 + 120 * n2(x, z, 1 / 900, 34)
	h += 12 * duneProfile((u2 / 170) % 1)
	return h
end

local ZONE_HEIGHT = {}
ZONE_HEIGHT[ZI.Forest] = forestH
ZONE_HEIGHT[ZI.Snow] = snowH
ZONE_HEIGHT[ZI.Hollow] = hollowH
ZONE_HEIGHT[ZI.Ruins] = ruinsH
ZONE_HEIGHT[ZI.Dunes] = dunesH

local function apronH(x, z)
	return 26 + 7 * fbm(x, z, 1 / 500, 3, 51)
end

-- Coastline -----------------------------------------------------------------
local function coastRadius(theta)
	local cx, cz = cos(theta), sin(theta)
	return R
		* (1 + 0.09 * noise(cx * 1.7 + 5.3, cz * 1.7 - 2.1, S0) + 0.04 * noise(cx * 5.1 - 1.7, cz * 5.1 + 3.3, S0 + 1))
end
Landscape.coastRadius = coastRadius
Landscape.MAX_COAST = R * 1.12

-- Features (filled in by init) -------------------------------------------------
local craters = {}
local lakes = {}
local hills = {}
local pads = {}
local corridor
local rampBottom = {}

-- Steps 1-3: regions, foothills, craters, hills, lakes.
local weights = table.create(NZ, 0)

local function regionHeight(x, z, d, theta)
	local b = clamp(BLEND / max(d, 300), 0.02, HALF * 0.9)
	local sum = 0
	for i = 1, NZ do
		local w = 1 - smooth(HALF - b, HALF + b, abs(wrap(theta - ZA[i])))
		weights[i] = w
		sum += w
	end
	local h = 0
	for i = 1, NZ do
		local w = weights[i] / sum
		if w > 0.001 then
			h += ZONE_HEIGHT[i](x, z) * w
		end
	end
	-- Foothills around the capital mesa
	h = lerp(apronH(x, z), h, smooth(HUB_R + 40, HUB_R + APRON, d))
	return h
end

local function featureHeight(x, z, h, withLakes)
	for _, c in ipairs(craters) do
		local dx, dz = x - c.x, z - c.z
		local dd = dx * dx + dz * dz
		local rr = c.r * 1.7
		if dd < rr * rr then
			local dc = sqrt(dd)
			if dc < c.r then
				h -= c.r * 0.2 * (1 - (dc / c.r) ^ 2)
			end
			h += c.r * 0.07 * exp(-((dc - c.r) / (0.22 * c.r)) ^ 2)
		end
	end
	for _, hl in ipairs(hills) do
		local dd = (x - hl.x) ^ 2 + (z - hl.z) ^ 2
		if dd < (hl.r * 3) ^ 2 then
			h += hl.h * exp(-dd / (hl.r * hl.r))
		end
	end
	if withLakes then
		for _, lk in ipairs(lakes) do
			local dx, dz = x - lk.x, z - lk.z
			local dd = dx * dx + dz * dz
			if dd < (lk.r * 1.3) ^ 2 then
				local dl = sqrt(dd) * (1 + 0.12 * n2(x, z, 1 / 120, 70))
				local bowl = 1 - smooth(lk.r * 0.45, lk.r, dl)
				h = lerp(h, lk.level - lk.depth, bowl)
			end
		end
	end
	return h
end

local function applyPads(x, z, h)
	for _, p in ipairs(pads) do
		local dd = (x - p.x) ^ 2 + (z - p.z) ^ 2
		local outer = p.r + p.fall
		if dd < outer * outer then
			local m = 1 - smooth(p.r, outer, sqrt(dd))
			h = lerp(h, p.h, m)
		end
	end
	return h
end

local function applyCorridor(x, z, h)
	local c = corridor
	if not c then
		return h
	end
	local px, pz = x - c.ax, z - c.az
	local t = clamp((px * c.dx + pz * c.dz) / c.len2, 0, 1)
	local qx, qz = c.ax + c.dx * t - x, c.az + c.dz * t - z
	local lat2 = qx * qx + qz * qz
	if lat2 < c.outer * c.outer then
		local m = 1 - smooth(c.inner, c.outer, sqrt(lat2))
		h = lerp(h, lerp(c.ha, c.hb, t), m)
	end
	return h
end

-- Values exposed by the last call to sample()/heightAt()
local lastKind, lastZone, lastS, lastRoad, lastPath, lastWater, lastFrozen, lastLakebed
local KIND_OCEAN, KIND_BEACH, KIND_LAND, KIND_HUB, KIND_APRON = 0, 1, 2, 3, 4

local function pathAt(x, z, zone)
	for _, p in ipairs(Layout.Paths) do
		if p.zone == zone then
			local pts = p.points
			local half = p.width * 0.5 * (1 + 0.35 * n2(x, z, 1 / 60, 95))
			for i = 1, #pts - 1 do
				local a, b = pts[i], pts[i + 1]
				local abx, abz = b.X - a.X, b.Z - a.Z
				local len2 = abx * abx + abz * abz
				local t = clamp(((x - a.X) * abx + (z - a.Z) * abz) / len2, 0, 1)
				-- gentle meander
				local wob = 26 * n2(a.X + abx * t, a.Z + abz * t, 1 / 260, 96)
				local nx, nz = -abz / sqrt(len2), abx / sqrt(len2)
				local qx = a.X + abx * t + nx * wob - x
				local qz = a.Z + abz * t + nz * wob - z
				if qx * qx + qz * qz < half * half then
					return p.material
				end
			end
		end
	end
	return nil
end

local function core(x, z)
	local d = sqrt(x * x + z * z)
	local theta = atan2(z, x)
	local s = coastRadius(theta) - d
	lastS = s
	lastRoad = false
	lastPath = nil
	lastWater = Layout.SEA_LEVEL
	lastFrozen = false
	lastLakebed = false

	if s < 0 then
		lastKind = KIND_OCEAN
		lastZone = "Coast"
		return lerp(-3, Landscape.SEABED, smooth(0, 700, -s)) + 2 * n2(x, z, 1 / 90, 97)
	end

	local wtheta = Layout.warpedAngle(x, z)
	local mtheta = wtheta + 0.035 * n2(x, z, 1 / 110, 61)
	local best, bestDist = 1, math.huge
	for i = 1, NZ do
		local ad = abs(wrap(mtheta - ZA[i]))
		if ad < bestDist then
			best, bestDist = i, ad
		end
	end
	lastZone = ORDER[best]

	if s < BEACH then
		lastKind = KIND_BEACH
		return lerp(-3, 7, s / BEACH) + 0.8 * n2(x, z, 1 / 40, 90)
	end

	local h = regionHeight(x, z, d, wtheta)
	h = featureHeight(x, z, h, true)
	h = applyPads(x, z, h)
	h = applyCorridor(x, z, h)

	-- Capital mesa with a ragged cliff edge
	local edge = d + 26 * n2(x, z, 1 / 85, 81) + 10 * n2(x, z, 1 / 26, 82)
	local hub = 1 - smooth(HUB_R - 34, HUB_R + 34, edge)
	if hub > 0 then
		h = lerp(h, HUB_H, hub)
	end

	-- Grand causeways from the city gates down to every region
	if d < HUB_R + RAMP + 200 then
		for i = 1, NZ do
			local dth = wrap(theta - ZA[i])
			if abs(dth) < 0.9 then
				local along = d * cos(dth)
				local lat = abs(d * sin(dth))
				if lat < ROAD * 0.5 + 50 then
					local t = clamp((along - (HUB_R - 60)) / (RAMP + 60), 0, 1)
					local rh = lerp(HUB_H, rampBottom[i], t)
					local m = (1 - smooth(ROAD * 0.5, ROAD * 0.5 + 48, lat))
						* (1 - smooth(HUB_R + RAMP, HUB_R + RAMP + 90, along))
					h = lerp(h, rh, m)
					if lat < ROAD * 0.5 - 1 and along > HUB_R - 100 and along < HUB_R + RAMP + 20 then
						lastRoad = true
					end
				end
			end
		end
	end

	-- Leave the beach gently
	local t = smooth(BEACH, BEACH + 520, s)
	h = lerp(7 + (s - BEACH) * 0.02, h, t)

	if hub > 0.5 then
		lastKind = KIND_HUB
		lastZone = "Hub"
	elseif d < HUB_R + APRON * 0.55 then
		lastKind = KIND_APRON
	else
		lastKind = KIND_LAND
		if t < 0.25 + 0.15 * n2(x, z, 1 / 70, 98) then
			lastKind = KIND_BEACH
		end
	end

	for _, lk in ipairs(lakes) do
		local dd = (x - lk.x) ^ 2 + (z - lk.z) ^ 2
		if dd < (lk.r * 1.25) ^ 2 then
			lastWater = max(lastWater, lk.level)
			lastFrozen = lk.frozen
			lastLakebed = h < lk.level + 1
		end
	end

	if lastKind == KIND_LAND or lastKind == KIND_APRON then
		lastPath = pathAt(x, z, lastZone)
	end
	return h
end

-- Public API --------------------------------------------------------------------
local initialized = false

function Landscape.init()
	if initialized then
		return
	end
	initialized = true

	local function rawHeight(p, withLakes)
		local d = math.max(p.Magnitude, 1)
		local h = regionHeight(p.X, p.Z, d, Layout.warpedAngle(p.X, p.Z))
		return featureHeight(p.X, p.Z, h, withLakes)
	end

	-- Impact craters in the ruined city
	local rng = Random.new(Layout.SEED + 5)
	for _ = 1, 8 do
		local a = rng:NextNumber(0, pi * 2)
		local rr = rng:NextNumber(450, 2000)
		table.insert(craters, {
			x = L.RuinsCenter.X + cos(a) * rr,
			z = L.RuinsCenter.Z + sin(a) * rr,
			r = rng:NextNumber(90, 230),
		})
	end

	-- Forest lake with a rocky hill on its far side for the waterfall
	local lake = L.ForestLake
	local outward = lake.Unit
	local hillPos = lake + outward * 360
	table.insert(hills, { x = hillPos.X, z = hillPos.Z, r = 170, h = 85 })
	Landscape.WaterfallHill = hillPos

	local function addLake(pos, r, depth, frozen)
		local level = math.huge
		for k = 0, 47 do
			local a = k / 48 * pi * 2
			local q = pos + Vector3.new(cos(a), 0, sin(a)) * r * 1.18
			level = min(level, rawHeight(q, false))
		end
		level = floor(level - 2)
		table.insert(lakes, { x = pos.X, z = pos.Z, r = r, depth = depth, level = level, frozen = frozen })
		return level
	end
	Landscape.ForestLakeLevel = addLake(lake, 330, 24, false)
	Landscape.SnowPondLevel = addLake(L.SnowPond, 120, 10, true)

	-- Flattened building sites
	local function addPad(pos, r, fall, raise)
		local h = rawHeight(pos, true) + (raise or 0)
		table.insert(pads, { x = pos.X, z = pos.Z, r = r, fall = fall, h = h })
		return h
	end
	Landscape.VillageHeight = addPad(L.SnowVillage, 300, 260)
	Landscape.TempleHeight = addPad(L.Temple, 160, 110, 6)
	Landscape.WatchtowerHeight = addPad(L.Watchtower, 330, 320)
	Landscape.BastionHeight = addPad(L.Bastion, 780, 320)
	Landscape.WorldTreeHeight = addPad(L.WorldTree, 170, 220, 10)
	Landscape.ForestSpawnHeight = addPad(L.ForestSpawn, 130, 160)
	for _, c in ipairs(Layout.forestCottages()) do
		addPad(c, 60, 70)
	end

	-- Straight stair corridor up the temple mountain
	local a, b = L.TempleStairsFoot, L.TempleStairsTop
	local ha = applyPads(a.X, a.Z, rawHeight(a, true))
	local hb = Landscape.TempleHeight
	corridor = {
		ax = a.X,
		az = a.Z,
		dx = b.X - a.X,
		dz = b.Z - a.Z,
		len2 = (b.X - a.X) ^ 2 + (b.Z - a.Z) ^ 2,
		ha = ha,
		hb = hb,
		inner = 15,
		outer = 42,
	}
	Landscape.StairsFootHeight = ha

	-- Height at the bottom of each causeway
	for i, id in ipairs(ORDER) do
		local foot = Layout.polar(ZA[i], HUB_R + RAMP)
		local h = applyCorridor(foot.X, foot.Z, applyPads(foot.X, foot.Z, rawHeight(foot, true)))
		rampBottom[i] = h
		Landscape["RampBottom" .. id] = h
	end
end

-- Ground height at a point.
function Landscape.heightAt(x, z)
	if not initialized then
		Landscape.init()
	end
	return core(x, z)
end

-- Ground position (Vector3) under a point.
function Landscape.groundAt(x, z)
	return Vector3.new(x, Landscape.heightAt(x, z), z)
end

-- Height plus everything a prop scatterer wants to know about the spot.
function Landscape.query(x, z)
	local h = Landscape.heightAt(x, z)
	local kind = lastKind
	return {
		h = h,
		zone = lastZone,
		coastDistance = lastS,
		ocean = kind == KIND_OCEAN,
		beach = kind == KIND_BEACH,
		hub = kind == KIND_HUB,
		apron = kind == KIND_APRON,
		land = kind == KIND_LAND,
		road = lastRoad,
		path = lastPath ~= nil,
		underwater = h < lastWater,
		water = lastWater,
	}
end

-- Slope (rise over run) estimated from four neighbours.
function Landscape.slopeAt(x, z, step)
	step = step or 4
	local hx1 = Landscape.heightAt(x + step, z)
	local hx0 = Landscape.heightAt(x - step, z)
	local hz1 = Landscape.heightAt(x, z + step)
	local hz0 = Landscape.heightAt(x, z - step)
	return max(abs(hx1 - hx0), abs(hz1 - hz0)) / (2 * step)
end

-- Materials ------------------------------------------------------------------------
local M = Enum.Material
Landscape.STRATA = "Strata"

local ZONE_MATS = {
	Forest = { surf = M.Grass, alt = M.LeafyGrass, bank = M.Ground, cliff = M.Rock, sub = M.Rock, bed = M.Ground },
	Snow = { surf = M.Snow, alt = M.Snow, bank = M.Snow, cliff = M.Rock, sub = M.Rock, bed = M.Rock },
	Hollow = { surf = M.Salt, alt = M.Slate, bank = M.Salt, cliff = M.Slate, sub = M.Slate, bed = M.Slate },
	Ruins = { surf = M.Mud, alt = M.Basalt, bank = M.Mud, cliff = M.Basalt, sub = M.Basalt, bed = M.Basalt },
	Dunes = { surf = M.Sand, alt = M.Sandstone, bank = M.Sand, cliff = M.Sandstone, sub = M.Sandstone, bed = M.Sand },
}
local ALT_THRESHOLD = { Forest = 0.12, Snow = 2, Hollow = 0.34, Ruins = 0.4, Dunes = 0.38 }

--[[
	Ground height and materials at a point.
	Returns h, surface, bank (moderate slopes), cliff (steep slopes),
	sub (below the surface), water level, frozen.
]]
function Landscape.sample(x, z)
	local h = Landscape.heightAt(x, z)
	local kind = lastKind
	local water, frozen = lastWater, lastFrozen

	if kind == KIND_OCEAN then
		local surf = n2(x, z, 1 / 300, 99) > 0.3 and M.Rock or M.Sand
		return h, surf, surf, M.Rock, M.Sandstone, water, false
	elseif kind == KIND_HUB then
		local surf = lastRoad and M.Pavement or M.Sandstone
		local dd = sqrt(x * x + z * z)
		-- avenues and the ring road of the capital
		if dd < HUB_R - 70 then
			local theta = atan2(z, x)
			for i = 1, NZ do
				local dth = wrap(theta - ZA[i])
				if abs(dth) < 0.5 and abs(dd * sin(dth)) < 17 then
					surf = M.Pavement
				end
			end
			if (dd > 240 and dd < 296) or (dd > HUB_R - 132 and dd < HUB_R - 104) then
				surf = M.Pavement
			end
		end
		return h, surf, M.Sandstone, M.Sandstone, Landscape.STRATA, water, false
	elseif kind == KIND_APRON then
		if lastRoad then
			return h, M.Pavement, M.Sandstone, M.Sandstone, Landscape.STRATA, water, false
		end
		local zm = ZONE_MATS[lastZone]
		local dd = sqrt(x * x + z * z)
		local blend = smooth(HUB_R, HUB_R + APRON * 0.55, dd) + 0.25 * n2(x, z, 1 / 90, 63)
		local surf
		if blend > 0.75 then
			surf = zm.surf
		else
			surf = n2(x, z, 1 / 140, 64) > 0.05 and M.Sandstone or M.Sand
		end
		return h, lastPath and M[lastPath] or surf, M.Sandstone, M.Sandstone, Landscape.STRATA, water, false
	elseif kind == KIND_BEACH then
		local zm = ZONE_MATS[lastZone]
		local cliff = lastZone == "Snow" and M.Rock or M.Sandstone
		return h, M.Sand, M.Sand, cliff, zm.sub, water, false
	end

	local zone = lastZone
	local zm = ZONE_MATS[zone]
	local surf = zm.surf
	if lastRoad then
		return h, M.Pavement, M.Sandstone, M.Sandstone, Landscape.STRATA, water, false
	end
	if n2(x, z, 1 / 170, 101) > ALT_THRESHOLD[zone] then
		surf = zm.alt
	end
	if zone == "Snow" and h > 300 and n2(x, z, 1 / 90, 102) > 0.05 then
		surf = M.Glacier
	end
	if lastPath then
		surf = M[lastPath]
	end
	if lastLakebed then
		surf = zm.bed
	end
	return h, surf, zm.bank, zm.cliff, zm.sub, water, frozen
end

return Landscape
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000006">
			<Properties>
				<string name="Name">Props</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Props
	Reusable scenery: trees, palms, lanterns, torches, rocks, cars, bones...
	Trees are built once as templates and cloned, so thousands stay fast.
]]

local Layout = require(script.Parent.IslandLayout)
local Util = require(script.Parent.Util)

local Props = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, ball, rod, beam, column, disc, wedge =
	Util.box, Util.ball, Util.rod, Util.beam, Util.column, Util.disc, Util.wedge
local NOCOL = { collide = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local NOSHADOW = { shadow = false }
local TAU = math.pi * 2

local templateCache = {}

local function variants(key, count, seed, build)
	local list = templateCache[key]
	if list then
		return list
	end
	list = {}
	local rng = Random.new(Layout.SEED + seed)
	for i = 1, count do
		table.insert(list, Util.template(key .. i, function(m)
			build(m, rng, i)
		end))
	end
	templateCache[key] = list
	return list
end

function Props.randomTemplate(rng, list)
	return list[rng:NextInteger(1, #list)]
end

-- Palm tree ---------------------------------------------------------------------
function Props.palms()
	return variants("Palm", 5, 101, function(m, rng)
		local H = rng:NextNumber(26, 36)
		local lean = rng:NextNumber(3, 9)
		local bark = Util.vary(rng, rgb(132, 104, 72), 0.08)
		local prev = Vector3.new(0, -2, 0)
		local segs = 5
		for s = 1, segs do
			local t = s / segs
			local p = Vector3.new(lean * t * t, H * t, 0)
			rod(m, prev, p, 2.5 - 0.9 * t, s % 2 == 0 and bark or Util.vary(rng, bark, 0.1), M.Wood)
			prev = p
		end
		local top = prev
		ball(m, top, 2.6, rgb(96, 84, 52), M.Wood, NOCOL)
		local leaf = Util.vary(rng, rgb(70, 132, 52), 0.1)
		for f = 1, 7 do
			local a = f / 7 * TAU + rng:NextNumber(-0.25, 0.25)
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local len = rng:NextNumber(11, 15)
			local mid = top + dir * len * 0.5 + Vector3.new(0, 1.8, 0)
			local tip = top + dir * len + Vector3.new(0, -rng:NextNumber(3, 6), 0)
			beam(m, top, mid, 3.6, 0.35, leaf, M.Grass, NOCOL_NOSHADOW)
			beam(m, mid, tip, 2.6, 0.35, Util.vary(rng, leaf, 0.12), M.Grass, NOCOL)
		end
		for c = 1, 3 do
			local a = c / 3 * TAU
			ball(m, top + Vector3.new(math.cos(a) * 1.3, -1.6, math.sin(a) * 1.3), 1.5, rgb(92, 66, 38), M.Wood, NOCOL_NOSHADOW)
		end
	end)
end

-- Broadleaf trees of the Wildwood -------------------------------------------------------
local FOREST_LEAVES = {
	rgb(76, 140, 58),
	rgb(92, 158, 64),
	rgb(62, 120, 52),
	rgb(110, 168, 70),
	rgb(84, 132, 46),
}
local BLOSSOMS = {
	rgb(244, 170, 200),
	rgb(250, 214, 228),
	rgb(206, 170, 236),
	rgb(255, 236, 200),
}

local function canopyTree(m, rng, leafColors, H, trunkD, puffs, puffSize)
	local bark = Util.vary(rng, rgb(98, 74, 52), 0.1)
	column(m, Vector3.new(0, -2, 0), 5, trunkD * 1.45, bark, M.Wood)
	local bend = Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
	local mid = Vector3.new(0, H * 0.5, 0) + bend
	local top = Vector3.new(0, H * 0.8, 0) + bend * 1.6
	rod(m, Vector3.new(0, 0, 0), mid, trunkD, bark, M.Wood)
	rod(m, mid, top, trunkD * 0.72, bark, M.Wood)
	local tips = { top + Vector3.new(0, H * 0.18, 0) }
	for b = 1, 2 do
		local a = rng:NextNumber(0, TAU)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local from = mid:Lerp(top, rng:NextNumber(0.2, 0.7))
		local to = from + dir * H * rng:NextNumber(0.28, 0.4) + Vector3.new(0, H * 0.22, 0)
		rod(m, from, to, trunkD * 0.45, bark, M.Wood, NOSHADOW)
		table.insert(tips, to)
	end
	for p = 1, puffs do
		local base = tips[(p - 1) % #tips + 1]
		local off = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.4, 0.6), rng:NextNumber(-1, 1)) * puffSize * 0.45
		local size = puffSize * rng:NextNumber(0.75, 1.15)
		ball(m, base + off, size, Util.vary(rng, Util.pick(rng, leafColors), 0.07), M.LeafyGrass, NOCOL)
	end
end

function Props.forestTrees()
	return variants("WildwoodTree", 8, 202, function(m, rng)
		canopyTree(m, rng, FOREST_LEAVES, rng:NextNumber(24, 36), rng:NextNumber(2.6, 3.8), 5, rng:NextNumber(15, 21))
	end)
end

function Props.blossomTrees()
	return variants("BlossomTree", 4, 203, function(m, rng, i)
		local petals = { BLOSSOMS[(i - 1) % #BLOSSOMS + 1] }
		canopyTree(m, rng, petals, rng:NextNumber(20, 28), rng:NextNumber(2.4, 3.2), 5, rng:NextNumber(13, 18))
		local glow = box(m, CFrame.new(0, 24, 0), Vector3.new(1, 1, 1), petals[1], M.SmoothPlastic, {
			collide = false,
			shadow = false,
			transparency = 1,
		})
		Util.particles(glow, {
			Texture = Util.TEX.sparkle,
			Color = Util.cs(petals[1]),
			Size = Util.ns(0, 0.5, 1, 0.3),
			Transparency = Util.ns(0, 0.2, 1, 1),
			Lifetime = NumberRange.new(5, 8),
			Rate = 2,
			Speed = NumberRange.new(0.5, 1.5),
			SpreadAngle = Vector2.new(180, 180),
			Acceleration = Vector3.new(0.6, -1.2, 0.3),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-40, 40),
			Shape = Enum.ParticleEmitterShape.Sphere,
		})
	end)
end

-- Slender pale-barked trees
function Props.slenderTrees()
	return variants("SilverTree", 3, 204, function(m, rng)
		local H = rng:NextNumber(34, 46)
		local bark = rgb(226, 222, 210)
		rod(m, Vector3.new(0, -2, 0), Vector3.new(rng:NextNumber(-1, 1), H, rng:NextNumber(-1, 1)), 2.2, bark, M.Wood)
		for b = 1, 3 do
			local y = H * (0.25 + b * 0.2)
			box(m, CFrame.new(0, y, 0) * CFrame.Angles(0, b, 0), Vector3.new(2.3, 0.6, 2.3), rgb(60, 56, 52), M.Wood, NOCOL_NOSHADOW)
		end
		local leaf = Util.vary(rng, rgb(150, 190, 80), 0.1)
		for p = 1, 3 do
			ball(m, Vector3.new(rng:NextNumber(-2, 2), H * (0.55 + p * 0.13), rng:NextNumber(-2, 2)), 12 - p * 1.5, leaf, M.LeafyGrass, NOCOL)
		end
	end)
end

-- Rare giant trees with hanging vines and glowing mushrooms
function Props.ancientTrees()
	return variants("AncientTree", 3, 205, function(m, rng)
		local H = rng:NextNumber(70, 92)
		local D = rng:NextNumber(13, 17)
		local bark = Util.vary(rng, rgb(88, 66, 48), 0.08)
		local moss = rgb(74, 110, 52)
		column(m, Vector3.new(0, -4, 0), 10, D * 1.6, bark, M.Wood)
		-- roots
		for r = 1, 6 do
			local a = r / 6 * TAU + rng:NextNumber(-0.2, 0.2)
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			rod(m, dir * D * 0.3 + Vector3.new(0, 7, 0), dir * D * 1.6 + Vector3.new(0, -2, 0), D * 0.32, r % 2 == 0 and moss or bark, M.Wood)
		end
		local mid = Vector3.new(rng:NextNumber(-3, 3), H * 0.55, rng:NextNumber(-3, 3))
		local top = Vector3.new(rng:NextNumber(-5, 5), H * 0.85, rng:NextNumber(-5, 5))
		rod(m, Vector3.new(0, 0, 0), mid, D, bark, M.Wood)
		rod(m, mid, top, D * 0.75, bark, M.Wood)
		local tips = { top + Vector3.new(0, 10, 0) }
		for b = 1, 5 do
			local a = b / 5 * TAU + rng:NextNumber(-0.3, 0.3)
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local from = mid:Lerp(top, rng:NextNumber(0.1, 0.9))
			local to = from + dir * rng:NextNumber(22, 32) + Vector3.new(0, rng:NextNumber(8, 18), 0)
			rod(m, from, to, D * 0.36, bark, M.Wood)
			table.insert(tips, to)
		end
		for p = 1, 10 do
			local base = tips[(p - 1) % #tips + 1]
			local off = Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-4, 8), rng:NextNumber(-12, 12))
			ball(m, base + off, rng:NextNumber(30, 44), Util.vary(rng, Util.pick(rng, FOREST_LEAVES), 0.08), M.LeafyGrass, NOCOL)
		end
		-- hanging vines
		for v = 1, 8 do
			local base = tips[(v - 1) % #tips + 1] + Vector3.new(rng:NextNumber(-10, 10), -8, rng:NextNumber(-10, 10))
			local len = rng:NextNumber(16, 30)
			box(m, CFrame.new(base - Vector3.new(0, len / 2, 0)), Vector3.new(0.6, len, 0.6), moss, M.Grass, NOCOL_NOSHADOW)
		end
		-- glowing mushrooms between the roots
		for s = 1, 4 do
			local a = s / 4 * TAU + 0.4
			local p = Vector3.new(math.cos(a), 0, math.sin(a)) * D * 1.1
			local h = rng:NextNumber(2, 4)
			column(m, p, h, 0.9, rgb(230, 226, 210), M.SmoothPlastic, NOCOL_NOSHADOW)
			local cap = disc(m, p + Vector3.new(0, h, 0), 1, rng:NextNumber(3, 4.5), rgb(90, 220, 255), M.Neon, NOCOL_NOSHADOW)
			if s == 1 then
				Util.pointLight(cap, rgb(110, 220, 255), 1.2, 18)
			end
		end
	end)
end

-- Snowy pines ---------------------------------------------------------------------------
-- Each tier is four wedges sloping outwards; alternate tiers are turned 45 degrees.
local function pineTier(m, y, radius, height, color, material, turn)
	for q = 0, 3 do
		local a = q * math.pi / 2 + turn
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local c = Vector3.new(0, y + height / 2, 0) + dir * (radius / 2)
		wedge(m, CFrame.lookAt(c, c + dir), Vector3.new(radius * 1.2, height, radius), color, material, NOCOL)
	end
end

function Props.pines()
	return variants("SnowPine", 8, 301, function(m, rng, i)
		local H = rng:NextNumber(38, 62)
		local bark = rgb(74, 56, 44)
		rod(m, Vector3.new(0, -3, 0), Vector3.new(0, H * 0.75, 0), H * 0.045, bark, M.Wood)
		local snowy = i % 3 == 0
		local green = Util.vary(rng, rgb(32, 62, 48), 0.1)
		local snow = rgb(236, 243, 248)
		local tiers = 3
		for k = 1, tiers do
			local t = (k - 1) / tiers
			local y = H * (0.16 + t * 0.6)
			local r = H * (0.33 - t * 0.24)
			local h = H * 0.36
			local color, mat = green, M.Grass
			if snowy or k == tiers or (k % 2 == 0 and rng:NextNumber() < 0.5) then
				color, mat = snow, M.Snow
			end
			pineTier(m, y, r, h, color, mat, (k % 2) * math.pi / 4)
		end
	end)
end

-- Bare winter tree (no leaves), used around the village and temple.
function Props.bareTrees()
	return variants("BareTree", 3, 302, function(m, rng)
		local bark = rgb(60, 48, 42)
		local function branch(from, dir, len, d, depth)
			local to = from + dir * len
			rod(m, from, to, d, bark, M.Wood, NOSHADOW)
			if depth > 0 then
				for _ = 1, 3 do
					local nd = (dir + Vector3.new(rng:NextNumber(-0.8, 0.8), rng:NextNumber(0.1, 0.6), rng:NextNumber(-0.8, 0.8))).Unit
					branch(to, nd, len * 0.66, d * 0.6, depth - 1)
				end
			else
				ball(m, to, d * 3, rgb(240, 246, 250), M.Snow, NOCOL_NOSHADOW)
			end
		end
		branch(Vector3.new(0, -2, 0), Vector3.new(0, 1, 0), rng:NextNumber(14, 20), 2.6, 2)
	end)
end

-- Crystal-white dead trees of the Hollow Expanse
function Props.quartzTrees()
	return variants("QuartzTree", 6, 401, function(m, rng)
		local color = rgb(236, 240, 246)
		local function branch(from, dir, len, d, depth)
			local to = from + dir * len
			rod(m, from, to, d, color, M.Glass, { reflectance = 0.15, transparency = 0.08 })
			if depth > 0 then
				local count = rng:NextInteger(2, 3)
				for _ = 1, count do
					local nd = (dir + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.1, 0.5), rng:NextNumber(-1, 1)) * 0.8).Unit
					branch(to, nd, len * rng:NextNumber(0.55, 0.75), d * 0.58, depth - 1)
				end
			end
		end
		local lean = Vector3.new(rng:NextNumber(-0.2, 0.2), 1, rng:NextNumber(-0.2, 0.2)).Unit
		branch(Vector3.new(0, -3, 0), lean, rng:NextNumber(14, 22), rng:NextNumber(2.2, 3.2), 2)
	end)
end

-- Bushes --------------------------------------------------------------------------------
function Props.bushes()
	return variants("Bush", 6, 501, function(m, rng, i)
		local leaf = Util.vary(rng, FOREST_LEAVES[(i - 1) % #FOREST_LEAVES + 1], 0.08)
		for b = 1, rng:NextInteger(2, 3) do
			ball(m, Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(1, 2.5), rng:NextNumber(-3, 3)), rng:NextNumber(5, 8), leaf, M.LeafyGrass, NOCOL)
		end
		if i % 2 == 0 then
			local flower = BLOSSOMS[(i / 2 - 1) % #BLOSSOMS + 1]
			for f = 1, 4 do
				local a = f / 4 * TAU
				ball(m, Vector3.new(math.cos(a) * 3, 4, math.sin(a) * 3), 1.2, flower, M.SmoothPlastic, NOCOL_NOSHADOW)
			end
		end
	end)
end

-- Lanterns, torches, lights ----------------------------------------------------------------

-- Japanese stone lantern (toro). position is the ground point.
function Props.stoneLantern(parent, position, yaw, snowy)
	local m = Util.model(parent, "StoneLantern")
	local stone = rgb(150, 148, 142)
	local cf = CFrame.new(position) * CFrame.Angles(0, yaw or 0, 0)
	box(m, cf * CFrame.new(0, 0.6, 0), Vector3.new(4.4, 1.2, 4.4), stone, M.Granite)
	column(m, (cf * CFrame.new(0, 1.2, 0)).Position, 4.5, 1.8, stone, M.Granite)
	box(m, cf * CFrame.new(0, 6, 0), Vector3.new(3.6, 0.8, 3.6), stone, M.Granite)
	local light = box(m, cf * CFrame.new(0, 7.4, 0), Vector3.new(2.6, 2, 2.6), rgb(255, 196, 120), M.Neon, NOSHADOW)
	Util.pointLight(light, rgb(255, 178, 96), 1.4, 22, false)
	Util.hipRoof(m, cf * CFrame.new(0, 8.4, 0), 5.6, 5.6, 1.8, 0.6, stone, M.Granite)
	ball(m, (cf * CFrame.new(0, 10.4, 0)).Position, 1.2, stone, M.Granite)
	if snowy then
		box(m, cf * CFrame.new(0, 9.9, 0), Vector3.new(3.4, 0.6, 3.4), rgb(240, 246, 252), M.Snow, NOSHADOW)
	end
	return m
end

-- Standing torch with real fire.
function Props.torch(parent, position, height, color)
	height = height or 9
	local m = Util.model(parent, "Torch")
	column(m, position, height, 0.9, rgb(70, 52, 38), M.Wood)
	local bowl = disc(m, position + Vector3.new(0, height, 0), 1, 2.6, color or rgb(196, 160, 72), M.Metal)
	Util.fire(bowl, 3, 7)
	Util.pointLight(bowl, rgb(255, 150, 70), 1.6, 26, false)
	return m
end

-- Tall street lamp with a warm lantern.
function Props.streetLamp(parent, position, height)
	height = height or 14
	local m = Util.model(parent, "Lamp")
	local metal = rgb(62, 56, 48)
	column(m, position, height, 0.8, metal, M.Metal)
	disc(m, position + Vector3.new(0, 0.4, 0), 0.8, 2.4, metal, M.Metal)
	local lamp = box(m, CFrame.new(position + Vector3.new(0, height + 1.4, 0)), Vector3.new(1.8, 2.4, 1.8), rgb(255, 214, 150), M.Neon, NOSHADOW)
	Util.pointLight(lamp, rgb(255, 196, 120), 1.5, 30, false)
	box(m, CFrame.new(position + Vector3.new(0, height + 2.9, 0)), Vector3.new(2.6, 0.6, 2.6), metal, M.Metal)
	return m
end

-- Rocks ------------------------------------------------------------------------------------
-- A cluster of tilted stone blocks (cheap, looks good on beaches and in ruins).
function Props.rockCluster(parent, rng, position, size, color, material)
	local m = Util.model(parent, "Rocks")
	for _ = 1, rng:NextInteger(2, 4) do
		local s = Vector3.new(rng:NextNumber(0.6, 1.2), rng:NextNumber(0.4, 0.9), rng:NextNumber(0.6, 1.2)) * size
		local cf = CFrame.new(position + Vector3.new(rng:NextNumber(-0.6, 0.6) * size, s.Y * 0.2, rng:NextNumber(-0.6, 0.6) * size))
			* CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, TAU), rng:NextNumber(-0.4, 0.4))
		box(m, cf, s, Util.vary(rng, color, 0.08), material or M.Rock)
	end
	return m
end

-- Broken classical column lying or standing.
function Props.brokenColumn(parent, rng, position, color, material)
	local m = Util.model(parent, "BrokenColumn")
	local d = rng:NextNumber(5, 8)
	if rng:NextNumber() < 0.5 then
		local h = rng:NextNumber(8, 26)
		box(m, CFrame.new(position + Vector3.new(0, 1, 0)), Vector3.new(d * 1.5, 2, d * 1.5), color, material)
		column(m, position + Vector3.new(0, 2, 0), h, d, color, material)
		box(m, CFrame.new(position + Vector3.new(0, h + 2.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)),
			Vector3.new(d * 0.9, 1.2, d * 0.9), color, material)
	else
		local a = rng:NextNumber(0, TAU)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local len = rng:NextNumber(14, 30)
		rod(m, position + Vector3.new(0, d * 0.35, 0), position + dir * len + Vector3.new(0, d * 0.3, 0), d, color, material)
		local p2 = position + dir * (len + d * 0.9) + Vector3.new(0, d * 0.3, 0)
		rod(m, p2, p2 + (dir + Vector3.new(0.4, 0, 0.5)).Unit * len * 0.4, d, color, material)
	end
	return m
end

-- Giant skeleton half buried in sand: spine, ribs and a horned skull.
function Props.giantSkeleton(parent, rng, position, yaw, scale)
	local m = Util.model(parent, "AncientRemains")
	local bone = rgb(232, 226, 208)
	local cf = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	local segs = 18
	local spine = {}
	for s = 0, segs do
		local t = s / segs
		local p = cf * Vector3.new(0, (4 + math.sin(t * math.pi) * 10) * scale, (t - 0.5) * 140 * scale)
		spine[s] = p
		ball(m, p, (5 - t * 2) * scale, bone, M.Marble)
	end
	for s = 3, 12 do
		local p = spine[s]
		local ribLen = (34 - math.abs(s - 7) * 3) * scale
		for side = -1, 1, 2 do
			local prev = p
			for k = 1, 4 do
				local a = k / 4 * math.pi * 0.9
				local q = p + cf:VectorToWorldSpace(Vector3.new(side * math.sin(a) * ribLen * 0.55, (math.cos(a) - 1) * ribLen * 0.45, 0))
				rod(m, prev, q, 1.6 * scale, bone, M.Marble, NOSHADOW)
				prev = q
			end
		end
	end
	local head = spine[segs] + cf.LookVector * -14 * scale + Vector3.new(0, -2 * scale, 0)
	ball(m, head, 22 * scale, bone, M.Marble)
	box(m, CFrame.lookAt(head, head - cf.LookVector) * CFrame.new(0, -6 * scale, -12 * scale), Vector3.new(14, 5, 18) * scale, bone, M.Marble)
	for side = -1, 1, 2 do
		local eye = head + cf:VectorToWorldSpace(Vector3.new(side * 5 * scale, 3 * scale, 9 * scale))
		ball(m, eye, 6 * scale, rgb(30, 28, 32), M.SmoothPlastic, NOCOL)
		local hornBase = head + cf:VectorToWorldSpace(Vector3.new(side * 8 * scale, 8 * scale, -2 * scale))
		local hornTip = hornBase + cf:VectorToWorldSpace(Vector3.new(side * 10, 18, -14) * scale)
		rod(m, hornBase, hornTip, 3 * scale, bone, M.Marble)
	end
	return m
end

-- Burnt-out car for the ruined city.
local CAR_PAINT = { rgb(110, 58, 40), rgb(70, 70, 74), rgb(140, 128, 108), rgb(96, 40, 36), rgb(52, 64, 72), rgb(150, 120, 60) }
function Props.wreckedCar(parent, rng, groundCF)
	local m = Util.model(parent, "WreckedCar")
	local paint = Util.vary(rng, Util.pick(rng, CAR_PAINT), 0.1)
	local rust = rgb(102, 62, 40)
	local glass = rgb(20, 22, 26)
	box(m, groundCF * CFrame.new(0, 2.4, 0), Vector3.new(7, 2.6, 15), paint, M.CorrodedMetal)
	box(m, groundCF * CFrame.new(0, 4.6, 0.8) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, 0), Vector3.new(6.2, 2.2, 7.2), paint, M.CorrodedMetal)
	box(m, groundCF * CFrame.new(0, 4.6, 0.8), Vector3.new(6.4, 1.6, 6), glass, M.Glass, NOSHADOW)
	box(m, groundCF * CFrame.new(0, 2.6, -7.4), Vector3.new(6.6, 1.4, 0.6), rust, M.CorrodedMetal, NOSHADOW)
	for _, w in ipairs({ { -3.4, -4.6 }, { 3.4, -4.6 }, { -3.4, 4.6 }, { 3.4, 4.6 } }) do
		if rng:NextNumber() < 0.8 then
			Util.cylinder(m, groundCF * CFrame.new(w[1], 1.4, w[2]), 1.2, 2.8, rgb(24, 22, 22), M.Rubber, NOSHADOW)
		end
	end
	return m
end

-- Leaning, broken lamp post for the ruins
function Props.brokenLamp(parent, rng, position)
	local m = Util.model(parent, "BrokenLamp")
	local metal = rgb(56, 52, 50)
	local bend = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
	local mid = position + Vector3.new(0, 12, 0) + bend * 2
	local top = mid + (Vector3.new(0, 1, 0) + bend * rng:NextNumber(0.6, 1.6)).Unit * 10
	rod(m, position - Vector3.new(0, 2, 0), mid, 0.8, metal, M.CorrodedMetal)
	rod(m, mid, top, 0.7, metal, M.CorrodedMetal)
	rod(m, top, top + (bend + Vector3.new(0, -0.3, 0)).Unit * 4, 0.6, metal, M.CorrodedMetal)
	return m
end

-- Smouldering fire with smoke, for ruins and camps.
function Props.smoulder(parent, position, big)
	local p = box(parent, CFrame.new(position), Vector3.new(4, 1, 4), rgb(30, 26, 24), M.Basalt, { collide = false, shadow = false, transparency = 1 })
	p.Name = "Smoulder"
	Util.particles(p, {
		Texture = Util.TEX.smoke,
		Color = Util.cs(rgb(40, 38, 38), rgb(90, 86, 84)),
		Size = Util.ns(0, big and 8 or 4, 1, big and 34 or 16),
		Transparency = Util.ns(0, 0.5, 1, 1),
		Lifetime = NumberRange.new(8, 14),
		Rate = big and 6 or 3,
		Speed = NumberRange.new(6, 10),
		SpreadAngle = Vector2.new(12, 12),
		Acceleration = Vector3.new(2, 1, 0),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-20, 20),
		LightInfluence = 1,
	})
	Util.particles(p, {
		Texture = Util.TEX.sparkle,
		Color = Util.cs(rgb(255, 150, 60), rgb(255, 70, 20)),
		Size = Util.ns(0, 0.4, 1, 0),
		Lifetime = NumberRange.new(2, 4),
		Rate = big and 14 or 6,
		Speed = NumberRange.new(4, 9),
		SpreadAngle = Vector2.new(30, 30),
		LightEmission = 1,
	})
	Util.pointLight(p, rgb(255, 110, 40), 2, big and 40 or 22, false)
	return p
end

return Props
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000007">
			<Properties>
				<string name="Name">TerrainWriter</string>
				<ProtectedString name="Source"><![CDATA[--[[
	TerrainWriter
	Writes the landscape into Roblox terrain, 256x256 stud chunk by chunk.
	Open sea is filled with big FillBlock calls; every chunk that touches the
	island is written voxel by voxel with WriteVoxels.
]]

local Layout = require(script.Parent.IslandLayout)
local Landscape = require(script.Parent.Landscape)
local Util = require(script.Parent.Util)

local TerrainWriter = {}

local M = Enum.Material
local AIR, WATER, ICE = M.Air, M.Water, M.Ice
local STRATA = Landscape.STRATA
local STRATA_MATS = { M.Sandstone, M.Sandstone, M.Limestone, M.Sandstone, M.Rock }

local VOX = 4
local CHUNK = 256
local N = CHUNK / VOX
local BOTTOM = Landscape.BOTTOM
local SEABED = Landscape.SEABED

local BANK_SLOPE = 0.75
local CLIFF_SLOPE = 1.2

-- Terrain colours. These are global per material, so each material is used by one region.
TerrainWriter.MaterialColors = {
	Grass = Color3.fromRGB(92, 156, 66),
	LeafyGrass = Color3.fromRGB(70, 128, 54),
	Ground = Color3.fromRGB(112, 88, 62),
	Sand = Color3.fromRGB(228, 194, 132),
	Sandstone = Color3.fromRGB(200, 150, 100),
	Limestone = Color3.fromRGB(230, 214, 178),
	Pavement = Color3.fromRGB(204, 184, 146),
	Salt = Color3.fromRGB(236, 237, 242),
	Slate = Color3.fromRGB(176, 180, 190),
	Mud = Color3.fromRGB(30, 28, 32),
	Basalt = Color3.fromRGB(56, 52, 54),
	Snow = Color3.fromRGB(242, 247, 255),
	Glacier = Color3.fromRGB(190, 222, 238),
	Ice = Color3.fromRGB(166, 208, 232),
	Rock = Color3.fromRGB(116, 117, 124),
	Cobblestone = Color3.fromRGB(128, 124, 118),
}

local function applyColors(terrain)
	for name, color in pairs(TerrainWriter.MaterialColors) do
		terrain:SetMaterialColor(M[name], color)
	end
	terrain.WaterColor = Color3.fromRGB(22, 112, 140)
	terrain.WaterReflectance = 0.55
	terrain.WaterTransparency = 0.7
	terrain.WaterWaveSize = 0.22
	terrain.WaterWaveSpeed = 11
	pcall(function()
		terrain.Decoration = true -- animated grass blades
	end)
end

local function writeChunk(terrain, cx, cz)
	-- Sample one column ring wider than the chunk so slopes are right at the edges.
	local hs, surf, bank, cliff, sub, wl, frz = {}, {}, {}, {}, {}, {}, {}
	local maxTop = Layout.SEA_LEVEL
	for i = 0, N + 1 do
		local x = cx + (i - 1) * VOX + VOX / 2
		local hrow = table.create(N + 2)
		hs[i] = hrow
		if i >= 1 and i <= N then
			surf[i], bank[i], cliff[i], sub[i], wl[i], frz[i] = {}, {}, {}, {}, {}, {}
		end
		for k = 0, N + 1 do
			local z = cz + (k - 1) * VOX + VOX / 2
			if i >= 1 and i <= N and k >= 1 and k <= N then
				local h, s1, s2, s3, s4, w, f = Landscape.sample(x, z)
				hrow[k] = h
				surf[i][k], bank[i][k], cliff[i][k], sub[i][k], wl[i][k], frz[i][k] = s1, s2, s3, s4, w, f
				if h > maxTop then
					maxTop = h
				end
				if w > maxTop then
					maxTop = w
				end
			else
				hrow[k] = Landscape.heightAt(x, z)
			end
		end
	end

	local yMin = BOTTOM
	local yMax = math.ceil((maxTop + 8) / VOX) * VOX
	local ny = (yMax - yMin) / VOX

	local mats = table.create(N)
	local occs = table.create(N)
	for i = 1, N do
		local mi, oi = table.create(ny), table.create(ny)
		mats[i], occs[i] = mi, oi
		for j = 1, ny do
			mi[j] = table.create(N, AIR)
			oi[j] = table.create(N, 0)
		end
	end

	for i = 1, N do
		local mi, oi = mats[i], occs[i]
		local hprev, hcur, hnext = hs[i - 1], hs[i], hs[i + 1]
		for k = 1, N do
			local h = hcur[k]
			local slope = math.max(math.abs(hnext[k] - hprev[k]), math.abs(hcur[k + 1] - hcur[k - 1])) / (2 * VOX)
			local top = surf[i][k]
			if slope > CLIFF_SLOPE then
				top = cliff[i][k]
			elseif slope > BANK_SLOPE then
				top = bank[i][k]
			end
			local deep = sub[i][k]
			local water = wl[i][k]
			local frozen = frz[i][k]
			for j = 1, ny do
				local yb = yMin + (j - 1) * VOX
				local occ = (h - yb) / VOX
				if occ > 0.02 then
					if occ > 1 then
						occ = 1
					end
					local mat
					if h - yb < 7 then
						mat = top
					elseif deep == STRATA then
						mat = STRATA_MATS[(math.floor((yb + 1000) / 12) % #STRATA_MATS) + 1]
					else
						mat = deep
					end
					mi[j][k] = mat
					oi[j][k] = occ
				elseif yb < water then
					if frozen and yb >= water - 8 then
						mi[j][k] = ICE
					else
						mi[j][k] = WATER
					end
					oi[j][k] = 1
				else
					break
				end
			end
		end
	end

	local region = Region3.new(Vector3.new(cx, yMin, cz), Vector3.new(cx + CHUNK, yMax, cz + CHUNK)):ExpandToGrid(VOX)
	terrain:WriteVoxels(region, VOX, mats, occs)
end

function TerrainWriter.Generate()
	Landscape.init()
	local terrain = workspace.Terrain
	applyColors(terrain)

	local ext = Layout.OCEAN_EXTENT
	local landReach = Landscape.MAX_COAST + 760
	local total = (2 * ext / CHUNK) ^ 2
	local done, landChunks = 0, 0
	local lastReport = -1
	local started = os.clock()

	local function oceanRun(x0, x1, cz)
		local w = x1 - x0
		local cxm = (x0 + x1) / 2
		terrain:FillBlock(
			CFrame.new(cxm, (BOTTOM + SEABED) / 2, cz + CHUNK / 2),
			Vector3.new(w, SEABED - BOTTOM, CHUNK),
			M.Sand
		)
		terrain:FillBlock(
			CFrame.new(cxm, (SEABED + Layout.SEA_LEVEL) / 2, cz + CHUNK / 2),
			Vector3.new(w, Layout.SEA_LEVEL - SEABED, CHUNK),
			WATER
		)
	end

	for cz = -ext, ext - CHUNK, CHUNK do
		local runStart = nil
		for cx = -ext, ext - CHUNK, CHUNK do
			local nx = math.clamp(0, cx, cx + CHUNK)
			local nz = math.clamp(0, cz, cz + CHUNK)
			local nearest = math.sqrt(nx * nx + nz * nz)
			if nearest > landReach then
				runStart = runStart or cx
			else
				if runStart then
					oceanRun(runStart, cx, cz)
					runStart = nil
				end
				writeChunk(terrain, cx, cz)
				landChunks += 1
			end
			done += 1
			Util.breathe()
		end
		if runStart then
			oceanRun(runStart, ext, cz)
		end
		local pct = math.floor(done / total * 20) * 5
		if pct ~= lastReport then
			lastReport = pct
			Util.log(string.format("Terrain %d%% (%d island chunks, %.0fs)", pct, landChunks, os.clock() - started))
		end
	end
end

-- Terrain shapes added on top of the base landscape -----------------------------

-- A boulder made of a few overlapping terrain balls.
function TerrainWriter.boulder(rng, pos, size, material)
	local terrain = workspace.Terrain
	terrain:FillBall(pos, size, material)
	for _ = 1, rng:NextInteger(1, 3) do
		local off = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 0.6), rng:NextNumber(-1, 1)) * size * 0.7
		terrain:FillBall(pos + off, size * rng:NextNumber(0.45, 0.8), material)
	end
end

-- A leaning rock spire made of stacked, shrinking cylinders.
function TerrainWriter.spire(rng, base, height, radius, material, lean)
	local terrain = workspace.Terrain
	local dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
	if dir.Magnitude < 0.01 then
		dir = Vector3.new(1, 0, 0)
	end
	dir = dir.Unit
	local up = (Vector3.new(0, 1, 0) + dir * (lean or 0.15)).Unit
	local segments = math.max(2, math.floor(height / 40))
	local segH = height / segments
	local p = base - Vector3.new(0, 10, 0)
	for s = 1, segments do
		local r = radius * (1 - (s - 1) / segments * 0.7)
		local c = p + up * (segH / 2)
		terrain:FillCylinder(CFrame.lookAt(c, c + up) * CFrame.Angles(math.pi / 2, 0, 0), segH + 6, r, material)
		p = p + up * segH
		up = (up + Vector3.new(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08))).Unit
	end
	terrain:FillBall(p, radius * 0.35, material)
end

-- A natural stone arch from a to b.
function TerrainWriter.arch(base1, base2, height, thickness, material)
	local terrain = workspace.Terrain
	local steps = 24
	for s = 0, steps do
		local t = s / steps
		local p = base1:Lerp(base2, t) + Vector3.new(0, math.sin(t * math.pi) * height, 0)
		local r = thickness * (1.25 - 0.45 * math.sin(t * math.pi))
		terrain:FillBall(p, r, material)
	end
end

return TerrainWriter
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000008">
			<Properties>
				<string name="Name">Util</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Util
	Small helpers for building anchored parts quickly.
	Every helper takes a parent first and returns the new part.
]]

local Config = require(script.Parent.Config)

local Util = {}

local M = Enum.Material
local SMOOTH = Enum.SurfaceType.Smooth
local HALF_PI = math.pi / 2

Util.rgb = Color3.fromRGB

local lastYield = os.clock()

-- Yield every Config.YIELD_EVERY seconds so Studio doesn't freeze.
function Util.breathe()
	if os.clock() - lastYield > Config.YIELD_EVERY then
		task.wait()
		lastYield = os.clock()
	end
end

function Util.log(...)
	if Config.VERBOSE then
		print("[IslandMap]", ...)
	end
end

local function finish(p, parent, color, material, opts)
	p.Anchored = true
	p.TopSurface = SMOOTH
	p.BottomSurface = SMOOTH
	p.Color = color
	p.Material = material or M.SmoothPlastic
	if opts then
		if opts.collide == false then
			p.CanCollide = false
			p.CanTouch = false
		end
		if opts.shadow == false then
			p.CastShadow = false
		end
		if opts.transparency then
			p.Transparency = opts.transparency
		end
		if opts.reflectance then
			p.Reflectance = opts.reflectance
		end
		if opts.name then
			p.Name = opts.name
		end
	end
	p.Parent = parent
	return p
end

local function clampSize(v)
	return Vector3.new(
		math.clamp(v.X, 0.05, 2048),
		math.clamp(v.Y, 0.05, 2048),
		math.clamp(v.Z, 0.05, 2048)
	)
end

-- Block centered on cf.
function Util.box(parent, cf, size, color, material, opts)
	local p = Instance.new("Part")
	p.Size = clampSize(size)
	p.CFrame = cf
	return finish(p, parent, color, material, opts)
end

-- Wedge centered on cf. The sloped face points along cf.LookVector.
function Util.wedge(parent, cf, size, color, material, opts)
	local p = Instance.new("WedgePart")
	p.Size = clampSize(size)
	p.CFrame = cf
	return finish(p, parent, color, material, opts)
end

-- Sphere centered on pos.
function Util.ball(parent, pos, diameter, color, material, opts)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	local d = math.clamp(diameter, 0.05, 2048)
	p.Size = Vector3.new(d, d, d)
	p.CFrame = CFrame.new(pos)
	return finish(p, parent, color, material, opts)
end

-- Ellipsoid (sphere mesh). Collision stays box-shaped, so it defaults to no collision.
function Util.ellipsoid(parent, cf, size, color, material, opts)
	local p = Instance.new("Part")
	p.Size = clampSize(size)
	p.CFrame = cf
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	opts = opts or {}
	if opts.collide == nil then
		opts.collide = false
	end
	return finish(p, parent, color, material, opts)
end

-- Cylinder whose axis runs along cf's X axis.
function Util.cylinder(parent, cf, length, diameter, color, material, opts)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = clampSize(Vector3.new(length, diameter, diameter))
	p.CFrame = cf
	return finish(p, parent, color, material, opts)
end

-- Upright cylinder standing on base (a Vector3 at its bottom center).
function Util.column(parent, base, height, diameter, color, material, opts)
	local cf = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, HALF_PI)
	return Util.cylinder(parent, cf, height, diameter, color, material, opts)
end

-- Flat disc (short upright cylinder) centered on pos.
function Util.disc(parent, pos, thickness, diameter, color, material, opts)
	local cf = CFrame.new(pos) * CFrame.Angles(0, 0, HALF_PI)
	return Util.cylinder(parent, cf, thickness, diameter, color, material, opts)
end

-- Cylinder from point a to point b.
function Util.rod(parent, a, b, diameter, color, material, opts)
	local len = (b - a).Magnitude
	if len < 0.05 then
		len = 0.05
	end
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, HALF_PI, 0)
	return Util.cylinder(parent, cf, len, diameter, color, material, opts)
end

-- Block from point a to point b (a beam or plank), width x thickness.
function Util.beam(parent, a, b, width, thickness, color, material, opts)
	local len = math.max((b - a).Magnitude, 0.05)
	local cf = CFrame.lookAt((a + b) / 2, b)
	return Util.box(parent, cf, Vector3.new(width, thickness, len), color, material, opts)
end

function Util.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Util.folder(parent, name)
	local f = parent:FindFirstChild(name)
	if f then
		return f
	end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Util.pointLight(part, color, brightness, range, shadows)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = math.min(range, 60)
	l.Shadows = shadows or false
	l.Parent = part
	return l
end

function Util.surfaceLight(part, face, color, brightness, range, angle)
	local l = Instance.new("SurfaceLight")
	l.Face = face
	l.Color = color
	l.Brightness = brightness
	l.Range = math.min(range, 60)
	l.Angle = angle or 90
	l.Parent = part
	return l
end

function Util.fire(part, size, heat, color, secondary)
	local f = Instance.new("Fire")
	f.Size = size
	f.Heat = heat
	f.Color = color or Color3.fromRGB(255, 140, 50)
	f.SecondaryColor = secondary or Color3.fromRGB(255, 60, 20)
	f.Parent = part
	return f
end

-- Particle emitter with sensible defaults; props overrides anything.
function Util.particles(part, props)
	local e = Instance.new("ParticleEmitter")
	e.LightInfluence = 0
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = part
	return e
end

-- Number / colour sequence helpers
function Util.ns(...)
	local pts = { ... }
	if #pts == 1 then
		return NumberSequence.new(pts[1])
	end
	local kps = {}
	for i = 1, #pts, 2 do
		table.insert(kps, NumberSequenceKeypoint.new(pts[i], pts[i + 1]))
	end
	return NumberSequence.new(kps)
end

function Util.cs(a, b)
	return ColorSequence.new(a, b or a)
end

-- Gable roof: two wedges meeting at a ridge.
-- cf is the center of the eaves line (top of the walls); the ridge runs along cf's Z axis.
function Util.gableRoof(parent, cf, width, depth, height, color, material, opts)
	local half = width / 2
	local left = Util.wedge(
		parent,
		cf * CFrame.new(-half / 2, height / 2, 0) * CFrame.Angles(0, HALF_PI, 0),
		Vector3.new(depth, height, half),
		color,
		material,
		opts
	)
	local right = Util.wedge(
		parent,
		cf * CFrame.new(half / 2, height / 2, 0) * CFrame.Angles(0, -HALF_PI, 0),
		Vector3.new(depth, height, half),
		color,
		material,
		opts
	)
	return left, right
end

-- Hip roof built from four sloped plates (reads well from any angle).
-- cf is the center of the eaves; returns nothing.
function Util.hipRoof(parent, cf, width, depth, rise, thickness, color, material, opts)
	local hw, hd = width / 2, depth / 2
	local angX = math.atan2(rise, hw)
	local angZ = math.atan2(rise, hd)
	local slantX = math.sqrt(hw * hw + rise * rise)
	local slantZ = math.sqrt(hd * hd + rise * rise)
	-- front / back plates span the full width
	for _, sgn in ipairs({ 1, -1 }) do
		local c = cf * CFrame.new(0, rise / 2, sgn * hd / 2) * CFrame.Angles(sgn * angZ, 0, 0)
		Util.box(parent, c, Vector3.new(width, thickness, slantZ), color, material, opts)
	end
	-- side plates
	for _, sgn in ipairs({ 1, -1 }) do
		local c = cf * CFrame.new(sgn * hw / 2, rise / 2, 0) * CFrame.Angles(0, 0, -sgn * angX)
		Util.box(parent, c, Vector3.new(slantX, thickness, depth), color, material, opts)
	end
end

-- Builds a model with fn(model) at the origin and returns it as a template.
-- The template lives in an unparented folder until cloned.
function Util.template(name, fn)
	local m = Instance.new("Model")
	m.Name = name
	fn(m)
	m.WorldPivot = CFrame.new()
	return m
end

-- Places a clone of template at position with a yaw (radians) and scale.
function Util.place(template, parent, position, yaw, scale, tilt)
	local m = template:Clone()
	if scale and math.abs(scale - 1) > 0.01 then
		m:ScaleTo(scale)
	end
	local cf = CFrame.new(position) * CFrame.Angles(0, yaw or 0, 0)
	if tilt then
		cf = cf * tilt
	end
	m:PivotTo(cf)
	m.Parent = parent
	return m
end

-- Shuffled jittered grid of points inside a square region (for scattering).
function Util.scatterGrid(rng, minX, minZ, maxX, maxZ, spacing)
	local pts = {}
	local x = minX
	while x < maxX do
		local z = minZ
		while z < maxZ do
			table.insert(pts, Vector3.new(x + rng:NextNumber(0, spacing), 0, z + rng:NextNumber(0, spacing)))
			z += spacing
		end
		x += spacing
	end
	return pts
end

function Util.vary(rng, color, amount)
	local k = 1 + rng:NextNumber(-amount, amount)
	return Color3.new(math.clamp(color.R * k, 0, 1), math.clamp(color.G * k, 0, 1), math.clamp(color.B * k, 0, 1))
end

function Util.pick(rng, list)
	return list[rng:NextInteger(1, #list)]
end

-- Built-in particle textures that ship with every Roblox install.
Util.TEX = {
	sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
}

return Util
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX00000010">
			<Properties>
				<string name="Name">Zones</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000009">
				<Properties>
					<string name="Name">Coast</string>
					<ProtectedString name="Source"><![CDATA[--[[
	The Endless Shore
	The sand beach that rings the whole island, dressed to match the region
	behind it, plus a lighthouse, a shipwreck and the invisible world border
	out at sea.
]]

local Layout = require(script.Parent.Parent.IslandLayout)
local Landscape = require(script.Parent.Parent.Landscape)
local TerrainWriter = require(script.Parent.Parent.TerrainWriter)
local Util = require(script.Parent.Parent.Util)
local Props = require(script.Parent.Parent.Props)
local Config = require(script.Parent.Parent.Config)

local Coast = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, ball, column, disc, rod, wedge = Util.box, Util.ball, Util.column, Util.disc, Util.rod, Util.wedge
local NOCOL = { collide = false }
local NOSHADOW = { shadow = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local TAU = math.pi * 2
local HALF_PI = math.pi / 2

local DRIFTWOOD = rgb(176, 160, 136)

local function ground(p)
	return Vector3.new(p.X, Landscape.heightAt(p.X, p.Z), p.Z)
end

-- Point on the beach at an angle, `inland` studs from the waterline.
local function beachPoint(angle, inland)
	local rc = Landscape.coastRadius(angle)
	return Layout.polar(angle, rc - inland)
end

local function driftwood(parent, rng, pos)
	local a = rng:NextNumber(0, TAU)
	local dir = Vector3.new(math.cos(a), 0, math.sin(a))
	local len = rng:NextNumber(8, 16)
	local p0 = pos - dir * len / 2 + Vector3.new(0, 0.6, 0)
	local p1 = pos + dir * len / 2 + Vector3.new(0, 0.9, 0)
	local m = Util.model(parent, "Driftwood")
	rod(m, p0, p1, rng:NextNumber(1.2, 2), DRIFTWOOD, M.Wood)
	rod(m, p0:Lerp(p1, 0.6), p0:Lerp(p1, 0.6) + Vector3.new(rng:NextNumber(-3, 3), 1.5, rng:NextNumber(-3, 3)), 0.6, DRIFTWOOD, M.Wood, NOSHADOW)
	return m
end

local function iceChunks(parent, rng, pos)
	local m = Util.model(parent, "IceChunks")
	for _ = 1, rng:NextInteger(2, 4) do
		local s = Vector3.new(rng:NextNumber(3, 9), rng:NextNumber(2, 6), rng:NextNumber(3, 9))
		box(m, CFrame.new(pos + Vector3.new(rng:NextNumber(-6, 6), s.Y * 0.2, rng:NextNumber(-6, 6))) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, TAU), rng:NextNumber(-0.4, 0.4)), s, rgb(190, 226, 244), M.Glacier, { transparency = 0.15, reflectance = 0.1 })
	end
	return m
end

-- Lighthouse --------------------------------------------------------------------------------------------
local function lighthouse(parent, rng, pos, seaDir)
	local m = Util.model(parent, "OldLighthouse")
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	TerrainWriter.boulder(rng, pos + Vector3.new(0, -4, 0), 22, M.Rock)
	local base = pos + Vector3.new(0, 10, 0)
	column(m, base - Vector3.new(0, 4, 0), 8, 30, rgb(120, 118, 112), M.Cobblestone)
	local white, red = rgb(240, 238, 232), rgb(178, 44, 40)
	local y = 4
	for k = 0, 5 do
		local d = 22 - k * 1.6
		column(m, base + Vector3.new(0, y, 0), 12, d, k % 2 == 0 and white or red, M.Plaster)
		y += 12
	end
	disc(m, base + Vector3.new(0, y, 0), 2, 22, rgb(50, 50, 54), M.Metal)
	for k = 0, 15 do
		local a = k / 16 * TAU
		box(m, CFrame.new(base + Vector3.new(math.cos(a) * 10.5, y + 2.5, math.sin(a) * 10.5)), Vector3.new(0.5, 3, 0.5), rgb(40, 40, 44), M.Metal, NOSHADOW)
	end
	column(m, base + Vector3.new(0, y + 1, 0), 10, 12, rgb(220, 240, 255), M.Glass, { transparency = 0.5, reflectance = 0.2 })
	local lamp = ball(m, base + Vector3.new(0, y + 6, 0), 6, rgb(255, 240, 190), M.Neon, NOSHADOW)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Angle = 40
	spot.Range = 60
	spot.Brightness = 6
	spot.Color = rgb(255, 236, 190)
	spot.Parent = lamp
	lamp.CFrame = CFrame.lookAt(lamp.Position, lamp.Position + seaDir)
	Util.pointLight(lamp, rgb(255, 236, 190), 3, 60)
	disc(m, base + Vector3.new(0, y + 11.5, 0), 1.4, 16, red, M.Metal)
	ball(m, base + Vector3.new(0, y + 12, 0), 10, red, M.Metal)
	ball(m, base + Vector3.new(0, y + 17.6, 0), 1.6, rgb(40, 40, 44), M.Metal)
	-- keeper's cottage
	local inland = -seaDir
	local hc = CFrame.lookAt(pos + inland * 30, pos + inland * 30 + seaDir)
	local g = Landscape.heightAt(hc.Position.X, hc.Position.Z)
	hc = hc - Vector3.new(0, hc.Position.Y - g, 0)
	box(m, hc * CFrame.new(0, 5, 0), Vector3.new(16, 12, 12), white, M.Plaster)
	Util.gableRoof(m, hc * CFrame.new(0, 11, 0) * CFrame.Angles(0, HALF_PI, 0), 15, 19, 6, red, M.RoofShingles)
	local win = box(m, hc * CFrame.new(-4, 6, -6.1), Vector3.new(3, 3, 0.3), rgb(255, 214, 140), M.SmoothPlastic, NOSHADOW)
	Util.surfaceLight(win, Enum.NormalId.Front, rgb(255, 200, 130), 1, 12)
	return m
end

-- Shipwreck ----------------------------------------------------------------------------------------------
local function shipwreck(parent, rng, pos, seaDir)
	local m = Util.model(parent, "Shipwreck")
	local hull = rgb(92, 66, 46)
	local cf = CFrame.lookAt(pos, pos + Vector3.new(-seaDir.Z, 0, seaDir.X)) * CFrame.Angles(0, 0, 0.35) * CFrame.new(0, 2, 0)
	box(m, cf * CFrame.new(0, 0, 0), Vector3.new(20, 3, 60), hull, M.WoodPlanks)
	for _, s in ipairs({ -1, 1 }) do
		box(m, cf * CFrame.new(s * 10, 5, 0) * CFrame.Angles(0, 0, s * 0.25), Vector3.new(2, 12, 58), hull, M.WoodPlanks)
	end
	wedge(m, cf * CFrame.new(0, 4, -36) * CFrame.Angles(0, math.pi, 0), Vector3.new(18, 10, 14), hull, M.WoodPlanks)
	-- broken ribs at the stern
	for z = 18, 30, 4 do
		for _, s in ipairs({ -1, 1 }) do
			rod(m, (cf * CFrame.new(s * 9, 1, z)).Position, (cf * CFrame.new(s * 12, 14, z)).Position, 1.4, hull, M.Wood, NOSHADOW)
		end
	end
	box(m, cf * CFrame.new(0, 8, -6), Vector3.new(18, 1, 34), rgb(122, 92, 64), M.WoodPlanks)
	local mast = rod(m, (cf * CFrame.new(0, 8, -4)).Position, (cf * CFrame.new(2, 46, -6)).Position, 2.2, rgb(80, 58, 40), M.Wood)
	mast.Name = "Mast"
	rod(m, (cf * CFrame.new(-12, 36, -5)).Position, (cf * CFrame.new(14, 38, -6)).Position, 1, rgb(80, 58, 40), M.Wood, NOSHADOW)
	box(m, cf * CFrame.new(-2, 28, -5.3) * CFrame.Angles(0, 0, 0.08), Vector3.new(16, 14, 0.3), rgb(220, 210, 186), M.Fabric, NOCOL)
	rod(m, (cf * CFrame.new(0, 8, 20)).Position, (cf * CFrame.new(16, -2, 34)).Position, 1.6, rgb(80, 58, 40), M.Wood)
	for _ = 1, 5 do
		local p = ground(pos + Vector3.new(rng:NextNumber(-40, 40), 0, rng:NextNumber(-40, 40)))
		box(m, CFrame.new(p + Vector3.new(0, 1, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, TAU), 0), Vector3.new(3.4, 3.4, 3.4), rgb(140, 104, 66), M.WoodPlanks)
	end
	local chest = box(m, CFrame.new(ground(pos + seaDir * -24) + Vector3.new(0, 1.2, 0)), Vector3.new(4, 2.6, 2.6), rgb(110, 70, 40), M.WoodPlanks)
	chest.Name = "Chest"
	box(m, chest.CFrame * CFrame.new(0, 0.2, -1.35), Vector3.new(4.2, 0.4, 0.2), rgb(214, 172, 74), M.Foil, NOCOL_NOSHADOW)
	return m
end

-- World border ----------------------------------------------------------------------------------------------
local function worldBorder(parent)
	local m = Util.model(parent, "WorldBorder")
	local R = Layout.WORLD_BORDER
	local n = 96
	for k = 0, n - 1 do
		local a = (k + 0.5) / n * TAU
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local pos = dir * R + Vector3.new(0, 600, 0)
		local p = box(m, CFrame.lookAt(pos, pos + Vector3.new(-dir.Z, 0, dir.X)), Vector3.new(20, 1400, TAU * R / n + 4), rgb(255, 255, 255), M.SmoothPlastic, {
			shadow = false,
			transparency = 1,
		})
		p.CanQuery = false
		p.CanTouch = false
	end
	return m
end

---------------------------------------------------------------------------------------------------------
function Coast.Build(folder, rng)
	Util.log("Dressing the shore...")
	local palms = Props.palms()
	local quartz = Props.quartzTrees()
	local deco = Util.folder(folder, "BeachDecor")
	local R = Layout.ISLAND_RADIUS
	local steps = math.floor(TAU * R / 60 * math.min(Config.FOLIAGE_DENSITY, 2))
	local count = 0
	for k = 0, steps - 1 do
		local a = k / steps * TAU + rng:NextNumber(-0.002, 0.002)
		local p = beachPoint(a, rng:NextNumber(50, Layout.BEACH_WIDTH - 30))
		local q = Landscape.query(p.X, p.Z)
		if q.h > 1.5 and not q.ocean then
			local pos = Vector3.new(p.X, q.h, p.Z)
			local zone = Layout.getZone(p.X * 0.97, p.Z * 0.97)
			local r = rng:NextNumber()
			if zone == "Forest" or zone == "Dunes" then
				if r < 0.32 then
					Util.place(Props.randomTemplate(rng, palms), deco, pos - Vector3.new(0, 1, 0), rng:NextNumber(0, TAU), rng:NextNumber(0.85, 1.25))
				elseif r < 0.4 then
					driftwood(deco, rng, pos)
				elseif r < 0.46 then
					Props.rockCluster(deco, rng, pos, rng:NextNumber(4, 9), rgb(140, 136, 128), M.Rock)
				end
			elseif zone == "Snow" then
				if r < 0.16 then
					Props.rockCluster(deco, rng, pos, rng:NextNumber(5, 10), rgb(118, 120, 126), M.Rock)
					workspace.Terrain:FillBall(pos + Vector3.new(0, 3, 0), rng:NextNumber(3, 5), M.Snow)
				elseif r < 0.26 then
					iceChunks(deco, rng, pos)
				elseif r < 0.3 then
					driftwood(deco, rng, pos)
				end
			elseif zone == "Hollow" then
				if r < 0.08 then
					Util.place(Props.randomTemplate(rng, quartz), deco, pos - Vector3.new(0, 1, 0), rng:NextNumber(0, TAU), rng:NextNumber(0.6, 1))
				elseif r < 0.18 then
					Props.rockCluster(deco, rng, pos, rng:NextNumber(4, 8), rgb(214, 216, 224), M.Slate)
				end
			elseif zone == "Ruins" then
				if r < 0.1 then
					Props.rockCluster(deco, rng, pos, rng:NextNumber(4, 10), rgb(80, 78, 76), M.Concrete)
				elseif r < 0.13 then
					Props.wreckedCar(deco, rng, CFrame.new(pos - Vector3.new(0, 1.5, 0)) * CFrame.Angles(0.1, rng:NextNumber(0, TAU), 0.15))
				elseif r < 0.18 then
					driftwood(deco, rng, pos)
				end
			end
			count += 1
		end
		Util.breathe()
	end

	-- a few rocky outcrops in the surf
	for _ = 1, 40 do
		local a = rng:NextNumber(0, TAU)
		local p = beachPoint(a, -rng:NextNumber(20, 120))
		TerrainWriter.boulder(rng, Vector3.new(p.X, rng:NextNumber(-6, 2), p.Z), rng:NextNumber(8, 18), M.Rock)
	end

	-- landmarks on the shore
	local la = Layout.ZoneAngle.Forest - 0.42
	local lp = beachPoint(la, 70)
	lighthouse(folder, rng, ground(lp), Vector3.new(math.cos(la), 0, math.sin(la)))
	local sa = Layout.ZoneAngle.Dunes + 0.3
	local sp = beachPoint(sa, 40)
	shipwreck(folder, rng, ground(sp), Vector3.new(math.cos(sa), 0, math.sin(sa)))

	worldBorder(folder)
	Util.log(string.format("  %d beach spots dressed", count))
end

return Coast
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000A">
				<Properties>
					<string name="Name">Dunes</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Sea of Whispering Dunes
	Towering golden dunes that roll forever. In their exact middle stands the
	Starwarden Watchtower: seven stacked tiers with glowing star windows, an
	observatory crowned by an armillary sphere around a captive star, and a
	pillar of light that can be seen from anywhere on the island.
	Around it: wind-carved hoodoos and arches, a colossal buried statue,
	the bones of a sand leviathan and lost caravans.
]]

local Layout = require(script.Parent.Parent.IslandLayout)
local Landscape = require(script.Parent.Parent.Landscape)
local TerrainWriter = require(script.Parent.Parent.TerrainWriter)
local Util = require(script.Parent.Parent.Util)
local Props = require(script.Parent.Parent.Props)

local Dunes = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, ball, column, disc, rod, beam, wedge = Util.box, Util.ball, Util.column, Util.disc, Util.rod, Util.beam, Util.wedge
local NOCOL = { collide = false }
local NOSHADOW = { shadow = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local TAU = math.pi * 2
local HALF_PI = math.pi / 2
local L = Layout.Landmarks

local STONE = rgb(226, 212, 182)
local STONE_ALT = rgb(214, 196, 160)
local STONE_DARK = rgb(184, 152, 112)
local GOLD = rgb(214, 172, 74)
local STARLIGHT = rgb(160, 214, 255)
local SANDSTONE = rgb(204, 160, 112)

local function flatCF(pos, dir)
	return CFrame.lookAt(pos, pos + Vector3.new(dir.X, 0, dir.Z))
end

local function ground(p)
	return Vector3.new(p.X, Landscape.heightAt(p.X, p.Z), p.Z)
end

local TELEPORT_SOURCE = [[
-- Teleport circle: touching it carries a player to the linked circle.
local pad = script.Parent
local busy = {}
pad.Touched:Connect(function(hit)
	local character = hit.Parent
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or busy[character] then
		return
	end
	local target = pad:GetAttribute("Target")
	if typeof(target) ~= "Vector3" then
		return
	end
	busy[character] = true
	character:PivotTo(CFrame.new(target + Vector3.new(0, 5, 0)))
	task.delay(2, function()
		busy[character] = nil
	end)
end)
]]

local function teleportPad(parent, pos, target, color)
	local pad = disc(parent, pos, 1, 16, color, M.Neon, NOSHADOW)
	pad.Name = "TeleportCircle"
	pad.Transparency = 0.25
	pad:SetAttribute("Target", target)
	Util.pointLight(pad, color, 2, 24)
	Util.particles(pad, {
		Texture = Util.TEX.sparkle,
		Color = Util.cs(color),
		Size = Util.ns(0, 0.8, 1, 0),
		Lifetime = NumberRange.new(1.5, 2.5),
		Rate = 25,
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(10, 10),
		EmissionDirection = Enum.NormalId.Right,
		LightEmission = 1,
	})
	local s = Instance.new("Script")
	s.Name = "Teleport"
	s.Source = TELEPORT_SOURCE
	s.Parent = pad
	return pad
end

-- Ring of beams (for the armillary sphere).
local function ring(parent, center, radius, axisCF, thickness, color, material)
	local seg = 28
	for k = 0, seg - 1 do
		local a0, a1 = k / seg * TAU, (k + 1) / seg * TAU
		local p0 = center + axisCF:VectorToWorldSpace(Vector3.new(math.cos(a0) * radius, math.sin(a0) * radius, 0))
		local p1 = center + axisCF:VectorToWorldSpace(Vector3.new(math.cos(a1) * radius, math.sin(a1) * radius, 0))
		beam(parent, p0, p1, thickness, thickness, color, material, NOCOL_NOSHADOW)
	end
end

-- Watchtower --------------------------------------------------------------------------------------
local function buildWatchtower(parent, rng)
	local m = Util.model(parent, "StarwardenWatchtower")
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local g = Landscape.WatchtowerHeight
	local C = Vector3.new(L.Watchtower.X, g, L.Watchtower.Z)
	local toCenter = Vector3.new(-C.X, 0, -C.Z).Unit

	-- stepped foundation
	disc(m, C + Vector3.new(0, -8, 0), 24, 320, STONE_DARK, M.Sandstone)
	disc(m, C + Vector3.new(0, -2, 0), 24, 276, STONE, M.Limestone)
	disc(m, C + Vector3.new(0, 4, 0), 24, 236, STONE_ALT, M.Limestone)
	disc(m, C + Vector3.new(0, 16.2, 0), 0.6, 238, GOLD, M.Foil, NOSHADOW)
	for k = 0, 2 do
		local r0 = 118 + k * 21
		local p = C + toCenter * (r0 + 10)
		box(m, flatCF(Vector3.new(p.X, g + 13 - k * 6 - 6, p.Z), toCenter), Vector3.new(60, 12, 22), STONE, M.Limestone)
	end

	-- seven buttresses and guardian pillars
	for k = 0, 6 do
		local a = k / 7 * TAU + math.atan2(toCenter.Z, toCenter.X) + TAU / 14
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local c = C + dir * 118 + Vector3.new(0, 16 + 35, 0)
		wedge(m, flatCF(c, dir), Vector3.new(18, 70, 56), STONE_ALT, M.Limestone)
		local pillarBase = ground(C + dir * 150)
		column(m, pillarBase - Vector3.new(0, 4, 0), 64, 11, STONE, M.Limestone)
		box(m, CFrame.new(pillarBase + Vector3.new(0, 61, 0)), Vector3.new(14, 3, 14), STONE_DARK, M.Sandstone)
		local star = box(m, CFrame.new(pillarBase + Vector3.new(0, 68, 0)) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), Vector3.new(5, 5, 5), STARLIGHT, M.Neon, NOCOL_NOSHADOW)
		Util.pointLight(star, STARLIGHT, 1.5, 34)
	end

	-- the seven tiers
	local y = g + 16
	for i = 0, 6 do
		local r = 88 - i * 8
		local h = 70 - i * 3
		local base = C + Vector3.new(0, y - C.Y, 0)
		column(m, base, h, r * 2, i % 2 == 0 and STONE or STONE_ALT, M.Limestone)
		for k = 0, 6 do
			local a = k / 7 * TAU + i * 0.22
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			box(m, flatCF(base + dir * (r - 0.6) + Vector3.new(0, h / 2, 0), dir), Vector3.new(5, h, 4), STONE_DARK, M.Sandstone)
			local a2 = a + TAU / 14
			local dir2 = Vector3.new(math.cos(a2), 0, math.sin(a2))
			box(m, flatCF(base + dir2 * (r + 0.1) + Vector3.new(0, h * 0.55, 0), dir2), Vector3.new(2.4, h * 0.4, 0.8), STARLIGHT, M.Neon, NOCOL_NOSHADOW)
		end
		disc(m, base + Vector3.new(0, h, 0), 4, r * 2 + 10, STONE_DARK, M.Sandstone)
		disc(m, base + Vector3.new(0, h + 2.2, 0), 0.6, r * 2 + 6, GOLD, M.Foil, NOSHADOW)
		if i % 2 == 1 then
			disc(m, base + Vector3.new(0, h - 4, 0), 2, r * 2 + 26, STONE, M.Limestone)
		end
		y += h
	end

	-- grand door facing the island center
	local doorCF = flatCF(C + toCenter * 87.5 + Vector3.new(0, 16, 0), toCenter)
	box(m, doorCF * CFrame.new(0, 17, 0), Vector3.new(22, 34, 1.2), rgb(40, 30, 26), M.Wood)
	Util.cylinder(m, doorCF * CFrame.new(0, 34, 0) * CFrame.Angles(0, HALF_PI, 0), 1.2, 22, rgb(40, 30, 26), M.Wood)
	box(m, doorCF * CFrame.new(-12, 18, -0.6), Vector3.new(2.4, 38, 1.6), GOLD, M.Foil, NOSHADOW)
	box(m, doorCF * CFrame.new(12, 18, -0.6), Vector3.new(2.4, 38, 1.6), GOLD, M.Foil, NOSHADOW)

	-- observatory on top
	local top = C + Vector3.new(0, y - C.Y, 0)
	disc(m, top + Vector3.new(0, 2, 0), 4, 124, STONE_DARK, M.Sandstone)
	for k = 0, 27 do
		local a = k / 28 * TAU
		box(m, CFrame.new(top + Vector3.new(math.cos(a) * 60, 7, math.sin(a) * 60)), Vector3.new(2, 6, 2), STONE, M.Limestone, NOSHADOW)
	end
	for k = 0, 6 do
		local a = k / 7 * TAU
		column(m, top + Vector3.new(math.cos(a) * 44, 4, math.sin(a) * 44), 40, 7, STONE, M.Marble)
	end
	disc(m, top + Vector3.new(0, 46, 0), 4, 104, STONE_DARK, M.Sandstone)
	ball(m, top + Vector3.new(0, 47, 0), 76, rgb(240, 236, 226), M.Marble)
	disc(m, top + Vector3.new(0, 62, 0), 1.2, 69.8, GOLD, M.Foil, NOSHADOW)

	-- armillary sphere around a captive star
	local core = top + Vector3.new(0, 140, 0)
	rod(m, top + Vector3.new(0, 84, 0), core - Vector3.new(0, 18, 0), 3, GOLD, M.Foil)
	ring(m, core, 44, CFrame.new(), 2.2, GOLD, M.Foil)
	ring(m, core, 40, CFrame.Angles(HALF_PI, 0, 0), 2.2, GOLD, M.Foil)
	ring(m, core, 36, CFrame.Angles(HALF_PI, 0.8, 0) * CFrame.Angles(0, 0, 0.5), 2, STARLIGHT, M.Neon)
	local star = ball(m, core, 18, rgb(230, 244, 255), M.Neon, NOCOL_NOSHADOW)
	Util.pointLight(star, STARLIGHT, 4, 60, false)
	Util.particles(star, {
		Texture = Util.TEX.sparkle,
		Color = Util.cs(rgb(200, 230, 255), rgb(255, 230, 160)),
		Size = Util.ns(0, 2.5, 1, 0),
		Lifetime = NumberRange.new(2, 4),
		Rate = 30,
		Speed = NumberRange.new(4, 10),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 1,
	})
	local beamPart = Util.cylinder(m, CFrame.new(core + Vector3.new(0, 1000, 0)) * CFrame.Angles(0, 0, HALF_PI), 1980, 5, rgb(200, 230, 255), M.Neon, NOCOL_NOSHADOW)
	beamPart.Transparency = 0.55
	beamPart.CanQuery = false
	beamPart.Name = "LightPillar"

	-- teleport circles between the door and the observatory
	-- (each circle drops you a little away from the other one so you don't bounce straight back)
	local side = Vector3.new(-toCenter.Z, 0, toCenter.X)
	local bottomPad = C + toCenter * 106 + Vector3.new(0, 16.6, 0)
	local topPad = top + Vector3.new(0, 4.6, 0) + toCenter * 52
	teleportPad(m, bottomPad, top + Vector3.new(0, 4.6, 0) + side * 52, STARLIGHT)
	teleportPad(m, topPad, bottomPad + toCenter * 14, rgb(255, 220, 150))
	return m
end

-- Colossal buried statue and hand --------------------------------------------------------------------
local function buriedStatue(parent, rng, pos)
	local m = Util.model(parent, "BuriedColossus")
	local face = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
	local cf = flatCF(pos - Vector3.new(0, 18, 0), face) * CFrame.Angles(0.25, 0, 0.18)
	ball(m, cf.Position, 64, SANDSTONE, M.Sandstone)
	box(m, cf * CFrame.new(0, 12, -24), Vector3.new(40, 8, 20), SANDSTONE, M.Sandstone)
	wedge(m, cf * CFrame.new(0, 0, -33), Vector3.new(8, 16, 8), SANDSTONE, M.Sandstone)
	for _, s in ipairs({ -1, 1 }) do
		ball(m, (cf * CFrame.new(s * 11, 6, -26)).Position, 9, rgb(60, 44, 34), M.SmoothPlastic, NOCOL)
	end
	box(m, cf * CFrame.new(0, -12, -26), Vector3.new(18, 3, 8), rgb(150, 110, 80), M.Sandstone)
	-- tall headdress, cracked
	box(m, cf * CFrame.new(0, 34, 4), Vector3.new(50, 20, 40), STONE_DARK, M.Sandstone)
	wedge(m, cf * CFrame.new(-18, 52, 4) * CFrame.Angles(0, HALF_PI, 0), Vector3.new(40, 18, 14), STONE_DARK, M.Sandstone)
	box(m, cf * CFrame.new(0, 34, -16), Vector3.new(50, 3, 2), GOLD, M.Foil, NOSHADOW)

	-- an enormous hand reaching out of the sand nearby
	local handPos = ground(pos + Vector3.new(-face.Z, 0, face.X) * 110)
	local hcf = CFrame.new(handPos) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0) * CFrame.Angles(-0.5, 0, 0)
	box(m, hcf * CFrame.new(0, 10, 0), Vector3.new(26, 30, 10), SANDSTONE, M.Sandstone)
	for f = 0, 3 do
		local x = -9 + f * 6
		local p0 = (hcf * CFrame.new(x, 25, 0)).Position
		local p1 = (hcf * CFrame.new(x, 38 - math.abs(f - 1.5) * 2, -3)).Position
		local p2 = (hcf * CFrame.new(x, 46 - math.abs(f - 1.5) * 3, -10)).Position
		rod(m, p0, p1, 5.4, SANDSTONE, M.Sandstone)
		rod(m, p1, p2, 4.8, SANDSTONE, M.Sandstone)
	end
	local t0 = (hcf * CFrame.new(14, 14, -2)).Position
	rod(m, t0, (hcf * CFrame.new(22, 26, -8)).Position, 6, SANDSTONE, M.Sandstone)
	return m
end

-- Lost caravan -------------------------------------------------------------------------------------------
local function caravan(parent, rng, pos)
	local m = Util.model(parent, "LostCaravan")
	local cf = CFrame.new(pos - Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0) * CFrame.Angles(0, 0, 0.2)
	local wood = rgb(120, 86, 56)
	box(m, cf * CFrame.new(0, 3, 0), Vector3.new(9, 2, 16), wood, M.WoodPlanks)
	for _, z in ipairs({ -5, 5 }) do
		Util.cylinder(m, cf * CFrame.new(-5, 2.2, z), 1, 6, rgb(90, 64, 42), M.Wood)
	end
	Util.cylinder(m, cf * CFrame.new(3, 0.4, 6) * CFrame.Angles(0, 0, 1.2), 1, 6, rgb(90, 64, 42), M.Wood)
	for k = -1, 1 do
		local p = cf * CFrame.new(0, 7, k * 5)
		rod(m, (cf * CFrame.new(-4.5, 4, k * 5)).Position, p.Position + Vector3.new(0, 1, 0), 0.5, wood, M.Wood, NOSHADOW)
		rod(m, (cf * CFrame.new(4.5, 4, k * 5)).Position, p.Position + Vector3.new(0, 1, 0), 0.5, wood, M.Wood, NOSHADOW)
	end
	Util.gableRoof(m, cf * CFrame.new(0, 4, 2), 10, 9, 4, rgb(214, 196, 168), M.Fabric, NOCOL)
	for _ = 1, 4 do
		local p = cf * CFrame.new(rng:NextNumber(-10, 10), 1, rng:NextNumber(-12, 12))
		box(m, p * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, TAU), 0), Vector3.new(3, 3, 3), rgb(140, 104, 66), M.WoodPlanks)
	end
	return m
end

---------------------------------------------------------------------------------------------------------
function Dunes.Build(folder, rng)
	Util.log("Building Sea of Whispering Dunes...")
	buildWatchtower(folder, rng)

	local tower = L.Watchtower
	local function spot(minR, maxR, clear)
		for _ = 1, 40 do
			local a = Layout.ZoneAngle.Dunes + rng:NextNumber(-0.85, 0.85) * Layout.HALF_SECTOR
			local p = Layout.polar(a, rng:NextNumber(minR, maxR))
			local q = Landscape.query(p.X, p.Z)
			if q.land and q.zone == "Dunes" and (p - tower).Magnitude > (clear or 420) then
				return Vector3.new(p.X, q.h, p.Z)
			end
		end
		return nil
	end
	local outer = Layout.ISLAND_RADIUS - Layout.BEACH_WIDTH - 220
	local inner = Layout.HUB_RADIUS + Layout.HUB_APRON * 0.8

	-- wind-carved hoodoos and arches
	for _ = 1, 26 do
		local p = spot(inner, outer)
		if p then
			TerrainWriter.spire(rng, p, rng:NextNumber(40, 130), rng:NextNumber(10, 22), M.Sandstone, rng:NextNumber(0.02, 0.12))
		end
		Util.breathe()
	end
	for _ = 1, 4 do
		local p = spot(inner + 300, outer - 200, 600)
		if p then
			local dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
			local b = ground(p + dir * rng:NextNumber(90, 160))
			TerrainWriter.arch(p - Vector3.new(0, 8, 0), b - Vector3.new(0, 8, 0), rng:NextNumber(60, 100), rng:NextNumber(10, 15), M.Sandstone)
		end
	end

	local relics = Util.model(folder, "Relics")
	local s = spot(inner + 500, outer - 300, 900)
	if s then
		buriedStatue(relics, rng, s)
	end
	local w = spot(inner + 300, outer, 700)
	if w then
		Props.giantSkeleton(relics, rng, w - Vector3.new(0, 14, 0), rng:NextNumber(0, TAU), 2.8)
	end
	for _ = 1, 3 do
		local p = spot(inner, outer, 500)
		if p then
			caravan(relics, rng, p)
		end
	end
	for _ = 1, 30 do
		local p = spot(inner, outer)
		if p then
			Props.brokenColumn(relics, rng, p - Vector3.new(0, 2, 0), STONE_ALT, M.Sandstone)
		end
	end
end

return Dunes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000B">
				<Properties>
					<string name="Name">Forest</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Eloria Wildwood
	A lush, enchanted forest: groves and sunny clearings, blossom trees shedding
	petals, a colossal world tree, a lake fed by a waterfall, glowing mushrooms,
	elven ruins, and only a handful of cottages hidden among the trees.
	New players arrive in a stone circle near the causeway from the capital.
]]

local Layout = require(script.Parent.Parent.IslandLayout)
local Landscape = require(script.Parent.Parent.Landscape)
local TerrainWriter = require(script.Parent.Parent.TerrainWriter)
local Util = require(script.Parent.Parent.Util)
local Props = require(script.Parent.Parent.Props)
local Config = require(script.Parent.Parent.Config)

local Forest = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, ball, column, disc, rod, beam = Util.box, Util.ball, Util.column, Util.disc, Util.rod, Util.beam
local NOCOL = { collide = false }
local NOSHADOW = { shadow = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local TAU = math.pi * 2
local HALF_PI = math.pi / 2
local L = Layout.Landmarks

local BARK = rgb(96, 72, 52)
local MOSS = rgb(82, 120, 56)
local WOOD_DARK = rgb(74, 52, 38)
local STONE = rgb(150, 148, 140)

local function flatCF(pos, dir)
	return CFrame.lookAt(pos, pos + Vector3.new(dir.X, 0, dir.Z))
end

local function ground(p)
	return Vector3.new(p.X, Landscape.heightAt(p.X, p.Z), p.Z)
end

-- World tree --------------------------------------------------------------------------------
local function buildWorldTree(parent, rng)
	local m = Util.model(parent, "Elderheart_WorldTree")
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local base = Vector3.new(L.WorldTree.X, Landscape.WorldTreeHeight - 2, L.WorldTree.Z)
	local H = 230

	-- six strands twisting around each other form the trunk
	for s = 1, 6 do
		local a0 = s / 6 * TAU
		local prev
		for k = 0, 9 do
			local t = k / 9
			local a = a0 + t * TAU * 0.55
			local r = 30 - t * 17
			local p = base + Vector3.new(math.cos(a) * r, t * H, math.sin(a) * r)
			if prev then
				rod(m, prev, p, 32 - t * 18, s % 3 == 0 and Util.vary(rng, MOSS, 0.06) or Util.vary(rng, BARK, 0.05), M.Wood)
			end
			prev = p
		end
	end
	column(m, base - Vector3.new(0, 4, 0), 46, 76, BARK, M.Wood)

	-- roots
	for r = 1, 11 do
		local a = r / 11 * TAU + rng:NextNumber(-0.15, 0.15)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local p0 = base + dir * 20 + Vector3.new(0, 26, 0)
		local p1 = base + dir * 48 + Vector3.new(0, 14, 0)
		local p2 = base + dir * rng:NextNumber(70, 95) + Vector3.new(0, -2, 0)
		local p3 = base + dir * rng:NextNumber(105, 130) + Vector3.new(0, -8, 0)
		local color = r % 2 == 0 and MOSS or BARK
		rod(m, p0, p1, 16, color, M.Wood)
		rod(m, p1, p2, 11, color, M.Wood)
		rod(m, p2, p3, 6, color, M.Wood)
	end

	-- branches and canopy
	local tips = {}
	for b = 1, 9 do
		local a = b / 9 * TAU + rng:NextNumber(-0.2, 0.2)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local from = base + Vector3.new(0, rng:NextNumber(150, 215), 0)
		local mid = from + dir * rng:NextNumber(50, 70) + Vector3.new(0, rng:NextNumber(20, 40), 0)
		local tip = mid + dir * rng:NextNumber(40, 60) + Vector3.new(0, rng:NextNumber(5, 25), 0)
		rod(m, from, mid, 12, BARK, M.Wood)
		rod(m, mid, tip, 7, BARK, M.Wood)
		table.insert(tips, tip)
		table.insert(tips, mid + Vector3.new(0, 20, 0))
	end
	table.insert(tips, base + Vector3.new(0, H + 20, 0))
	local leaves = { rgb(120, 190, 92), rgb(94, 170, 82), rgb(150, 210, 110), rgb(104, 182, 120) }
	for i, tip in ipairs(tips) do
		local size = i == #tips and 150 or rng:NextNumber(62, 100)
		ball(m, tip + Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-4, 10), rng:NextNumber(-8, 8)), size, Util.pick(rng, leaves), M.LeafyGrass, NOCOL)
		if i % 4 == 0 then
			ball(m, tip + Vector3.new(rng:NextNumber(-20, 20), 18, rng:NextNumber(-20, 20)), size * 0.5, rgb(236, 206, 96), M.LeafyGrass, NOCOL)
		end
	end

	-- hanging spirit lanterns
	for k = 1, 12 do
		local tip = tips[(k - 1) % #tips + 1]
		local p = tip + Vector3.new(rng:NextNumber(-20, 20), -rng:NextNumber(40, 60), rng:NextNumber(-20, 20))
		box(m, CFrame.new((p + tip) / 2 + Vector3.new(0, -14, 0)), Vector3.new(0.3, (tip - p).Magnitude - 28, 0.3), MOSS, M.Grass, NOCOL_NOSHADOW)
		local orb = ball(m, p, 3, rgb(170, 255, 220), M.Neon, NOCOL_NOSHADOW)
		if k % 2 == 0 then
			Util.pointLight(orb, rgb(150, 255, 210), 1.5, 30)
		end
	end

	-- drifting spirit motes all around the crown
	local motes = box(m, CFrame.new(base + Vector3.new(0, 190, 0)), Vector3.new(260, 160, 260), rgb(255, 255, 255), M.SmoothPlastic, {
		collide = false,
		shadow = false,
		transparency = 1,
	})
	motes.CanQuery = false
	Util.particles(motes, {
		Texture = Util.TEX.sparkle,
		Color = Util.cs(rgb(200, 255, 170), rgb(255, 230, 140)),
		Size = Util.ns(0, 0, 0.3, 1.2, 1, 0),
		Lifetime = NumberRange.new(6, 10),
		Rate = 40,
		Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -0.4, 0),
		LightEmission = 1,
		Shape = Enum.ParticleEmitterShape.Box,
	})

	-- rune stones around the roots
	for k = 0, 9 do
		local a = k / 10 * TAU
		local p = ground(base + Vector3.new(math.cos(a) * 150, 0, math.sin(a) * 150))
		local cf = flatCF(p, base - p) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08))
		box(m, cf * CFrame.new(0, 6, 0), Vector3.new(6, 16, 3), STONE, M.Slate)
		box(m, cf * CFrame.new(0, 14.4, 0), Vector3.new(6.4, 1.2, 3.4), MOSS, M.Grass, NOSHADOW)
		box(m, cf * CFrame.new(0, 7, -1.55), Vector3.new(0.8, 9, 0.2), rgb(120, 255, 200), M.Neon, NOCOL_NOSHADOW)
	end
	return m
end

-- Lake, waterfall and dock -------------------------------------------------------------------------
local function buildLake(parent, rng)
	local m = Util.model(parent, "MirrorLake")
	local level = Landscape.ForestLakeLevel
	local lake = L.ForestLake
	local hill = Landscape.WaterfallHill
	local toLake = (lake - hill).Unit
	toLake = Vector3.new(toLake.X, 0, toLake.Z).Unit
	local side = Vector3.new(-toLake.Z, 0, toLake.X)

	-- cascade following the hill down to the water
	local pts = {}
	local p = Vector3.new(hill.X, 0, hill.Z) - toLake * 30
	for _ = 1, 80 do
		local h = Landscape.heightAt(p.X, p.Z)
		table.insert(pts, Vector3.new(p.X, math.max(h, level) + 1.4, p.Z))
		if h < level - 1 then
			break
		end
		p += toLake * 10
	end
	local water = rgb(206, 236, 255)
	for i = 1, #pts - 1 do
		beam(m, pts[i], pts[i + 1], 30 - i * 0.2, 1.2, water, M.Glass, { collide = false, shadow = false, transparency = 0.35, reflectance = 0.15 })
	end
	local source = box(m, CFrame.new(pts[1]), Vector3.new(26, 2, 2), water, M.Glass, { collide = false, transparency = 1 })
	Util.particles(source, {
		Texture = Util.TEX.sparkle,
		Color = Util.cs(rgb(230, 245, 255)),
		Size = Util.ns(0, 1, 1, 0.3),
		Transparency = Util.ns(0, 0.3, 1, 1),
		Lifetime = NumberRange.new(1, 2),
		Rate = 30,
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(30, 10),
	})
	local foot = pts[#pts]
	local mist = box(m, CFrame.new(foot + Vector3.new(0, 2, 0)), Vector3.new(30, 2, 10), water, M.Glass, { collide = false, transparency = 1 })
	Util.particles(mist, {
		Texture = Util.TEX.smoke,
		Color = Util.cs(rgb(240, 248, 255)),
		Size = Util.ns(0, 6, 1, 18),
		Transparency = Util.ns(0, 0.6, 1, 1),
		Lifetime = NumberRange.new(3, 5),
		Rate = 10,
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(60, 60),
		Shape = Enum.ParticleEmitterShape.Box,
	})
	-- rocks along both banks of the cascade
	for i = 1, #pts, 3 do
		for _, s in ipairs({ -1, 1 }) do
			TerrainWriter.boulder(rng, pts[i] + side * s * rng:NextNumber(18, 26), rng:NextNumber(6, 10), M.Rock)
		end
	end

	-- lily pads with a few flowers
	for _ = 1, 40 do
		local a = rng:NextNumber(0, TAU)
		local r = rng:NextNumber(60, 220)
		local q = lake + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if Landscape.heightAt(q.X, q.Z) < level - 2 then
			disc(m, Vector3.new(q.X, level + 0.15, q.Z), 0.2, rng:NextNumber(3, 6), rgb(70, 140, 60), M.Grass, NOCOL_NOSHADOW)
			if rng:NextNumber() < 0.3 then
				ball(m, Vector3.new(q.X, level + 0.6, q.Z), 1.2, rgb(250, 200, 220), M.SmoothPlastic, NOCOL_NOSHADOW)
			end
		end
	end

	-- wooden dock on the shore facing the capital
	local towardCenter = (Vector3.new(0, 0, 0) - lake)
	towardCenter = Vector3.new(towardCenter.X, 0, towardCenter.Z).Unit
	local startP = lake + towardCenter * 300
	local endP = lake + towardCenter * 230
	local planks = rgb(132, 100, 70)
	local deckY = level + 2.2
	local a0 = Vector3.new(startP.X, deckY, startP.Z)
	local a1 = Vector3.new(endP.X, deckY, endP.Z)
	local len = (a1 - a0).Magnitude
	local cf = CFrame.lookAt(a0:Lerp(a1, 0.5), a1)
	box(m, cf, Vector3.new(10, 0.8, len), planks, M.WoodPlanks)
	for z = -len / 2, len / 2, 10 do
		for _, x in ipairs({ -4.5, 4.5 }) do
			local post = (cf * CFrame.new(x, 0, z)).Position
			column(m, post - Vector3.new(0, 14, 0), 16, 1.2, WOOD_DARK, M.Wood)
		end
	end
	local lampPos = (cf * CFrame.new(4.5, 0.4, -len / 2 + 2)).Position
	Props.streetLamp(m, lampPos, 7)
	-- small rowing boat tied at the end
	local boatCF = cf * CFrame.new(-9, -1.6, -len / 2 + 4) * CFrame.Angles(0, 0.2, 0)
	box(m, boatCF, Vector3.new(4.6, 1.6, 12), rgb(120, 82, 54), M.WoodPlanks)
	Util.wedge(m, boatCF * CFrame.new(0, 0, -7.5), Vector3.new(4.6, 1.6, 3), rgb(120, 82, 54), M.WoodPlanks)
	box(m, boatCF * CFrame.new(0, 0.6, 0), Vector3.new(4, 0.3, 1.4), rgb(90, 64, 44), M.Wood, NOSHADOW)
	return m
end

-- Cottage -----------------------------------------------------------------------------------------
local ROOFS = { rgb(70, 82, 104), rgb(128, 58, 48), rgb(84, 104, 66), rgb(96, 70, 60) }

local function cottage(parent, rng, pos, facing)
	local m = Util.model(parent, "Cottage")
	local cf = flatCF(pos, facing)
	local W, D, H = 24, 18, 12
	local plaster = Util.vary(rng, rgb(240, 228, 204), 0.03)
	local roofColor = Util.pick(rng, ROOFS)

	box(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(W + 2, 4, D + 2), STONE, M.Cobblestone)
	box(m, cf * CFrame.new(0, 2.5 + H / 2, 0), Vector3.new(W, H, D), plaster, M.Plaster)
	-- timber framing on the long faces
	for _, z in ipairs({ -D / 2 - 0.25, D / 2 + 0.25 }) do
		for _, x in ipairs({ -W / 2 + 0.5, -W / 6, W / 6, W / 2 - 0.5 }) do
			box(m, cf * CFrame.new(x, 2.5 + H / 2, z), Vector3.new(1, H, 0.5), WOOD_DARK, M.Wood, NOSHADOW)
		end
		box(m, cf * CFrame.new(0, 2.5 + H - 0.5, z), Vector3.new(W, 1, 0.5), WOOD_DARK, M.Wood, NOSHADOW)
		box(m, cf * CFrame.new(0, 2.5 + H / 2, z), Vector3.new(W, 0.8, 0.5), WOOD_DARK, M.Wood, NOSHADOW)
	end
	for _, x in ipairs({ -W / 2 - 0.25, W / 2 + 0.25 }) do
		box(m, cf * CFrame.new(x, 2.5 + H / 2, 0), Vector3.new(0.5, 0.8, D), WOOD_DARK, M.Wood, NOSHADOW)
	end

	-- door and glowing windows on the front (-Z)
	box(m, cf * CFrame.new(0, 2.5 + 4, -D / 2 - 0.3), Vector3.new(4.4, 8, 0.4), rgb(92, 60, 40), M.WoodPlanks, NOSHADOW)
	ball(m, (cf * CFrame.new(1.4, 6.5, -D / 2 - 0.55)).Position, 0.5, rgb(214, 172, 74), M.Metal, NOCOL_NOSHADOW)
	for _, x in ipairs({ -W / 3, W / 3 }) do
		local win = box(m, cf * CFrame.new(x, 2.5 + 7.5, -D / 2 - 0.3), Vector3.new(4, 4, 0.3), rgb(255, 214, 140), M.SmoothPlastic, NOSHADOW)
		Util.surfaceLight(win, Enum.NormalId.Front, rgb(255, 200, 130), 1.2, 14, 90)
		box(m, cf * CFrame.new(x, 2.5 + 7.5, -D / 2 - 0.5), Vector3.new(4.4, 0.4, 0.2), WOOD_DARK, M.Wood, NOCOL_NOSHADOW)
		box(m, cf * CFrame.new(x, 2.5 + 7.5, -D / 2 - 0.5), Vector3.new(0.4, 4.4, 0.2), WOOD_DARK, M.Wood, NOCOL_NOSHADOW)
		box(m, cf * CFrame.new(x, 2.5 + 5.2, -D / 2 - 1), Vector3.new(5, 1, 1.4), rgb(110, 76, 50), M.Wood, NOSHADOW)
		for f = -1, 1 do
			ball(m, (cf * CFrame.new(x + f * 1.4, 2.5 + 6, -D / 2 - 1)).Position, 1, Util.pick(rng, { rgb(240, 120, 160), rgb(250, 220, 90), rgb(180, 120, 230) }), M.SmoothPlastic, NOCOL_NOSHADOW)
		end
	end

	-- steep gable roof with the ridge along the long side, and a chimney
	local roofCF = cf * CFrame.new(0, 2.5 + H, 0) * CFrame.Angles(0, HALF_PI, 0)
	Util.gableRoof(m, roofCF, D + 5, W + 4, 10, roofColor, M.RoofShingles)
	box(m, roofCF * CFrame.new(0, 10.2, 0), Vector3.new(1.2, 1, W + 4.6), WOOD_DARK, M.Wood, NOSHADOW)
	local chimney = box(m, cf * CFrame.new(W / 2 - 4, 2.5 + H + 8, D / 4), Vector3.new(3.4, 14, 3.4), STONE, M.Cobblestone)
	local top = box(m, cf * CFrame.new(W / 2 - 4, 2.5 + H + 15.5, D / 4), Vector3.new(4, 1, 4), rgb(110, 108, 104), M.Slate, NOSHADOW)
	Util.particles(top, {
		Texture = Util.TEX.smoke,
		Color = Util.cs(rgb(220, 220, 220), rgb(170, 170, 170)),
		Size = Util.ns(0, 1.5, 1, 7),
		Transparency = Util.ns(0, 0.4, 1, 1),
		Lifetime = NumberRange.new(5, 8),
		Rate = 3,
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(8, 8),
		Acceleration = Vector3.new(1, 0.4, 0),
		EmissionDirection = Enum.NormalId.Top,
		LightInfluence = 1,
	})
	chimney.Name = "Chimney"

	-- porch lantern
	local lantern = box(m, cf * CFrame.new(-3.6, 2.5 + 9.5, -D / 2 - 0.9), Vector3.new(1.2, 1.6, 1.2), rgb(255, 210, 140), M.Neon, NOCOL_NOSHADOW)
	Util.pointLight(lantern, rgb(255, 190, 120), 1.2, 18)

	-- picket fence around a front garden
	local fence = rgb(226, 216, 196)
	local gardenFront = -D / 2 - 14
	for x = -W / 2 - 4, W / 2 + 4, 3 do
		if math.abs(x) > 3 then
			local p = (cf * CFrame.new(x, 0, gardenFront)).Position
			local g = Landscape.heightAt(p.X, p.Z)
			box(m, CFrame.new(Vector3.new(p.X, g + 1.6, p.Z)) * cf.Rotation, Vector3.new(0.5, 4, 0.5), fence, M.Wood, NOSHADOW)
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		local a = (cf * CFrame.new(s * 3, 0, gardenFront)).Position
		local b = (cf * CFrame.new(s * (W / 2 + 4), 0, gardenFront)).Position
		local ga, gb = Landscape.heightAt(a.X, a.Z), Landscape.heightAt(b.X, b.Z)
		beam(m, Vector3.new(a.X, ga + 2.6, a.Z), Vector3.new(b.X, gb + 2.6, b.Z), 0.3, 0.6, fence, M.Wood, NOSHADOW)
	end
	-- vegetable rows and a woodpile
	for row = 0, 2 do
		local c = cf * CFrame.new(-W / 4, 0.3, -D / 2 - 5 - row * 3)
		box(m, c, Vector3.new(8, 1, 1.6), rgb(92, 64, 44), M.Ground, NOSHADOW)
		for k = -1, 1 do
			ball(m, (c * CFrame.new(k * 2.5, 0.9, 0)).Position, 1.4, rgb(90, 160, 60), M.LeafyGrass, NOCOL_NOSHADOW)
		end
	end
	for k = 0, 5 do
		local c = cf * CFrame.new(W / 2 + 2 + (k % 3) * 1.5 + (k // 3) * 0.75, 1 + (k // 3) * 1.3, 0) * CFrame.Angles(0, HALF_PI, 0)
		Util.cylinder(m, c, 6, 1.4, rgb(130, 96, 64), M.Wood, NOSHADOW)
	end
	return m
end

-- Spawn clearing -------------------------------------------------------------------------------------
local function buildSpawn(parent, rng)
	local m = Util.model(parent, "WildwoodArrival")
	local center = Vector3.new(L.ForestSpawn.X, Landscape.ForestSpawnHeight, L.ForestSpawn.Z)
	local toHub = Vector3.new(-center.X, 0, -center.Z).Unit

	disc(m, center + Vector3.new(0, 0.3, 0), 1.6, 34, STONE, M.Cobblestone)
	disc(m, center + Vector3.new(0, 1.2, 0), 0.4, 26, MOSS, M.Grass, NOSHADOW)

	-- glowing rune ring
	local runes = rgb(120, 255, 190)
	for k = 0, 23 do
		local a0, a1 = k / 24 * TAU, (k + 0.6) / 24 * TAU
		local p0 = center + Vector3.new(math.cos(a0) * 26, 0.6, math.sin(a0) * 26)
		local p1 = center + Vector3.new(math.cos(a1) * 26, 0.6, math.sin(a1) * 26)
		beam(m, p0, p1, 1, 0.3, runes, M.Neon, NOCOL_NOSHADOW)
	end

	-- standing stones
	for k = 0, 11 do
		local a = k / 12 * TAU + 0.13
		local p = ground(center + Vector3.new(math.cos(a) * 40, 0, math.sin(a) * 40))
		local h = rng:NextNumber(12, 20)
		local cf = flatCF(p, center - p) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06))
		box(m, cf * CFrame.new(0, h / 2 - 2, 0), Vector3.new(6, h + 2, 3.5), Util.vary(rng, STONE, 0.06), M.Slate)
		box(m, cf * CFrame.new(0, h - 0.4, 0), Vector3.new(6.4, 1, 3.9), MOSS, M.Grass, NOSHADOW)
		box(m, cf * CFrame.new(0, h / 2, -1.85), Vector3.new(0.7, h * 0.5, 0.2), runes, M.Neon, NOCOL_NOSHADOW)
	end

	-- floating crystal above the circle
	local crystal = box(m, CFrame.new(center + Vector3.new(0, 22, 0)) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), Vector3.new(4, 4, 4), rgb(140, 255, 210), M.Neon, NOCOL_NOSHADOW)
	Util.pointLight(crystal, rgb(140, 255, 210), 2, 40)
	Util.particles(crystal, {
		Texture = Util.TEX.sparkle,
		Color = Util.cs(rgb(170, 255, 220)),
		Size = Util.ns(0, 0.6, 1, 0),
		Lifetime = NumberRange.new(2, 3),
		Rate = 12,
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 1,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "IslandSpawn_Forest"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(center + Vector3.new(0, 1.6, 0))
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = M.Slate
	spawn.Color = rgb(120, 150, 130)
	spawn.Transparency = 0.4
	spawn.Enabled = Config.PLAYER_START ~= "Hub"
	spawn.Parent = m

	-- signpost towards the capital, the world tree and the lake
	local postPos = ground(center + toHub * 22 + Vector3.new(-toHub.Z, 0, toHub.X) * 10)
	column(m, postPos - Vector3.new(0, 2, 0), 14, 1.2, WOOD_DARK, M.Wood)
	local signs = {
		{ "Solkhar", toHub },
		{ "Elderheart", (L.WorldTree - center).Unit },
		{ "Mirror Lake", (L.ForestLake - center).Unit },
	}
	for i, s in ipairs(signs) do
		local dir = Vector3.new(s[2].X, 0, s[2].Z).Unit
		local p = postPos + Vector3.new(0, 12 - i * 2.2, 0) + dir * 3
		local board = box(m, CFrame.lookAt(p, p + dir) * CFrame.Angles(0, HALF_PI, 0), Vector3.new(7, 1.6, 0.4), rgb(140, 104, 70), M.WoodPlanks, NOSHADOW)
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local gui = Instance.new("SurfaceGui")
			gui.Face = face
			gui.CanvasSize = Vector2.new(350, 80)
			gui.LightInfluence = 1
			gui.Parent = board
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Text = s[1]
			label.TextColor3 = rgb(250, 240, 214)
			label.Font = Enum.Font.Garamond
			label.TextScaled = true
			label.Parent = gui
		end
	end
	for _, s in ipairs({ -1, 1 }) do
		Props.streetLamp(m, ground(center + toHub * 30 + Vector3.new(-toHub.Z, 0, toHub.X) * s * 8), 9)
	end
	return m
end

-- Elven ruins ----------------------------------------------------------------------------------------
local function ruinSite(parent, rng, pos)
	local m = Util.model(parent, "ElvenRuins")
	local stone = rgb(214, 210, 196)
	local yaw = rng:NextNumber(0, TAU)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	-- broken arch
	for _, s in ipairs({ -1, 1 }) do
		local base = ground((cf * CFrame.new(s * 12, 0, 0)).Position)
		column(m, base - Vector3.new(0, 2, 0), s < 0 and 26 or 18, 4.4, stone, M.Limestone)
		box(m, CFrame.new(base + Vector3.new(0, 0.5, 0)) * cf.Rotation, Vector3.new(7, 3, 7), stone, M.Limestone)
	end
	local top = cf * CFrame.new(0, 24, 0)
	for k = 0, 3 do
		local t0, t1 = k / 6 * math.pi, (k + 1) / 6 * math.pi
		local p0 = (top * CFrame.new(-12 * math.cos(t0), 6 * math.sin(t0), 0)).Position
		local p1 = (top * CFrame.new(-12 * math.cos(t1), 6 * math.sin(t1), 0)).Position
		beam(m, p0, p1, 4, 3.4, stone, M.Limestone)
	end
	-- vines and moss
	for _ = 1, 5 do
		local p = (cf * CFrame.new(rng:NextNumber(-14, 14), rng:NextNumber(8, 22), rng:NextNumber(-1, 1))).Position
		box(m, CFrame.new(p), Vector3.new(0.5, rng:NextNumber(6, 12), 0.5), MOSS, M.Grass, NOCOL_NOSHADOW)
	end
	for _ = 1, 4 do
		local p = ground((cf * CFrame.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(-30, 30))).Position)
		Props.brokenColumn(m, rng, p, stone, M.Limestone)
	end
	-- mossy steps
	for k = 0, 3 do
		local p = (cf * CFrame.new(0, 0, -10 - k * 3)).Position
		local g = Landscape.heightAt(p.X, p.Z)
		box(m, CFrame.new(Vector3.new(p.X, g - 1 + (3 - k) * 0.6, p.Z)) * cf.Rotation, Vector3.new(20 - k * 2, 2 + (3 - k) * 1.2, 3), k % 2 == 0 and stone or MOSS, M.Limestone)
	end
	return m
end

-- Glowing mushrooms -------------------------------------------------------------------------------
local function mushrooms(parent, rng, pos)
	local m = Util.model(parent, "GlowShrooms")
	local caps = { rgb(90, 220, 255), rgb(255, 120, 220), rgb(170, 255, 120) }
	local cap = Util.pick(rng, caps)
	local first
	for _ = 1, rng:NextInteger(3, 5) do
		local p = ground(pos + Vector3.new(rng:NextNumber(-5, 5), 0, rng:NextNumber(-5, 5)))
		local h = rng:NextNumber(1.5, 5)
		column(m, p - Vector3.new(0, 1, 0), h + 1, 0.8, rgb(232, 226, 210), M.SmoothPlastic, NOCOL_NOSHADOW)
		local c = disc(m, p + Vector3.new(0, h, 0), 0.8, rng:NextNumber(2.4, 4.6), cap, M.Neon, NOCOL_NOSHADOW)
		first = first or c
	end
	Util.pointLight(first, cap, 1.1, 16)
	return m
end

---------------------------------------------------------------------------------------------------------
function Forest.Build(folder, rng)
	Util.log("Building Eloria Wildwood...")
	buildSpawn(folder, rng)
	buildWorldTree(folder, rng)
	buildLake(folder, rng)

	local cottages = Util.model(folder, "Cottages")
	for _, c in ipairs(Layout.forestCottages()) do
		local g = ground(c)
		local facing = Vector3.new(-c.X, 0, -c.Z).Unit
		cottage(cottages, rng, g, Vector3.new(facing.X + rng:NextNumber(-0.6, 0.6), 0, facing.Z + rng:NextNumber(-0.6, 0.6)))
	end

	-- scatter the forest
	local trees = Util.folder(folder, "Trees")
	local broadleaf, blossom, slender, ancient = Props.forestTrees(), Props.blossomTrees(), Props.slenderTrees(), Props.ancientTrees()
	local bushes = Props.bushes()
	local avoid = {
		{ L.ForestSpawn, 90 },
		{ L.WorldTree, 175 },
		{ L.ForestLake, 380 },
		{ Landscape.WaterfallHill, 120 },
	}
	for _, c in ipairs(Layout.forestCottages()) do
		table.insert(avoid, { c, 60 })
	end
	local spacing = 46 / math.sqrt(math.max(Config.FOLIAGE_DENSITY, 0.05))
	local R = Landscape.MAX_COAST
	local count, ruinsBuilt, shroomCount = 0, 0, 0
	local ruinSpots = {}
	local pts = Util.scatterGrid(rng, -R, -R, R, R, spacing)
	for _, p in ipairs(pts) do
		if Layout.getZone(p.X, p.Z) == "Forest" then
			local q = Landscape.query(p.X, p.Z)
			if q.land and q.zone == "Forest" and not q.path and not q.road and not q.underwater then
				local blocked = false
				for _, a in ipairs(avoid) do
					local dx, dz = p.X - a[1].X, p.Z - a[1].Z
					if dx * dx + dz * dz < a[2] * a[2] then
						blocked = true
						break
					end
				end
				local grove = Landscape.noise2(p.X, p.Z, 1 / 700, 200)
				local chance = math.clamp(0.42 + grove * 1.5, 0.04, 0.95)
				if not blocked and rng:NextNumber() < chance and Landscape.slopeAt(p.X, p.Z) < 0.9 then
					local roll = rng:NextNumber()
					local pos = Vector3.new(p.X, q.h - 1, p.Z)
					local yaw = rng:NextNumber(0, TAU)
					if roll < 0.012 and grove > 0.05 then
						Util.place(Props.randomTemplate(rng, ancient), trees, pos - Vector3.new(0, 2, 0), yaw, rng:NextNumber(0.9, 1.2))
						if shroomCount < 120 then
							mushrooms(trees, rng, pos + Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(-30, 30)))
							shroomCount += 1
						end
					elseif roll < 0.09 then
						Util.place(Props.randomTemplate(rng, blossom), trees, pos, yaw, rng:NextNumber(0.85, 1.2))
					elseif roll < 0.22 then
						Util.place(Props.randomTemplate(rng, slender), trees, pos, yaw, rng:NextNumber(0.85, 1.2))
					else
						Util.place(Props.randomTemplate(rng, broadleaf), trees, pos, yaw, rng:NextNumber(0.8, 1.35))
					end
					count += 1
					-- undergrowth
					if rng:NextNumber() < 0.45 then
						local b = Vector3.new(p.X + rng:NextNumber(-14, 14), 0, p.Z + rng:NextNumber(-14, 14))
						Util.place(Props.randomTemplate(rng, bushes), trees, Vector3.new(b.X, Landscape.heightAt(b.X, b.Z) - 0.8, b.Z), rng:NextNumber(0, TAU), rng:NextNumber(0.8, 1.4))
					end
					if grove > 0.18 and shroomCount < 120 and rng:NextNumber() < 0.04 then
						mushrooms(trees, rng, pos + Vector3.new(8, 0, 8))
						shroomCount += 1
					end
				elseif not blocked and grove < -0.2 and #ruinSpots < 5 and rng:NextNumber() < 0.01 then
					local farEnough = true
					for _, r in ipairs(ruinSpots) do
						if (r - p).Magnitude < 900 then
							farEnough = false
						end
					end
					if farEnough then
						table.insert(ruinSpots, p)
					end
				elseif not blocked and rng:NextNumber() < 0.06 then
					-- flowers and bushes in the clearings
					Util.place(Props.randomTemplate(rng, bushes), trees, Vector3.new(p.X, q.h - 0.8, p.Z), rng:NextNumber(0, TAU), rng:NextNumber(0.7, 1.1))
				end
			end
		end
		Util.breathe()
	end
	local ruins = Util.model(folder, "Ruins")
	for _, p in ipairs(ruinSpots) do
		ruinSite(ruins, rng, ground(p))
		ruinsBuilt += 1
	end
	Util.log(string.format("  %d trees, %d ruins, %d mushroom rings", count, ruinsBuilt, shroomCount))
end

return Forest
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000C">
				<Properties>
					<string name="Name">Hollow</string>
					<ProtectedString name="Source"><![CDATA[--[[
	The Hollow Expanse
	An endless white desert under eternal night. A giant crescent moon hangs
	over the horizon, crystal-white dead trees and leaning pale spires dot the
	dunes, enormous bones lie half buried, and at the heart of it all rises the
	Pale Bastion: a colossal white dome ringed by needle-thin towers.
]]

local Layout = require(script.Parent.Parent.IslandLayout)
local Landscape = require(script.Parent.Parent.Landscape)
local TerrainWriter = require(script.Parent.Parent.TerrainWriter)
local Util = require(script.Parent.Parent.Util)
local Props = require(script.Parent.Parent.Props)
local Config = require(script.Parent.Parent.Config)

local Hollow = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, ball, column, disc, rod, beam = Util.box, Util.ball, Util.column, Util.disc, Util.rod, Util.beam
local NOSHADOW = { shadow = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local TAU = math.pi * 2
local L = Layout.Landmarks

local WHITE = rgb(236, 236, 240)
local PALE = rgb(214, 216, 224)
local SPIRIT = rgb(150, 210, 255)

local function flatCF(pos, dir)
	return CFrame.lookAt(pos, pos + Vector3.new(dir.X, 0, dir.Z))
end

local function ground(p)
	return Vector3.new(p.X, Landscape.heightAt(p.X, p.Z), p.Z)
end

-- The Pale Bastion -------------------------------------------------------------------------------
local function buildBastion(parent, rng)
	local m = Util.model(parent, "PaleBastion")
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local G = Vector3.new(L.Bastion.X, Landscape.BastionHeight, L.Bastion.Z)
	local R, sink = 450, 120
	local toCenter = Vector3.new(-G.X, 0, -G.Z).Unit

	ball(m, G - Vector3.new(0, sink, 0), R * 2, WHITE, M.Concrete)
	for _, y in ipairs({ 40, 130, 220, 290 }) do
		local yy = y + sink
		local d = 2 * math.sqrt(R * R - yy * yy) + 3
		disc(m, G + Vector3.new(0, y, 0), 5, d, PALE, M.Concrete, NOSHADOW)
	end

	-- crown spire on top of the dome
	local top = G + Vector3.new(0, R - sink, 0)
	column(m, top - Vector3.new(0, 20, 0), 140, 46, WHITE, M.Concrete)
	disc(m, top + Vector3.new(0, 120, 0), 6, 64, PALE, M.Concrete)
	column(m, top + Vector3.new(0, 123, 0), 90, 22, WHITE, M.Concrete)
	rod(m, top + Vector3.new(0, 210, 0), top + Vector3.new(0, 330, 0), 6, WHITE, M.Concrete)
	local beacon = ball(m, top + Vector3.new(0, 332, 0), 8, SPIRIT, M.Neon, NOSHADOW)
	Util.pointLight(beacon, SPIRIT, 3, 60)

	-- needle towers around the dome
	for k = 0, 6 do
		local a = k / 7 * TAU + 0.2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local base = ground(G + dir * (R + rng:NextNumber(70, 140)))
		local h = rng:NextNumber(220, 420)
		box(m, CFrame.new(base + Vector3.new(0, 8, 0)), Vector3.new(44, 24, 44), PALE, M.Concrete)
		column(m, base, h, 26, WHITE, M.Concrete)
		disc(m, base + Vector3.new(0, h * 0.55, 0), 4, 36, PALE, M.Concrete, NOSHADOW)
		disc(m, base + Vector3.new(0, h, 0), 6, 48, PALE, M.Concrete)
		column(m, base + Vector3.new(0, h + 3, 0), 30, 12, WHITE, M.Concrete)
		rod(m, base + Vector3.new(0, h + 33, 0), base + Vector3.new(0, h + 90, 0), 3, WHITE, M.Concrete)
		local tip = ball(m, base + Vector3.new(0, h + 91, 0), 4, SPIRIT, M.Neon, NOSHADOW)
		if k % 2 == 0 then
			Util.pointLight(tip, SPIRIT, 2, 40)
		end
	end

	-- the great gate, facing the island center
	local gatePos = G + toCenter * (math.sqrt(R * R - sink * sink) - 18)
	local gcf = flatCF(gatePos, toCenter)
	box(m, gcf * CFrame.new(0, 45, 0), Vector3.new(64, 92, 60), rgb(10, 10, 14), M.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		box(m, gcf * CFrame.new(s * 40, 55, -26), Vector3.new(16, 112, 18), WHITE, M.Concrete)
	end
	box(m, gcf * CFrame.new(0, 116, -26), Vector3.new(98, 16, 20), WHITE, M.Concrete)
	box(m, gcf * CFrame.new(0, 100, -31), Vector3.new(64, 3, 4), SPIRIT, M.Neon, NOCOL_NOSHADOW)

	-- processional road of white slabs and pillars leading to the gate
	for k = 0, 34 do
		local p = ground(gatePos + toCenter * (40 + k * 10))
		box(m, flatCF(p, toCenter), Vector3.new(26, 1.6, 9.4), PALE, M.Marble, NOSHADOW)
		if k % 5 == 2 then
			for _, s in ipairs({ -1, 1 }) do
				local side = Vector3.new(-toCenter.Z, 0, toCenter.X)
				local q = ground(p + side * s * 24)
				box(m, CFrame.new(q + Vector3.new(0, 20, 0)), Vector3.new(6, 44, 6), WHITE, M.Concrete)
				box(m, CFrame.new(q + Vector3.new(0, 42.5, 0)), Vector3.new(8, 2, 8), PALE, M.Concrete, NOSHADOW)
				local glow = box(m, CFrame.new(q + Vector3.new(0, 44.5, 0)) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), Vector3.new(2.6, 2.6, 2.6), SPIRIT, M.Neon, NOCOL_NOSHADOW)
				if k % 10 == 2 then
					Util.pointLight(glow, SPIRIT, 1.5, 30)
				end
			end
		end
	end

	-- outer wall ring with four breaks
	local ringR = R + 220
	for s = 0, 71 do
		if s % 18 > 1 then
			local a = (s + 0.5) / 72 * TAU
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			if dir:Dot(toCenter) < 0.97 then
				local p = ground(G + dir * ringR)
				local len = TAU * ringR / 72 + 1
				box(m, CFrame.lookAt(p + Vector3.new(0, 9, 0), p + Vector3.new(0, 9, 0) + Vector3.new(-dir.Z, 0, dir.X)), Vector3.new(10, 26, len), WHITE, M.Concrete)
			end
		end
	end
	return m, G
end

-- Crescent moon ----------------------------------------------------------------------------------------
local function buildMoon(parent)
	local m = Util.model(parent, "HollowMoon")
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local a = Layout.ZoneAngle.Hollow
	local radial = Vector3.new(math.cos(a), 0, math.sin(a))
	local tangent = Vector3.new(-radial.Z, 0, radial.X)
	local pos = radial * (Layout.ISLAND_RADIUS + 1400) + Vector3.new(0, 2300, 0)
	local D = 1000
	local moon = ball(m, pos, D, rgb(252, 250, 236), M.Neon, NOCOL_NOSHADOW)
	moon.Name = "Moon"
	moon.CanQuery = false
	local shadow = ball(m, pos + tangent * D * 0.3 - radial * D * 0.12, D * 0.96, rgb(6, 8, 16), M.SmoothPlastic, NOCOL_NOSHADOW)
	shadow.Name = "MoonShadow"
	shadow.CanQuery = false
	return m
end

-- Glowing fissure lines in the sand ---------------------------------------------------------------------
local function fissure(parent, rng, pos)
	local m = Util.model(parent, "Fissure")
	local p = pos
	local dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
	for k = 1, rng:NextInteger(3, 6) do
		dir = (dir + Vector3.new(rng:NextNumber(-0.7, 0.7), 0, rng:NextNumber(-0.7, 0.7))).Unit
		local q = p + dir * rng:NextNumber(10, 24)
		local a = ground(p) + Vector3.new(0, 0.15, 0)
		local b = ground(q) + Vector3.new(0, 0.15, 0)
		local seg = beam(m, a, b, rng:NextNumber(0.8, 1.6), 0.3, SPIRIT, M.Neon, NOCOL_NOSHADOW)
		if k == 1 then
			Util.pointLight(seg, SPIRIT, 1, 20)
		end
		p = q
	end
	return m
end

---------------------------------------------------------------------------------------------------------
function Hollow.Build(folder, rng)
	Util.log("Building The Hollow Expanse...")
	local _, bastion = buildBastion(folder, rng)
	buildMoon(folder)

	local R = Landscape.MAX_COAST
	local function spot(minR, maxR)
		for _ = 1, 40 do
			local a = Layout.ZoneAngle.Hollow + rng:NextNumber(-0.85, 0.85) * Layout.HALF_SECTOR
			local p = Layout.polar(a, rng:NextNumber(minR, maxR))
			local q = Landscape.query(p.X, p.Z)
			if q.land and q.zone == "Hollow" and (p - Vector3.new(bastion.X, 0, bastion.Z)).Magnitude > 760 then
				return Vector3.new(p.X, q.h, p.Z)
			end
		end
		return nil
	end
	local outer = Layout.ISLAND_RADIUS - Layout.BEACH_WIDTH - 200
	local inner = Layout.HUB_RADIUS + Layout.HUB_APRON * 0.7

	-- leaning pale spires and arches (terrain)
	local spires = 0
	for _ = 1, 40 do
		local p = spot(inner, outer)
		if p then
			TerrainWriter.spire(rng, p, rng:NextNumber(60, 220), rng:NextNumber(12, 26), M.Slate, rng:NextNumber(0.08, 0.35))
			spires += 1
		end
		Util.breathe()
	end
	for _ = 1, 3 do
		local p = spot(inner + 400, outer - 200)
		if p then
			local dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
			local b = ground(p + dir * rng:NextNumber(120, 200))
			TerrainWriter.arch(p - Vector3.new(0, 6, 0), b - Vector3.new(0, 6, 0), rng:NextNumber(70, 110), rng:NextNumber(12, 16), M.Slate)
		end
	end

	-- remains of colossal creatures
	local bones = Util.model(folder, "Remains")
	for i = 1, 3 do
		local p = spot(inner + 200, outer)
		if p then
			Props.giantSkeleton(bones, rng, p - Vector3.new(0, 10, 0), rng:NextNumber(0, TAU), i == 1 and 2.2 or rng:NextNumber(1.2, 1.7))
		end
	end

	-- broken white pillars
	local pillars = Util.model(folder, "Pillars")
	for _ = 1, 34 do
		local p = spot(inner, outer)
		if p then
			Props.brokenColumn(pillars, rng, p - Vector3.new(0, 1, 0), WHITE, M.Marble)
		end
	end

	-- fissures and drifting spirit motes
	local glow = Util.model(folder, "SpiritGlow")
	for _ = 1, 26 do
		local p = spot(inner, outer)
		if p then
			fissure(glow, rng, p)
		end
	end
	for _ = 1, 14 do
		local p = spot(inner, outer)
		if p then
			local e = box(glow, CFrame.new(p + Vector3.new(0, 12, 0)), Vector3.new(80, 20, 80), SPIRIT, M.SmoothPlastic, { collide = false, shadow = false, transparency = 1 })
			e.CanQuery = false
			Util.particles(e, {
				Texture = Util.TEX.sparkle,
				Color = Util.cs(rgb(190, 230, 255), rgb(255, 255, 255)),
				Size = Util.ns(0, 0, 0.3, 0.8, 1, 0),
				Lifetime = NumberRange.new(6, 10),
				Rate = 8,
				Speed = NumberRange.new(0.4, 1.2),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, 0.5, 0),
				LightEmission = 1,
				Shape = Enum.ParticleEmitterShape.Box,
			})
		end
	end

	-- crystal-white dead trees
	local trees = Util.folder(folder, "QuartzTrees")
	local quartz = Props.quartzTrees()
	local spacing = 150 / math.sqrt(math.max(Config.FOLIAGE_DENSITY, 0.05))
	local count = 0
	for _, p in ipairs(Util.scatterGrid(rng, -R, -R, R, R, spacing)) do
		if Layout.getZone(p.X, p.Z) == "Hollow" and rng:NextNumber() < 0.4 then
			local q = Landscape.query(p.X, p.Z)
			if q.land and q.zone == "Hollow" and (p - Vector3.new(bastion.X, 0, bastion.Z)).Magnitude > 720 then
				Util.place(Props.randomTemplate(rng, quartz), trees, Vector3.new(p.X, q.h - 1, p.Z), rng:NextNumber(0, TAU), rng:NextNumber(0.8, 1.6))
				count += 1
			end
		end
		Util.breathe()
	end
	Util.log(string.format("  %d spires, %d quartz trees", spires, count))
end

return Hollow
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000D">
				<Properties>
					<string name="Name">Hub</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Solkhar, Citadel of the Sun Throne (central capital)
	A walled desert city on a sandstone mesa: a tiered royal palace with a great
	dome, a sun-clock spire, rings of flat-roofed houses, fountain plazas with
	markets, and five grand gates whose causeways lead down to every region.
]]

local Layout = require(script.Parent.Parent.IslandLayout)
local Landscape = require(script.Parent.Parent.Landscape)
local Util = require(script.Parent.Parent.Util)
local Props = require(script.Parent.Parent.Props)
local Config = require(script.Parent.Parent.Config)

local Hub = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, ball, column, disc, wedge, cylinder = Util.box, Util.ball, Util.column, Util.disc, Util.wedge, Util.cylinder
local NOCOL = { collide = false }
local NOSHADOW = { shadow = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local TAU = math.pi * 2
local HALF_PI = math.pi / 2

local TOP = Layout.HUB_HEIGHT
local HUB_R = Layout.HUB_RADIUS
local WALL_R = HUB_R - 80
local TIER1_R, TIER1_TOP = 228, TOP + 12
local TIER2_R, TIER2_TOP = 132, TOP + 30

local STONE = rgb(232, 218, 190)
local STONE_DARK = rgb(196, 160, 112)
local MARBLE = rgb(244, 240, 230)
local GOLD = rgb(214, 172, 74)
local TEAL = rgb(30, 116, 124)
local DOOR = rgb(52, 36, 28)
local WINDOW = rgb(34, 28, 30)

local HOUSE_COLORS = {
	rgb(236, 224, 200),
	rgb(226, 204, 166),
	rgb(242, 234, 216),
	rgb(216, 188, 150),
	rgb(234, 214, 180),
	rgb(222, 196, 172),
}
local CLOTH = {
	rgb(30, 116, 124),
	rgb(166, 46, 44),
	rgb(222, 152, 44),
	rgb(62, 62, 132),
	rgb(240, 236, 226),
	rgb(120, 40, 92),
}
local GATE_COLORS = {
	Forest = rgb(78, 164, 88),
	Snow = rgb(150, 200, 238),
	Hollow = rgb(220, 222, 236),
	Ruins = rgb(150, 46, 44),
	Dunes = rgb(232, 172, 64),
}

local function flatCF(pos, dir)
	return CFrame.lookAt(pos, pos + Vector3.new(dir.X, 0, dir.Z))
end

-- Facing angles of the five avenues
local AVENUES = {}
for _, id in ipairs(Layout.ZONE_ORDER) do
	table.insert(AVENUES, { id = id, angle = Layout.ZoneAngle[id], dir = Layout.zoneDirection(id) })
end

local function nearAvenue(p, width)
	local d = p.Magnitude
	local theta = math.atan2(p.Z, p.X)
	for _, av in ipairs(AVENUES) do
		local dth = Layout.wrapAngle(theta - av.angle)
		if math.abs(dth) < HALF_PI and math.abs(d * math.sin(dth)) < width then
			return true
		end
	end
	return false
end

-- Small helpers -------------------------------------------------------------------------

-- Arched window/door: dark rectangle with a round top, on a wall facing -Z of cf.
local function arch(parent, cf, w, h, color)
	box(parent, cf * CFrame.new(0, h / 2, 0), Vector3.new(w, h, 0.6), color, M.SmoothPlastic, NOSHADOW)
	cylinder(parent, cf * CFrame.new(0, h, 0) * CFrame.Angles(0, HALF_PI, 0), 0.6, w, color, M.SmoothPlastic, NOSHADOW)
end

local function obelisk(parent, base, height)
	local m = Util.model(parent, "Obelisk")
	box(m, CFrame.new(base + Vector3.new(0, 2, 0)), Vector3.new(8, 4, 8), STONE_DARK, M.Sandstone)
	box(m, CFrame.new(base + Vector3.new(0, 4 + height / 2, 0)), Vector3.new(4.4, height, 4.4), STONE, M.Limestone)
	Util.hipRoof(m, CFrame.new(base + Vector3.new(0, 4 + height, 0)), 4.4, 4.4, 4, 0.8, GOLD, M.Foil)
	return m
end

-- Palace ------------------------------------------------------------------------------------
local function buildPalace(parent)
	local m = Util.model(parent, "SunThronePalace")
	local front = Layout.zoneDirection("Forest")
	local P = flatCF(Vector3.new(0, TIER2_TOP, 0), front) -- local -Z faces the Forest avenue

	local function at(x, y, z)
		return P * CFrame.new(x, y, z)
	end

	-- plinth, hall, cornice
	box(m, at(0, 1.5, 6), Vector3.new(118, 3, 88), STONE_DARK, M.Sandstone)
	box(m, at(0, 25, 6), Vector3.new(110, 44, 80), STONE, M.Limestone)
	box(m, at(0, 47.5, 6), Vector3.new(114, 3, 84), STONE_DARK, M.Sandstone)
	box(m, at(0, 20, 6), Vector3.new(111, 1.6, 81), GOLD, M.Foil, NOSHADOW)

	-- roof merlons
	for x = -52, 52, 8 do
		for _, z in ipairs({ -35, 47 }) do
			box(m, at(x, 51, z), Vector3.new(4, 4, 2), STONE, M.Limestone, NOSHADOW)
		end
	end
	for z = -27, 39, 8 do
		for _, x in ipairs({ -56, 56 }) do
			box(m, at(x, 51, z), Vector3.new(2, 4, 4), STONE, M.Limestone, NOSHADOW)
		end
	end

	-- drum and great dome
	local domeCenter = (P * CFrame.new(0, 49, 6)).Position
	column(m, domeCenter, 16, 66, STONE, M.Limestone)
	disc(m, domeCenter + Vector3.new(0, 16, 0), 2, 70, GOLD, M.Foil)
	for k = 0, 11 do
		local a = k / 12 * TAU
		local p = domeCenter + Vector3.new(math.cos(a) * 33, 4, math.sin(a) * 33)
		arch(m, flatCF(p, Vector3.new(math.cos(a), 0, math.sin(a))), 4, 7, WINDOW)
	end
	ball(m, domeCenter + Vector3.new(0, 16, 0), 68, MARBLE, M.Marble)
	disc(m, domeCenter + Vector3.new(0, 26, 0), 2, 59.6, TEAL, M.SmoothPlastic, NOSHADOW)
	local tip = domeCenter + Vector3.new(0, 50, 0)
	column(m, tip - Vector3.new(0, 2, 0), 8, 4, GOLD, M.Foil)
	ball(m, tip + Vector3.new(0, 8, 0), 6, GOLD, M.Foil)
	Util.rod(m, tip + Vector3.new(0, 10, 0), tip + Vector3.new(0, 24, 0), 1.2, GOLD, M.Foil)
	local crown = ball(m, tip + Vector3.new(0, 25, 0), 3, rgb(255, 222, 140), M.Neon, NOSHADOW)
	Util.pointLight(crown, rgb(255, 210, 130), 2, 40)

	-- corner towers
	for _, c in ipairs({ { -55, -34 }, { 55, -34 }, { -55, 46 }, { 55, 46 } }) do
		local base = (P * CFrame.new(c[1], 0, c[2])).Position
		column(m, base, 80, 22, STONE, M.Limestone)
		disc(m, base + Vector3.new(0, 46, 0), 2, 28, STONE_DARK, M.Sandstone)
		disc(m, base + Vector3.new(0, 68, 0), 2, 28, STONE_DARK, M.Sandstone)
		disc(m, base + Vector3.new(0, 80, 0), 2, 26, GOLD, M.Foil)
		for k = 0, 3 do
			local a = k / 4 * TAU + math.pi / 4
			local p = base + Vector3.new(math.cos(a) * 11.1, 54, math.sin(a) * 11.1)
			arch(m, flatCF(p, Vector3.new(math.cos(a), 0, math.sin(a))), 3, 7, WINDOW)
		end
		ball(m, base + Vector3.new(0, 80, 0), 22, MARBLE, M.Marble)
		Util.rod(m, base + Vector3.new(0, 90, 0), base + Vector3.new(0, 102, 0), 1, GOLD, M.Foil)
		ball(m, base + Vector3.new(0, 102, 0), 2.4, GOLD, M.Foil)
	end

	-- side wings with small domes
	for _, sx in ipairs({ -1, 1 }) do
		box(m, at(sx * 75, 15, 10), Vector3.new(40, 30, 60), STONE, M.Limestone)
		box(m, at(sx * 75, 31, 10), Vector3.new(42, 2, 62), STONE_DARK, M.Sandstone)
		ball(m, (at(sx * 75, 32, 10)).Position, 24, MARBLE, M.Marble)
		ball(m, (at(sx * 75, 45, 10)).Position, 2.4, GOLD, M.Foil)
		for z = -10, 30, 13 do
			arch(m, at(sx * 95.4, 8, z) * CFrame.Angles(0, -sx * HALF_PI, 0), 4, 10, WINDOW)
		end
	end

	-- facade windows (two rows) on front and back
	for _, row in ipairs({ 8, 28 }) do
		for x = -45, 45, 13 do
			if math.abs(x) > 12 then
				arch(m, at(x, row, -34.3), 5, 9, WINDOW)
				arch(m, at(x, row, 46.3) * CFrame.Angles(0, math.pi, 0), 5, 9, WINDOW)
			end
		end
	end

	-- grand door with a sun emblem
	arch(m, at(0, 0, -34.4), 18, 26, DOOR)
	local sun = (at(0, 36, -34.8)).Position
	cylinder(m, CFrame.lookAt(sun, sun + front) * CFrame.Angles(0, HALF_PI, 0), 0.8, 12, GOLD, M.Foil, NOSHADOW)
	for k = 0, 11 do
		local a = k / 12 * TAU
		local off = (P * CFrame.Angles(0, 0, a)).RightVector
		Util.beam(m, sun + off * 6.5, sun + off * 10.5, 1.2, 0.5, GOLD, M.Foil, NOCOL_NOSHADOW)
	end

	-- front colonnade
	for x = -42, 42, 12 do
		local base = (at(x, 0, -46)).Position
		box(m, CFrame.new(base + Vector3.new(0, 1, 0)), Vector3.new(6, 2, 6), STONE_DARK, M.Sandstone)
		column(m, base + Vector3.new(0, 2, 0), 32, 4.6, MARBLE, M.Marble)
		box(m, CFrame.new(base + Vector3.new(0, 35, 0)), Vector3.new(6.4, 2, 6.4), GOLD, M.Foil)
	end
	box(m, at(0, 39, -41), Vector3.new(96, 4, 14), STONE, M.Limestone)
	box(m, at(0, 41.6, -41), Vector3.new(98, 1.2, 15), STONE_DARK, M.Sandstone)
	box(m, at(0, 0.5, -42), Vector3.new(98, 1, 18), STONE_DARK, M.Sandstone)

	-- banners between the columns
	for _, x in ipairs({ -30, -18, 18, 30 }) do
		box(m, at(x, 26, -47.2), Vector3.new(5, 18, 0.3), TEAL, M.Fabric, NOCOL_NOSHADOW)
		box(m, at(x, 17.4, -47.3), Vector3.new(5, 1.2, 0.3), GOLD, M.Foil, NOCOL_NOSHADOW)
	end

	-- braziers flanking the door
	for _, x in ipairs({ -14, 14 }) do
		Props.torch(m, (at(x, 0, -52)).Position, 8)
	end
	return m
end

-- Sun-clock spire ------------------------------------------------------------------------------
local function buildClockSpire(parent)
	local m = Util.model(parent, "SunClockSpire")
	local a = Layout.ZoneAngle.Forest + TAU / 10
	local base = Vector3.new(math.cos(a) * 186, TIER1_TOP, math.sin(a) * 186)
	local face = Vector3.new(-math.cos(a), 0, -math.sin(a))
	local cf = flatCF(base, -face)

	box(m, cf * CFrame.new(0, 3, 0), Vector3.new(32, 6, 32), STONE_DARK, M.Sandstone)
	box(m, cf * CFrame.new(0, 66, 0), Vector3.new(24, 120, 24), STONE, M.Limestone)
	for _, c in ipairs({ { -12, -12 }, { 12, -12 }, { -12, 12 }, { 12, 12 } }) do
		box(m, cf * CFrame.new(c[1], 66, c[2]), Vector3.new(3.4, 120, 3.4), STONE_DARK, M.Sandstone)
	end
	for y = 30, 120, 24 do
		box(m, cf * CFrame.new(0, y, 0), Vector3.new(26, 1.6, 26), STONE_DARK, M.Sandstone, NOSHADOW)
	end
	for y = 20, 110, 24 do
		for s = 0, 3 do
			arch(m, cf * CFrame.Angles(0, s * HALF_PI, 0) * CFrame.new(0, y, -12.3), 3, 8, WINDOW)
		end
	end

	-- clock chamber
	box(m, cf * CFrame.new(0, 141, 0), Vector3.new(30, 30, 30), STONE, M.Limestone)
	box(m, cf * CFrame.new(0, 156.5, 0), Vector3.new(33, 2, 33), GOLD, M.Foil)
	for s = 0, 3 do
		local f = cf * CFrame.Angles(0, s * HALF_PI, 0) * CFrame.new(0, 141, -15)
		cylinder(m, f * CFrame.new(0, 0, -0.4) * CFrame.Angles(0, HALF_PI, 0), 0.8, 25, GOLD, M.Foil, NOSHADOW)
		local dial = cylinder(m, f * CFrame.new(0, 0, -0.9) * CFrame.Angles(0, HALF_PI, 0), 0.6, 22, rgb(250, 244, 226), M.SmoothPlastic, NOSHADOW)
		Util.surfaceLight(dial, Enum.NormalId.Right, rgb(255, 230, 180), 0.8, 14, 80)
		for h = 0, 11 do
			local ang = h / 12 * TAU
			local len = h % 3 == 0 and 2.6 or 1.2
			box(m, f * CFrame.new(math.sin(ang) * 9, math.cos(ang) * 9, -1.3) * CFrame.Angles(0, 0, -ang), Vector3.new(0.6, len, 0.3), rgb(40, 30, 24), M.SmoothPlastic, NOCOL_NOSHADOW)
		end
		-- hands at ten past ten
		local hour, minute = -math.pi / 3, math.pi / 3
		box(m, f * CFrame.new(0, 0, -1.5) * CFrame.Angles(0, 0, -hour) * CFrame.new(0, 2.6, 0), Vector3.new(1, 5.2, 0.3), rgb(40, 30, 24), M.Metal, NOCOL_NOSHADOW)
		box(m, f * CFrame.new(0, 0, -1.6) * CFrame.Angles(0, 0, -minute) * CFrame.new(0, 3.6, 0), Vector3.new(0.6, 7.2, 0.3), rgb(40, 30, 24), M.Metal, NOCOL_NOSHADOW)
	end

	-- open belfry, bell and dome
	for _, c in ipairs({ { -12, -12 }, { 12, -12 }, { -12, 12 }, { 12, 12 } }) do
		box(m, cf * CFrame.new(c[1], 167, c[2]), Vector3.new(4, 20, 4), STONE, M.Limestone)
	end
	box(m, cf * CFrame.new(0, 178, 0), Vector3.new(30, 2, 30), STONE_DARK, M.Sandstone)
	local bellPos = (cf * CFrame.new(0, 166, 0)).Position
	ball(m, bellPos, 9, GOLD, M.Foil)
	column(m, bellPos - Vector3.new(0, 4, 0), 4, 9.6, GOLD, M.Foil)
	local glow = ball(m, bellPos - Vector3.new(0, 6, 0), 1, rgb(255, 210, 140), M.Neon, NOCOL_NOSHADOW)
	Util.pointLight(glow, rgb(255, 200, 120), 1.5, 34)
	ball(m, (cf * CFrame.new(0, 179, 0)).Position, 26, MARBLE, M.Marble)
	Util.rod(m, (cf * CFrame.new(0, 190, 0)).Position, (cf * CFrame.new(0, 208, 0)).Position, 1.4, GOLD, M.Foil)
	for k = 0, 7 do
		local ang = k / 8 * TAU
		local o = (cf * CFrame.new(0, 200, 0)).Position
		Util.rod(m, o, o + Vector3.new(math.cos(ang) * 5, 1.5, math.sin(ang) * 5), 0.5, GOLD, M.Foil, NOCOL_NOSHADOW)
	end
	ball(m, (cf * CFrame.new(0, 209, 0)).Position, 3, GOLD, M.Foil)
	return m, base
end

-- Platforms and stairs ---------------------------------------------------------------------------
local function buildTiers(parent)
	local m = Util.model(parent, "RoyalTerraces")
	local function tier(radius, bottom, top)
		disc(m, Vector3.new(0, (bottom + top) / 2, 0), top - bottom, radius * 2, STONE, M.Limestone)
		disc(m, Vector3.new(0, top - 0.4, 0), 1.2, radius * 2 + 3, STONE_DARK, M.Sandstone, NOSHADOW)
		disc(m, Vector3.new(0, bottom + 2, 0), 1, radius * 2 + 1, GOLD, M.Foil, NOSHADOW)
	end
	tier(TIER1_R, TOP - 4, TIER1_TOP)
	tier(TIER2_R, TIER1_TOP - 1, TIER2_TOP)

	local function stairs(dir, rFrom, bottomY, topY)
		local steps = math.ceil((topY - bottomY) / 1.5)
		local rise = (topY - bottomY) / steps
		for k = 1, steps do
			local r = rFrom + (k - 0.5) * 2.6
			local stepTop = topY - (k - 1) * rise
			local center = dir * r
			box(m, flatCF(Vector3.new(center.X, (stepTop + bottomY - 2) / 2, center.Z), dir), Vector3.new(34, stepTop - bottomY + 2, 2.7), STONE, M.Limestone)
		end
		local foot = dir * (rFrom + steps * 2.6 + 4)
		local side = Vector3.new(-dir.Z, 0, dir.X)
		for _, s in ipairs({ -1, 1 }) do
			obelisk(m, Vector3.new(foot.X, bottomY, foot.Z) + side * s * 22, 20)
		end
	end
	for _, av in ipairs(AVENUES) do
		stairs(av.dir, TIER1_R - 1, TOP, TIER1_TOP)
		stairs(av.dir, TIER2_R - 1, TIER1_TOP, TIER2_TOP)
	end
	return m
end

-- Houses --------------------------------------------------------------------------------------------
local function house(parent, rng, cf, w, d)
	local m = Util.model(parent, "House")
	local color = Util.pick(rng, HOUSE_COLORS)
	local trim = Util.vary(rng, STONE_DARK, 0.06)
	local roll = rng:NextNumber()
	local levels = roll < 0.3 and 1 or (roll < 0.8 and 2 or 3)
	local h = levels * 12

	box(m, cf * CFrame.new(0, h / 2 - 1, 0), Vector3.new(w, h + 2, d), color, M.Plaster)
	box(m, cf * CFrame.new(0, h + 0.6, 0), Vector3.new(w + 1.2, 1.2, d + 1.2), trim, M.Sandstone, NOSHADOW)
	box(m, cf * CFrame.new(0, 0.3, 0), Vector3.new(w + 0.8, 1.6, d + 0.8), trim, M.Sandstone, NOSHADOW)

	-- door, windows
	arch(m, cf * CFrame.new(rng:NextNumber(-w / 4, w / 4), 0, -d / 2 - 0.2), 4.5, 7, DOOR)
	for lv = 1, levels do
		local y = (lv - 1) * 12 + (lv == 1 and 5 or 3.5)
		if lv > 1 or w > 24 then
			local xs = w > 24 and { -w / 4, w / 4 } or { 0 }
			for _, x in ipairs(xs) do
				if lv > 1 or math.abs(x) > 4 then
					arch(m, cf * CFrame.new(x, y, -d / 2 - 0.2), 3, 4.5, WINDOW)
				end
			end
		end
		if rng:NextNumber() < 0.6 then
			arch(m, cf * CFrame.new(w / 2 + 0.2, y, 0) * CFrame.Angles(0, -HALF_PI, 0), 3, 4.5, WINDOW)
		end
	end

	-- awning over the door
	if rng:NextNumber() < 0.55 then
		local cloth = Util.pick(rng, CLOTH)
		wedge(m, cf * CFrame.new(0, 9.2, -d / 2 - 2.2), Vector3.new(w * 0.6, 1.6, 4.4), cloth, M.Fabric, NOCOL_NOSHADOW)
	end

	-- rooftop: dome, upper room or clutter
	local r = rng:NextNumber()
	if r < 0.28 then
		local dd = math.min(w, d) * 0.62
		disc(m, (cf * CFrame.new(0, h + 1.2, 0)).Position, 2, dd + 2, trim, M.Sandstone, NOSHADOW)
		ball(m, (cf * CFrame.new(0, h + 2, 0)).Position, dd, rng:NextNumber() < 0.3 and TEAL or MARBLE, M.Marble)
		ball(m, (cf * CFrame.new(0, h + 2 + dd / 2, 0)).Position, 1.6, GOLD, M.Foil, NOCOL)
	elseif r < 0.5 then
		box(m, cf * CFrame.new(w * 0.2, h + 4.5, d * 0.2), Vector3.new(w * 0.45, 8, d * 0.45), color, M.Plaster)
		box(m, cf * CFrame.new(w * 0.2, h + 9, d * 0.2), Vector3.new(w * 0.45 + 1, 1, d * 0.45 + 1), trim, M.Sandstone, NOSHADOW)
	else
		for _ = 1, rng:NextInteger(1, 3) do
			local p = cf * CFrame.new(rng:NextNumber(-w / 3, w / 3), h + 1.8, rng:NextNumber(-d / 3, d / 3))
			if rng:NextNumber() < 0.5 then
				ball(m, p.Position, rng:NextNumber(1.8, 2.8), rgb(176, 96, 60), M.Slate, NOCOL)
			else
				box(m, p * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Vector3.new(2.4, 2.4, 2.4), rgb(140, 104, 66), M.WoodPlanks, NOCOL)
			end
		end
		if rng:NextNumber() < 0.4 then
			local cloth = Util.pick(rng, CLOTH)
			box(m, cf * CFrame.new(0, h + 6, 0) * CFrame.Angles(0.08, 0, 0), Vector3.new(w * 0.7, 0.3, d * 0.6), cloth, M.Fabric, NOCOL)
			for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
				column(m, (cf * CFrame.new(c[1] * w * 0.33, h + 1, c[2] * d * 0.28)).Position, 5, 0.5, rgb(90, 70, 50), M.Wood, NOCOL_NOSHADOW)
			end
		end
	end
	return m
end

-- Plaza with fountain and market stalls ------------------------------------------------------------
local function fountain(parent, pos)
	local m = Util.model(parent, "Fountain")
	disc(m, pos + Vector3.new(0, 1.5, 0), 3.4, 30, STONE, M.Limestone)
	disc(m, pos + Vector3.new(0, 3.3, 0), 0.6, 31, STONE_DARK, M.Sandstone, NOSHADOW)
	disc(m, pos + Vector3.new(0, 3.1, 0), 0.6, 27, rgb(70, 170, 200), M.Glass, { transparency = 0.25, reflectance = 0.3, shadow = false })
	column(m, pos, 9, 4, STONE, M.Limestone)
	disc(m, pos + Vector3.new(0, 9, 0), 1.4, 12, STONE_DARK, M.Sandstone)
	disc(m, pos + Vector3.new(0, 9.6, 0), 0.4, 10.4, rgb(70, 170, 200), M.Glass, { transparency = 0.25, reflectance = 0.3, shadow = false })
	local spout = ball(m, pos + Vector3.new(0, 12, 0), 2.4, GOLD, M.Foil)
	Util.particles(spout, {
		Texture = Util.TEX.sparkle,
		Color = Util.cs(rgb(200, 236, 255), rgb(120, 200, 240)),
		Size = Util.ns(0, 0.5, 1, 0.2),
		Transparency = Util.ns(0, 0.1, 1, 0.8),
		Lifetime = NumberRange.new(1.2, 1.6),
		Rate = 70,
		Speed = NumberRange.new(10, 13),
		SpreadAngle = Vector2.new(14, 14),
		Acceleration = Vector3.new(0, -26, 0),
		EmissionDirection = Enum.NormalId.Top,
	})
	return m
end

local function stall(parent, rng, cf)
	local m = Util.model(parent, "MarketStall")
	local cloth = Util.pick(rng, CLOTH)
	local wood = rgb(110, 80, 54)
	for _, c in ipairs({ { -5, -4 }, { 5, -4 }, { -5, 4 }, { 5, 4 } }) do
		column(m, (cf * CFrame.new(c[1], 0, c[2])).Position, c[2] < 0 and 9 or 10.5, 0.7, wood, M.Wood, NOSHADOW)
	end
	box(m, cf * CFrame.new(0, 10, 0) * CFrame.Angles(-0.18, 0, 0), Vector3.new(12, 0.3, 10), cloth, M.Fabric, NOCOL)
	box(m, cf * CFrame.new(0, 9.3, -5.1), Vector3.new(12, 1.4, 0.3), Util.pick(rng, CLOTH), M.Fabric, NOCOL_NOSHADOW)
	box(m, cf * CFrame.new(0, 1.8, -2.5), Vector3.new(10, 3.6, 3), wood, M.WoodPlanks)
	local goods = { rgb(232, 120, 40), rgb(200, 40, 50), rgb(240, 200, 60), rgb(120, 170, 60), rgb(150, 90, 180) }
	for g = -1, 1 do
		local p = cf * CFrame.new(g * 3, 4.1, -2.5)
		if rng:NextNumber() < 0.5 then
			box(m, p * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0), Vector3.new(2.4, 1, 2), Util.pick(rng, goods), M.Fabric, NOCOL_NOSHADOW)
		else
			ball(m, p.Position + Vector3.new(0, 0.4, 0), 1.8, Util.pick(rng, goods), M.SmoothPlastic, NOCOL_NOSHADOW)
		end
	end
	return m
end

-- Walls and gates --------------------------------------------------------------------------------------
local function buildWalls(parent)
	local m = Util.model(parent, "CityWalls")
	local segments = 84
	local gateHalf = (Layout.ROAD_WIDTH / 2 + 16) / WALL_R
	local wallH = 34

	local function inGate(a, extra)
		for _, av in ipairs(AVENUES) do
			if math.abs(Layout.wrapAngle(a - av.angle)) < gateHalf + (extra or 0) then
				return av
			end
		end
		return nil
	end

	for s = 0, segments - 1 do
		local a = (s + 0.5) / segments * TAU
		if not inGate(a, 0.02) then
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local tangent = Vector3.new(-dir.Z, 0, dir.X)
			local pos = dir * WALL_R + Vector3.new(0, TOP - 4 + wallH / 2, 0)
			local len = TAU * WALL_R / segments + 1.2
			local cf = CFrame.lookAt(pos, pos + tangent)
			box(m, cf, Vector3.new(12, wallH + 4, len), STONE, M.Sandstone)
			box(m, cf * CFrame.new(0, wallH / 2 + 2.4, 0), Vector3.new(13, 1, len), STONE_DARK, M.Sandstone, NOSHADOW)
			for k = -1, 1, 2 do
				box(m, cf * CFrame.new(5.5, wallH / 2 + 5, k * len / 4), Vector3.new(2.4, 5, len / 4), STONE, M.Sandstone, NOSHADOW)
			end
			if s % 7 == 3 and not inGate(a, 0.08) then
				local base = dir * (WALL_R + 3) + Vector3.new(0, TOP - 4, 0)
				column(m, base, wallH + 18, 26, STONE, M.Sandstone)
				disc(m, base + Vector3.new(0, wallH + 18, 0), 2, 30, STONE_DARK, M.Sandstone)
				ball(m, base + Vector3.new(0, wallH + 19, 0), 22, MARBLE, M.Marble)
				Util.rod(m, base + Vector3.new(0, wallH + 28, 0), base + Vector3.new(0, wallH + 38, 0), 0.8, GOLD, M.Foil)
				local flag = box(m, CFrame.new(base + Vector3.new(2.5, wallH + 36, 0)), Vector3.new(5, 3, 0.3), TEAL, M.Fabric, NOCOL_NOSHADOW)
				flag.Name = "Pennant"
			end
		end
	end

	-- the five gates
	for _, av in ipairs(AVENUES) do
		local gm = Util.model(m, "Gate_" .. av.id)
		local color = GATE_COLORS[av.id]
		local dir = av.dir
		local side = Vector3.new(-dir.Z, 0, dir.X)
		local center = dir * WALL_R + Vector3.new(0, TOP - 4, 0)
		local gap = Layout.ROAD_WIDTH + 8
		for _, s in ipairs({ -1, 1 }) do
			local base = center + side * s * (gap / 2 + 14)
			column(gm, base, 64, 30, STONE, M.Sandstone)
			disc(gm, base + Vector3.new(0, 64, 0), 2.4, 34, GOLD, M.Foil)
			ball(gm, base + Vector3.new(0, 65, 0), 28, MARBLE, M.Marble)
			Util.rod(gm, base + Vector3.new(0, 78, 0), base + Vector3.new(0, 92, 0), 1, GOLD, M.Foil)
			ball(gm, base + Vector3.new(0, 92, 0), 2.6, GOLD, M.Foil)
			local brazier = disc(gm, base + dir * 17 + Vector3.new(0, 12, 0), 1.2, 4, GOLD, M.Metal)
			Util.fire(brazier, 4, 8)
			Util.pointLight(brazier, rgb(255, 160, 80), 2, 36)
		end
		-- stone arch over the road made of voussoirs
		local archBase = center + Vector3.new(0, 30, 0)
		local span = gap + 4
		for k = 0, 8 do
			local t0, t1 = k / 9 * math.pi, (k + 1) / 9 * math.pi
			local p0 = archBase + side * (math.cos(t0) * span / 2) + Vector3.new(0, math.sin(t0) * 12, 0)
			local p1 = archBase + side * (math.cos(t1) * span / 2) + Vector3.new(0, math.sin(t1) * 12, 0)
			local mid = (p0 + p1) / 2
			box(gm, CFrame.lookAt(mid, p1, dir), Vector3.new(4, 14, (p1 - p0).Magnitude + 0.6), STONE, M.Sandstone)
		end
		local lintelCF = CFrame.lookAt(archBase + Vector3.new(0, 18, 0), archBase + Vector3.new(0, 18, 0) + side)
		box(gm, lintelCF, Vector3.new(14, 8, span + 18), STONE, M.Sandstone)
		box(gm, lintelCF * CFrame.new(0, 4.6, 0), Vector3.new(15, 1.2, span + 20), GOLD, M.Foil, NOSHADOW)

		-- plaque with the destination name, facing out of the city
		local plaque = box(gm, CFrame.lookAt(archBase + dir * 7.2 + Vector3.new(0, 18, 0), archBase + dir * 20 + Vector3.new(0, 18, 0)), Vector3.new(36, 6, 0.6), rgb(48, 40, 34), M.Slate, NOSHADOW)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.CanvasSize = Vector2.new(720, 120)
		gui.LightInfluence = 0.2
		gui.Parent = plaque
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = string.upper(Layout.ZoneInfo[av.id].name)
		label.TextColor3 = rgb(240, 206, 120)
		label.Font = Enum.Font.Garamond
		label.TextScaled = true
		label.Parent = gui
		-- the same name on the inside, facing the palace
		local inner = plaque:Clone()
		inner.CFrame = CFrame.lookAt(archBase - dir * 7.2 + Vector3.new(0, 18, 0), archBase - dir * 20 + Vector3.new(0, 18, 0))
		inner.Parent = gm

		-- hanging banners in the region's colour
		for _, s in ipairs({ -1, 1 }) do
			local p = center + side * s * (gap / 2 + 14) + dir * 15.4 + Vector3.new(0, 40, 0)
			box(gm, CFrame.lookAt(p, p + dir), Vector3.new(8, 26, 0.3), color, M.Fabric, NOCOL_NOSHADOW)
			box(gm, CFrame.lookAt(p, p + dir) * CFrame.new(0, -13.6, 0), Vector3.new(8, 1.2, 0.4), GOLD, M.Foil, NOCOL_NOSHADOW)
		end
	end
	return m
end

-- Causeways down from the gates ----------------------------------------------------------------------
local function buildCauseways(parent)
	local m = Util.model(parent, "Causeways")
	for _, av in ipairs(AVENUES) do
		local dir = av.dir
		local side = Vector3.new(-dir.Z, 0, dir.X)
		local half = Layout.ROAD_WIDTH / 2 + 1.2
		local from, to = HUB_R - 40, HUB_R + Layout.RAMP_LENGTH - 10
		local step = 28
		local r = from
		local index = 0
		while r < to do
			local r2 = math.min(r + step, to)
			for _, s in ipairs({ -1, 1 }) do
				local pa = dir * r + side * s * half
				local pb = dir * r2 + side * s * half
				local a = Vector3.new(pa.X, Landscape.heightAt(pa.X, pa.Z) + 1.6, pa.Z)
				local b = Vector3.new(pb.X, Landscape.heightAt(pb.X, pb.Z) + 1.6, pb.Z)
				Util.beam(m, a, b, 2.4, 5, STONE, M.Sandstone)
				if index % 4 == 0 then
					Props.streetLamp(m, a + Vector3.new(0, 1.6, 0) - side * s * 0.2, 12)
				end
			end
			r = r2
			index += 1
			Util.breathe()
		end
		-- guardian obelisks at the foot of each causeway
		local foot = dir * (to + 14)
		for _, s in ipairs({ -1, 1 }) do
			local p = foot + side * s * (half + 8)
			obelisk(m, Vector3.new(p.X, Landscape.heightAt(p.X, p.Z) - 1, p.Z), 26)
		end
	end
	return m
end

-- Spawn plaza -----------------------------------------------------------------------------------------
local function buildSpawn(parent)
	local m = Util.model(parent, "HubSpawnPlaza")
	local dir = Layout.zoneDirection("Forest")
	local p = dir * 196 + Vector3.new(0, TIER1_TOP, 0)
	disc(m, p + Vector3.new(0, 0.2, 0), 0.4, 38, STONE_DARK, M.Sandstone, NOSHADOW)
	disc(m, p + Vector3.new(0, 0.4, 0), 0.4, 32, GOLD, M.Foil, NOSHADOW)
	disc(m, p + Vector3.new(0, 0.6, 0), 0.4, 20, MARBLE, M.Marble, NOSHADOW)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "IslandSpawn_Hub"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(p + Vector3.new(0, 0.9, 0))
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = M.Marble
	spawn.Color = MARBLE
	spawn.Transparency = 0.3
	spawn.Enabled = Config.PLAYER_START == "Hub"
	spawn.Parent = m
	return m
end

---------------------------------------------------------------------------------------------------------
function Hub.Build(folder, rng)
	Util.log("Building Solkhar (capital)...")
	buildTiers(folder)
	buildPalace(folder)
	local _, clockBase = buildClockSpire(folder)
	buildWalls(folder)
	Util.breathe()
	buildCauseways(folder)
	buildSpawn(folder)

	-- fountain plazas on each avenue
	local plazas = {}
	local market = Util.model(folder, "Markets")
	for _, av in ipairs(AVENUES) do
		local center = av.dir * 412
		table.insert(plazas, center)
		fountain(market, center + Vector3.new(0, TOP, 0))
		local side = Vector3.new(-av.dir.Z, 0, av.dir.X)
		for k, off in ipairs({ { 30, -24 }, { 30, 24 }, { -30, -24 }, { -30, 24 } }) do
			local pos = center + side * off[1] + av.dir * off[2] + Vector3.new(0, TOP, 0)
			local face = (center + Vector3.new(0, TOP, 0) - pos)
			if k <= 4 then
				stall(market, rng, flatCF(pos, face))
			end
		end
		for k = 0, 5 do
			local a = k / 6 * TAU + 0.3
			local p = center + Vector3.new(math.cos(a) * 46, 0, math.sin(a) * 46)
			if not nearAvenue(p, 22) then
				Util.place(Props.randomTemplate(rng, Props.palms()), market, p + Vector3.new(0, TOP, 0), rng:NextNumber(0, TAU), rng:NextNumber(0.9, 1.15))
			end
		end
	end

	-- palms and lamps lining the avenues
	local avenueDeco = Util.model(folder, "AvenueTrees")
	for _, av in ipairs(AVENUES) do
		local side = Vector3.new(-av.dir.Z, 0, av.dir.X)
		for r = 316, 520, 34 do
			if math.abs(r - 412) > 56 then
				for _, s in ipairs({ -1, 1 }) do
					local p = av.dir * r + side * s * 22 + Vector3.new(0, TOP, 0)
					if (r // 34) % 2 == 0 then
						Util.place(Props.randomTemplate(rng, Props.palms()), avenueDeco, p, rng:NextNumber(0, TAU), rng:NextNumber(0.9, 1.1))
					else
						Props.streetLamp(avenueDeco, p, 13)
					end
				end
			end
		end
	end

	-- houses in rings between the avenues
	local houses = Util.model(folder, "Houses")
	local count = 0
	for ringR = 322, WALL_R - 68, 42 do
		local a = rng:NextNumber(0, 0.2)
		while a < TAU do
			local w = rng:NextNumber(20, 32)
			local d = rng:NextNumber(20, 30)
			local center = Vector3.new(math.cos(a) * ringR, 0, math.sin(a) * ringR)
			local blocked = nearAvenue(center, 26 + w / 2)
				or (clockBase and (center - Vector3.new(clockBase.X, 0, clockBase.Z)).Magnitude < 40)
			for _, pz in ipairs(plazas) do
				if (center - pz).Magnitude < 66 then
					blocked = true
				end
			end
			if not blocked then
				if rng:NextNumber() < 0.1 then
					Util.place(Props.randomTemplate(rng, Props.palms()), houses, center + Vector3.new(0, TOP, 0), rng:NextNumber(0, TAU), 1)
				else
					local jitter = Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
					local pos = center + jitter + Vector3.new(0, TOP, 0)
					house(houses, rng, flatCF(pos, -center), w, d)
					count += 1
				end
			end
			a += (w + rng:NextNumber(6, 12)) / ringR
			Util.breathe()
		end
	end
	Util.log(string.format("  %d houses", count))

	-- palms on the ledge outside the walls
	local ledge = Util.model(folder, "LedgePalms")
	for k = 0, 39 do
		local a = k / 40 * TAU + rng:NextNumber(-0.04, 0.04)
		local p = Vector3.new(math.cos(a), 0, math.sin(a)) * (WALL_R + 34)
		if not nearAvenue(p, 40) then
			local h = Landscape.heightAt(p.X, p.Z)
			if h > TOP - 3 then
				Util.place(Props.randomTemplate(rng, Props.palms()), ledge, Vector3.new(p.X, h, p.Z), rng:NextNumber(0, TAU), rng:NextNumber(0.9, 1.2))
			end
		end
	end
end

return Hub
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000E">
				<Properties>
					<string name="Name">Ruins</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Ashen Remnant
	A dead city swallowed by black sand. No streets survive, only shattered
	skyscrapers jutting out of the dunes at odd angles, toppled towers,
	burnt-out cars half buried in ash, smouldering fires and bent street lamps.
]]

local Layout = require(script.Parent.Parent.IslandLayout)
local Landscape = require(script.Parent.Parent.Landscape)
local Util = require(script.Parent.Parent.Util)
local Props = require(script.Parent.Parent.Props)

local Ruins = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, rod = Util.box, Util.rod
local NOSHADOW = { shadow = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local TAU = math.pi * 2
local HALF_PI = math.pi / 2
local L = Layout.Landmarks

local CONCRETE = rgb(98, 96, 94)
local CONCRETE_DARK = rgb(70, 68, 68)
local GLASS = rgb(30, 38, 46)
local REBAR = rgb(96, 58, 40)
local SOOT = rgb(14, 14, 16)

local function ground(p)
	return Vector3.new(p.X, Landscape.heightAt(p.X, p.Z), p.Z)
end

-- One broken skyscraper. cf is the center of its footprint at the base.
local function skyscraper(parent, rng, cf, w, d, H)
	local m = Util.model(parent, "Skyscraper")
	local tint = Util.vary(rng, CONCRETE, 0.1)
	local glass = Util.vary(rng, GLASS, 0.15)

	-- The tower is split into two halves; the right half broke off lower down,
	-- leaving a stepped, sheared silhouette.
	local hl = H
	local hr = H * rng:NextNumber(0.55, 0.88)
	local halves = { { x = -w / 4, h = hl }, { x = w / 4, h = hr } }
	for _, half in ipairs(halves) do
		box(m, cf * CFrame.new(half.x, half.h / 2, 0), Vector3.new(w / 2 - 1, half.h, d - 2), glass, M.Glass, { reflectance = 0.12 })
	end
	-- floor bands: full width up to the break, then only the standing half
	for y = 6, hl - 4, 12 do
		if y < hr - 4 then
			box(m, cf * CFrame.new(0, y, 0), Vector3.new(w + 0.6, 1.4, d + 0.6), tint, M.Concrete, NOSHADOW)
		else
			box(m, cf * CFrame.new(-w / 4 - 0.2, y, 0), Vector3.new(w / 2 + 0.2, 1.4, d + 0.6), tint, M.Concrete, NOSHADOW)
		end
	end
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local ch = c[1] < 0 and hl or hr
		box(m, cf * CFrame.new(c[1] * (w / 2 - 0.4), ch / 2, c[2] * (d / 2 - 0.4)), Vector3.new(2.6, ch, 2.6), tint, M.Concrete)
	end
	box(m, cf * CFrame.new(0, hl / 2, 0), Vector3.new(2.4, hl, d + 0.4), tint, M.Concrete, NOSHADOW)

	-- slab hanging off the break, sagging toward the fallen half
	box(m, cf * CFrame.new(w / 4, hr + 3, 0) * CFrame.Angles(0, 0, -rng:NextNumber(0.3, 0.7)), Vector3.new(w / 2, 1.4, d * 0.8), tint, M.Concrete)

	-- jagged broken crowns on both halves
	for _, half in ipairs(halves) do
		for _ = 1, rng:NextInteger(2, 4) do
			local sx = rng:NextNumber(0.25, 0.5) * w / 2
			local sz = rng:NextNumber(0.2, 0.5) * d
			local h = rng:NextNumber(4, 22)
			local x = half.x + rng:NextNumber(-1, 1) * (w / 2 - sx) / 2
			local z = rng:NextNumber(-1, 1) * (d - sz) / 2
			box(m, cf * CFrame.new(x, half.h + h / 2 - 1, z), Vector3.new(sx, h, sz), tint, M.Concrete)
		end
		for _ = 1, rng:NextInteger(4, 7) do
			local x = half.x + rng:NextNumber(-0.45, 0.45) * w / 2
			local z = rng:NextNumber(-0.45, 0.45) * d
			local a = (cf * CFrame.new(x, half.h - 1, z)).Position
			local b = (cf * CFrame.new(x + rng:NextNumber(-3, 3), half.h + rng:NextNumber(5, 16), z + rng:NextNumber(-3, 3))).Position
			rod(m, a, b, 0.5, REBAR, M.CorrodedMetal, NOCOL_NOSHADOW)
		end
	end

	-- blown-out holes, some still burning inside
	for k = 1, rng:NextInteger(3, 6) do
		local face = rng:NextInteger(0, 3)
		local y = rng:NextNumber(0.15, 0.9) * hr
		local hw = (face % 2 == 0) and w or d
		local off = rng:NextNumber(-0.3, 0.3) * hw
		local hole = cf * CFrame.Angles(0, face * HALF_PI, 0) * CFrame.new(off, y, -((face % 2 == 0) and d or w) / 2 - 0.3)
		local p = box(m, hole, Vector3.new(rng:NextNumber(8, 22), rng:NextNumber(10, 24), 1.2), SOOT, M.Basalt, NOSHADOW)
		if k == 1 and rng:NextNumber() < 0.35 then
			Util.pointLight(p, rgb(255, 110, 40), 2, 30)
			Util.particles(p, {
				Texture = Util.TEX.fire,
				Color = Util.cs(rgb(255, 160, 60), rgb(255, 60, 20)),
				Size = Util.ns(0, 3, 1, 0),
				Transparency = Util.ns(0, 0.3, 1, 1),
				Lifetime = NumberRange.new(0.6, 1.2),
				Rate = 20,
				Speed = NumberRange.new(3, 6),
				EmissionDirection = Enum.NormalId.Top,
				LightEmission = 1,
			})
		end
	end
	return m
end

-- Concrete chunks scattered around a point.
local function debris(parent, rng, center, radius, count)
	local m = Util.model(parent, "Debris")
	for _ = 1, count do
		local a = rng:NextNumber(0, TAU)
		local r = rng:NextNumber(0.2, 1) * radius
		local p = ground(center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
		local s = Vector3.new(rng:NextNumber(3, 12), rng:NextNumber(2, 7), rng:NextNumber(3, 12))
		box(m, CFrame.new(p + Vector3.new(0, s.Y * 0.2, 0)) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, TAU), rng:NextNumber(-0.6, 0.6)), s, Util.vary(rng, CONCRETE_DARK, 0.15), M.Concrete)
	end
	return m
end

local function charredTree(parent, rng, pos)
	local m = Util.model(parent, "CharredTree")
	local bark = rgb(26, 24, 24)
	local top = pos + Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(14, 22), rng:NextNumber(-2, 2))
	rod(m, pos - Vector3.new(0, 2, 0), top, 1.8, bark, M.Wood)
	for _ = 1, 3 do
		local from = pos:Lerp(top, rng:NextNumber(0.4, 0.9))
		rod(m, from, from + Vector3.new(rng:NextNumber(-7, 7), rng:NextNumber(2, 7), rng:NextNumber(-7, 7)), 0.8, bark, M.Wood, NOSHADOW)
	end
	return m
end

local function billboard(parent, rng, pos)
	local m = Util.model(parent, "FallenBillboard")
	local yaw = rng:NextNumber(0, TAU)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(rng:NextNumber(0.3, 1.1), 0, rng:NextNumber(-0.2, 0.2))
	local faded = Util.pick(rng, { rgb(120, 60, 50), rgb(70, 90, 110), rgb(140, 120, 70), rgb(90, 90, 96) })
	box(m, cf * CFrame.new(0, 10, 0), Vector3.new(30, 14, 1), faded, M.SmoothPlastic)
	box(m, cf * CFrame.new(0, 10, 0.8), Vector3.new(31, 15, 0.6), rgb(50, 48, 46), M.CorrodedMetal, NOSHADOW)
	for _, x in ipairs({ -10, 10 }) do
		rod(m, (cf * CFrame.new(x, -4, 1)).Position, (cf * CFrame.new(x, 4, 1)).Position, 1.2, rgb(60, 56, 52), M.CorrodedMetal)
	end
	return m
end

---------------------------------------------------------------------------------------------------------
function Ruins.Build(folder, rng)
	Util.log("Building Ashen Remnant...")
	local center = L.RuinsCenter
	local inner = Layout.HUB_RADIUS + Layout.HUB_APRON * 0.8
	local outer = Layout.ISLAND_RADIUS - Layout.BEACH_WIDTH - 250

	local function spot(nearCenter, maxDist)
		for _ = 1, 40 do
			local p
			if nearCenter then
				local a = rng:NextNumber(0, TAU)
				p = center + Vector3.new(math.cos(a), 0, math.sin(a)) * math.sqrt(rng:NextNumber()) * maxDist
			else
				local a = Layout.ZoneAngle.Ruins + rng:NextNumber(-0.85, 0.85) * Layout.HALF_SECTOR
				p = Layout.polar(a, rng:NextNumber(inner, outer))
			end
			local q = Landscape.query(p.X, p.Z)
			if q.land and q.zone == "Ruins" and not q.underwater then
				return Vector3.new(p.X, q.h, p.Z)
			end
		end
		return nil
	end

	-- skyline
	local towers = Util.folder(folder, "Skyscrapers")
	local placed = {}
	local built = 0
	for _ = 1, 160 do
		if built >= 34 then
			break
		end
		local p = spot(true, 1900)
		if p then
			local ok = true
			for _, o in ipairs(placed) do
				if (o - p).Magnitude < 170 then
					ok = false
					break
				end
			end
			if ok then
				table.insert(placed, p)
				local w, d = rng:NextNumber(46, 84), rng:NextNumber(46, 84)
				local roll = rng:NextNumber()
				local yaw = CFrame.Angles(0, rng:NextNumber(0, TAU), 0)
				-- taller towers closer to the old downtown
				local downtown = 1 - math.clamp((p - center).Magnitude / 1900, 0, 1)
				local H = rng:NextNumber(110, 200) + downtown * rng:NextNumber(80, 240)
				if roll < 0.12 then
					-- toppled tower lying in the sand
					local cf = CFrame.new(p + Vector3.new(0, math.min(w, d) * 0.25, 0)) * yaw * CFrame.Angles(HALF_PI * 0.94, 0, 0) * CFrame.new(0, -H * 0.15, 0)
					skyscraper(towers, rng, cf, w, d, H * 0.7)
				elseif roll < 0.3 then
					-- stump
					skyscraper(towers, rng, CFrame.new(p - Vector3.new(0, 6, 0)) * yaw, w, d, rng:NextNumber(26, 70))
				elseif roll < 0.6 then
					local tilt = CFrame.Angles(rng:NextNumber(-0.22, 0.22), 0, rng:NextNumber(-0.22, 0.22))
					skyscraper(towers, rng, CFrame.new(p - Vector3.new(0, rng:NextNumber(12, 30), 0)) * yaw * tilt, w, d, H)
				else
					skyscraper(towers, rng, CFrame.new(p - Vector3.new(0, rng:NextNumber(8, 24), 0)) * yaw, w, d, H)
				end
				-- rubble mound and chunks at the base
				for _ = 1, 3 do
					local a = rng:NextNumber(0, TAU)
					workspace.Terrain:FillBall(p + Vector3.new(math.cos(a) * w * 0.55, -6, math.sin(a) * d * 0.55), rng:NextNumber(14, 26), M.Basalt)
				end
				debris(towers, rng, p, math.max(w, d) * 1.1, rng:NextInteger(6, 11))
				built += 1
			end
		end
		Util.breathe()
	end

	-- wrecks and remains scattered through the dunes
	local wrecks = Util.folder(folder, "Wrecks")
	for _ = 1, 120 do
		local p = spot(rng:NextNumber() < 0.7, 2300) or spot(false)
		if p then
			local yaw = CFrame.Angles(0, rng:NextNumber(0, TAU), 0)
			local roll = rng:NextNumber()
			local cf
			if roll < 0.18 then
				cf = CFrame.new(p + Vector3.new(0, 5.6, 0)) * yaw * CFrame.Angles(0, 0, math.pi)
			elseif roll < 0.3 then
				cf = CFrame.new(p + Vector3.new(0, 3.4, 0)) * yaw * CFrame.Angles(0, 0, HALF_PI)
			else
				cf = CFrame.new(p - Vector3.new(0, rng:NextNumber(0.5, 2.5), 0)) * yaw * CFrame.Angles(rng:NextNumber(-0.12, 0.12), 0, rng:NextNumber(-0.12, 0.12))
			end
			Props.wreckedCar(wrecks, rng, cf)
		end
		Util.breathe()
	end
	for _ = 1, 45 do
		local p = spot(true, 2300)
		if p then
			Props.brokenLamp(wrecks, rng, p)
		end
	end
	for _ = 1, 40 do
		local p = spot(false)
		if p then
			charredTree(wrecks, rng, p)
		end
	end
	for _ = 1, 8 do
		local p = spot(true, 2000)
		if p then
			billboard(wrecks, rng, p - Vector3.new(0, 3, 0))
		end
	end
	for _ = 1, 16 do
		local p = spot(true, 2200)
		if p then
			debris(wrecks, rng, p, 40, rng:NextInteger(5, 9))
		end
	end

	-- smouldering fires
	local fires = Util.model(folder, "Smoulders")
	for k = 1, 12 do
		local p = spot(true, 2000)
		if p then
			Props.smoulder(fires, p + Vector3.new(0, 1, 0), k <= 3)
		end
	end
	Util.log(string.format("  %d skyscrapers", built))
end

return Ruins
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000F">
				<Properties>
					<string name="Name">Snow</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Shirayuki Vale
	A deep, silent winter forest of snow-laden pines covering most of the region.
	In a valley sits a very small Japanese village by a frozen pond. Far beyond,
	a long stone stairway lined with lanterns and torii climbs a mountain to
	Ryuudou Temple, with its gate, great hall, five-storey pagoda and bell.
]]

local Layout = require(script.Parent.Parent.IslandLayout)
local Landscape = require(script.Parent.Parent.Landscape)
local TerrainWriter = require(script.Parent.Parent.TerrainWriter)
local Util = require(script.Parent.Parent.Util)
local Props = require(script.Parent.Parent.Props)
local Config = require(script.Parent.Parent.Config)

local Snow = {}

local M = Enum.Material
local rgb = Color3.fromRGB
local box, ball, column, disc, rod, beam, wedge = Util.box, Util.ball, Util.column, Util.disc, Util.rod, Util.beam, Util.wedge
local NOSHADOW = { shadow = false }
local NOCOL_NOSHADOW = { collide = false, shadow = false }
local TAU = math.pi * 2
local HALF_PI = math.pi / 2
local L = Layout.Landmarks

local SNOW = rgb(242, 247, 252)
local WOOD = rgb(70, 50, 38)
local WOOD_LIGHT = rgb(120, 92, 66)
local PLASTER = rgb(238, 234, 224)
local VERMILION = rgb(178, 50, 38)
local TILE = rgb(62, 60, 66)
local THATCH = rgb(146, 120, 80)
local GRANITE = rgb(150, 148, 144)
local SHOJI = rgb(252, 238, 210)
local GOLD = rgb(214, 172, 74)

local function flatCF(pos, dir)
	return CFrame.lookAt(pos, pos + Vector3.new(dir.X, 0, dir.Z))
end

local function ground(p)
	return Vector3.new(p.X, Landscape.heightAt(p.X, p.Z), p.Z)
end

-- Roof with a layer of snow on top (gable).
local function snowyGable(parent, cf, width, depth, height, color, material)
	Util.gableRoof(parent, cf, width, depth, height, color, material)
	Util.gableRoof(parent, cf * CFrame.new(0, 1, 0), width - 1, depth - 0.6, height, SNOW, M.Snow, NOSHADOW)
end

-- Hip roof with snow on top.
local function snowyHip(parent, cf, width, depth, rise, color)
	Util.hipRoof(parent, cf, width, depth, rise, 1.4, color, M.ClayRoofTiles)
	Util.hipRoof(parent, cf * CFrame.new(0, 1, 0), width - 2, depth - 2, rise, 0.8, SNOW, M.Snow, NOSHADOW)
end

local function label(part, face, text, color, canvas)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.CanvasSize = canvas or Vector2.new(400, 120)
	gui.LightInfluence = 0.6
	gui.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color
	t.Font = Enum.Font.Garamond
	t.TextScaled = true
	t.Parent = gui
	return gui
end

local function redLantern(parent, pos)
	local l = Util.ellipsoid(parent, CFrame.new(pos), Vector3.new(1.8, 2.6, 1.8), rgb(232, 80, 48), M.Neon, NOCOL_NOSHADOW)
	Util.pointLight(l, rgb(255, 130, 80), 1.2, 18)
	box(parent, CFrame.new(pos + Vector3.new(0, 1.5, 0)), Vector3.new(1.2, 0.4, 1.2), rgb(30, 26, 24), M.Wood, NOCOL_NOSHADOW)
	return l
end

-- Torii gate standing at cf (ground center); people walk through along cf's Z axis.
local function torii(parent, cf, width, height, color)
	local m = Util.model(parent, "Torii")
	color = color or VERMILION
	for _, s in ipairs({ -1, 1 }) do
		local base = (cf * CFrame.new(s * width / 2, 0, 0)).Position
		column(m, base - Vector3.new(0, 2, 0), height + 2, width * 0.09, color, M.SmoothPlastic)
		column(m, base - Vector3.new(0, 1, 0), 3, width * 0.12, rgb(30, 28, 28), M.SmoothPlastic)
	end
	box(m, cf * CFrame.new(0, height * 0.78, 0), Vector3.new(width + width * 0.16, height * 0.06, width * 0.08), color, M.SmoothPlastic)
	box(m, cf * CFrame.new(0, height + height * 0.04, 0), Vector3.new(width * 1.42, height * 0.07, width * 0.12), color, M.SmoothPlastic)
	box(m, cf * CFrame.new(0, height + height * 0.1, 0), Vector3.new(width * 1.5, height * 0.05, width * 0.14), rgb(28, 26, 26), M.SmoothPlastic)
	box(m, cf * CFrame.new(0, height + height * 0.14, 0), Vector3.new(width * 1.48, height * 0.03, width * 0.13), SNOW, M.Snow, NOSHADOW)
	box(m, cf * CFrame.new(0, height * 0.9, 0), Vector3.new(width * 0.06, height * 0.12, width * 0.1), color, M.SmoothPlastic)
	return m
end

-- Minka (farmhouse) at cf ground center, front facing -Z.
local function minka(parent, rng, cf, W, D, thatched)
	local m = Util.model(parent, "Minka")
	box(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(W + 3, 2.4, D + 3), GRANITE, M.Granite)
	box(m, cf * CFrame.new(0, 2, 0), Vector3.new(W, 1.2, D), WOOD_LIGHT, M.WoodPlanks)
	box(m, cf * CFrame.new(0, 7.35, 0), Vector3.new(W - 0.6, 9.5, D - 0.6), PLASTER, M.Plaster)
	for _, x in ipairs({ -W / 2, -W / 6, W / 6, W / 2 }) do
		for _, z in ipairs({ -D / 2, D / 2 }) do
			box(m, cf * CFrame.new(x, 7.5, z), Vector3.new(1.2, 11, 1.2), WOOD, M.Wood)
		end
	end
	for _, z in ipairs({ -D / 2, D / 2 }) do
		box(m, cf * CFrame.new(0, 12.2, z), Vector3.new(W + 1, 1.2, 1), WOOD, M.Wood, NOSHADOW)
		box(m, cf * CFrame.new(0, 4, z), Vector3.new(W + 0.6, 0.8, 0.9), WOOD, M.Wood, NOSHADOW)
	end
	for _, x in ipairs({ -W / 2, W / 2 }) do
		box(m, cf * CFrame.new(x, 12.2, 0), Vector3.new(1, 1.2, D + 1), WOOD, M.Wood, NOSHADOW)
	end
	-- glowing shoji screens
	for i, x in ipairs({ -W / 3, 0, W / 3 }) do
		local panel = box(m, cf * CFrame.new(x, 8, -D / 2 - 0.1), Vector3.new(W / 3 - 2, 7, 0.3), SHOJI, M.SmoothPlastic, NOSHADOW)
		if i == 2 then
			Util.surfaceLight(panel, Enum.NormalId.Front, rgb(255, 206, 140), 1.4, 16, 100)
		end
		for _, y in ipairs({ 6, 8, 10 }) do
			box(m, cf * CFrame.new(x, y, -D / 2 - 0.3), Vector3.new(W / 3 - 2, 0.25, 0.2), WOOD, M.Wood, NOCOL_NOSHADOW)
		end
		box(m, cf * CFrame.new(x, 8, -D / 2 - 0.3), Vector3.new(0.25, 7, 0.2), WOOD, M.Wood, NOCOL_NOSHADOW)
	end
	-- engawa (veranda) and stepping stone
	box(m, cf * CFrame.new(0, 2.6, -D / 2 - 2.2), Vector3.new(W + 2, 0.6, 4), WOOD_LIGHT, M.WoodPlanks)
	box(m, cf * CFrame.new(0, 0.9, -D / 2 - 5.2), Vector3.new(4, 1, 2.2), GRANITE, M.Granite)

	-- roof (ridge along X)
	local roofCF = cf * CFrame.new(0, 12.8, 0) * CFrame.Angles(0, HALF_PI, 0)
	local rise = thatched and 10 or 8
	snowyGable(m, roofCF, D + 9, W + 7, rise, thatched and THATCH or TILE, thatched and M.Grass or M.ClayRoofTiles)
	box(m, cf * CFrame.new(0, 12.8 + rise + 1, 0), Vector3.new(W + 8, 1.6, 2), WOOD, M.Wood, NOSHADOW)
	local ridge = box(m, cf * CFrame.new(0, 12.8 + rise + 2.1, 0), Vector3.new(W + 8, 0.8, 2.6), SNOW, M.Snow, NOSHADOW)
	Util.particles(ridge, {
		Texture = Util.TEX.smoke,
		Color = Util.cs(rgb(230, 230, 232), rgb(190, 190, 196)),
		Size = Util.ns(0, 1, 1, 6),
		Transparency = Util.ns(0, 0.5, 1, 1),
		Lifetime = NumberRange.new(5, 8),
		Rate = 2,
		Speed = NumberRange.new(2, 3),
		SpreadAngle = Vector2.new(8, 8),
		EmissionDirection = Enum.NormalId.Top,
		LightInfluence = 1,
	})
	redLantern(m, (cf * CFrame.new(W / 2 - 1.5, 10, -D / 2 - 3.5)).Position)

	-- firewood and a barrel by the side
	for k = 0, 4 do
		local c = cf * CFrame.new(W / 2 + 2.4 + (k % 3) * 1.4, 1 + (k // 3) * 1.3, 2) * CFrame.Angles(0, HALF_PI, 0)
		Util.cylinder(m, c, 6, 1.3, rgb(122, 90, 60), M.Wood, NOSHADOW)
	end
	box(m, cf * CFrame.new(W / 2 + 3.4, 2.6, 2), Vector3.new(4.8, 0.6, 6.4), SNOW, M.Snow, NOSHADOW)
	column(m, (cf * CFrame.new(-W / 2 - 2.5, 0, -2)).Position, 3.6, 3, WOOD_LIGHT, M.Wood)
	disc(m, (cf * CFrame.new(-W / 2 - 2.5, 3.8, -2)).Position, 0.6, 3, SNOW, M.Snow, NOSHADOW)
	return m
end

-- Village ---------------------------------------------------------------------------------------
local function buildVillage(parent, rng)
	local m = Util.model(parent, "ShirayukiVillage")
	local center = Vector3.new(L.SnowVillage.X, Landscape.VillageHeight, L.SnowVillage.Z)
	local outDir = (L.TempleStairsFoot - L.SnowVillage)
	outDir = Vector3.new(outDir.X, 0, outDir.Z).Unit
	local V = flatCF(center, outDir) -- -Z points toward the temple path

	-- stone-slab street
	for z = -150, 150, 6 do
		local p = ground((V * CFrame.new(rng:NextNumber(-0.6, 0.6), 0, z)).Position)
		box(m, CFrame.new(p + Vector3.new(0, 0.1, 0)) * V.Rotation * CFrame.Angles(0, rng:NextNumber(-0.06, 0.06), 0), Vector3.new(9, 1, 4.6), Util.vary(rng, GRANITE, 0.05), M.Slate, NOSHADOW)
	end

	local houses = {
		{ -30, -90, false },
		{ 31, -64, true },
		{ -33, -12, true },
		{ 32, 22, false },
		{ -30, 74, false },
		{ 36, 108, true, true },
	}
	for _, h in ipairs(houses) do
		local x, z = h[1], h[2]
		local yaw = x < 0 and -HALF_PI or HALF_PI
		local p = ground((V * CFrame.new(x, 0, z)).Position)
		local elder = h[4] -- the village elder's larger house
		minka(m, rng, CFrame.new(p) * V.Rotation * CFrame.Angles(0, yaw, 0), elder and 32 or rng:NextNumber(20, 24), elder and 20 or rng:NextNumber(15, 17), h[3])
	end

	-- well in the square
	local wellPos = ground((V * CFrame.new(14, 0, 40)).Position)
	column(m, wellPos - Vector3.new(0, 1, 0), 4, 7, GRANITE, M.Granite)
	disc(m, wellPos + Vector3.new(0, 3.1, 0), 0.2, 5.4, rgb(20, 24, 30), M.SmoothPlastic, NOSHADOW)
	for _, s in ipairs({ -1, 1 }) do
		column(m, wellPos + Vector3.new(s * 3.2, 0, 0), 9, 0.8, WOOD, M.Wood)
	end
	snowyGable(m, CFrame.new(wellPos + Vector3.new(0, 9, 0)) * V.Rotation, 9, 5, 3, TILE, M.ClayRoofTiles)

	-- lanterns along the street
	for z = -130, 130, 44 do
		for _, x in ipairs({ -8, 8 }) do
			Props.stoneLantern(m, ground((V * CFrame.new(x, 0, z + (x > 0 and 22 or 0))).Position), 0, true)
		end
	end

	-- torii at both ends of the street
	torii(m, CFrame.new(ground((V * CFrame.new(0, 0, -158)).Position)) * V.Rotation, 16, 18)
	torii(m, CFrame.new(ground((V * CFrame.new(0, 0, 160)).Position)) * V.Rotation, 14, 16)

	-- small roadside shrine
	local shrinePos = ground((V * CFrame.new(-14, 0, -150)).Position)
	local shrine = CFrame.new(shrinePos) * V.Rotation * CFrame.Angles(0, -HALF_PI, 0)
	box(m, shrine * CFrame.new(0, 1, 0), Vector3.new(5, 2, 5), GRANITE, M.Granite)
	box(m, shrine * CFrame.new(0, 4, 0), Vector3.new(3.4, 4, 3), WOOD_LIGHT, M.Wood)
	snowyGable(m, shrine * CFrame.new(0, 6, 0), 5.4, 4.6, 2, TILE, M.ClayRoofTiles)
	redLantern(m, (shrine * CFrame.new(0, 4.5, -2.6)).Position)

	-- bamboo fences
	for _, side in ipairs({ -1, 1 }) do
		for z = -120, 110, 4 do
			if math.abs(z) > 20 then
				local p = ground((V * CFrame.new(side * 56, 0, z)).Position)
				column(m, p - Vector3.new(0, 1, 0), 6, 0.7, rgb(150, 160, 96), M.Wood, NOSHADOW)
			end
		end
		for _, z0 in ipairs({ -120, 24 }) do
			local a = ground((V * CFrame.new(side * 56, 0, z0)).Position)
			local b = ground((V * CFrame.new(side * 56, 0, z0 + 96)).Position)
			beam(m, a + Vector3.new(0, 3.5, 0), b + Vector3.new(0, 3.5, 0), 0.4, 0.4, rgb(120, 130, 80), M.Wood, NOSHADOW)
		end
	end

	-- drifts of snow against the houses
	for _ = 1, 14 do
		local p = ground((V * CFrame.new(rng:NextNumber(-60, 60), 0, rng:NextNumber(-140, 140))).Position)
		if math.abs((V:PointToObjectSpace(p)).X) > 14 then
			workspace.Terrain:FillBall(p, rng:NextNumber(3, 6), M.Snow)
		end
	end

	-- frozen pond with a viewing lantern and a bench
	local pond = L.SnowPond
	local pondLevel = Landscape.SnowPondLevel
	local toVillage = (L.SnowVillage - pond).Unit
	local bank = pond + toVillage * 132
	Props.stoneLantern(m, ground(bank), 0, true)
	local benchPos = ground(pond + toVillage * 140 + Vector3.new(8, 0, 8))
	box(m, CFrame.new(benchPos + Vector3.new(0, 2, 0)) * V.Rotation, Vector3.new(8, 0.6, 2.4), WOOD_LIGHT, M.WoodPlanks)
	box(m, CFrame.new(benchPos + Vector3.new(0, 2.5, 0)) * V.Rotation, Vector3.new(7.6, 0.4, 2), SNOW, M.Snow, NOSHADOW)
	for _, s in ipairs({ -1, 1 }) do
		box(m, CFrame.new(benchPos + Vector3.new(0, 1, 0)) * V.Rotation * CFrame.new(s * 3.2, 0, 0), Vector3.new(0.8, 2, 2), WOOD, M.Wood)
	end
	m:SetAttribute("PondLevel", pondLevel)
	return m, V
end

-- Jizo statues along the trail -----------------------------------------------------------------------
local function jizo(parent, pos, facing)
	local m = Util.model(parent, "Jizo")
	local cf = flatCF(pos, facing)
	box(m, cf * CFrame.new(0, 0.6, 0), Vector3.new(3.4, 1.6, 3), GRANITE, M.Granite)
	column(m, (cf * CFrame.new(0, 1.2, 0)).Position, 3.6, 2.4, GRANITE, M.Granite)
	ball(m, (cf * CFrame.new(0, 5.6, 0)).Position, 2.4, GRANITE, M.Granite)
	wedge(m, cf * CFrame.new(0, 3.6, -0.9), Vector3.new(2.4, 1.6, 1), rgb(196, 40, 36), M.Fabric, NOCOL_NOSHADOW)
	disc(m, (cf * CFrame.new(0, 6.9, 0)).Position, 0.6, 2.2, SNOW, M.Snow, NOSHADOW)
	return m
end

-- Temple --------------------------------------------------------------------------------------------
local function pagoda(parent, base)
	local m = Util.model(parent, "FiveStoreyPagoda")
	box(m, CFrame.new(base + Vector3.new(0, 1.5, 0)), Vector3.new(28, 3, 28), GRANITE, M.Granite)
	local y = 3
	for i = 0, 4 do
		local s = 16 - i * 2
		box(m, CFrame.new(base + Vector3.new(0, y + 4.5, 0)), Vector3.new(s, 9, s), PLASTER, M.Plaster)
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			box(m, CFrame.new(base + Vector3.new(c[1] * s / 2, y + 4.5, c[2] * s / 2)), Vector3.new(1.2, 9, 1.2), VERMILION, M.SmoothPlastic, NOSHADOW)
		end
		box(m, CFrame.new(base + Vector3.new(0, y + 8.6, 0)), Vector3.new(s + 1.6, 1.2, s + 1.6), VERMILION, M.SmoothPlastic, NOSHADOW)
		snowyHip(m, CFrame.new(base + Vector3.new(0, y + 9.2, 0)), s + 14, s + 14, 4.5, TILE)
		y += 13
	end
	local top = base + Vector3.new(0, y + 1, 0)
	rod(m, top - Vector3.new(0, 4, 0), top + Vector3.new(0, 30, 0), 1.2, GOLD, M.Foil)
	for k = 1, 9 do
		disc(m, top + Vector3.new(0, 3 + k * 2.4, 0), 0.6, 3.6 - k * 0.15, GOLD, M.Foil, NOSHADOW)
	end
	ball(m, top + Vector3.new(0, 31, 0), 2.4, GOLD, M.Foil)
	return m
end

local function bellTower(parent, cf)
	local m = Util.model(parent, "BellPavilion")
	box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(22, 3, 22), GRANITE, M.Granite)
	for _, c in ipairs({ { -8, -8 }, { 8, -8 }, { -8, 8 }, { 8, 8 } }) do
		column(m, (cf * CFrame.new(c[1], 3, c[2])).Position, 17, 1.8, VERMILION, M.SmoothPlastic)
	end
	box(m, cf * CFrame.new(0, 19.6, 0), Vector3.new(19, 1.2, 19), VERMILION, M.SmoothPlastic, NOSHADOW)
	snowyHip(m, cf * CFrame.new(0, 20.2, 0), 28, 28, 7, TILE)
	local bronze = rgb(74, 64, 50)
	column(m, (cf * CFrame.new(0, 8, 0)).Position, 9.5, 7, bronze, M.Metal)
	ball(m, (cf * CFrame.new(0, 17, 0)).Position, 6.8, bronze, M.Metal)
	box(m, cf * CFrame.new(0, 19, 0), Vector3.new(16, 1, 1), WOOD, M.Wood, NOSHADOW)
	-- hanging log striker
	Util.cylinder(m, cf * CFrame.new(-7.5, 11, 0), 7, 1.6, WOOD_LIGHT, M.Wood, NOSHADOW)
	for _, s in ipairs({ -1, 1 }) do
		box(m, cf * CFrame.new(-7.5 + s * 2.5, 15, 0), Vector3.new(0.2, 8, 0.2), rgb(220, 200, 150), M.Fabric, NOCOL_NOSHADOW)
	end
	return m
end

local function komainu(parent, cf)
	local m = Util.model(parent, "Komainu")
	box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(6.4, 3, 8.4), GRANITE, M.Granite)
	cf = cf * CFrame.new(0, 3, 0)
	box(m, cf * CFrame.new(0, 2, 0), Vector3.new(5, 4, 7), GRANITE, M.Granite)
	box(m, cf * CFrame.new(0, 5.5, 0.8), Vector3.new(3.4, 3, 5), GRANITE, M.Granite)
	ball(m, (cf * CFrame.new(0, 8.4, -1.2)).Position, 3.6, GRANITE, M.Granite)
	ball(m, (cf * CFrame.new(0, 8.8, 1.4)).Position, 2.2, GRANITE, M.Granite)
	box(m, cf * CFrame.new(0, 4.3, 0.8), Vector3.new(3.6, 0.6, 5.2), SNOW, M.Snow, NOSHADOW)
	return m
end

local function buildTemple(parent, rng)
	local m = Util.model(parent, "RyuudouTemple")
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local center = Vector3.new(L.Temple.X, Landscape.TempleHeight, L.Temple.Z)
	local front = (L.TempleStairsTop - L.Temple)
	front = Vector3.new(front.X, 0, front.Z).Unit
	local T = flatCF(center, front) -- -Z points down the stairs

	-- stone courtyard
	box(m, T * CFrame.new(0, -0.6, 0), Vector3.new(206, 2.6, 206), GRANITE, M.Slate)
	for z = -96, 0, 6 do
		box(m, T * CFrame.new(0, 0.9, z), Vector3.new(12, 0.6, 5.4), Util.vary(rng, rgb(170, 168, 162), 0.04), M.Granite, NOSHADOW)
	end

	-- earthen walls with tiled caps
	local function wallRun(fromX, fromZ, toX, toZ)
		local a = (T * CFrame.new(fromX, 0, fromZ)).Position
		local b = (T * CFrame.new(toX, 0, toZ)).Position
		local cf = CFrame.lookAt((a + b) / 2, b)
		local len = (b - a).Magnitude
		box(m, cf * CFrame.new(0, 4, 0), Vector3.new(3, 10, len), PLASTER, M.Plaster)
		box(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(3.6, 2, len), GRANITE, M.Granite, NOSHADOW)
		snowyGable(m, cf * CFrame.new(0, 9, 0), 6, len + 1, 2.4, TILE, M.ClayRoofTiles)
	end
	wallRun(-100, 100, 100, 100)
	wallRun(-100, -100, -100, 100)
	wallRun(100, -100, 100, 100)
	wallRun(-100, -100, -26, -100)
	wallRun(26, -100, 100, -100)

	-- sanmon (two-storey gate)
	local G = T * CFrame.new(0, 0, -100)
	box(m, G * CFrame.new(0, 0.4, 0), Vector3.new(48, 2, 20), GRANITE, M.Granite)
	for _, x in ipairs({ -18, -6, 6, 18 }) do
		for _, z in ipairs({ -6, 6 }) do
			column(m, (G * CFrame.new(x, 1, z)).Position, 20, 2.6, VERMILION, M.SmoothPlastic)
		end
	end
	box(m, G * CFrame.new(0, 20.6, 0), Vector3.new(40, 1.6, 14), VERMILION, M.SmoothPlastic)
	snowyHip(m, G * CFrame.new(0, 21.4, 0), 54, 28, 7, TILE)
	box(m, G * CFrame.new(0, 28, 0), Vector3.new(32, 9, 11), PLASTER, M.Plaster)
	for _, x in ipairs({ -16, -5.3, 5.3, 16 }) do
		box(m, G * CFrame.new(x, 28, -5.6), Vector3.new(1, 9, 0.6), VERMILION, M.SmoothPlastic, NOSHADOW)
	end
	box(m, G * CFrame.new(0, 32.4, 0), Vector3.new(34, 1.2, 13), VERMILION, M.SmoothPlastic, NOSHADOW)
	snowyHip(m, G * CFrame.new(0, 33, 0), 46, 24, 9, TILE)
	local plaque = box(m, G * CFrame.new(0, 26.4, -6.4), Vector3.new(10, 4, 0.6), rgb(40, 32, 28), M.Wood, NOSHADOW)
	label(plaque, Enum.NormalId.Front, "龍洞寺", GOLD)
	for _, x in ipairs({ -12, 12 }) do
		redLantern(m, (G * CFrame.new(x, 17, -8)).Position)
	end

	-- lanterns lining the way to the hall
	for z = -84, -20, 16 do
		for _, x in ipairs({ -12, 12 }) do
			Props.stoneLantern(m, (T * CFrame.new(x, 0.8, z)).Position, 0, true)
		end
	end

	-- main hall
	local Hc = T * CFrame.new(0, 0, 36)
	box(m, Hc * CFrame.new(0, 3, 0), Vector3.new(96, 6, 70), GRANITE, M.Granite)
	for k = 1, 6 do
		box(m, Hc * CFrame.new(0, 6 - k, -35 - k * 2 + 1), Vector3.new(30, 2, 2), GRANITE, M.Granite)
	end
	box(m, Hc * CFrame.new(0, 18, 4), Vector3.new(72, 24, 46), PLASTER, M.Plaster)
	for x = -36, 36, 9 do
		column(m, (Hc * CFrame.new(x, 6, -27)).Position, 24, 2.6, VERMILION, M.SmoothPlastic)
		column(m, (Hc * CFrame.new(x, 6, 4 - 23)).Position, 24, 2, WOOD, M.Wood, NOSHADOW)
	end
	box(m, Hc * CFrame.new(0, 29.5, -27), Vector3.new(76, 2, 2.4), VERMILION, M.SmoothPlastic)
	box(m, Hc * CFrame.new(0, 7.2, -24), Vector3.new(76, 0.6, 8), WOOD_LIGHT, M.WoodPlanks)
	box(m, Hc * CFrame.new(0, 9, -27.6), Vector3.new(72, 0.5, 0.5), VERMILION, M.SmoothPlastic, NOSHADOW)
	for _, x in ipairs({ -18, 0, 18 }) do
		local door = box(m, Hc * CFrame.new(x, 15, -19.2), Vector3.new(12, 16, 0.6), rgb(96, 64, 42), M.Wood, NOSHADOW)
		for _, y in ipairs({ 10, 14, 18, 22 }) do
			box(m, Hc * CFrame.new(x, y, -19.6), Vector3.new(12, 0.3, 0.3), WOOD, M.Wood, NOCOL_NOSHADOW)
		end
		if x == 0 then
			Util.surfaceLight(door, Enum.NormalId.Front, rgb(255, 196, 120), 1, 20, 90)
		end
	end
	local bigLantern = Util.ellipsoid(m, Hc * CFrame.new(0, 24, -29), Vector3.new(6, 9, 6), rgb(220, 60, 40), M.Neon, NOCOL_NOSHADOW)
	Util.pointLight(bigLantern, rgb(255, 120, 70), 2, 34)
	box(m, Hc * CFrame.new(0, 8.4, -30), Vector3.new(8, 3.6, 4), rgb(100, 70, 46), M.WoodPlanks)
	-- double roof
	snowyHip(m, Hc * CFrame.new(0, 30.4, 4), 100, 74, 12, TILE)
	box(m, Hc * CFrame.new(0, 40, 4), Vector3.new(60, 10, 34), PLASTER, M.Plaster)
	box(m, Hc * CFrame.new(0, 45.2, 4), Vector3.new(62, 1.2, 36), VERMILION, M.SmoothPlastic, NOSHADOW)
	snowyHip(m, Hc * CFrame.new(0, 45.8, 4), 80, 54, 18, TILE)
	for _, x in ipairs({ -22, 22 }) do
		local p = (Hc * CFrame.new(x, 64.6, 4)).Position
		box(m, CFrame.new(p) * T.Rotation * CFrame.Angles(0, 0, x > 0 and -0.3 or 0.3), Vector3.new(2, 6, 2), GOLD, M.Foil, NOSHADOW)
	end
	for _, s in ipairs({ -1, 1 }) do
		komainu(m, Hc * CFrame.new(s * 22, 0.6, -50))
	end

	pagoda(m, (T * CFrame.new(64, 0, -40)).Position)
	bellTower(m, T * CFrame.new(-62, 0, -44))

	-- sacred cedar wrapped in a shimenawa rope
	local cedarPos = (T * CFrame.new(-62, 0, 52)).Position
	Util.place(Props.pines()[2], m, cedarPos - Vector3.new(0, 1, 0), 0.4, 1.6)
	local rope = rgb(222, 200, 150)
	for k = 0, 15 do
		local a0, a1 = k / 16 * TAU, (k + 1) / 16 * TAU
		local r = 4.6
		beam(m, cedarPos + Vector3.new(math.cos(a0) * r, 10, math.sin(a0) * r), cedarPos + Vector3.new(math.cos(a1) * r, 10, math.sin(a1) * r), 1, 1, rope, M.Fabric, NOSHADOW)
	end
	for k = 0, 3 do
		local a = k / 4 * TAU + 0.4
		local p = cedarPos + Vector3.new(math.cos(a) * 5, 8, math.sin(a) * 5)
		box(m, CFrame.lookAt(p, p + Vector3.new(math.cos(a), 0, math.sin(a))) * CFrame.Angles(0, 0, 0.3), Vector3.new(1.2, 3, 0.1), rgb(250, 250, 250), M.SmoothPlastic, NOCOL_NOSHADOW)
	end
	return m, T
end

-- Stairway ---------------------------------------------------------------------------------------------
local function buildStairway(parent, rng)
	local m = Util.model(parent, "TempleStairway")
	local foot, top = L.TempleStairsFoot, L.TempleStairsTop
	local footH, topH = Landscape.StairsFootHeight, Landscape.TempleHeight
	local dir = Vector3.new(top.X - foot.X, 0, top.Z - foot.Z)
	local len = dir.Magnitude
	dir = dir.Unit
	local side = Vector3.new(-dir.Z, 0, dir.X)
	local run = 3
	local n = math.floor(len / run)
	local rise = (topH - footH) / n
	for k = 0, n do
		local t = k / n
		local p = foot + dir * (t * len)
		local stepTop = footH + k * rise
		local lineH = footH + t * (topH - footH)
		local h = stepTop - (lineH - 4)
		box(m, flatCF(Vector3.new(p.X, stepTop - h / 2, p.Z), dir), Vector3.new(20, h, run + 0.25), Util.vary(rng, GRANITE, 0.04), M.Granite)
		if k % 28 == 14 then
			for _, s in ipairs({ -1, 1 }) do
				Props.stoneLantern(m, Vector3.new(p.X, stepTop - 0.5, p.Z) + side * s * 13, 0, true)
			end
		end
		Util.breathe()
	end
	-- torii along the climb
	for _, t in ipairs({ 0, 0.33, 0.66 }) do
		local p = foot + dir * (t * len - 6)
		local hgt = Landscape.heightAt(p.X, p.Z)
		torii(m, flatCF(Vector3.new(p.X, hgt, p.Z), dir), 24, t == 0 and 30 or 24)
	end
	-- stone marker at the foot
	local markerPos = ground(foot - dir * 14 + side * 20)
	local marker = box(m, flatCF(markerPos + Vector3.new(0, 7, 0), -side), Vector3.new(4.5, 16, 4.5), GRANITE, M.Granite)
	label(marker, Enum.NormalId.Front, "龍洞寺\nRYUUDOU TEMPLE", rgb(40, 34, 30), Vector2.new(200, 600))
	label(marker, Enum.NormalId.Back, "龍洞寺\nRYUUDOU TEMPLE", rgb(40, 34, 30), Vector2.new(200, 600))
	disc(m, markerPos + Vector3.new(0, 15.3, 0), 0.6, 5, SNOW, M.Snow, NOSHADOW)
	return m
end

-- A lone charcoal-burner's hut high in the forest ------------------------------------------------------------
local function findQuietSpot(rng)
	local best, bestSlope = nil, math.huge
	local R = Layout.ISLAND_RADIUS
	for _ = 1, 260 do
		local a = Layout.ZoneAngle.Snow + rng:NextNumber(-0.7, 0.7) * Layout.HALF_SECTOR
		local p = Layout.polar(a, rng:NextNumber(R * 0.55, R * 0.82))
		local far = (p - L.SnowVillage).Magnitude > 900 and (p - L.Temple).Magnitude > 800
		if far then
			local q = Landscape.query(p.X, p.Z)
			if q.land and q.zone == "Snow" and q.h > 90 then
				local s = Landscape.slopeAt(p.X, p.Z, 10)
				if s < bestSlope then
					best, bestSlope = p, s
				end
			end
		end
	end
	return best
end

local function buildHut(parent, rng)
	local spot = findQuietSpot(rng)
	if not spot then
		return
	end
	local m = Util.model(parent, "MountainHut")
	local p = ground(spot)
	local facing = Vector3.new(-p.X, 0, -p.Z).Unit
	minka(m, rng, flatCF(p - Vector3.new(0, 1.5, 0), facing), 18, 14, true)
	-- charcoal kiln
	local kiln = ground(p + Vector3.new(-facing.Z, 0, facing.X) * 22)
	ball(m, kiln, 12, rgb(120, 96, 80), M.Ground)
	disc(m, kiln + Vector3.new(0, 4.8, 0), 0.6, 8, SNOW, M.Snow, NOSHADOW)
	local vent = box(m, CFrame.new(kiln + Vector3.new(0, 6, 0)), Vector3.new(1.4, 1.4, 1.4), rgb(60, 50, 44), M.Basalt, NOSHADOW)
	Util.particles(vent, {
		Texture = Util.TEX.smoke,
		Color = Util.cs(rgb(120, 116, 112), rgb(200, 200, 204)),
		Size = Util.ns(0, 1.5, 1, 10),
		Transparency = Util.ns(0, 0.4, 1, 1),
		Lifetime = NumberRange.new(6, 9),
		Rate = 3,
		Speed = NumberRange.new(3, 5),
		SpreadAngle = Vector2.new(8, 8),
		EmissionDirection = Enum.NormalId.Top,
		LightInfluence = 1,
	})
	Props.stoneLantern(m, ground(p + facing * 16), 0, true)
end

---------------------------------------------------------------------------------------------------------
function Snow.Build(folder, rng)
	Util.log("Building Shirayuki Vale...")
	buildVillage(folder, rng)
	buildTemple(folder, rng)
	buildStairway(folder, rng)
	buildHut(folder, rng)

	-- jizo statues along the trail from the capital
	local path = Layout.Paths[2].points
	local jz = Util.model(folder, "TrailJizo")
	for i = 1, #path - 1 do
		local a, b = path[i], path[i + 1]
		local d = (b - a)
		local len = d.Magnitude
		local side = Vector3.new(-d.Z, 0, d.X).Unit
		for t = 260, len - 200, 420 do
			local p = a + d.Unit * t + side * 16
			jizo(jz, ground(p), -side)
		end
	end

	-- the winter forest
	local pines = Props.pines()
	local bare = Props.bareTrees()
	local trees = Util.folder(folder, "Pines")
	local rocks = Util.folder(folder, "Rocks")
	local spacing = 50 / math.sqrt(math.max(Config.FOLIAGE_DENSITY, 0.05))
	local R = Landscape.MAX_COAST
	local foot, top = L.TempleStairsFoot, L.TempleStairsTop
	local sx, sz = top.X - foot.X, top.Z - foot.Z
	local slen2 = sx * sx + sz * sz
	local function nearStairs(x, z)
		local t = math.clamp(((x - foot.X) * sx + (z - foot.Z) * sz) / slen2, 0, 1)
		local dx, dz = foot.X + sx * t - x, foot.Z + sz * t - z
		return dx * dx + dz * dz < 36 * 36
	end
	local count, rockCount = 0, 0
	for _, p in ipairs(Util.scatterGrid(rng, -R, -R, R, R, spacing)) do
		if Layout.getZone(p.X, p.Z) == "Snow" then
			local q = Landscape.query(p.X, p.Z)
			if q.land and q.zone == "Snow" and not q.path and not q.road and not q.underwater then
				local dv = (p - L.SnowVillage).Magnitude
				local dt = (p - L.Temple).Magnitude
				local dp = (p - L.SnowPond).Magnitude
				if dv > 300 and dt > 225 and dp > 150 and not nearStairs(p.X, p.Z) then
					local slope = Landscape.slopeAt(p.X, p.Z)
					local grove = Landscape.noise2(p.X, p.Z, 1 / 600, 300)
					if slope > 1.05 then
						if rng:NextNumber() < 0.12 then
							local pos = Vector3.new(p.X, q.h, p.Z)
							TerrainWriter.boulder(rng, pos, rng:NextNumber(6, 12), M.Rock)
							workspace.Terrain:FillBall(pos + Vector3.new(0, 6, 0), rng:NextNumber(4, 6), M.Snow)
							rockCount += 1
						end
					elseif rng:NextNumber() < math.clamp(0.62 + grove * 1.3, 0.12, 0.96) then
						local pos = Vector3.new(p.X, q.h - 1.5, p.Z)
						if dv < 560 and rng:NextNumber() < 0.25 then
							Util.place(Props.randomTemplate(rng, bare), trees, pos, rng:NextNumber(0, TAU), rng:NextNumber(0.9, 1.3))
						else
							Util.place(Props.randomTemplate(rng, pines), trees, pos, rng:NextNumber(0, TAU), rng:NextNumber(0.75, 1.4))
						end
						count += 1
					end
				end
			end
		end
		Util.breathe()
	end
	Util.log(string.format("  %d trees, %d snowy boulders", count, rockCount))
	rocks:SetAttribute("Count", rockCount)
end

return Snow
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
