		<Item class="ModuleScript" referent="RBX0000001B">
			<Properties>
				<string name="Name">LightingFX</string>
				<ProtectedString name="Source"><![CDATA[--[[
	LightingFX
	Lighting looks of the intro (DESIGN §7.2). Everything it touches is saved
	first and put back exactly by Restore (properties, enabled flags, parents).

	    local fx = LightingFX.new(camera?)
	    fx:Begin()            save + Lighting:SetAttribute("CutsceneActive", true)
	    fx:Space()            black ambient, low side sun, strong bloom, cool grade; Atmosphere and Sky
	                          taken out of Lighting, Clouds and every post effect (Lighting + camera) off
	    fx:World()            the saved look again + a slight warm grade
	    fx:Set(prop, value)   change a Lighting property (saved; put back by the next Space/World
	                          switch and by Restore, so a stage sets its tweaks in SetActive(true))
	    fx:Effect(className, props) -> instance  an extra effect in Lighting, destroyed by Restore
	                          (destroy it yourself earlier if it belongs to one stage only)
	    fx:Restore()          everything back, attribute back, created effects destroyed (idempotent)

	LightingFX.SPACE / LightingFX.SPACE_EFFECTS / LightingFX.WORLD_GRADE are the
	looks (stages may tweak them before calling Space/World).
]]

local Lighting = game:GetService("Lighting")

local LightingFX = {}
LightingFX.__index = LightingFX

local rgb = Color3.fromRGB

LightingFX.SPACE = {
	ClockTime = 7.1, -- low sun: hard side light, the planet reads as a crescent
	GeographicLatitude = 0,
	Brightness = 3.2,
	Ambient = rgb(0, 0, 0),
	OutdoorAmbient = rgb(6, 7, 14),
	ColorShift_Top = rgb(255, 244, 228),
	ColorShift_Bottom = rgb(0, 0, 0),
	EnvironmentDiffuseScale = 0,
	EnvironmentSpecularScale = 0.25,
	ExposureCompensation = 0,
	FogStart = 100000,
	FogEnd = 100000,
	FogColor = rgb(0, 0, 0),
	GlobalShadows = true,
	ShadowSoftness = 0.1,
}

LightingFX.SPACE_EFFECTS = {
	{ "BloomEffect", { Name = "IntroSpaceBloom", Intensity = 1.4, Size = 40, Threshold = 0.85 } },
	{
		"ColorCorrectionEffect",
		{ Name = "IntroSpaceGrade", Brightness = 0, Contrast = 0.12, Saturation = 0.12, TintColor = rgb(236, 240, 255) },
	},
}

LightingFX.WORLD_GRADE = { Name = "IntroWorldGrade", Brightness = 0.01, Contrast = 0.04, Saturation = 0.06, TintColor = rgb(255, 246, 234) }

function LightingFX.new(camera)
	local self = setmetatable({}, LightingFX)
	self.camera = camera or workspace.CurrentCamera
	self.saved = {} -- prop -> original value (only props we changed)
	self.removed = {} -- { instance, parent } taken out of the lighting
	self.disabled = {} -- instances whose Enabled we set false
	self.created = {} -- instances we made
	self.spaceEffects = {}
	self.mode = nil
	self.begun = false
	return self
end

function LightingFX:Begin()
	if self.begun then
		return
	end
	self.begun = true
	self.attribute = Lighting:GetAttribute("CutsceneActive")
	Lighting:SetAttribute("CutsceneActive", true)
end

function LightingFX:Set(prop, value)
	if self.saved[prop] == nil then
		self.saved[prop] = Lighting[prop]
	end
	Lighting[prop] = value
end

function LightingFX:Effect(className, props)
	local e = Instance.new(className)
	for k, v in pairs(props or {}) do
		e[k] = v
	end
	e.Parent = Lighting
	table.insert(self.created, e)
	return e
end

local function destroy(list)
	for _, inst in ipairs(list) do
		pcall(function()
			inst:Destroy()
		end)
	end
	table.clear(list)
end

-- put back properties, parents and enabled flags (keeps the attribute and created world effects)
function LightingFX:_restoreLook()
	for prop, value in pairs(self.saved) do
		pcall(function()
			Lighting[prop] = value
		end)
	end
	table.clear(self.saved)
	for i = #self.removed, 1, -1 do
		local entry = self.removed[i]
		pcall(function()
			entry[1].Parent = entry[2]
		end)
	end
	table.clear(self.removed)
	for _, inst in ipairs(self.disabled) do
		pcall(function()
			inst.Enabled = true
		end)
	end
	table.clear(self.disabled)
	destroy(self.spaceEffects)
end

function LightingFX:Space()
	self:Begin()
	self:_restoreLook()
	self.mode = "space"
	-- Atmosphere and Sky have no Enabled switch: take them out of Lighting for now
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Atmosphere") or child:IsA("Sky") then
			table.insert(self.removed, { child, child.Parent })
			child.Parent = nil
		end
	end
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
	if clouds and clouds.Enabled then
		clouds.Enabled = false
		table.insert(self.disabled, clouds)
	end
	local holders = { Lighting }
	if self.camera then
		table.insert(holders, self.camera)
	end
	for _, holder in ipairs(holders) do
		for _, child in ipairs(holder:GetChildren()) do
			if child:IsA("PostEffect") and child.Enabled then
				child.Enabled = false
				table.insert(self.disabled, child)
			end
		end
	end
	for prop, value in pairs(LightingFX.SPACE) do
		self:Set(prop, value)
	end
	-- a sky without sun, moon or stars behind the space dome
	local sky = Instance.new("Sky")
	sky.Name = "IntroSpaceSky"
	sky.CelestialBodiesShown = false
	sky.StarCount = 0
	sky.Parent = Lighting
	table.insert(self.spaceEffects, sky)
	for _, spec in ipairs(LightingFX.SPACE_EFFECTS) do
		local e = Instance.new(spec[1])
		for k, v in pairs(spec[2]) do
			e[k] = v
		end
		e.Parent = Lighting
		table.insert(self.spaceEffects, e)
	end
end

function LightingFX:World()
	self:Begin()
	self:_restoreLook()
	self.mode = "world"
	if not self.worldGrade then
		self.worldGrade = self:Effect("ColorCorrectionEffect", LightingFX.WORLD_GRADE)
	end
end

function LightingFX:Restore()
	self:_restoreLook()
	destroy(self.created)
	self.worldGrade = nil
	if self.begun then
		self.begun = false
		pcall(function()
			Lighting:SetAttribute("CutsceneActive", self.attribute)
		end)
	end
	self.mode = nil
end

return LightingFX
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000001C">
			<Properties>
				<string name="Name">Screen</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Screen
	Everything 2D of the intro (DESIGN §7.2, §7.4): one ScreenGui (IgnoreGuiInset,
	DisplayOrder 100) with, bottom to top: impact frames (ViewportFrame with
	silhouettes + radial lines), speed lines, colour flash, cinematic bars
	(2.39:1 letterbox), black fade, skip hint.

	All animation is a function of cutscene time t (no tweens): a marker starts an
	effect at its own time, Update(t) draws the state at t. So a long frame or a
	jump in t shows exactly what should be on screen at t.

	    local screen = Screen.new(player, camera, config)
	    screen:Bars(show, seconds, t0)          slide the bars in (true) / out (false)
	    screen:Fade(toBlack, seconds, t0)       fade to black (true) / from black (false)
	    screen:Flash(color, seconds, t0)        full-screen flash fading out over seconds
	    screen:Shake(magnitude, seconds, t0)    camera shake (studs of jitter), decays
	    screen:ShakeOffset(t) -> CFrame         camera-local offset; camera.CFrame = cf * offset
	    screen:SpeedLines(on, t0)               screen-space speed lines
	    screen:Impact(mode, t0)                 "white" | "black" | "off" (§7.4)
	    screen:AddSilhouette(name, source, poseFn?)   clones the visible parts of source (Model or
	                                            part) into the impact ViewportFrame; while impact
	                                            frames show they follow poseFn(sourcePart) -> CFrame
	                                            (default sourcePart.CFrame)
	    screen:RemoveSilhouette(name)
	    screen:SetSkipHint(visible)
	    screen:Update(t, dt)                    draw (call after the camera and the models are set)
	    screen:Destroy()                        removes the gui, shows the hidden game GUI again
]]

local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Screen = {}
Screen.__index = Screen

local BAR_RATIO = 2.39
local SPEED_LINES = 36
local IMPACT_LINES = 32
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local TAU = math.pi * 2
local HIDDEN_CORE = { "Backpack", "PlayerList", "Health", "EmotesMenu" }

local Z_IMPACT, Z_IMPACT_LINES, Z_SPEED, Z_FLASH, Z_BARS, Z_FADE, Z_HINT = 1, 2, 3, 4, 5, 6, 7

local function clamp01(x)
	return x < 0 and 0 or (x > 1 and 1 or x)
end

local function smooth(x)
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end

-- deterministic pseudo random 0..1
local function hash(i, s)
	local x = math.sin(i * 12.9898 + s * 78.233) * 43758.5453
	return x - math.floor(x)
end

local function frame(parent, name, z, color)
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color or BLACK
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = z
	f.Parent = parent
	return f
end

local function taperedLine(parent, z)
	local f = frame(parent, "Line", z, WHITE)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundTransparency = 0
	f.Visible = false
	local g = Instance.new("UIGradient")
	-- left end (inner, towards the screen centre) invisible, right end (outer) solid
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.55, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	g.Parent = f
	return f
end

-- A value easing from `from` to `to` over [t0, t0 + dur].
local function ramp(state, t)
	if state.dur <= 0 then
		return t >= state.t0 and state.to or state.from
	end
	return state.from + (state.to - state.from) * smooth((t - state.t0) / state.dur)
end

function Screen.new(player, camera, config)
	local self = setmetatable({}, Screen)
	self.player = player
	self.camera = camera
	self.config = config or {}
	self.t = 0
	self.bars = { from = 0, to = 0, t0 = 0, dur = 0 }
	self.fade = { from = 0, to = 0, t0 = 0, dur = 0 }
	self.flash = { color = WHITE, t0 = -1, dur = 0 }
	self.shakes = {}
	self.speed = { on = false, t0 = -100 }
	self.impactMode = "off"
	self.silhouettes = {}
	self.hiddenGuis = {}
	self.hiddenCore = {}

	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	local gui = Instance.new("ScreenGui")
	gui.Name = "IntroCutsceneScreen"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	self.gui = gui

	-- impact frames
	local vf = Instance.new("ViewportFrame")
	vf.Name = "ImpactFrame"
	vf.BorderSizePixel = 0
	vf.Size = UDim2.fromScale(1, 1)
	vf.BackgroundColor3 = WHITE
	vf.BackgroundTransparency = 0
	vf.ZIndex = Z_IMPACT
	vf.Visible = false
	vf.LightDirection = Vector3.new(-0.3, -1, -0.4)
	vf.Parent = gui
	local vcam = Instance.new("Camera")
	vcam.Name = "ImpactCamera"
	vcam.Parent = vf
	vf.CurrentCamera = vcam
	self.impactFrame = vf
	self.impactCamera = vcam
	self.impactLinesFrame = frame(gui, "ImpactLines", Z_IMPACT_LINES)
	self.impactLinesFrame.Visible = false
	self.impactLines = {}
	for i = 1, IMPACT_LINES do
		self.impactLines[i] = taperedLine(self.impactLinesFrame, Z_IMPACT_LINES)
	end

	-- speed lines
	self.speedFrame = frame(gui, "SpeedLines", Z_SPEED)
	self.speedFrame.Visible = false
	self.speedLines = {}
	for i = 1, SPEED_LINES do
		self.speedLines[i] = taperedLine(self.speedFrame, Z_SPEED)
	end

	self.flashFrame = frame(gui, "Flash", Z_FLASH, WHITE)
	self.flashFrame.Visible = false

	self.barTop = frame(gui, "BarTop", Z_BARS)
	self.barTop.BackgroundTransparency = 0
	self.barTop.Visible = false
	self.barBottom = frame(gui, "BarBottom", Z_BARS)
	self.barBottom.BackgroundTransparency = 0
	self.barBottom.AnchorPoint = Vector2.new(0, 1)
	self.barBottom.Visible = false

	self.fadeFrame = frame(gui, "Fade", Z_FADE)
	self.fadeFrame.Visible = false

	local hint = Instance.new("TextLabel")
	hint.Name = "SkipHint"
	hint.AnchorPoint = Vector2.new(1, 1)
	hint.Position = UDim2.new(1, -24, 1, -18)
	hint.Size = UDim2.fromOffset(260, 24)
	hint.BackgroundTransparency = 1
	hint.Font = Enum.Font.GothamMedium
	hint.TextSize = 16
	hint.TextXAlignment = Enum.TextXAlignment.Right
	hint.TextColor3 = WHITE
	hint.TextTransparency = 0.35
	hint.TextStrokeTransparency = 0.8
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	hint.Text = touchOnly and "Tap to skip" or "Press Space to skip"
	hint.ZIndex = Z_HINT
	hint.Visible = false
	hint.Parent = gui
	self.hint = hint

	if self.config.HIDE_GUI ~= false and playerGui then
		self:_hideGameGui(playerGui)
	end
	gui.Parent = playerGui
	return self
end

function Screen:_hideGameGui(playerGui)
	for _, g in ipairs(playerGui:GetChildren()) do
		if g:IsA("ScreenGui") and g ~= self.gui and g.Enabled then
			g.Enabled = false
			table.insert(self.hiddenGuis, g)
		end
	end
	for _, name in ipairs(HIDDEN_CORE) do
		local item = Enum.CoreGuiType[name]
		local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, item)
		if ok and enabled then
			if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, item, false) then
				table.insert(self.hiddenCore, item)
			end
		end
	end
end

-- Markers ------------------------------------------------------------------------------------------------
function Screen:Bars(show, seconds, t0)
	local b = self.bars
	b.from = ramp(b, t0)
	b.to = show and 1 or 0
	b.t0 = t0
	b.dur = seconds or 1
end

function Screen:Fade(toBlack, seconds, t0)
	local f = self.fade
	f.from = ramp(f, t0)
	f.to = toBlack and 1 or 0
	if not toBlack and f.from < 1e-3 then
		f.from = 1 -- "from black" starts black even when nothing faded in before
	end
	f.t0 = t0
	f.dur = seconds or 1
end

function Screen:Flash(color, seconds, t0)
	self.flash.color = color or WHITE
	self.flash.t0 = t0
	self.flash.dur = math.max(seconds or 0.3, 1 / 60)
end

function Screen:Shake(magnitude, seconds, t0)
	table.insert(self.shakes, { mag = magnitude or 0.5, dur = math.max(seconds or 0.5, 1e-3), t0 = t0, seed = #self.shakes * 7.31 + t0 })
end

function Screen:ShakeOffset(t)
	local x, y, roll = 0, 0, 0
	local shakes = self.shakes
	for i = #shakes, 1, -1 do
		local s = shakes[i]
		local p = (t - s.t0) / s.dur
		if p >= 1 then
			table.remove(shakes, i)
		elseif p >= 0 then
			local k = s.mag * (1 - p) * (1 - p)
			local tt = (t - s.t0) * 17
			x += math.noise(tt, s.seed, 0.5) * 2 * k
			y += math.noise(s.seed, tt, 1.5) * 2 * k
			roll += math.noise(tt, 2.5, s.seed) * k * 0.02
		end
	end
	if x == 0 and y == 0 and roll == 0 then
		return CFrame.identity
	end
	return CFrame.new(x, y, 0) * CFrame.Angles(0, 0, roll)
end

function Screen:SpeedLines(on, t0)
	if on == self.speed.on then
		return
	end
	-- keep the level continuous when toggled mid-ramp
	local level = self:_speedLevel(t0)
	self.speed.on = on
	if on then
		self.speed.t0 = t0 - level * 0.25
	else
		self.speed.t0 = t0 - (1 - level) * 0.35
	end
end

function Screen:_speedLevel(t)
	local s = self.speed
	if s.on then
		return clamp01((t - s.t0) / 0.25)
	end
	return 1 - clamp01((t - s.t0) / 0.35)
end

function Screen:Impact(mode, _t0)
	if mode ~= "white" and mode ~= "black" then
		mode = "off"
	end
	self.impactMode = mode
	local vf = self.impactFrame
	if mode == "off" then
		vf.Visible = false
		self.impactLinesFrame.Visible = false
		return
	end
	local white = mode == "white"
	vf.BackgroundColor3 = white and WHITE or BLACK
	vf.Ambient = white and BLACK or WHITE
	vf.LightColor = white and BLACK or WHITE
	vf.ImageColor3 = white and BLACK or WHITE
	local lineColor = white and BLACK or WHITE
	for _, line in ipairs(self.impactLines) do
		line.BackgroundColor3 = lineColor
	end
	vf.Visible = true
	self.impactLinesFrame.Visible = true
end

-- Silhouettes ------------------------------------------------------------------------------------------
local function silhouetteClone(part)
	local archivable = part.Archivable
	part.Archivable = true
	local c = part:Clone()
	part.Archivable = archivable
	if not c then
		return nil
	end
	for _, child in ipairs(c:GetChildren()) do
		if child:IsA("DataModelMesh") then
			if child:IsA("SpecialMesh") then
				child.TextureId = ""
			end
		else
			child:Destroy()
		end
	end
	if c:IsA("MeshPart") then
		pcall(function()
			c.TextureID = ""
		end)
	end
	c.Anchored = true
	c.CanCollide = false
	c.CanTouch = false
	c.CanQuery = false
	c.CastShadow = false
	c.Material = Enum.Material.SmoothPlastic
	c.Color = WHITE
	c.Transparency = 0
	c.Reflectance = 0
	c.LocalTransparencyModifier = 0
	return c
end

function Screen:AddSilhouette(name, source, poseFn)
	self:RemoveSilhouette(name)
	local parts = {}
	if source:IsA("BasePart") then
		table.insert(parts, source)
	end
	for _, d in ipairs(source:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	local modelArchivable
	if source:IsA("Model") then
		modelArchivable = source.Archivable
		source.Archivable = true
	end
	local pairsList = {}
	for _, p in ipairs(parts) do
		if p.Transparency < 0.99 and p.Name ~= "HumanoidRootPart" then
			local c = silhouetteClone(p)
			if c then
				c.Parent = self.impactFrame
				table.insert(pairsList, { p, c })
			end
		end
	end
	if modelArchivable ~= nil then
		source.Archivable = modelArchivable
	end
	self.silhouettes[name] = { list = pairsList, pose = poseFn }
end

function Screen:RemoveSilhouette(name)
	local s = self.silhouettes[name]
	if s then
		for _, pair in ipairs(s.list) do
			pair[2]:Destroy()
		end
		self.silhouettes[name] = nil
	end
end

function Screen:SetSkipHint(visible)
	self.hint.Visible = visible and true or false
end

-- Drawing ----------------------------------------------------------------------------------------------
function Screen:_size()
	local s = self.gui.AbsoluteSize
	if s.X < 1 or s.Y < 1 then
		s = self.camera and self.camera.ViewportSize or Vector2.new(1280, 720)
	end
	return s.X, s.Y
end

function Screen:_drawSpeedLines(t, w, h)
	local level = self:_speedLevel(t)
	if level <= 0 then
		self.speedFrame.Visible = false
		return
	end
	self.speedFrame.Visible = true
	local R = 0.5 * math.sqrt(w * w + h * h)
	for i, line in ipairs(self.speedLines) do
		local a = (i - 1 + hash(i, 1) * 0.8) / SPEED_LINES * TAU
		local speed = 1.4 + hash(i, 2) * 1.6
		local phase = (t * speed + hash(i, 3)) % 1
		local rOut = R * (1.12 - 0.6 * phase)
		local len = R * (0.16 + 0.26 * hash(i, 4))
		local mid = rOut - len / 2
		local alpha = level * math.sin(math.pi * phase) * 0.75
		line.Visible = alpha > 0.02
		line.Position = UDim2.new(0.5, math.cos(a) * mid, 0.5, math.sin(a) * mid)
		line.Size = UDim2.fromOffset(len, 1.5 + 2 * hash(i, 5))
		line.Rotation = math.deg(a)
		line.BackgroundTransparency = 1 - alpha
	end
end

function Screen:_drawImpact(t, w, h)
	local camera = self.camera
	if camera then
		self.impactCamera.CFrame = camera.CFrame
		self.impactCamera.FieldOfView = camera.FieldOfView
	end
	for _, s in pairs(self.silhouettes) do
		local pose = s.pose
		for _, pair in ipairs(s.list) do
			local src, c = pair[1], pair[2]
			local cf = pose and pose(src) or src.CFrame
			c.CFrame = cf
		end
	end
	-- radial lines, re-randomised every frame (deterministic per 1/60 s)
	local R = 0.5 * math.sqrt(w * w + h * h)
	local seed = math.floor(t * 60)
	for i, line in ipairs(self.impactLines) do
		local a = hash(i, seed) * TAU
		local len = R * (0.3 + 0.45 * hash(i, seed + 0.5))
		local mid = R * 1.05 - len / 2
		line.Visible = true
		line.Position = UDim2.new(0.5, math.cos(a) * mid, 0.5, math.sin(a) * mid)
		line.Size = UDim2.fromOffset(len, 2 + 7 * hash(i, seed + 0.25) ^ 2)
		line.Rotation = math.deg(a)
	end
end

function Screen:Update(t, _dt)
	self.t = t
	local w, h = self:_size()

	-- bars
	local b = ramp(self.bars, t)
	local barH = math.max(0, (h - w / BAR_RATIO) / 2)
	local showBars = b > 1e-3 and barH > 0.5
	self.barTop.Visible = showBars
	self.barBottom.Visible = showBars
	if showBars then
		local size = UDim2.new(1, 0, 0, math.ceil(barH) + 1)
		self.barTop.Size = size
		self.barBottom.Size = size
		self.barTop.Position = UDim2.fromOffset(0, -(barH + 1) * (1 - b))
		self.barBottom.Position = UDim2.new(0, 0, 1, (barH + 1) * (1 - b))
	end

	-- black fade
	local f = ramp(self.fade, t)
	self.fadeFrame.Visible = f > 1e-3
	self.fadeFrame.BackgroundTransparency = 1 - f

	-- flash
	local fl = self.flash
	local p = (t - fl.t0) / fl.dur
	if fl.dur > 0 and p >= 0 and p < 1 then
		self.flashFrame.Visible = true
		self.flashFrame.BackgroundColor3 = fl.color
		self.flashFrame.BackgroundTransparency = 1 - (1 - p) * (1 - p)
	else
		self.flashFrame.Visible = false
	end

	self:_drawSpeedLines(t, w, h)
	if self.impactMode ~= "off" then
		self:_drawImpact(t, w, h)
	end
end

function Screen:Destroy()
	for name in pairs(self.silhouettes) do
		self:RemoveSilhouette(name)
	end
	if self.gui then
		self.gui:Destroy()
		self.gui = nil
	end
	for _, g in ipairs(self.hiddenGuis) do
		pcall(function()
			if g.Parent then
				g.Enabled = true
			end
		end)
	end
	table.clear(self.hiddenGuis)
	for _, item in ipairs(self.hiddenCore) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, item, true)
	end
	table.clear(self.hiddenCore)
end

return Screen
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000001D">
			<Properties>
				<string name="Name">Server</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Server  (Script, RunContext = Server; runs where it is, inside ReplicatedStorage.IntroCutscene)
	The server side of the intro cutscene (docs/intro/DESIGN.md §7.0):

	  * creates the RemoteEvent ReplicatedStorage.IntroCutscene_Finished that the client fires
	    with the soul core colour when the cutscene ends
	  * when Config.GIVE_SWORD is true, gives that player the ResonanceSword: a Tool built from the
	    ResonanceSword pieces of ReplicatedStorage.IntroAssets (or the part-built stand-in when
	    the meshes aren't imported), crystals tinted Neon in the colour, put in the Backpack (and
	    StarterGear, so it comes back after a respawn) and equipped

	Nothing but the colour comes from the client, and the colour is checked: it must be a Color3
	with finite components (clamped to 0..1). Requests are rate limited, and every player gets
	the sword at most once per server (a player who already has a ResonanceSword gets nothing).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local package = script.Parent
local Config = require(package:WaitForChild("Config"))
local Assets = require(package:WaitForChild("Assets"))

local REMOTE_NAME = "IntroCutscene_Finished"
local TOOL_NAME = "ResonanceSword"
local MIN_INTERVAL = 2 -- seconds between two requests of one player that are looked at

local remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
if not (remote and remote:IsA("RemoteEvent")) then
	remote = Instance.new("RemoteEvent")
	remote.Name = REMOTE_NAME
	remote.Parent = ReplicatedStorage
end

local lastRequest = {} -- [Player] = os.clock() of the last request looked at
local given = {} -- [Player] = true once the sword was given

local function validColor(value)
	local valueType = typeof(value)
	if valueType ~= "Color3" then
		return nil
	end
	local r, g, b = value.R, value.G, value.B
	for _, c in ipairs({ r, g, b }) do
		if type(c) ~= "number" or c ~= c or c == math.huge or c == -math.huge then
			return nil
		end
	end
	return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end

local function hasSword(player)
	for _, holder in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character, player:FindFirstChildOfClass("StarterGear") }) do
		local tool = holder and holder:FindFirstChild(TOOL_NAME)
		if tool and tool:IsA("Tool") then
			return true
		end
	end
	return false
end

-- The Tool: an invisible Handle at the grip centre (blade along its +Y, so the default Grip holds
-- it like the cutscene's hand does, DESIGN §4.3) with every sword piece welded to it.
local function buildSword(color)
	local model = Assets.place(TOOL_NAME, nil, CFrame.new())
	Assets.setResonance(model, color, 1)
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = "Resonance Sword"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.identity
	tool:SetAttribute("SoulColor", color)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 1.1, 0.3)
	handle.CFrame = model:GetPivot()
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = true
	handle.Anchored = false
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.Parent = tool

	for _, p in ipairs(Assets.pieces(model)) do
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		local weld = Instance.new("Weld")
		weld.Name = "Weld_" .. p.Name
		weld.Part0 = handle
		weld.Part1 = p
		weld.C0 = handle.CFrame:ToObjectSpace(p.CFrame)
		weld.C1 = CFrame.identity
		weld.Parent = p
		p.Parent = tool
	end
	-- crystals glow a little in the dark
	local crystal = Assets.pieces(tool, "Crystal")[1]
	if crystal then
		local glow = Instance.new("PointLight")
		glow.Name = "ResonanceGlow"
		glow.Color = color
		glow.Brightness = 0.8
		glow.Range = 7
		glow.Shadows = false
		glow.Parent = crystal
	end
	model:Destroy()
	return tool
end

local function giveSword(player, color)
	if hasSword(player) then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack or player.Parent ~= Players then
		return
	end
	local tool = buildSword(color)
	local gear = player:FindFirstChildOfClass("StarterGear")
	if gear then
		tool:Clone().Parent = gear
	end
	tool.Parent = backpack
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(tool)
	end
end

remote.OnServerEvent:Connect(function(player, value)
	local now = os.clock()
	local last = lastRequest[player]
	if last and now - last < MIN_INTERVAL then
		return
	end
	lastRequest[player] = now
	if given[player] then
		return
	end
	local color = validColor(value)
	if not color then
		return
	end
	given[player] = true
	if Config.GIVE_SWORD == false then
		return
	end
	local ok, err = pcall(giveSword, player, color)
	if not ok then
		warn("[IntroCutscene] could not give the sword to " .. player.Name .. ": " .. tostring(err))
	end
end)

Players.PlayerRemoving:Connect(function(player)
	lastRequest[player] = nil
	given[player] = nil
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000001E">
			<Properties>
				<string name="Name">SpaceStage</string>
				<ProtectedString name="Source"><![CDATA[--[[
	SpaceStage  (stage "space", docs/intro/DESIGN.md §1 S0-S4, §3, §5, §7.2)
	Everything of the void far from the island, built at ctx.origins.space:

	  SkyAnchor   the dome, 1600 stars, 3 galaxies (point parts) and 8 nebulae (pre-warmed
	              ParticleEmitters), re-pivoted onto the camera every frame (one BulkMoveTo), so the
	              sky never parallaxes. Display rules exactly as tools/blender/intro/space.py:
	                star    b = clamp((stars - appear) / 0.08) * (1 - 0.45 * twinkle * (0.5 + 0.5 sin(2.2 t + phase)))
	                galaxy  u = smoothstep(clamp((galaxies - delay) / 0.7)); p = rotZ((1 - u) twist) lerp(from, to, u)
	                        in the galaxy frame (X = xaxis, Y = normal x xaxis, Z = normal), brightness u
	                nebula  a = smoothstep(clamp((nebula - appear) / 0.35))
	              Stars are opaque Neon balls whose colour is scaled by b (cheap: no transparency
	              sorting for 1600 parts); galaxy points are translucent Neon balls (transparency by u).
	  SoulCore    the asset + soft glow sprite + PointLight (glow / pulse) + comet tail (tail channel: three Beams
	              trailing along -velocity, a Trail and a sparkle emitter, all in the soul colour)
	  Planet      ShatteredPlanet on its track
	  Rift        cracks revealed in order with flicker and small flashes (crack), shards flung outward
	              along the rift plane, tumbling and fading, rim and view scaling in (open)
	  DustMotes   specks streaming upward past the camera while falling

	Stage interface: see init.luau. Shared pieces for the world stage:
	    SpaceStage.Core.new(parent, assets, color, name)   soul core visual (also used in the world)
	    SpaceStage.Rift.new(parent, assets, name, opts)    rift visual (opts.farSide: the world's SkyRift)
	    SpaceStage.util                                    small helpers (present, velocity, emitter, ...)
]]

local Convert = require(script.Parent.Convert)

local SpaceStage = {}
SpaceStage.__index = SpaceStage

-- display rules of tools/blender/intro/space.py
local STAR_FADE = 0.08
local GALAXY_SPAN = 0.7
local NEBULA_FADE = 0.35
local TWINKLE_DEPTH = 0.45
local TWINKLE_SPEED = 2.2
-- stars smaller than this (studs at ~900 away, ~1 px at 1080p) would shimmer in and out of
-- existence between pixels; the size field stays the diameter otherwise
-- (a smaller star is drawn at STAR_MIN_D and dimmed by size / STAR_MIN_D: the same light)
local STAR_MIN_D = 1.2
local STAR_WRITE_STEP = 0.02 -- a star's colour is rewritten when its brightness moved this much
local GALAXY_POINT_TRANSPARENCY = 0.4 -- galaxy points at full brightness (overlaps read as glow)
local GALAXY_HAZE_TRANSPARENCY = 0.78 -- the dim, big puffs between the arms
-- nebula puffs: particles bigger than this are not safe to rely on, so big clouds get more puffs
local PUFF_MAX = 100
local NEBULA_HAZE_ALPHA = 0.2
local NEBULA_CORE_ALPHA = 0.24

-- built-in particle textures (content/textures/particles of the Roblox client)
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEX_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local TAU = math.pi * 2
local WHITE = Color3.new(1, 1, 1)
local NSK = NumberSequenceKeypoint.new

---------------------------------------------------------------------------------------------- helpers
local util = {}
SpaceStage.util = util

local function clamp01(x)
	return x < 0 and 0 or (x > 1 and 1 or x)
end
util.clamp01 = clamp01

local function smooth(x)
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end
util.smooth = smooth

-- deterministic pseudo random 0..1
local function hash(i, s)
	local x = math.sin(i * 12.9898 + s * 78.233) * 43758.5453
	return x - math.floor(x)
end
util.hash = hash

local function scaleColor(c, k)
	return Color3.new(c.R * k, c.G * k, c.B * k)
end
util.scaleColor = scaleColor

-- Is a track's object there at t? Its `visible` channel, and t inside the baked range (a track
-- baked for part of the timeline only exists there; single-sample tracks are constant).
local function present(track, s, t)
	local v = s.channels.visible
	if v ~= nil and v < 0.5 then
		return false
	end
	if track.n > 1 and (t < track.t0 - 1e-3 or t > track.t1 + 1e-3) then
		return false
	end
	return true
end
util.present = present

-- World-space velocity (studs/s) of a track at t, never differencing across a cut.
-- Leaves the track's sample table at time t.
local function velocity(tl, track, origin, t)
	local h = 1 / 30
	local a, b = t - h, t
	if tl:cutBetween(a, b) then
		a, b = t, t + h
	end
	local p0 = Convert.posOf(track:sample(a).pos)
	local p1 = Convert.posOf(track:sample(b).pos)
	track:sample(t)
	return origin:VectorToWorldSpace((p1 - p0) / (b - a))
end
util.velocity = velocity

local function invisiblePart(parent, name, size, cf)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
	p.Transparency = 1
	p.Size = size or Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = cf or CFrame.new()
	p.Parent = parent
	return p
end
util.invisiblePart = invisiblePart

local function attachment(parent, name, pos)
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = pos or Vector3.zero
	a.Parent = parent
	return a
end
util.attachment = attachment

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Rate = 0
	e.LightInfluence = 0
	e.Texture = TEX_SPARKLE
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = parent
	return e
end
util.emitter = emitter
util.TEX_SMOKE = TEX_SMOKE
util.TEX_SPARKLE = TEX_SPARKLE

local function light(parent, color, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = math.min(range or 16, 60)
	l.Brightness = 0
	l.Shadows = false
	l.Enabled = false
	l.Parent = parent
	return l
end
util.light = light

local function setLight(l, brightness, range)
	local on = brightness > 0.01
	if l.Enabled ~= on then
		l.Enabled = on
	end
	if on then
		l.Brightness = brightness
		if range then
			l.Range = math.clamp(range, 0, 60)
		end
	end
end
util.setLight = setLight

--[[ A soft round glow in world space: one particle of the built-in soft glow texture, locked to
	its part (camera-facing, depth tested, additive, no banding). The particle lives ~400 s (Lifetime
	20 x TimeScale 0.05); size, colour, transparency and brightness are emitter properties, which
	Roblox applies to living particles, so it is emitted once and then only restyled.
	glowSprite(parent part, name, color) -> sprite; setGlow(sprite, diameter, alpha at the centre,
	color?, brightness?) (alpha <= 0 hides it); resetGlow(sprite) after the part left the workspace
	(its particle is gone; the next setGlow emits a new one). ]]
local TEX_GLOW = "rbxasset://textures/particles/explosion01_implosion_main.dds"
local GLOW_TEX_SCALE = 1.5 -- particle size per glow diameter (the texture's glow fills ~2/3 of it)
local PARTICLE_MAX = 100 -- largest particle size Roblox draws
util.TEX_GLOW = TEX_GLOW

local function glowSprite(parent, name, color)
	local at = attachment(parent, name)
	local e = emitter(at, {
		Texture = TEX_GLOW,
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Lifetime = NumberRange.new(20),
		TimeScale = 0.05,
		Speed = NumberRange.new(0),
		Rotation = NumberRange.new(0),
		RotSpeed = NumberRange.new(0),
		LockedToPart = true,
		Size = NumberSequence.new(1),
		Transparency = NumberSequence.new(1),
	})
	e.Name = name
	e:SetAttribute("Prewarm", 1) -- (for scene dumps: one particle, always there)
	return { e = e, live = false, alpha = -1, size = -1, color = color, brightness = -1 }
end
util.glowSprite = glowSprite

local function resetGlow(g)
	g.live = false
	g.alpha = -1
end
util.resetGlow = resetGlow

local function setGlow(g, diameter, alpha, color, brightness)
	local e = g.e
	if alpha <= 0.004 or diameter <= 0.01 then
		if g.alpha ~= 0 then
			g.alpha = 0
			e.Transparency = NumberSequence.new(1)
		end
		return
	end
	if not g.live and e:IsDescendantOf(workspace) then
		g.live = true
		e:Clear()
		e:Emit(1)
	end
	local size = math.min(diameter * GLOW_TEX_SCALE, PARTICLE_MAX)
	if math.abs(size - g.size) > 0.01 then
		g.size = size
		e.Size = NumberSequence.new(size)
	end
	if math.abs(alpha - g.alpha) > 0.004 then
		g.alpha = alpha
		e.Transparency = NumberSequence.new(1 - math.clamp(alpha, 0, 1))
	end
	color = color or g.color
	if color ~= g.color then
		g.color = color
		e.Color = ColorSequence.new(color)
	end
	if brightness and math.abs(brightness - g.brightness) > 0.01 then
		g.brightness = brightness
		e.Brightness = brightness
	end
end
util.setGlow = setGlow

local function setParent(inst, parent)
	if inst.Parent ~= parent then
		inst.Parent = parent
	end
end
util.setParent = setParent

local function bulkMove(parts, cframes)
	if #parts == 0 then
		return
	end
	local ok = pcall(function()
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i = 1, #parts do
			local p = parts[i]
			if p.Parent then
				p.CFrame = cframes[i]
			end
		end
	end
end
util.bulkMove = bulkMove

----------------------------------------------------------------------------------- soul core visual
local Core = {}
Core.__index = Core
SpaceStage.Core = Core

local TAIL_LENGTH = 18 -- studs at tail = 1 (core diameter ~3)
-- comet tail beams: { length factor, width at the core, width at the end, transparency at the core,
-- whiteness at the core, textured (soft cloudy band scrolling backward) }
local TAIL_BEAMS = {
	{ 1.0, 1.3, 0.1, 0.55, 0.3, false },
	{ 0.75, 2.8, 0.6, 0.0, 0.0, true },
	{ 0.45, 0.45, 0.03, 0.15, 0.85, false },
}

function Core.new(parent, assets, color, name)
	local self = setmetatable({}, Core)
	self.color = color
	self.parent = parent
	local folder = Instance.new("Folder")
	folder.Name = name or "SoulCore"
	self.folder = folder
	local model = assets.place("SoulCore", folder, nil, color)
	self.model = model
	self.mover = assets.mover(model)
	self.glowParts = assets.pieces(model, "CoreGlow")
	self.ringParts = assets.pieces(model, "CoreRing")

	local fx = invisiblePart(folder, "SoulCore__FX")
	self.fx = fx
	self.light = light(fx, color, 20)
	self.glow = glowSprite(fx, "Glow", color)
	local head = attachment(fx, "Head", Vector3.new(0, 0, -0.6)) -- just behind the orb's centre
	self.tailEnds = {}
	self.beams = {}
	for k, spec in ipairs(TAIL_BEAMS) do
		local tip = attachment(fx, "Tail" .. k, Vector3.new(0, 0, -1))
		local b = Instance.new("Beam")
		b.Name = "Tail" .. k
		b.Attachment0 = head
		b.Attachment1 = tip
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Segments = 12
		b.Width0 = spec[2]
		b.Width1 = spec[3]
		b.Color = ColorSequence.new(color:Lerp(WHITE, spec[5]), color)
		b.Transparency = NumberSequence.new({ NSK(0, spec[4]), NSK(0.45, spec[4] + (1 - spec[4]) * 0.5), NSK(1, 1) })
		if spec[6] then
			b.Texture = TEX_SMOKE
			b.TextureMode = Enum.TextureMode.Wrap
			b.TextureLength = 5
			b.TextureSpeed = 1.6
		end
		b.Enabled = false
		b.Parent = fx
		self.tailEnds[k] = tip
		self.beams[k] = b
	end
	local ta, tb = attachment(fx, "TrailA", Vector3.new(0, 0.85, 0)), attachment(fx, "TrailB", Vector3.new(0, -0.85, 0))
	local trail = Instance.new("Trail")
	trail.Attachment0 = ta
	trail.Attachment1 = tb
	trail.FaceCamera = true
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Color = ColorSequence.new(color:Lerp(WHITE, 0.4), color)
	trail.Transparency = NumberSequence.new({ NSK(0, 0.35), NSK(1, 1) })
	trail.WidthScale = NumberSequence.new({ NSK(0, 1), NSK(1, 0.1) })
	trail.Lifetime = 0.4
	trail.MinLength = 0.05
	trail.Enabled = false
	trail.Parent = fx
	self.trail = trail
	self.sparkles = emitter(fx, {
		Texture = TEX_SPARKLE,
		Color = ColorSequence.new(color:Lerp(WHITE, 0.6), color),
		LightEmission = 1,
		Size = NumberSequence.new({ NSK(0, 0.45, 0.15), NSK(1, 0) }),
		Transparency = NumberSequence.new({ NSK(0, 0), NSK(0.7, 0.3), NSK(1, 1) }),
		Lifetime = NumberRange.new(0.6, 1.4),
		Speed = NumberRange.new(0.5, 2.5),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-90, 90),
		Shape = Enum.ParticleEmitterShape.Sphere,
	})
	self.dir = Vector3.yAxis -- tail direction (world), kept when the core stands still
	self.shown = false
	self.last = {}
	return self
end

function Core:SetShown(shown)
	if shown == self.shown then
		return
	end
	self.shown = shown
	setParent(self.folder, shown and self.parent or nil)
	if shown then
		-- particles die with the folder leaving the workspace: emit the glow again
		resetGlow(self.glow)
		self.last.glow = nil
	else
		self.trail.Enabled = false
		self.sparkles.Enabled = false
	end
end

-- after the stage folder holding the core went out of the workspace and came back
function Core:Revive()
	resetGlow(self.glow)
	self.last.glow = nil
end

function Core:ClearTrail()
	pcall(function()
		self.trail:Clear()
	end)
end

-- cf: core pivot (world), scale: track scale, ch: channels, vel: world velocity (studs/s)
function Core:Update(cf, scale, ch, vel)
	local glow = ch.glow or 1
	local pulse = ch.pulse or 0
	local tail = clamp01(ch.tail or 0)
	scale = math.max(scale or 1, 0.01)
	self.mover:MoveTo(cf, scale)
	local last = self.last
	if last.glow == nil or math.abs(glow - last.glow) > 0.004 or math.abs(pulse - last.pulse) > 0.004 then
		last.glow, last.pulse = glow, pulse
		local level = clamp01(glow) ^ 0.8
		local hot = clamp01((glow - 1) / 2) * 0.55 + clamp01(pulse) * 0.15
		local core = scaleColor(self.color, math.min(1, level * (1 + 0.35 * pulse))):Lerp(WHITE, hot)
		for _, p in ipairs(self.glowParts) do
			p.Color = core
		end
		local ring = scaleColor(self.color, math.min(1, level * 1.1))
		for _, p in ipairs(self.ringParts) do
			p.Color = ring
		end
		-- soft glow around the orb: grows with glow, beats with pulse
		local d = (3 + 1.6 * math.min(glow, 3)) * (1 + 0.25 * pulse) * scale
		local alpha = math.clamp(0.1 * glow + 0.15 * pulse, 0, 0.45)
		setGlow(self.glow, d, alpha, self.color:Lerp(WHITE, 0.2 + 0.2 * pulse), 1 + 0.35 * math.min(glow, 3))
		setLight(self.light, 0.8 * glow + 1.6 * pulse, (9 + 7 * math.min(glow, 3)) * scale)
	end
	local pos = cf.Position
	if vel and vel.Magnitude > 0.5 then
		self.dir = -vel.Unit
	end
	local dir = self.dir
	self.fx.CFrame = CFrame.lookAt(pos, pos + dir, math.abs(dir.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis)
	local L = tail * TAIL_LENGTH * scale
	local on = L > 0.2
	for k, b in ipairs(self.beams) do
		if b.Enabled ~= on then
			b.Enabled = on
		end
		if on then
			self.tailEnds[k].Position = Vector3.new(0, 0, -L * TAIL_BEAMS[k][1])
		end
	end
	local trailOn = tail > 0.03
	if self.trail.Enabled ~= trailOn then
		self.trail.Enabled = trailOn
	end
	if trailOn and math.abs(tail - (last.tail or -1)) > 0.01 then
		last.tail = tail
		self.trail.Lifetime = 0.12 + 0.5 * tail
		self.trail.MaxLength = 2 + L
	end
	local sp = self.sparkles
	local rate = 50 * tail
	if sp.Enabled ~= (rate > 0.5) then
		sp.Enabled = rate > 0.5
	end
	if rate > 0.5 then
		sp.Rate = rate
		sp.Acceleration = dir * 6
	end
end

function Core:Destroy()
	self.folder:Destroy()
end

----------------------------------------------------------------------------------------- rift visual
local Rift = {}
Rift.__index = Rift
SpaceStage.Rift = Rift

local RIFT_LIGHT = Color3.fromRGB(190, 140, 255)

--[[ opts.farSide: the world's SkyRift, seen from the far side, where the forest picture would be
	wrong: its view becomes a dark violet glow (a hole into space). ]]
function Rift.new(parent, assets, name, opts)
	opts = opts or {}
	local self = setmetatable({}, Rift)
	self.parent = parent
	local folder = Instance.new("Folder")
	folder.Name = name
	self.folder = folder
	local model = assets.place("Rift", folder)
	self.model = model
	local parts = assets.pieces(model)
	self.parts = parts
	self.base = {}
	self.cframes = {}
	self.lastT = {}
	self.lastS = {}
	local idx = {}
	for i, p in ipairs(parts) do
		idx[p] = i
		self.base[i] = { cf = p.CFrame, size = p.Size, tr = p:GetAttribute("BaseTransparency") or p.Transparency }
		self.cframes[i] = p.CFrame
		self.lastS[i] = 1
		self.lastT[i] = -1
	end
	local function indices(style)
		local list = {}
		for _, p in ipairs(assets.pieces(model, style)) do
			table.insert(list, idx[p])
		end
		return list
	end
	self.cracks = indices("Crack")
	self.shards = indices("Shard")
	self.rims = indices("RiftEdge")
	self.views = indices("RiftView")
	self.role = {}
	for k, i in ipairs(self.cracks) do
		self.role[i] = { kind = "crack", k = k }
	end
	for k, i in ipairs(self.shards) do
		local rng = Random.new(1009 + k * 31)
		local pos = self.base[i].cf.Position
		local flat = Vector3.new(pos.X, 0, pos.Z)
		local a = rng:NextNumber(0, TAU)
		self.role[i] = {
			kind = "shard",
			dir = flat.Magnitude > 0.3 and flat.Unit or Vector3.new(math.cos(a), 0, math.sin(a)),
			dist = rng:NextNumber(9, 24),
			lift = rng:NextNumber(0.5, 5),
			axis = rng:NextUnitVector(),
			spin = rng:NextNumber(2.5, 7.5),
			fade = rng:NextNumber(0.4, 0.62),
		}
	end
	for _, i in ipairs(self.rims) do
		self.role[i] = { kind = "rim" }
	end
	for _, i in ipairs(self.views) do
		self.role[i] = { kind = "view" }
	end
	if opts.farSide then
		for _, i in ipairs(self.views) do
			local p = parts[i]
			for _, c in ipairs(p:GetChildren()) do
				if c:IsA("SurfaceAppearance") or c:IsA("Decal") then
					c:Destroy()
				end
			end
			if p:IsA("MeshPart") then
				pcall(function()
					p.TextureID = ""
				end)
			end
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromRGB(24, 10, 46)
		end
	end
	for _, p in ipairs(parts) do
		p.Transparency = 1
	end
	self.anchor = invisiblePart(folder, "Rift__FX")
	self.light = light(self.anchor, RIFT_LIGHT, 50)
	self.flashAt = attachment(self.anchor, "Flash")
	self.flash = emitter(self.flashAt, {
		Texture = TEX_SPARKLE,
		Color = ColorSequence.new(WHITE, RIFT_LIGHT),
		LightEmission = 1,
		Size = NumberSequence.new({ NSK(0, 2.6, 0.8), NSK(1, 0) }),
		Transparency = NumberSequence.new({ NSK(0, 0), NSK(1, 0.6) }),
		Lifetime = NumberRange.new(0.12, 0.28),
		Speed = NumberRange.new(0, 0.5),
		Rotation = NumberRange.new(0, 360),
		Brightness = 2,
	})
	self.revealed = {}
	self.shown = false
	self.scale = 1
	return self
end

function Rift:SetShown(shown)
	if shown ~= self.shown then
		self.shown = shown
		setParent(self.folder, shown and self.parent or nil)
	end
end

local function setTransparency(self, i, tr)
	if math.abs(tr - self.lastT[i]) > 0.004 or (tr >= 1) ~= (self.lastT[i] >= 1) then
		self.lastT[i] = tr
		self.parts[i].Transparency = tr
	end
end

-- cf: rift pivot (world), scale: track scale, crack/open: channels 0..1, t: cutscene time
function Rift:Update(cf, scale, crack, open, t)
	local S = math.max(scale or 1, 0.01)
	local parts, base, cframes, lastS = self.parts, self.base, self.cframes, self.lastS
	local nCracks = #self.cracks
	local frame = math.floor(t * 30)
	local openE = 1 - (1 - open) ^ 2.2 -- ease out: shards fly fast, then drift
	local rimS = 0.22 + 0.78 * smooth(open / 0.7)
	local viewS = smooth((open - 0.04) / 0.6)
	local crackFade = 1 - smooth(open / 0.35)
	local activity = 0
	for i, p in ipairs(parts) do
		local b = base[i]
		local role = self.role[i]
		local localCF, size, tr = b.cf, 1, 1
		local kind = role and role.kind
		if kind == "crack" then
			local k = role.k
			local r = (k - 1) / math.max(nCracks, 1) * 0.9
			local lvl = clamp01((crack - r) / 0.05)
			local fresh = 1 - clamp01((crack - r) / 0.18)
			local flick = hash(k, frame) > 0.45 and 1 or 0.2
			local vis = lvl * (1 - fresh * (1 - flick)) * crackFade
			tr = 1 - (1 - b.tr) * vis
			if lvl > 0 and lvl < 1 then
				activity = math.max(activity, fresh)
			end
			if lvl > 0 and not self.revealed[k] then
				self.revealed[k] = true
				if self.shown and crackFade > 0.5 then
					self.flashAt.Position = b.cf.Position * S
					self.flash:Emit(3)
				end
			elseif lvl <= 0 then
				self.revealed[k] = nil
			end
		elseif kind == "shard" then
			local glass = open > 0.001 and 1 or smooth((crack - 0.55) / 0.45) * 0.55
			local vis = glass * (1 - smooth((open - role.fade) / (1 - role.fade)))
			tr = 1 - (1 - b.tr) * vis
			if open > 0.001 then
				local pos = b.cf.Position + role.dir * (role.dist * openE) + Vector3.yAxis * (role.lift * openE)
				localCF = CFrame.new(pos) * CFrame.fromAxisAngle(role.axis, role.spin * open) * b.cf.Rotation
				size = 1 - 0.35 * open
			end
		elseif kind == "rim" then
			tr = open > 0.005 and b.tr or 1
			localCF = CFrame.new(b.cf.Position * rimS) * b.cf.Rotation
			size = rimS
		elseif kind == "view" then
			tr = viewS > 0.02 and b.tr or 1
			localCF = CFrame.new(b.cf.Position * viewS) * b.cf.Rotation
			size = math.max(viewS, 0.02)
		end
		setTransparency(self, i, tr)
		local s = size * S
		if math.abs(s - lastS[i]) > 1e-3 * math.max(s, 0.01) then
			lastS[i] = s
			local sz = b.size * s
			p.Size = Vector3.new(math.max(sz.X, 0.001), math.max(sz.Y, 0.001), math.max(sz.Z, 0.001))
		end
		if S ~= 1 then
			localCF = CFrame.new(localCF.Position * S) * localCF.Rotation
		end
		cframes[i] = cf * localCF
	end
	bulkMove(parts, cframes)
	self.model.WorldPivot = cf
	self.anchor.CFrame = cf
	local flicker = activity * (hash(frame, 3.7) > 0.6 and 1 or 0.25)
	setLight(self.light, 3 * smooth(open) + 2.5 * flicker, 46 * S)
end

function Rift:Destroy()
	self.folder:Destroy()
end

---------------------------------------------------------------------------------------- the sky
-- Builds the SkyAnchor contents. Returns the sky state used by SpaceStage:_updateSky.
local function buildSky(model, assets, starfield)
	local sky = {
		parts = {}, -- every part moved with the sky (one BulkMoveTo)
		offsets = {}, -- their sky-local CFrames
		cframes = {},
		stars = {},
		galaxies = {},
		nebulae = {},
	}
	local function add(p, offset)
		table.insert(sky.parts, p)
		table.insert(sky.offsets, offset)
		table.insert(sky.cframes, offset)
		return #sky.parts
	end
	local dome = assets.place("SpaceDome", model, Convert.ASSET_TURN)
	for _, p in ipairs(assets.pieces(dome)) do
		-- black Neon: unlit, so the low sun can't put a specular glint on the inside of the dome
		p.Material = Enum.Material.Neon
		p.Color = Color3.new(0, 0, 0)
		add(p, p.CFrame)
	end

	local tpl = Instance.new("Part")
	tpl.Shape = Enum.PartType.Ball
	tpl.Material = Enum.Material.Neon
	tpl.Anchored = true
	tpl.CanCollide = false
	tpl.CanTouch = false
	tpl.CanQuery = false
	tpl.CastShadow = false
	tpl.Massless = true
	tpl.TopSurface = Enum.SurfaceType.Smooth
	tpl.BottomSurface = Enum.SurfaceType.Smooth
	tpl.Transparency = 1

	local data = starfield or {}
	local stars = data.stars or {}
	local starFolder = Instance.new("Folder")
	starFolder.Name = "Stars"
	starFolder.Parent = model
	for k = 0, #stars // 9 - 1 do
		local o = k * 9
		local size = stars[o + 4]
		local d = math.max(size, STAR_MIN_D)
		local p = tpl:Clone()
		p.Name = "Star"
		p.Size = Vector3.new(d, d, d)
		local offset = CFrame.new(Convert.pos(stars[o + 1], stars[o + 2], stars[o + 3]))
		p.CFrame = offset
		p.Parent = starFolder
		add(p, offset)
		local dim = math.clamp(size / STAR_MIN_D, 0.4, 1)
		table.insert(sky.stars, {
			part = p,
			color = Color3.new(stars[o + 5] * dim, stars[o + 6] * dim, stars[o + 7] * dim),
			appear = stars[o + 8],
			phase = stars[o + 9],
			b = -1,
		})
	end

	for gi, g in ipairs(data.galaxies or {}) do
		local n = g.normal or { 0, 0, 1 }
		local Z = Vector3.new(n[1], n[2], n[3]).Unit
		local X
		if g.xaxis then
			X = Vector3.new(g.xaxis[1], g.xaxis[2], g.xaxis[3]).Unit
		else -- space.frame_axes
			local helper = math.abs(Z.Z) < 0.9 and Vector3.zAxis or Vector3.xAxis
			X = helper:Cross(Z).Unit
		end
		local Y = Z:Cross(X)
		local c = g.center or { 0, 0, 0 }
		local gal = {
			c = Convert.pos(c[1], c[2], c[3]),
			X = Convert.pos(X.X, X.Y, X.Z),
			Y = Convert.pos(Y.X, Y.Y, Y.Z),
			Z = Convert.pos(Z.X, Z.Y, Z.Z),
			twist = g.twist or 0,
			points = {},
		}
		local folder = Instance.new("Folder")
		folder.Name = "Galaxy_" .. gi
		folder.Parent = model
		local pts = g.points or {}
		for k = 0, #pts // 11 - 1 do
			local o = k * 11
			local col = Color3.new(pts[o + 8], pts[o + 9], pts[o + 10])
			local haze = math.max(col.R, col.G, col.B) < 0.42
			local d = math.max(pts[o + 7], 0.5)
			local p = tpl:Clone()
			p.Name = "GalaxyPoint"
			p.Size = Vector3.new(d, d, d)
			p.Color = haze and scaleColor(col, 1.6) or col
			p.Parent = folder
			local pt = {
				part = p,
				from = Vector3.new(pts[o + 1], pts[o + 2], pts[o + 3]),
				to = Vector3.new(pts[o + 4], pts[o + 5], pts[o + 6]),
				delay = pts[o + 11],
				base = haze and GALAXY_HAZE_TRANSPARENCY or GALAXY_POINT_TRANSPARENCY,
				u = -1,
			}
			pt.index = add(p, CFrame.new(gal.c))
			table.insert(gal.points, pt)
		end
		table.insert(sky.galaxies, gal)
	end

	for ni, nb in ipairs(data.nebulae or {}) do
		local c = nb.center or { 0, 0, 0 }
		local r = nb.radius or 150
		local col = nb.color or { 0.5, 0.3, 0.9 }
		local color = Color3.new(col[1], col[2], col[3])
		local offset = CFrame.new(Convert.pos(c[1], c[2], c[3]))
		local function anchorPart(name, radius)
			local anchor = Instance.new("Part")
			anchor.Name = name
			anchor.Shape = Enum.PartType.Ball
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanTouch = false
			anchor.CanQuery = false
			anchor.CastShadow = false
			anchor.Transparency = 1
			anchor.Size = Vector3.new(2 * radius, 2 * radius, 2 * radius)
			anchor.CFrame = offset
			anchor.Parent = model
			add(anchor, offset)
			return anchor
		end
		local common = {
			Texture = TEX_SMOKE,
			LightEmission = 1,
			LightInfluence = 0,
			Lifetime = NumberRange.new(20),
			Speed = NumberRange.new(0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-3, 3),
			LockedToPart = true,
			-- slowed down: the pre-warmed clouds outlive any hitch of the stage (~400 s)
			TimeScale = 0.05,
			Shape = Enum.ParticleEmitterShape.Sphere,
			ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
			Transparency = NumberSequence.new(1),
		}
		-- haze: puffs of diameter hazeD filling a cloud of radius ~r; core: brighter, smaller, central
		local hazeD = math.min(r * 0.9, PUFF_MAX)
		local hazeR = math.max(r - hazeD * 0.45, r * 0.3)
		local coreD = math.min(r * 0.5, PUFF_MAX * 0.7)
		local coreR = r * 0.35
		local hazeN = math.clamp(math.ceil(1.1 * (r / (hazeD / 2)) ^ 2), 6, 40)
		local coreN = math.clamp(math.ceil((coreR / (coreD / 2)) ^ 2), 3, 12)
		local hazePart = anchorPart("Nebula_" .. ni, hazeR)
		local corePart = anchorPart("Nebula_" .. ni .. "_Core", coreR)
		local haze = emitter(hazePart, common)
		haze.Name = "Haze"
		haze.Color = ColorSequence.new(color)
		haze.Size = NumberSequence.new({ NSK(0, hazeD, hazeD * 0.2), NSK(1, hazeD, hazeD * 0.2) })
		haze:SetAttribute("Prewarm", hazeN)
		local core = emitter(corePart, common)
		core.Name = "Core"
		core.Color = ColorSequence.new(color:Lerp(Color3.new(1, 0.92, 1), 0.35))
		core.Size = NumberSequence.new({ NSK(0, coreD, coreD * 0.2), NSK(1, coreD, coreD * 0.2) })
		core:SetAttribute("Prewarm", coreN)
		table.insert(sky.nebulae, {
			appear = nb.appear or 0,
			emitters = { { e = haze, count = hazeN, alpha = NEBULA_HAZE_ALPHA }, { e = core, count = coreN, alpha = NEBULA_CORE_ALPHA } },
			a = -1,
		})
	end
	tpl:Destroy()
	return sky
end

-- galaxy point positions for channel value g (sky-local offsets + brightness)
local function layoutGalaxies(sky, g)
	local offsets = sky.offsets
	for _, gal in ipairs(sky.galaxies) do
		local c, X, Y, Z, twist = gal.c, gal.X, gal.Y, gal.Z, gal.twist
		for _, pt in ipairs(gal.points) do
			local u = smooth((g - pt.delay) / GALAXY_SPAN)
			local f, to = pt.from, pt.to
			local x = f.X + (to.X - f.X) * u
			local y = f.Y + (to.Y - f.Y) * u
			local z = f.Z + (to.Z - f.Z) * u
			local phi = (1 - u) * twist
			local cs, sn = math.cos(phi), math.sin(phi)
			local xr, yr = x * cs - y * sn, x * sn + y * cs
			offsets[pt.index] = CFrame.new(c + X * xr + Y * yr + Z * z)
			if math.abs(u - pt.u) > 0.01 or (u <= 0) ~= (pt.u <= 0) or (u >= 1 and pt.u < 1) then
				pt.u = u
				pt.part.Transparency = u > 0.003 and 1 - (1 - pt.base) * u or 1
			end
		end
	end
end

---------------------------------------------------------------------------------------- the stage
function SpaceStage.new(ctx)
	local self = setmetatable({}, SpaceStage)
	self.ctx = ctx
	self.active = false
	local Assets = ctx.assets
	local tl = ctx.timeline
	local folder = Instance.new("Folder")
	folder.Name = "Space"
	self.folder = folder

	local skyModel = Instance.new("Model")
	skyModel.Name = "SkyAnchor"
	self.skyModel = skyModel
	self.sky = buildSky(skyModel, Assets, ctx.data.starfield)
	skyModel.WorldPivot = CFrame.new()
	skyModel.Parent = folder
	self.starfield = tl:track("Starfield")
	self.channels = { stars = -1, galaxies = -1, nebula = -1 }

	local function trackOf(name)
		local track = tl:track(name)
		if track and track.stage ~= "world" then
			return track
		end
		return nil
	end
	self.coreTrack = tl:track("SoulCore") -- space + world: this stage shows it while active
	if self.coreTrack then
		self.core = Core.new(folder, Assets, ctx.color, "SoulCore")
	end
	self.planetTrack = trackOf("Planet")
	if self.planetTrack then
		self.planet = Assets.place("ShatteredPlanet", folder)
		self.planet.Name = "Planet"
		self.planetMover = Assets.mover(self.planet)
		self.planetShown = true
	end
	self.riftTrack = trackOf("Rift")
	if self.riftTrack then
		self.rift = Rift.new(folder, Assets, "Rift")
	end

	-- dust motes streaming past the camera (world-space particles left behind as it falls)
	local motes = invisiblePart(folder, "DustMotes", Vector3.new(70, 50, 70))
	self.motes = emitter(motes, {
		Texture = TEX_SPARKLE,
		Color = ColorSequence.new(Color3.fromRGB(205, 220, 255)),
		LightEmission = 1,
		Size = NumberSequence.new({ NSK(0, 0), NSK(0.15, 0.22, 0.1), NSK(0.85, 0.22, 0.1), NSK(1, 0) }),
		Transparency = NumberSequence.new({ NSK(0, 0.35), NSK(1, 0.6) }),
		Lifetime = NumberRange.new(2, 3.5),
		Rate = 80,
		Speed = NumberRange.new(6, 9),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(8, 8),
		Rotation = NumberRange.new(0, 360),
	})
	self.motesPart = motes
	local spawn = tl:firstMarker("stage", "world")
	self.motesFrom = 1.5
	self.motesTo = spawn and spawn.t or tl.stageSwitch
	self.prewarmed = false
	folder.Parent = ctx.root
	return self
end

function SpaceStage:SetActive(active)
	if active and not self.active then
		self.prewarmed = false -- particles die with the folder leaving the workspace
		if self.core then
			self.core:Revive()
		end
	end
	self.active = active
	self.folder.Parent = active and self.ctx.root or nil
	if not active then
		self.motes.Enabled = false
	end
end

function SpaceStage:_updateSky(t)
	local ctx = self.ctx
	local sky = self.sky
	local sf = self.starfield
	local function ch(name)
		local v = sf and sf:channel(name, t)
		return v == nil and 1 or v
	end
	local starsCh, galCh, nebCh, twinkle = ch("stars"), ch("galaxies"), ch("nebula"), ch("twinkle")

	if math.abs(galCh - self.channels.galaxies) > 1e-5 then
		self.channels.galaxies = galCh
		layoutGalaxies(sky, galCh)
	end
	-- re-pivot onto the camera: the sky never parallaxes (DESIGN §2 SkyAnchor)
	local skyCF = CFrame.new(ctx.cameraCF.Position) * ctx.origins.space.Rotation
	local parts, offsets, cframes = sky.parts, sky.offsets, sky.cframes
	for i = 1, #parts do
		cframes[i] = skyCF * offsets[i]
	end
	bulkMove(parts, cframes)
	self.skyModel.WorldPivot = skyCF

	for _, s in ipairs(sky.stars) do
		local fade = clamp01((starsCh - s.appear) / STAR_FADE)
		local b = 0
		if fade > 0 then
			b = fade * (1 - TWINKLE_DEPTH * twinkle * (0.5 + 0.5 * math.sin(TWINKLE_SPEED * t + s.phase)))
		end
		local last = s.b
		if math.abs(b - last) > STAR_WRITE_STEP or (b <= 0.004) ~= (last <= 0.004) or (b >= fade - 1e-4 and math.abs(b - last) > 0.002) then
			s.b = b
			local p = s.part
			if b > 0.004 then
				p.Color = scaleColor(s.color, b)
				if last <= 0.004 then
					p.Transparency = 0
				end
			else
				p.Transparency = 1
			end
		end
	end

	if not self.prewarmed then
		-- the clouds exist from the start (invisible), so they never pop in
		self.prewarmed = true
		for _, nb in ipairs(sky.nebulae) do
			for _, spec in ipairs(nb.emitters) do
				spec.e:Emit(spec.count)
			end
		end
	end
	if math.abs(nebCh - self.channels.nebula) > 1e-4 then
		self.channels.nebula = nebCh
		for _, nb in ipairs(sky.nebulae) do
			local a = smooth((nebCh - nb.appear) / NEBULA_FADE)
			if math.abs(a - nb.a) > 0.005 or (a <= 0) ~= (nb.a <= 0) then
				nb.a = a
				for _, spec in ipairs(nb.emitters) do
					spec.e.Transparency = NumberSequence.new(1 - a * spec.alpha)
				end
			end
		end
	end
end

function SpaceStage:Update(t, dt)
	local ctx = self.ctx
	local tl = ctx.timeline
	local origin = ctx.origins.space
	self:_updateSky(t)

	if self.core then
		local track = self.coreTrack
		local vel = velocity(tl, track, origin, t)
		local s = track:sample(t)
		local shown = present(track, s, t)
		self.core:SetShown(shown)
		if shown then
			self.core:Update(Convert.assetCF(origin, s.pos, s.rot), s.scale, s.channels, vel)
		end
	end

	if self.planet then
		local track = self.planetTrack
		local s = track:sample(t)
		local shown = present(track, s, t) and s.scale > 1e-3
		if shown ~= self.planetShown then
			self.planetShown = shown
			self.planet.Parent = shown and self.folder or nil
		end
		if shown then
			self.planetMover:MoveTo(Convert.assetCF(ctx.origin(track.stage, t), s.pos, s.rot), s.scale)
		end
	end

	if self.rift then
		local track = self.riftTrack
		local s = track:sample(t)
		local ch = s.channels
		local shown = present(track, s, t) and s.scale > 1e-3
		self.rift:SetShown(shown)
		if shown then
			self.rift:Update(Convert.assetCF(ctx.origin(track.stage, t), s.pos, s.rot), s.scale, ch.crack or 0, ch.open or 0, t)
		end
	end

	-- dust motes: an emission box around the camera; the specks stay in the world, so the fall
	-- makes them stream upward. Their own speed tops the relative speed up to ~10 studs/s.
	local camPos = ctx.cameraCF.Position
	local on = t >= self.motesFrom and t < self.motesTo
	if self.motes.Enabled ~= on then
		self.motes.Enabled = on
	end
	if on then
		local fall = 0
		if self.lastCam and dt and dt > 1e-4 then
			fall = math.clamp((self.lastCam.Y - camPos.Y) / dt, 0, 200)
		end
		local up = math.max(1, 10 - fall)
		self.motes.Speed = NumberRange.new(up * 0.7, up * 1.1)
	end
	self.lastCam = camPos
	self.motesPart.CFrame = CFrame.new(camPos - Vector3.new(0, 18, 0))
end

function SpaceStage:OnMarker(kind, _args, _t)
	if kind == "cut" and self.core then
		self.core:ClearTrail()
	end
end

function SpaceStage:Destroy()
	self.folder:Destroy()
end

return SpaceStage
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000001F">
			<Properties>
				<string name="Name">Timeline</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Timeline
	Samples the baked tracks of IntroData at any time t (docs/intro/DESIGN.md §8).
	Pure Luau: no Roblox types, plain numbers in Blender coordinates. Convert
	turns samples into CFrames.

	    local tl = Timeline.new(IntroData)
	    local cam = tl:track("Camera")            -- Track or nil
	    local s = cam:sample(t)                    -- reused table, copy what you keep
	    s.pos      -- { x, y, z }     Blender stage coordinates (Catmull-Rom)
	    s.rot      -- { w, x, y, z }  unit quaternion, Blender world rotation (slerp)
	    s.scale    -- number (1 when the track has no scale)
	    s.channels -- { name = value } (linear; step for visible/held/is*)
	    s.t        -- the time sampled
	    cam:channel("fov", t)                      -- one channel, no table writes
	    cam:has("fov"), cam.stage, cam.t0, cam.t1 -- first / last sample time

	    local c = tl:character(t)                  -- nil when the data has no character
	    c.root.pos, c.root.rot                     -- HumanoidRootPart (like a track sample)
	    c.joints.Waist                             -- { w, x, y, z } joint-space quaternion (§4.2)
	    c.rootLoc                                  -- { x, y, z } Root bone location (joint space)
	    c.channels.visible, c.channels.form
	    tl:characterTrack()                        -- the sampler itself (t0, t1, n, ...)

	    tl:stageAt(t)            -> "space" | "world"   (world from stageSwitch on)
	    tl:cutBetween(a, b)      -> first cut time c with a < c <= b, or nil
	    tl.markers               -- { { t, name, kind, args = {...} } } sorted by t
	    tl:markersOf(kind)       -> list of those markers
	    tl:firstMarker(kind, arg1?) -> marker or nil
	    local cur = tl:cursor()
	    cur:advance(t, function(m) ... end)   -- fires every marker with m.t <= t once, in order
	    Timeline.parseMarker("shake:0.4:1.6") -> "shake", { 0.4, 1.6 }

	Sampling rules: i = (t - t0) * rate, clamped to [0, n - 1]; positions use a
	centripetal Catmull-Rom spline over samples i-1 .. i+2 (a neighbour missing
	at a track end or a cut is extrapolated from the samples on t's side),
	rotations slerp between i and i+1 (shortest arc), scalars
	are linear, step channels take sample floor(i). When a cut lies in
	(time(i), time(i+1)] the sample on t's side of the cut is used as is, and
	the spline never reaches across a cut for its outer neighbours either.

	Every sample call reuses the same output tables: no allocation per frame.
]]

local Timeline = {}
Timeline.__index = Timeline

local EPS = 1e-6
local floor = math.floor
local sqrt = math.sqrt
local acos = math.acos
local sin = math.sin

local JOINT_NAMES = {
	"Root",
	"Waist",
	"Neck",
	"LeftShoulder",
	"LeftElbow",
	"LeftWrist",
	"RightShoulder",
	"RightElbow",
	"RightWrist",
	"LeftHip",
	"LeftKnee",
	"LeftAnkle",
	"RightHip",
	"RightKnee",
	"RightAnkle",
}
Timeline.JOINT_NAMES = JOINT_NAMES

-- Channels that hold their value until the next sample (DESIGN §8).
local function isStep(name)
	return name == "visible" or name == "held" or string.sub(name, 1, 2) == "is"
end
Timeline.isStep = isStep

-- "kind:arg1:arg2" -> kind, { args } (numbers converted)
function Timeline.parseMarker(name)
	local parts = string.split(name, ":")
	local kind = parts[1] or ""
	local args = {}
	for k = 2, #parts do
		local v = parts[k]
		args[k - 1] = tonumber(v) or v
	end
	return kind, args
end

-- first cut c with a < c <= b (both with a small tolerance), or nil
local function cutIn(cuts, a, b)
	for k = 1, #cuts do
		local c = cuts[k]
		if c > a + EPS and c <= b + EPS then
			return c
		end
		if c > b + EPS then
			return nil
		end
	end
	return nil
end

--[[ Locate t on a sampler's grid. Returns
	i      lower sample index (0-based)
	f      fraction towards i + 1 (0 when held by a clamp or a cut)
	hasP   sample i - 1 may be used as the spline's first neighbour
	hasN   sample i + 2 may be used as the spline's last neighbour
]]
local function locate(s, t)
	local n = s.n
	if n <= 1 then
		return 0, 0, false, false
	end
	local rate, t0 = s.rate, s.t0
	local fi = (t - t0) * rate
	if fi <= 0 then
		return 0, 0, false, false
	end
	if fi >= n - 1 then
		return n - 1, 0, false, false
	end
	local i = floor(fi)
	local f = fi - i
	if f > 1 - 1e-7 then
		i += 1
		f = 0
		if i >= n - 1 then
			return n - 1, 0, false, false
		end
	end
	local cuts = s.cuts
	if #cuts > 0 then
		local ta = t0 + i / rate
		local tb = t0 + (i + 1) / rate
		local c = cutIn(cuts, ta, tb)
		if c then
			if t < c - EPS then
				return i, 0, false, false
			end
			return i + 1, 0, false, false
		end
		local hasP = i >= 1 and cutIn(cuts, t0 + (i - 1) / rate, ta) == nil
		local hasN = i + 2 <= n - 1 and cutIn(cuts, tb, t0 + (i + 2) / rate) == nil
		return i, f, hasP, hasN
	end
	return i, f, i >= 1, i + 2 <= n - 1
end
Timeline._locate = locate

-- Centripetal Catmull-Rom of the flat xyz array P between samples i and i + 1, into out.
local function splinePos(P: { number }, i: number, f: number, hasP: boolean, hasN: boolean, out: { number })
	local b = i * 3
	local bx, by, bz = P[b + 1], P[b + 2], P[b + 3]
	if f == 0 then
		out[1], out[2], out[3] = bx, by, bz
		return
	end
	local cx, cy, cz = P[b + 4], P[b + 5], P[b + 6]
	-- a missing outer neighbour (track end, cut) is extrapolated: quadratically through the
	-- three samples on this side when there are three, else mirrored
	local ax, ay, az, dx, dy, dz
	if hasP then
		ax, ay, az = P[b - 2], P[b - 1], P[b]
	elseif hasN then
		ax, ay, az = 3 * bx - 3 * cx + P[b + 7], 3 * by - 3 * cy + P[b + 8], 3 * bz - 3 * cz + P[b + 9]
	else
		ax, ay, az = 2 * bx - cx, 2 * by - cy, 2 * bz - cz
	end
	if hasN then
		dx, dy, dz = P[b + 7], P[b + 8], P[b + 9]
	elseif hasP then
		dx, dy, dz = 3 * cx - 3 * bx + ax, 3 * cy - 3 * by + ay, 3 * cz - 3 * bz + az
	else
		dx, dy, dz = 2 * cx - bx, 2 * cy - by, 2 * cz - bz
	end
	-- knot intervals: |segment| ^ 0.5
	local d12 = sqrt(sqrt((cx - bx) ^ 2 + (cy - by) ^ 2 + (cz - bz) ^ 2))
	if d12 < 1e-4 then
		out[1], out[2], out[3] = bx + (cx - bx) * f, by + (cy - by) * f, bz + (cz - bz) * f
		return
	end
	local d01 = sqrt(sqrt((bx - ax) ^ 2 + (by - ay) ^ 2 + (bz - az) ^ 2))
	local d23 = sqrt(sqrt((dx - cx) ^ 2 + (dy - cy) ^ 2 + (dz - cz) ^ 2))
	if d01 < 1e-4 then
		d01 = d12
	end
	if d23 < 1e-4 then
		d23 = d12
	end
	local t1 = d01
	local t2 = t1 + d12
	local t3 = t2 + d23
	local u = t1 + f * d12
	-- Barry-Goldman pyramid, expanded into four weights
	local a1a, a1b = (t1 - u) / t1, u / t1
	local a2b, a2c = (t2 - u) / d12, (u - t1) / d12
	local a3c, a3d = (t3 - u) / d23, (u - t2) / d23
	local b1, b1p = (t2 - u) / t2, u / t2
	local b2, b2p = (t3 - u) / (t3 - t1), (u - t1) / (t3 - t1)
	local c, cp = (t2 - u) / d12, (u - t1) / d12
	local wA = c * b1 * a1a
	local wB = c * (b1 * a1b + b1p * a2b) + cp * b2 * a2b
	local wC = c * b1p * a2c + cp * (b2 * a2c + b2p * a3c)
	local wD = cp * b2p * a3d
	out[1] = wA * ax + wB * bx + wC * cx + wD * dx
	out[2] = wA * ay + wB * by + wC * cy + wD * dy
	out[3] = wA * az + wB * bz + wC * cz + wD * dz
end

-- Linear interpolation of the flat xyz array P (used for the Root bone location).
local function lerpPos(P: { number }, i: number, f: number, out: { number })
	local b = i * 3
	if f == 0 then
		out[1], out[2], out[3] = P[b + 1], P[b + 2], P[b + 3]
		return
	end
	out[1] = P[b + 1] + (P[b + 4] - P[b + 1]) * f
	out[2] = P[b + 2] + (P[b + 5] - P[b + 2]) * f
	out[3] = P[b + 3] + (P[b + 6] - P[b + 3]) * f
end

-- Shortest-arc slerp of the flat wxyz array R between samples i and i + 1, normalised, into out.
local function slerpRot(R: { number }, i: number, f: number, out: { number })
	local b = i * 4
	local w1, x1, y1, z1 = R[b + 1], R[b + 2], R[b + 3], R[b + 4]
	local w, x, y, z
	if f == 0 then
		w, x, y, z = w1, x1, y1, z1
	else
		local w2, x2, y2, z2 = R[b + 5], R[b + 6], R[b + 7], R[b + 8]
		local dot = w1 * w2 + x1 * x2 + y1 * y2 + z1 * z2
		if dot < 0 then
			w2, x2, y2, z2 = -w2, -x2, -y2, -z2
			dot = -dot
		end
		local k1, k2
		if dot > 0.9995 then
			k1, k2 = 1 - f, f
		else
			local theta = acos(dot)
			local s = sin(theta)
			k1 = sin((1 - f) * theta) / s
			k2 = sin(f * theta) / s
		end
		w = w1 * k1 + w2 * k2
		x = x1 * k1 + x2 * k2
		y = y1 * k1 + y2 * k2
		z = z1 * k1 + z2 * k2
	end
	local len = sqrt(w * w + x * x + y * y + z * z)
	if len < 1e-9 then
		out[1], out[2], out[3], out[4] = 1, 0, 0, 0
		return
	end
	out[1], out[2], out[3], out[4] = w / len, x / len, y / len, z / len
end

local function scalarAt(V: { number }, i: number, f: number, step: boolean?): number
	local a = V[i + 1]
	if step or f == 0 then
		return a
	end
	return a + (V[i + 2] - a) * f
end

local function channelSetup(sampler, channels)
	sampler.channelData = channels or {}
	sampler.stepChannel = {}
	sampler.channelNames = {}
	for name in pairs(sampler.channelData) do
		table.insert(sampler.channelNames, name)
		sampler.stepChannel[name] = isStep(name)
	end
	table.sort(sampler.channelNames)
end

local function fillChannels(sampler, i, f, out)
	local data, step = sampler.channelData, sampler.stepChannel
	local names = sampler.channelNames
	for k = 1, #names do
		local name = names[k]
		out[name] = scalarAt(data[name], i, f, step[name])
	end
end

local function sampleCount(d, fallback)
	if d.n then
		return d.n
	end
	if d.pos then
		return #d.pos // 3
	end
	return fallback
end

-- Track ---------------------------------------------------------------------------------------------
local Track = {}
Track.__index = Track
Timeline.Track = Track

function Track.new(name, d, fps, cuts)
	local self = setmetatable({}, Track)
	self.name = name
	self.stage = d.stage or "world"
	self.rate = d.rate or fps
	self.t0 = d.t0 or 0
	self.n = sampleCount(d, 1)
	self.t1 = self.t0 + (self.n - 1) / self.rate
	self.posData = d.pos
	self.rotData = d.rot
	self.scaleData = d.scale
	self.cuts = cuts
	channelSetup(self, d.channels)
	self.out = { pos = { 0, 0, 0 }, rot = { 1, 0, 0, 0 }, scale = 1, channels = {}, t = 0 }
	return self
end

function Track:has(channel)
	return self.channelData[channel] ~= nil
end

function Track:sample(t)
	local out = self.out
	local i, f, hasP, hasN = locate(self, t)
	out.t = t
	if self.posData then
		splinePos(self.posData, i, f, hasP, hasN, out.pos)
	end
	if self.rotData then
		slerpRot(self.rotData, i, f, out.rot)
	end
	out.scale = self.scaleData and scalarAt(self.scaleData, i, f, false) or 1
	fillChannels(self, i, f, out.channels)
	return out
end

-- One channel's value at t (nil if the track has no such channel).
function Track:channel(name, t)
	local data = self.channelData[name]
	if not data then
		return nil
	end
	local i, f = locate(self, t)
	return scalarAt(data, i, f, self.stepChannel[name])
end

-- Character -----------------------------------------------------------------------------------------
local Character = {}
Character.__index = Character
Timeline.Character = Character

function Character.new(d, fps, cuts)
	local self = setmetatable({}, Character)
	self.rate = d.rate or fps
	self.t0 = d.t0 or 0
	local root = d.root or {}
	self.n = d.n or (root.pos and #root.pos // 3) or 1
	self.t1 = self.t0 + (self.n - 1) / self.rate
	self.posData = root.pos
	self.rotData = root.rot
	self.rootLocData = d.rootLoc
	self.cuts = cuts
	self.jointData = d.joints or {}
	self.jointNames = {}
	for _, name in ipairs(JOINT_NAMES) do
		if self.jointData[name] then
			table.insert(self.jointNames, name)
		end
	end
	for name in pairs(self.jointData) do
		if not table.find(self.jointNames, name) then
			table.insert(self.jointNames, name)
		end
	end
	channelSetup(self, d.channels)
	local joints = {}
	for _, name in ipairs(self.jointNames) do
		joints[name] = { 1, 0, 0, 0 }
	end
	self.out = {
		root = { pos = { 0, 0, 0 }, rot = { 1, 0, 0, 0 } },
		joints = joints,
		rootLoc = { 0, 0, 0 },
		channels = {},
		t = 0,
		t0 = self.t0,
		t1 = self.t1,
	}
	return self
end

function Character:sample(t)
	local out = self.out
	local i, f, hasP, hasN = locate(self, t)
	out.t = t
	if self.posData then
		splinePos(self.posData, i, f, hasP, hasN, out.root.pos)
	end
	if self.rotData then
		slerpRot(self.rotData, i, f, out.root.rot)
	end
	local names, data, joints = self.jointNames, self.jointData, out.joints
	for k = 1, #names do
		local name = names[k]
		slerpRot(data[name], i, f, joints[name])
	end
	if self.rootLocData then
		lerpPos(self.rootLocData, i, f, out.rootLoc)
	end
	fillChannels(self, i, f, out.channels)
	return out
end

function Character:channel(name, t)
	local data = self.channelData[name]
	if not data then
		return nil
	end
	local i, f = locate(self, t)
	return scalarAt(data, i, f, self.stepChannel[name])
end

-- Marker cursor -------------------------------------------------------------------------------------
local Cursor = {}
Cursor.__index = Cursor

-- Fire fn(marker) for every marker with marker.t <= t not fired yet, in order. Returns the count.
function Cursor:advance(t, fn)
	local markers = self.markers
	local count = 0
	while self.index <= #markers do
		local m = markers[self.index]
		if m.t > t + EPS then
			break
		end
		self.index += 1 -- before fn: a marker never fires twice, even if fn errors
		count += 1
		fn(m)
	end
	return count
end

-- The next marker that has not fired, or nil.
function Cursor:peek()
	return self.markers[self.index]
end

-- Rewind so that the next advance fires markers after time t (nil = from the start).
function Cursor:reset(t)
	self.index = 1
	if t then
		while self.index <= #self.markers and self.markers[self.index].t <= t + EPS do
			self.index += 1
		end
	end
end

-- Timeline ------------------------------------------------------------------------------------------
function Timeline.new(data)
	assert(type(data) == "table", "Timeline.new needs the IntroData table")
	local self = setmetatable({}, Timeline)
	self.data = data
	self.fps = data.fps or 30
	self.duration = data.duration or 0
	self.stageSwitch = data.stageSwitch or math.huge
	local cuts = {}
	for _, c in ipairs(data.cuts or {}) do
		table.insert(cuts, c)
	end
	table.sort(cuts)
	self.cuts = cuts
	local markers = {}
	for k, m in ipairs(data.markers or {}) do
		local kind, args = Timeline.parseMarker(m.name)
		table.insert(markers, { t = m.t, name = m.name, kind = kind, args = args, order = k })
	end
	table.sort(markers, function(a, b)
		if a.t ~= b.t then
			return a.t < b.t
		end
		return a.order < b.order
	end)
	self.markers = markers
	self.tracks = {}
	for name, d in pairs(data.tracks or {}) do
		self.tracks[name] = Track.new(name, d, self.fps, cuts)
	end
	if data.character then
		self.characterSampler = Character.new(data.character, self.fps, cuts)
	end
	return self
end

function Timeline:track(name)
	return self.tracks[name]
end

function Timeline:trackNames()
	local names = {}
	for name in pairs(self.tracks) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function Timeline:characterTrack()
	return self.characterSampler
end

function Timeline:character(t)
	local c = self.characterSampler
	return c and c:sample(t) or nil
end

function Timeline:stageAt(t)
	if t >= self.stageSwitch - EPS then
		return "world"
	end
	return "space"
end

function Timeline:cutBetween(a, b)
	return cutIn(self.cuts, a, b)
end

function Timeline:markersOf(kind)
	local list = {}
	for _, m in ipairs(self.markers) do
		if m.kind == kind then
			table.insert(list, m)
		end
	end
	return list
end

function Timeline:firstMarker(kind, arg1)
	for _, m in ipairs(self.markers) do
		if m.kind == kind and (arg1 == nil or m.args[1] == arg1) then
			return m
		end
	end
	return nil
end

function Timeline:cursor()
	return setmetatable({ markers = self.markers, index = 1 }, Cursor)
end

return Timeline
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000020">
			<Properties>
				<string name="Name">WorldStage</string>
				<ProtectedString name="Source"><![CDATA[--[[
	WorldStage  (stage "world", docs/intro/DESIGN.md §1 W1-W8, §3, §7.2, §7.3)
	Everything above and on Sylverune, built at ctx.origins.world (read every frame: the landing
	point may be refined right before this stage starts):

	  SkyRift     the Rift asset high in the sky, opening downward (SpaceStage.Rift, far side: the
	              view is a dark violet hole into space instead of the forest picture)
	  SoulCore    the world part of the core (SpaceStage.Core: glow, pulse, comet tail) until the
	              morph; the `morph` marker condenses light into the character (sparkles flying in,
	              a burst + light flash at the end)
	  Sword       ResonanceSword: `resonance` blends the Crystal pieces from colourless glass to
	              Neon soul colour (Assets.setResonance), `glow` -> light + outline, `held` -> the
	              pivot sits in the character's right hand (CharacterRig:GripCF, every frame);
	              registered as an impact-frame silhouette; `resonate` -> burst of sparkles;
	              a glowing wake (Trail) while surfing and sparks while braking
	  Blast       glow-explosion sphere (Neon balls in the soul colour, `opacity`, diameter = 2 x scale)
	  SlashArc    the swing's crescent (`opacity`)
	  Shockwave   the ring (uniform scale = radius, `opacity`, white -> soul colour as it fades) and a
	              dust wall racing outward along the ground with it (emitters on the ring, ground
	              found by raycasts) + a dust burst at the stop (`shockwave` marker)
	  Streaks     3D speed streaks flowing past the character during the dive (speedlines window)
	  Wind        trees bend away from the landing point (§7.3, exactly; every pivot saved and
	              restored exactly), workspace.GlobalWind gust (saved and restored)

	Everything this stage makes lives in one folder under ctx.root; every property it changes on
	map instances (tree part CFrames, model WorldPivots, workspace.GlobalWind) is put back exactly
	when the wind has passed, on SetActive(false) and in Destroy().
	Stage interface: see init.luau.
]]

local Convert = require(script.Parent.Convert)
local SpaceStage = require(script.Parent.SpaceStage)

local util = SpaceStage.util
local clamp01, hash = util.clamp01, util.hash
local present, velocity = util.present, util.velocity
local invisiblePart, attachment, emitter = util.invisiblePart, util.attachment, util.emitter
local light, setLight, setParent = util.light, util.setLight, util.setParent
local TEX_SMOKE, TEX_SPARKLE = util.TEX_SMOKE, util.TEX_SPARKLE
local TEX_SPARKS = "rbxasset://textures/particles/fire_sparks_main.dds" -- built-in (Fire's sparks)

local WorldStage = {}
WorldStage.__index = WorldStage

local WHITE = Color3.new(1, 1, 1)
local TAU = math.pi * 2
local NSK = NumberSequenceKeypoint.new
local CSK = ColorSequenceKeypoint.new

-- §7.3 shockwave wind
local WIND_SPEED = 160 -- studs/s, the wave front
local WIND_SETTLE = 4.5 -- tau after which a tree is back at rest (restored exactly)
local function windF(tau)
	if tau < 0 then
		return 0
	end
	return (1 - math.exp(-tau / 0.12)) * math.exp(-tau / 1.1) * math.cos(TAU * tau / 1.6)
end
local function windA(d)
	return 0.42 * math.clamp(1 - d / 340, 0.15, 1)
end
WorldStage.windF = windF
WorldStage.windA = windA

local GUST = 55 -- studs/s added to workspace.GlobalWind at the peak (grass flattening)
local GUST_END = 5.5 -- seconds after the wind marker the gust is over (GlobalWind restored)
local BRAKE_TIME = 2.0 -- the brake ends at the shockwave marker (DESIGN §1: 33.0-35.0)
local MORPH_CONDENSE = 0.6 -- morph marker -> burst (DESIGN §1: morph 20.3, flash 20.9)
local DUST_EMITTERS = 32 -- each one hops around its sector of the ring every frame
local DUST_SECTORS = 96 -- ground heights are raycast once per (sector, 8-stud radius step)
local STREAKS = 18
local STREAK_SPAN = 70 -- studs of streak field along the travel direction

---------------------------------------------------------------------------------------- helpers
-- CFrame at pos whose UpVector is up (any right vector).
local function frameUp(pos, up)
	local helper = math.abs(up.Y) < 0.95 and Vector3.yAxis or Vector3.xAxis
	local right = helper:Cross(up).Unit
	return CFrame.fromMatrix(pos, right, up, right:Cross(up))
end

-- Linear position of a baked sampler (Track or the character sampler) at t, Blender coordinates
-- -> Roblox stage-local Vector3. No table writes (safe to call between other samples).
local function samplerPos(s, t)
	local P = s.posData
	if not P then
		return Vector3.zero
	end
	local n = s.n
	local fi = math.clamp((t - s.t0) * s.rate, 0, math.max(n - 1, 0))
	local i = math.floor(fi)
	local f = fi - i
	if i >= n - 1 then
		i, f = n - 1, 0
	end
	local b = i * 3
	local x, y, z = P[b + 1], P[b + 2], P[b + 3]
	if f > 0 then
		x += (P[b + 4] - x) * f
		y += (P[b + 5] - y) * f
		z += (P[b + 6] - z) * f
	end
	return Convert.pos(x, y, z)
end

-- World velocity of a sampler at t (one-sided at cuts).
local function samplerVel(tl, s, origin, t)
	local h = 1 / 30
	local a, b = t - h, t
	if tl:cutBetween(a, b) then
		a, b = t, t + h
	end
	return origin:VectorToWorldSpace((samplerPos(s, b) - samplerPos(s, a)) / (b - a))
end

local function window(t, t0, t1, fadeIn, fadeOut)
	if not t0 or not t1 or t < t0 or t > t1 then
		return 0
	end
	return clamp01((t - t0) / fadeIn) * clamp01((t1 - t) / fadeOut)
end

local function setEnabled(inst, on)
	if inst.Enabled ~= on then
		inst.Enabled = on
	end
end

local function moveParts(parts, cframes)
	if #parts == 0 then
		return
	end
	local ok = pcall(function()
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i, p in ipairs(parts) do
			pcall(function()
				p.CFrame = cframes[i]
			end)
		end
	end
end

local function isTreePiece(name)
	return string.find(name, "Trunk", 1, true) ~= nil or string.find(name, "Bark", 1, true) ~= nil
end

---------------------------------------------------------------------------------------- the sword
local Sword = {}
Sword.__index = Sword

local CRYSTAL_PALE = Color3.fromRGB(225, 235, 245)

function Sword.new(parent, ctx)
	local self = setmetatable({}, Sword)
	local Assets = ctx.assets
	self.ctx = ctx
	self.color = ctx.color
	local model = Assets.place("ResonanceSword", parent)
	model.Name = "Sword"
	self.model = model
	Assets.setResonance(model, ctx.color, 0)
	self.resonance = 0
	self.mover = Assets.mover(model)
	ctx.screen:AddSilhouette("sword", model)

	-- blade extent along the sword's +Y (asset-local, pivot = grip centre)
	local tip, base = 0, math.huge
	local pivot = model:GetPivot()
	for _, p in ipairs(Assets.pieces(model, "Blade")) do
		local o = pivot:ToObjectSpace(p.CFrame)
		local half = 0.5 * (math.abs(o.XVector.Y) * p.Size.X + math.abs(o.YVector.Y) * p.Size.Y + math.abs(o.ZVector.Y) * p.Size.Z)
		tip = math.max(tip, o.Position.Y + half)
		base = math.min(base, o.Position.Y - half)
	end
	if tip <= 0 then
		tip, base = 4.5, 0.65
	end
	base = math.clamp(base, 0.3, tip * 0.5)
	self.tip, self.base = tip, base

	local fx = invisiblePart(parent, "Sword__FX")
	self.fx = fx
	self.tipAt = attachment(fx, "Tip", Vector3.new(0, tip - 0.25, 0))
	self.baseAt = attachment(fx, "Base", Vector3.new(0, base + 0.2, 0))
	self.midAt = attachment(fx, "Mid", Vector3.new(0, (tip + base) / 2, 0))
	self.light = light(fx, CRYSTAL_PALE, 12)

	local wake = Instance.new("Trail")
	wake.Name = "Wake"
	wake.Attachment0 = self.tipAt
	wake.Attachment1 = self.baseAt
	wake.LightEmission = 1
	wake.LightInfluence = 0
	wake.Color = ColorSequence.new(ctx.color:Lerp(WHITE, 0.45), ctx.color)
	wake.Transparency = NumberSequence.new({ NSK(0, 0.25), NSK(0.6, 0.75), NSK(1, 1) })
	wake.Lifetime = 0.35
	wake.MinLength = 0.05
	wake.Enabled = false
	wake.Parent = fx
	self.wake = wake

	self.burst = emitter(self.midAt, {
		Texture = TEX_SPARKLE,
		Color = ColorSequence.new(ctx.color:Lerp(WHITE, 0.7), ctx.color),
		LightEmission = 1,
		Size = NumberSequence.new({ NSK(0, 0.7, 0.25), NSK(1, 0) }),
		Transparency = NumberSequence.new({ NSK(0, 0), NSK(0.6, 0.2), NSK(1, 1) }),
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(10, 26),
		Drag = 3,
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-200, 200),
	})

	-- sparks while braking: a tiny part whose +Y is the spray direction
	local sparkPart = invisiblePart(parent, "Sword__Sparks", Vector3.new(0.3, 0.3, 0.3))
	self.sparkPart = sparkPart
	self.sparks = emitter(sparkPart, {
		Texture = TEX_SPARKS,
		Color = ColorSequence.new({ CSK(0, WHITE), CSK(0.35, ctx.color:Lerp(WHITE, 0.5)), CSK(1, ctx.color) }),
		LightEmission = 1,
		Size = NumberSequence.new({ NSK(0, 0.32, 0.1), NSK(1, 0) }),
		Squash = NumberSequence.new(2.2),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Transparency = NumberSequence.new({ NSK(0, 0), NSK(0.7, 0.15), NSK(1, 1) }),
		Lifetime = NumberRange.new(0.25, 0.65),
		Speed = NumberRange.new(22, 46),
		SpreadAngle = Vector2.new(26, 26),
		Acceleration = Vector3.new(0, -55, 0),
		Drag = 2,
		EmissionDirection = Enum.NormalId.Top,
		Brightness = 2,
	})

	local hl = Instance.new("Highlight")
	hl.Name = "SwordGlow"
	hl.Adornee = model
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.Enabled = false
	hl.Parent = fx
	self.highlight = hl

	self.shown = true
	self.last = {}
	return self
end

function Sword:SetShown(shown, parent)
	if shown == self.shown then
		return
	end
	self.shown = shown
	setParent(self.model, shown and parent or nil)
	if not shown then
		self.wake.Enabled = false
		self.sparks.Enabled = false
		self.highlight.Enabled = false
		setLight(self.light, 0)
	end
end

-- cf: pivot (world), scale: track scale, ch: channels; extra: { flash = 0..1 light spike,
-- wake = bool, sparks = rate, sparkDir = world direction of the spray }
function Sword:Update(cf, scale, ch, extra)
	local Assets = self.ctx.assets
	self.mover:MoveTo(cf, math.max(scale or 1, 0.01))
	self.fx.CFrame = cf
	local r = clamp01(ch.resonance or self.resonance)
	if math.abs(r - self.resonance) > 0.004 or (r >= 1 and self.resonance < 1) or (r <= 0 and self.resonance > 0) then
		self.resonance = r
		Assets.setResonance(self.model, self.color, r)
	end
	local glow = math.max(ch.glow or 0, 0)
	local flash = extra.flash or 0
	local glowColor = CRYSTAL_PALE:Lerp(self.color, r)
	local last = self.last
	if last.glow == nil or math.abs(glow - last.glow) > 0.01 or math.abs(r - last.r) > 0.01 or flash > 0 or last.flash > 0 then
		last.glow, last.r, last.flash = glow, r, flash
		local level = clamp01(glow / 3)
		setLight(self.light, 1.3 * glow + 6 * flash, 8 + 6 * math.min(glow, 3) + 20 * flash)
		self.light.Color = glowColor
		local hl = self.highlight
		local on = level > 0.02 or flash > 0.02
		setEnabled(hl, on)
		if on then
			local k = math.min(1, level + flash)
			hl.OutlineColor = glowColor:Lerp(WHITE, 0.2)
			hl.OutlineTransparency = 1 - 0.85 * k
			hl.FillColor = glowColor
			hl.FillTransparency = 1 - 0.3 * k
		end
	end
	setEnabled(self.wake, extra.wake == true)
	local rate = extra.sparks or 0
	local on = rate > 1
	setEnabled(self.sparks, on)
	if on then
		self.sparks.Rate = rate
		local dir = extra.sparkDir
		if not dir or dir.Magnitude < 1e-3 then
			dir = cf.UpVector
		end
		-- from the blade's rear half, spraying back along the travel direction
		local at = cf * Vector3.new(0, self.base + (self.tip - self.base) * 0.25, 0)
		self.sparkPart.CFrame = frameUp(at, dir.Unit)
	end
end

function Sword:Burst()
	self.burst:Emit(70)
end

function Sword:ClearTrail()
	pcall(function()
		self.wake:Clear()
	end)
end

---------------------------------------------------------------------------------------- the stage
function WorldStage.new(ctx)
	local self = setmetatable({}, WorldStage)
	self.ctx = ctx
	self.active = false
	local Assets = ctx.assets
	local tl = ctx.timeline
	local folder = Instance.new("Folder")
	folder.Name = "World"
	self.folder = folder

	local function trackOf(name)
		local track = tl:track(name)
		if track and track.stage ~= "space" then
			return track
		end
		return nil
	end

	-- times of the events this stage animates (from the markers, so the state is a function of t)
	local switch = tl.stageSwitch
	local function markerAfter(kind, arg1, after)
		for _, m in ipairs(tl.markers) do
			if m.kind == kind and (arg1 == nil or m.args[1] == arg1) and m.t >= after - 1e-6 then
				return m
			end
		end
		return nil
	end
	local morph = markerAfter("morph", nil, -math.huge)
	self.morphT = morph and morph.t or nil
	if self.morphT then
		-- the burst comes with the flash right after the morph (DESIGN §1: 20.3 -> flash 20.9)
		local flash = markerAfter("flash", nil, self.morphT + 0.1)
		self.morphBurstT = (flash and flash.t <= self.morphT + 1.5) and flash.t or self.morphT + MORPH_CONDENSE
	end
	local shock = markerAfter("shockwave", nil, -math.huge)
	self.shockT = shock and shock.t or nil
	local wind = markerAfter("wind", nil, -math.huge)
	local worldData = ctx.data.world or {}
	self.windT = (wind and wind.t) or worldData.windStart
	self.windStrength = wind and tonumber(wind.args[1]) or 1
	local surfOn = markerAfter("speedlines", "on", switch)
	local surfOff = surfOn and markerAfter("speedlines", "off", surfOn.t)
	self.surf0 = surfOn and surfOn.t or nil
	self.surf1 = surfOff and surfOff.t or self.shockT
	if self.shockT then
		self.brake0, self.brake1 = self.shockT - BRAKE_TIME, self.shockT
	end

	self.skyRiftTrack = trackOf("SkyRift")
	if self.skyRiftTrack then
		self.skyRift = SpaceStage.Rift.new(folder, Assets, "SkyRift", { farSide = true })
	end
	self.coreTrack = trackOf("SoulCore")
	if self.coreTrack then
		self.core = SpaceStage.Core.new(folder, Assets, ctx.color, "SoulCore")
	end
	self.swordTrack = trackOf("Sword")
	if self.swordTrack then
		self.sword = Sword.new(folder, ctx)
	end

	self.blastTrack = trackOf("Blast")
	if self.blastTrack then
		local outer = Assets.part(folder, "Blast__Glow", "CoreGlow", Vector3.new(2, 2, 2), CFrame.new(), Enum.PartType.Ball)
		outer.Color = ctx.color
		outer.Transparency = 1
		local inner = Assets.part(folder, "Blast__Core", "CoreGlow", Vector3.new(1, 1, 1), CFrame.new(), Enum.PartType.Ball)
		inner.Color = ctx.color:Lerp(WHITE, 0.55)
		inner.Transparency = 1
		self.blast = { outer = outer, inner = inner, light = light(outer, ctx.color, 60), shown = false }
	end

	self.slashTrack = trackOf("SlashArc")
	if self.slashTrack then
		local model = Assets.place("SlashArc", folder, nil, ctx.color)
		self.slash = { model = model, mover = Assets.mover(model), opacity = -1, shown = true }
	end

	self.shockTrack = trackOf("Shockwave")
	if self.shockTrack then
		local model = Assets.place("Shockwave", folder, nil, ctx.color, 0)
		self.shock = { model = model, mover = Assets.mover(model), opacity = -1, blend = -1, shown = true }
	end

	-- dust: a wall of dust riding the ring along the ground + the burst at the stop
	local dustPart = invisiblePart(folder, "ShockDust")
	self.dustPart = dustPart
	local dustColor = Color3.fromRGB(196, 182, 156)
	self.dust = {}
	for k = 1, DUST_EMITTERS do
		local a = attachment(dustPart, "Dust" .. k)
		local e = emitter(a, {
			Texture = TEX_SMOKE,
			Color = ColorSequence.new(dustColor:Lerp(ctx.color, 0.12), dustColor),
			LightInfluence = 0.8,
			LightEmission = 0.05,
			Size = NumberSequence.new({ NSK(0, 4, 1), NSK(0.35, 11, 2.5), NSK(1, 18, 4) }),
			Transparency = NumberSequence.new({ NSK(0, 0.2), NSK(0.5, 0.45), NSK(1, 1) }),
			Lifetime = NumberRange.new(1.1, 2.1),
			Speed = NumberRange.new(5, 14),
			SpreadAngle = Vector2.new(30, 30),
			Drag = 1.6,
			Acceleration = Vector3.new(0, 2.5, 0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-40, 40),
			EmissionDirection = Enum.NormalId.Top,
		})
		self.dust[k] = { at = a, e = e, base = (k - 1) / DUST_EMITTERS * TAU }
	end
	self.dustBurstAt = attachment(dustPart, "Burst")
	self.dustBurst = emitter(self.dustBurstAt, {
		Texture = TEX_SMOKE,
		Color = ColorSequence.new(dustColor:Lerp(WHITE, 0.15), dustColor),
		LightInfluence = 0.8,
		Size = NumberSequence.new({ NSK(0, 4, 1.5), NSK(0.4, 12, 3), NSK(1, 20, 4) }),
		Transparency = NumberSequence.new({ NSK(0, 0.35), NSK(0.6, 0.6), NSK(1, 1) }),
		Lifetime = NumberRange.new(1.4, 2.6),
		Speed = NumberRange.new(30, 70),
		SpreadAngle = Vector2.new(84, 84),
		Drag = 2.6,
		Acceleration = Vector3.new(0, 3, 0),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-30, 30),
		EmissionDirection = Enum.NormalId.Top,
	})

	-- morph: light condensing into the body, then a burst
	local morphPart = invisiblePart(folder, "MorphFX", Vector3.new(9, 9, 9))
	self.morphPart = morphPart
	self.condense = emitter(morphPart, {
		Texture = TEX_SPARKLE,
		Color = ColorSequence.new(ctx.color, ctx.color:Lerp(WHITE, 0.8)),
		LightEmission = 1,
		Size = NumberSequence.new({ NSK(0, 0.15), NSK(0.3, 0.55, 0.2), NSK(1, 0.1) }),
		Transparency = NumberSequence.new({ NSK(0, 1), NSK(0.2, 0.1), NSK(1, 0.3) }),
		Lifetime = NumberRange.new(0.35, 0.6),
		Speed = NumberRange.new(7, 12),
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		Rotation = NumberRange.new(0, 360),
	})
	self.morphAt = attachment(morphPart, "Center")
	self.morphBurst = emitter(self.morphAt, {
		Texture = TEX_SPARKLE,
		Color = ColorSequence.new(ctx.color:Lerp(WHITE, 0.6), ctx.color),
		LightEmission = 1,
		Size = NumberSequence.new({ NSK(0, 0.9, 0.3), NSK(1, 0) }),
		Transparency = NumberSequence.new({ NSK(0, 0), NSK(0.7, 0.25), NSK(1, 1) }),
		Lifetime = NumberRange.new(0.6, 1.3),
		Speed = NumberRange.new(14, 32),
		Drag = 3.5,
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
	})
	self.morphLight = light(morphPart, ctx.color, 30)

	-- speed streaks: beams flowing past the character during the dive
	local streakPart = invisiblePart(folder, "Streaks")
	self.streakPart = streakPart
	self.streaks = {}
	for k = 1, STREAKS do
		local a0 = attachment(streakPart, "S" .. k .. "a")
		local a1 = attachment(streakPart, "S" .. k .. "b")
		local b = Instance.new("Beam")
		b.Name = "Streak" .. k
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Segments = 1
		b.Color = ColorSequence.new(WHITE:Lerp(ctx.color, 0.25))
		b.Transparency = NumberSequence.new({ NSK(0, 0.2), NSK(1, 1) })
		b.Width0 = 0.1
		b.Width1 = 0.02
		b.Enabled = false
		b.Parent = streakPart
		local radius = 2.5 + 11 * hash(k, 1)
		local ang = hash(k, 2) * TAU
		self.streaks[k] = {
			beam = b,
			a0 = a0,
			a1 = a1,
			x = math.cos(ang) * radius,
			y = math.sin(ang) * radius,
			phase = hash(k, 4),
			len = 0.6 + 0.8 * hash(k, 5),
			on = false,
		}
	end

	self.trees = nil -- collected when the stage starts (after streaming, with the final landing)
	self.savedWind = nil
	return self
end

function WorldStage:SetActive(active)
	if active == self.active then
		return
	end
	self.active = active
	self.folder.Parent = active and self.ctx.root or nil
	if active then
		self:_collectTrees()
	else
		self:_restoreTrees()
		self:_restoreWind()
	end
end

---------------------------------------------------------------------------------------- trees
function WorldStage:_exclusions()
	local list = { self.ctx.root }
	local Players = game:GetService("Players")
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	return list
end

function WorldStage:_collectTrees()
	if self.trees then
		return
	end
	local ctx = self.ctx
	local trees = {}
	self.trees = trees
	local landing = ctx.landing
	if not landing then
		return
	end
	local radius = (ctx.config and ctx.config.WIND_RADIUS) or 320
	local seen = {}
	local claimed = {} -- parts already moved by a tree (nested models never move a part twice)
	local function consider(model, loose)
		if seen[model] or not model:IsA("Model") or model == workspace then
			return
		end
		seen[model] = true
		if model:FindFirstChildOfClass("Humanoid") or model:IsDescendantOf(ctx.root) then
			return
		end
		local ok, pivot = pcall(model.GetPivot, model)
		if not ok or not pivot then
			return
		end
		if loose then
			-- a model found by its Trunk / Bark piece may have its pivot at the middle: bend it
			-- about the bottom of its bounding box (the generator's trees pivot at their base)
			local okBox, boxCF, boxSize = pcall(model.GetBoundingBox, model)
			if okBox and boxCF then
				local bottom = boxCF.Position.Y - 0.5 * (math.abs(boxCF.XVector.Y) * boxSize.X + math.abs(boxCF.YVector.Y) * boxSize.Y + math.abs(boxCF.ZVector.Y) * boxSize.Z)
				if pivot.Y - bottom > 2 then
					pivot = CFrame.new(pivot.X, bottom, pivot.Z) * pivot.Rotation
				end
			end
		end
		local flat = Vector3.new(pivot.X - landing.X, 0, pivot.Z - landing.Z)
		local d = flat.Magnitude
		if d > radius then
			return
		end
		local parts, orig, offsets = {}, {}, {}
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p.Anchored and not claimed[p] then
				claimed[p] = true
				table.insert(parts, p)
				table.insert(orig, p.CFrame)
				table.insert(offsets, pivot:ToObjectSpace(p.CFrame))
			end
		end
		if #parts == 0 then
			return
		end
		local away = d > 0.05 and flat.Unit or Vector3.xAxis
		table.insert(trees, {
			model = model,
			parts = parts,
			orig = orig,
			offsets = offsets,
			cframes = table.clone(orig),
			pivot = pivot,
			worldPivot = model.WorldPivot,
			hasPrimary = model.PrimaryPart ~= nil,
			d = d,
			axis = Vector3.yAxis:Cross(away).Unit, -- +angle tilts the top away from the landing point
			A = windA(d),
			moved = false,
			done = false,
		})
	end
	local island = workspace:FindFirstChild("Island")
	local forest = island and island:FindFirstChild("Forest")
	local folder = forest and forest:FindFirstChild("Trees")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			consider(m)
		end
	end
	-- any other model with a Trunk / Bark piece nearby
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = self:_exclusions()
	local ok, hits = pcall(function()
		return workspace:GetPartBoundsInRadius(landing, radius + 40, params)
	end)
	if ok and hits then
		for _, p in ipairs(hits) do
			if not claimed[p] and isTreePiece(p.Name) then
				local m = p:FindFirstAncestorOfClass("Model")
				if m then
					consider(m, true)
				end
			end
		end
	end
end

local function restoreTree(tree)
	if tree.moved then
		tree.moved = false
		moveParts(tree.parts, tree.orig)
		if not tree.hasPrimary then
			pcall(function()
				tree.model.WorldPivot = tree.worldPivot
			end)
		end
	end
end

function WorldStage:_restoreTrees()
	for _, tree in ipairs(self.trees or {}) do
		restoreTree(tree)
	end
end

function WorldStage:_updateTrees(t)
	local trees = self.trees
	local t0 = self.windT
	if not trees or not t0 or t < t0 then
		return
	end
	local strength = self.windStrength or 1
	local batchParts, batchCF = self.batchParts or {}, self.batchCF or {}
	self.batchParts, self.batchCF = batchParts, batchCF
	table.clear(batchParts)
	table.clear(batchCF)
	for _, tree in ipairs(trees) do
		if not tree.done then
			local tau = t - t0 - tree.d / WIND_SPEED
			if tau > WIND_SETTLE then
				restoreTree(tree)
				tree.done = true
			elseif tau >= 0 then
				local theta = tree.A * strength * windF(tau)
				local p = tree.pivot.Position
				local pivot = CFrame.new(p) * CFrame.fromAxisAngle(tree.axis, theta) * tree.pivot.Rotation
				local offsets, cframes = tree.offsets, tree.cframes
				for i, part in ipairs(tree.parts) do
					local cf = pivot * offsets[i]
					cframes[i] = cf
					table.insert(batchParts, part)
					table.insert(batchCF, cf)
				end
				if not tree.hasPrimary then
					tree.model.WorldPivot = pivot
				end
				tree.moved = true
			end
		end
	end
	moveParts(batchParts, batchCF)
end

---------------------------------------------------------------------------------------- wind gust
function WorldStage:_restoreWind()
	if self.savedWind then
		pcall(function()
			workspace.GlobalWind = self.savedWind
		end)
		self.savedWind = nil
	end
end

function WorldStage:_updateWind(t)
	local t0 = self.windT
	if not t0 or t < t0 or self.windDone then
		return
	end
	local tau = t - t0
	if tau > GUST_END then
		self:_restoreWind()
		self.windDone = true
		return
	end
	if not self.savedWind then
		self.savedWind = workspace.GlobalWind
		-- the wave travels toward the camera of the wide shot: blow from the landing point to it
		local ctx = self.ctx
		local d = ctx.cameraCF.Position - ctx.landing
		d = Vector3.new(d.X, 0, d.Z)
		self.windDir = d.Magnitude > 1 and d.Unit or ctx.origins.world.LookVector
	end
	local env = (1 - math.exp(-tau / 0.15)) * math.exp(-tau / 1.5)
	workspace.GlobalWind = self.savedWind + self.windDir * (GUST * (self.windStrength or 1) * env)
end

---------------------------------------------------------------------------------------- frame
function WorldStage:_updateCore(t, origin)
	local track = self.coreTrack
	local s = track:sample(t)
	local shown = t >= self.ctx.timeline.stageSwitch - 1e-6 and present(track, s, t)
	self.core:SetShown(shown)
	if shown then
		local vel = velocity(self.ctx.timeline, track, origin, t)
		s = track:sample(t)
		self.core:Update(Convert.assetCF(origin, s.pos, s.rot), s.scale, s.channels, vel)
	end
end

function WorldStage:_updateMorph(t)
	local tm, tb = self.morphT, self.morphBurstT
	local active = tm ~= nil and t >= tm - 0.05 and t <= tb + 1.6
	local cond = active and t < tb
	setEnabled(self.condense, cond)
	if not active then
		setLight(self.morphLight, 0)
		return
	end
	local rig = self.ctx.character
	local cf = rig and rig.rootCF
	if cf then
		self.morphPart.CFrame = CFrame.new(cf.Position)
	end
	local u = clamp01((t - tm) / math.max(tb - tm, 0.05))
	if cond then
		self.condense.Rate = 90 + 110 * u
	elseif not self.morphBurstDone then
		self.morphBurstDone = true
		self.morphBurst:Emit(90)
	end
	local b
	if t < tb then
		b = 1.5 + 4.5 * u * u
	else
		b = 10 * math.exp(-(t - tb) / 0.35)
	end
	setLight(self.morphLight, b, 18 + 12 * u)
end

function WorldStage:_updateSword(t, origin, rootVel)
	local track = self.swordTrack
	local sword = self.sword
	local s = track:sample(t)
	local ch = s.channels
	local shown = present(track, s, t)
	sword:SetShown(shown, self.folder)
	if not shown then
		return
	end
	local rig = self.ctx.character
	local cf
	if (ch.held or 0) >= 0.5 and rig and rig.animated then
		cf = rig:GripCF()
	else
		cf = Convert.assetCF(origin, s.pos, s.rot)
	end
	local extra = self.swordExtra or {}
	self.swordExtra = extra
	local tr = self.resonateT
	extra.flash = tr and t >= tr and math.exp(-(t - tr) / 0.25) or 0
	if extra.flash < 0.01 then
		extra.flash = 0
	end
	extra.wake = self.surf0 ~= nil and t >= self.surf0 and t <= (self.shockT or self.surf1 or self.surf0)
	local brake = window(t, self.brake0, self.brake1, 0.25, 0.08)
	extra.sparks = brake * (100 + 100 * clamp01((t - (self.brake0 or t)) / BRAKE_TIME))
	extra.sparkDir = -rootVel + Vector3.new(0, 0.35 * rootVel.Magnitude + 2, 0)
	sword:Update(cf, s.scale, ch, extra)
end

function WorldStage:_updateBlast(t, origin)
	local b = self.blast
	local track = self.blastTrack
	local s = track:sample(t)
	local opacity = clamp01(s.channels.opacity or 1)
	local shown = present(track, s, t) and s.scale > 1e-3 and opacity > 0.003
	if shown ~= b.shown then
		b.shown = shown
		if not shown then
			b.outer.Transparency = 1
			b.inner.Transparency = 1
			setLight(b.light, 0)
		end
	end
	if not shown then
		return
	end
	local d = math.clamp(s.scale * 2, 0.05, 2048)
	local cf = origin * CFrame.new(Convert.posOf(s.pos))
	b.outer.Size = Vector3.new(d, d, d)
	b.outer.CFrame = cf
	b.outer.Transparency = 1 - 0.62 * opacity
	local di = math.max(d * 0.55, 0.05)
	b.inner.Size = Vector3.new(di, di, di)
	b.inner.CFrame = cf
	b.inner.Transparency = 1 - 0.9 * opacity
	setLight(b.light, 7 * opacity, math.min(10 + d * 1.5, 60))
end

function WorldStage:_follow(f, track, t, origin)
	local Assets = self.ctx.assets
	local s = track:sample(t)
	local opacity = clamp01(s.channels.opacity or 1)
	local shown = present(track, s, t) and s.scale > 1e-3 and opacity > 0.003
	if shown ~= f.shown then
		f.shown = shown
		setParent(f.model, shown and self.folder or nil)
	end
	if not shown then
		return nil
	end
	f.mover:MoveTo(Convert.assetCF(origin, s.pos, s.rot), s.scale)
	if math.abs(opacity - f.opacity) > 0.005 then
		f.opacity = opacity
		Assets.setOpacity(f.model, opacity)
	end
	return s, opacity
end

-- Ground height under the ring at angle a (radians) and radius, cached per sector / radius step.
function WorldStage:_groundAt(center, a, radius)
	local cache = self.groundCache
	if not cache or (self.groundCenter - center).Magnitude > 1 then
		cache = {}
		self.groundCache, self.groundCenter = cache, center
	end
	local sec = math.floor(a / TAU * DUST_SECTORS) % DUST_SECTORS
	local step = math.floor(radius / 8 + 0.5)
	local key = step * DUST_SECTORS + sec
	local y = cache[key]
	if y == nil then
		local ab = (sec + 0.5) / DUST_SECTORS * TAU
		local p = center + Vector3.new(math.cos(ab), 0, math.sin(ab)) * (step * 8)
		local hit = self.rayParams and workspace:Raycast(p + Vector3.new(0, 80, 0), Vector3.new(0, -200, 0), self.rayParams)
		y = hit and hit.Position.Y or center.Y
		cache[key] = y
	end
	return y
end

function WorldStage:_updateShock(t, origin)
	local f = self.shock
	local s, opacity = self:_follow(f, self.shockTrack, t, origin)
	local dustOn = false
	if s then
		local blend = clamp01(1 - opacity)
		if math.abs(blend - f.blend) > 0.02 then
			f.blend = blend
			self.ctx.assets.recolor(f.model, self.ctx.color, blend)
		end
		-- dust riding the ring along the ground
		local radius = s.scale -- the ring asset has radius 1
		local center = origin * Convert.posOf(s.pos)
		local maxR = ((self.ctx.config and self.ctx.config.WIND_RADIUS) or 320) + 80
		dustOn = radius > 3 and radius < maxR and opacity > 0.08
		if dustOn then
			self.dustPart.CFrame = CFrame.new(center)
			-- denser as the ring grows (the same dust per stud of ring), thinning out at the edge
			local rate = math.clamp(radius * 0.09, 8, 30) * opacity * clamp01((maxR - radius) / 80)
			local frame = math.floor(t * 60)
			local sector = TAU / DUST_EMITTERS
			for k, dk in ipairs(self.dust) do
				local a = (dk.base + sector * hash(k, frame)) % TAU
				local dir = Vector3.new(math.cos(a), 0, math.sin(a))
				local y = self:_groundAt(center, a, radius)
				dk.at.CFrame = frameUp(Vector3.new(dir.X * radius, y - center.Y + 0.5, dir.Z * radius), (dir * 1.4 + Vector3.yAxis).Unit)
				dk.e.Rate = rate
				setEnabled(dk.e, true)
			end
		end
	end
	if not dustOn then
		for _, dk in ipairs(self.dust) do
			setEnabled(dk.e, false)
		end
	end
end

function WorldStage:_updateStreaks(t, rootVel)
	local level = window(t, self.surf0, self.surf1, 0.2, 0.25)
	local speed = rootVel.Magnitude
	level *= clamp01((speed - 12) / 45)
	local rig = self.ctx.character
	local center = rig and rig.rootCF and rig.rootCF.Position
	if level < 0.02 or not center or speed < 1 then
		if self.streaksOn then
			self.streaksOn = false
			for _, st in ipairs(self.streaks) do
				st.beam.Enabled = false
				st.on = false
			end
		end
		return
	end
	self.streaksOn = true
	local dir = rootVel.Unit
	-- the field's -Z is the travel direction
	self.streakPart.CFrame = CFrame.lookAt(center, center + dir, math.abs(dir.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis)
	local flow = speed * 1.1
	local len = math.clamp(speed * 0.16, 3, 16)
	for k, st in ipairs(self.streaks) do
		-- along the travel axis: from STREAK_SPAN/2 ahead to STREAK_SPAN/2 behind, wrapping
		local u = (st.phase - t * flow / STREAK_SPAN) % 1
		local z = -(u - 0.5) * STREAK_SPAN -- local -Z = ahead
		local fade = math.sin(math.pi * u)
		local w = level * fade * (0.6 + 0.4 * hash(k, 6))
		local on = w > 0.05
		if on ~= st.on then
			st.on = on
			st.beam.Enabled = on
		end
		if on then
			st.a0.Position = Vector3.new(st.x, st.y, z)
			st.a1.Position = Vector3.new(st.x, st.y, z + len * st.len)
			st.beam.Width0 = 0.13 * w
			st.beam.Width1 = 0.02 * w
		end
	end
end

function WorldStage:Update(t, _dt)
	local ctx = self.ctx
	local tl = ctx.timeline
	local origin = ctx.origins.world
	if not self.rayParams then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = self:_exclusions()
		params.IgnoreWater = false
		params.RespectCanCollide = true
		self.rayParams = params
	end

	if self.skyRift then
		local track = self.skyRiftTrack
		local s = track:sample(t)
		local shown = present(track, s, t) and s.scale > 1e-3
		self.skyRift:SetShown(shown)
		if shown then
			local ch = s.channels
			self.skyRift:Update(Convert.assetCF(origin, s.pos, s.rot), s.scale, ch.crack or 1, ch.open or 1, t)
		end
	end
	if self.core then
		self:_updateCore(t, origin)
	end
	self:_updateMorph(t)

	local rootVel = Vector3.zero
	local cs = tl:characterTrack()
	if cs and cs.posData then
		rootVel = samplerVel(tl, cs, origin, t)
	end
	if self.sword then
		self:_updateSword(t, origin, rootVel)
	end
	if self.blast then
		self:_updateBlast(t, origin)
	end
	if self.slash then
		self:_follow(self.slash, self.slashTrack, t, origin)
	end
	if self.shock then
		self:_updateShock(t, origin)
	end
	self:_updateStreaks(t, rootVel)
	self:_updateTrees(t)
	self:_updateWind(t)
end

function WorldStage:OnMarker(kind, _args, t)
	if kind == "cut" then
		if self.core then
			self.core:ClearTrail()
		end
		if self.sword then
			self.sword:ClearTrail()
		end
	elseif kind == "resonate" then
		self.resonateT = t
		if self.sword and self.active then
			self.sword:Burst()
		end
	elseif kind == "shockwave" then
		self.shockT = self.shockT or t
		if self.active then
			-- dust bursts from the ground under the sword
			local center
			local sword = self.sword
			if sword and sword.shown then
				center = sword.model:GetPivot().Position
			else
				local rig = self.ctx.character
				center = rig and rig.rootCF and rig.rootCF.Position
			end
			if center then
				local hit = self.rayParams and workspace:Raycast(center + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), self.rayParams)
				local ground = hit and hit.Position or Vector3.new(center.X, self.ctx.landing.Y, center.Z)
				self.dustPart.CFrame = CFrame.new(ground)
				self.dustBurstAt.CFrame = CFrame.new(0, 0.5, 0)
				self.dustBurst:Emit(60)
			end
		end
	elseif kind == "wind" then
		self.windT = t
	end
end

function WorldStage:Destroy()
	self:_restoreTrees()
	self:_restoreWind()
	pcall(function()
		self.ctx.screen:RemoveSilhouette("sword")
	end)
	self.folder:Destroy()
end

return WorldStage
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
