<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="ModuleScript" referent="RBX00000021">
		<Properties>
			<string name="Name">IntroCutscene</string>
			<ProtectedString name="Source"><![CDATA[--[[
	IntroCutscene  ("Awaken", docs/intro/DESIGN.md)
	ModuleScript for ReplicatedStorage. Plays back the Blender-authored intro
	(IntroData + IntroAssets) with the player's real avatar.

	    local Intro = require(game.ReplicatedStorage:WaitForChild("IntroCutscene"))
	    Intro.Play({
	        color = Color3.fromRGB(120, 200, 255), -- soul core colour (required)
	        onFinished = function(color) end,      -- optional
	    })                                          -- yields until the cutscene ends
	    Intro.IsPlaying() -> boolean
	    Intro.Finished    -- RBXScriptSignal (BindableEvent.Event), fires with the colour

	Play must be called from a LocalScript; while playing, further calls do
	nothing. In Studio, pressing Config.TEST_IN_STUDIO_KEY (F7) during a play test
	plays it with Config.TEST_COLOR. When it ends (normally, skipped, aborted or
	after an error) everything is restored, the RemoteEvent
	ReplicatedStorage.IntroCutscene_Finished is fired with the colour (the server
	script gives the sword), Finished fires and onFinished is called.

	Frame loop
	  * RunService:BindToRenderStep("IntroCutscene", Camera + 1): the clock advances
	    (by real frame time, at most Config.MAX_FRAME_DT per frame), every marker
	    with time <= t fires once, in order (even when a frame jumps over several),
	    then Update(t) sets everything for time t: camera, character, the active
	    stage, the screen. Every frame runs inside xpcall: an error is logged
	    and the cutscene stops cleanly.
	  * RunService.PreSimulation (after the Animator): CharacterRig:ApplyJoints()
	    re-applies this frame's Motor6D Transforms so nothing overwrites them.
	  * Character death / removal / respawn or the player leaving aborts the
	    cutscene (everything restored, Finished still fires).

	Markers handled here: bars, fade, flash, shake, impact, speedlines (Screen),
	stage:world (stage switch), sound:<name>, end. Every marker is also passed to
	both stages' OnMarker (cut, wind, shockwave, resonate, morph, ...).

	Stage interface (SpaceStage.luau, WorldStage.luau)
	    Stage.new(ctx) -> stage       build everything (parent it under ctx.root); called at start
	    stage:SetActive(active)       space is active for t < stageSwitch, world after
	    stage:Update(t, dt)           only called while active; the camera (ctx.cameraCF) and the
	                                  character (ctx.character) are already set for t
	    stage:OnMarker(kind, args, t) every marker, active or not (t = the marker's own time)
	    stage:Destroy()               remove everything it made (called once at the end)

	ctx (shared by the stages)
	    color        Color3     soul core colour
	    data         table      IntroData
	    timeline     Timeline   (Timeline.luau)
	    assets       Assets     module (Assets.luau)
	    screen       Screen     (AddSilhouette for impact frames, Flash, Shake, ...)
	    lighting     LightingFX (Set / Effect for extra tweaks, restored automatically)
	    character    CharacterRig (GripCF, PartCFrame, root, character, ...)
	    origins      { space = CFrame, world = CFrame }  stage origins (§2). origins.world may
	                 be refined right before the world stage starts (landing found only after
	                 streaming), so read it in SetActive(true)/Update, don't cache it in new()
	    origin(stage, t) -> CFrame  origin for a track's `stage` field ("camera" = by time)
	    landing      Vector3    landing point on the ground (also refined like origins.world)
	    camera       Camera     workspace.CurrentCamera (Scriptable while playing)
	    cameraCF     CFrame     this frame's camera CFrame (incl. shake)
	    root         Folder     workspace.IntroCutscene, holds everything created
	    config       Config
	    player       Player
	    t            number     current cutscene time
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(script.Config)
local Convert = require(script.Convert)
local Timeline = require(script.Timeline)
local Assets = require(script.Assets)
local Screen = require(script.Screen)
local LightingFX = require(script.LightingFX)
local CharacterRig = require(script.CharacterRig)
local SpaceStage = require(script.SpaceStage)
local WorldStage = require(script.WorldStage)

local Intro = {}

local RENDER_STEP = "IntroCutscene"
local REMOTE_NAME = "IntroCutscene_Finished"
local SKIP_FADE = 0.35
local WHITE = Color3.new(1, 1, 1)

local finishedEvent = Instance.new("BindableEvent")
finishedEvent.Name = "IntroCutsceneFinished"
Intro.Finished = finishedEvent.Event

local current = nil -- the running session

local function log(...)
	print("[IntroCutscene]", ...)
end

local function warnf(...)
	warn("[IntroCutscene]", ...)
end

local function try(what, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnf("cleanup step '" .. what .. "' failed: " .. tostring(err))
	end
	return ok
end

local function notifyServer(color)
	task.spawn(function()
		local remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME) or ReplicatedStorage:WaitForChild(REMOTE_NAME, 5)
		if remote and remote:IsA("RemoteEvent") then
			remote:FireServer(color)
		end
	end)
end

-- Landing point (DESIGN §7.1) ----------------------------------------------------------------------------
local function groundAt(x, z, exclude)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude
	params.IgnoreWater = true
	params.RespectCanCollide = true -- leaves, clouds and effects are not the ground
	local hit = workspace:Raycast(Vector3.new(x, 5000, z), Vector3.new(0, -10000, 0), params)
	return hit and hit.Position.Y or nil
end

local function exclusions(extra)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	for _, inst in ipairs(extra) do
		table.insert(list, inst)
	end
	return list
end

local HUB = Vector3.zero

-- -> ground point (Vector3), direction toward the hub (Vector3), provisional (ground not found yet)
local function findLanding(character, root)
	local spec = Config.LANDING
	local specType = typeof(spec)
	if specType == "Vector3" then
		return spec, HUB - spec, false
	end
	local exclude = exclusions({ root })
	local xz
	local layoutModule = ReplicatedStorage:FindFirstChild("IslandLayout")
	if layoutModule and layoutModule:IsA("ModuleScript") then
		local ok, layout = pcall(require, layoutModule)
		local spawnXZ = ok and type(layout) == "table" and layout.Landmarks and layout.Landmarks.ForestSpawn
		local spawnType = typeof(spawnXZ)
		if spawnType == "Vector3" then
			xz = Vector3.new(spawnXZ.X, 0, spawnXZ.Z)
		end
	end
	local spawn = workspace:FindFirstChild("IslandSpawn_Forest", true)
	if not (spawn and spawn:IsA("BasePart")) then
		spawn = nil
	end
	if not xz and spawn then
		xz = Vector3.new(spawn.Position.X, 0, spawn.Position.Z)
	end
	if xz then
		local toHub = HUB - xz
		if toHub.Magnitude > 1e-3 then
			xz += toHub.Unit * math.min(Config.LANDING_OFFSET_TO_HUB or 14, toHub.Magnitude)
		end
		local y = groundAt(xz.X, xz.Z, exclude)
		if y then
			return Vector3.new(xz.X, y, xz.Z), HUB - xz, false
		end
		if spawn then
			return Vector3.new(xz.X, spawn.Position.Y - 1.6, xz.Z), HUB - xz, true
		end
	end
	-- no island: land where the character is
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	local pos = hrp and hrp.Position or Vector3.zero
	local p = xz or Vector3.new(pos.X, 0, pos.Z)
	local y = groundAt(p.X, p.Z, exclude)
	if y then
		return Vector3.new(p.X, y, p.Z), xz and (HUB - xz) or (hrp and hrp.CFrame.LookVector or Vector3.zAxis), false
	end
	local feet = pos.Y - ((hum and hum.HipHeight or 2) + (hrp and hrp.Size.Y / 2 or 1))
	return Vector3.new(p.X, feet, p.Z), xz and (HUB - xz) or (hrp and hrp.CFrame.LookVector or Vector3.zAxis), true
end

-- Session ---------------------------------------------------------------------------------------------------
local Session = {}
Session.__index = Session

function Session.new(color, onFinished)
	local self = setmetatable({}, Session)
	self.color = color
	self.onFinished = onFinished
	self.player = Players.LocalPlayer
	self.camera = workspace.CurrentCamera
	self.t = 0
	self.done = false
	self.connections = {}
	self.doneEvent = Instance.new("BindableEvent")
	return self
end

function Session:_connect(signal, fn)
	table.insert(self.connections, signal:Connect(fn))
end

function Session:_waitCharacter()
	local player = self.player
	local deadline = os.clock() + 15
	while os.clock() < deadline do
		local c = player.Character
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		if c and hum and hum.Health > 0 and c:FindFirstChild("HumanoidRootPart") and c:IsDescendantOf(workspace) then
			return c
		end
		task.wait(0.1)
	end
	return nil
end

function Session:_setWorldOrigin()
	local height = (self.data.world and self.data.world.landingHeight) or 0
	local origin = Convert.stageOrigin(self.landing - Vector3.new(0, height, 0), self.toHub)
	self.origins.world = origin
	if self.ctx then
		self.ctx.landing = self.landing
	end
end

function Session:_refineLanding()
	self.landingProvisional = false
	local y = groundAt(self.landing.X, self.landing.Z, exclusions({ self.root }))
	if y then
		self.landing = Vector3.new(self.landing.X, y, self.landing.Z)
		self:_setWorldOrigin()
	end
end

function Session:start()
	local player = self.player
	assert(player, "IntroCutscene.Play must be called from a LocalScript")
	local character = self:_waitCharacter()
	assert(character, "no living character to play the intro with")

	self.data = require(script.IntroData)
	local tl = Timeline.new(self.data)
	self.timeline = tl
	self.cameraTrack = tl:track("Camera")

	local old = workspace:FindFirstChild("IntroCutscene")
	if old and old:IsA("Folder") then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "IntroCutscene"
	root.Parent = workspace
	self.root = root

	self.landing, self.toHub, self.landingProvisional = findLanding(character, root)
	self.origins = { space = Config.SPACE_ORIGIN }
	self:_setWorldOrigin()
	task.spawn(function()
		pcall(function()
			player:RequestStreamAroundAsync(self.landing)
		end)
	end)
	task.spawn(Assets.preload)

	local cam = self.camera
	self.savedCamera = { CameraType = cam.CameraType, CameraSubject = cam.CameraSubject, FieldOfView = cam.FieldOfView, Focus = cam.Focus }
	cam.CameraType = Enum.CameraType.Scriptable

	self.lighting = LightingFX.new(cam)
	self.lighting:Begin()
	self.screen = Screen.new(player, cam, Config)
	local rig = CharacterRig.new(player, character, root)
	self.rig = rig
	rig:SetColor(self.color)
	rig:Takeover()

	local ctx = {
		color = self.color,
		data = self.data,
		timeline = tl,
		assets = Assets,
		screen = self.screen,
		lighting = self.lighting,
		character = rig,
		origins = self.origins,
		landing = self.landing,
		camera = cam,
		cameraCF = cam.CFrame,
		root = root,
		config = Config,
		player = player,
		t = 0,
	}
	function ctx.origin(stage, t)
		if stage == "space" then
			return ctx.origins.space
		elseif stage == "world" then
			return ctx.origins.world
		end
		return tl:stageAt(t) == "world" and ctx.origins.world or ctx.origins.space
	end
	self.ctx = ctx

	self.space = SpaceStage.new(ctx)
	self.world = WorldStage.new(ctx)
	self.stages = { self.space, self.world }
	self.screen:AddSilhouette("character", character, function(part)
		return rig:PartCFrame(part)
	end)
	self.stage = "space"
	self.lighting:Space()
	self.world:SetActive(false)
	self.space:SetActive(true)

	self.cursor = tl:cursor()
	self.onMarker = function(m)
		self:_marker(m)
	end

	local hum = rig.humanoid
	self:_connect(hum.Died, function()
		self:abort("the character died")
	end)
	self:_connect(player.CharacterRemoving, function()
		self:abort("the character was removed")
	end)
	self:_connect(player.CharacterAdded, function()
		self:abort("the character respawned")
	end)
	self:_connect(character.AncestryChanged, function()
		if not character:IsDescendantOf(workspace) then
			self:abort("the character left the workspace")
		end
	end)
	self:_connect(Players.PlayerRemoving, function(p)
		if p == player then
			self:abort("the player left")
		end
	end)
	if Config.ALLOW_SKIP then
		self.screen:SetSkipHint(true)
		self:_connect(UserInputService.InputBegan, function(input, processed)
			if processed then
				return
			end
			local k = input.KeyCode
			if k == Enum.KeyCode.Space or k == Enum.KeyCode.Return or k == Enum.KeyCode.ButtonA or input.UserInputType == Enum.UserInputType.Touch then
				self:skip()
			end
		end)
	end

	-- first frame now, so nothing of the world shows before the cutscene does
	self:_frame(0)
	if self.done then
		return
	end
	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_STEP)
	end)
	RunService:BindToRenderStep(RENDER_STEP, Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:_step(dt)
	end)
	self:_connect(RunService.PreSimulation, function()
		if not self.done then
			local ok, err = pcall(rig.ApplyJoints, rig)
			if not ok then
				warnf("joints: " .. tostring(err))
			end
		end
	end)
end

-- Markers ----------------------------------------------------------------------------------------------------
function Session:_sound(name)
	local id = Config.SOUNDS and Config.SOUNDS[name]
	if type(id) == "number" then
		id = "rbxassetid://" .. tostring(id)
	end
	if type(id) ~= "string" or id == "" then
		return
	end
	if string.match(id, "^%d+$") then
		id = "rbxassetid://" .. id
	end
	local s = Instance.new("Sound")
	s.Name = "IntroSound_" .. tostring(name)
	s.SoundId = id
	s.Volume = 0.8
	s.Parent = self.root
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
end

function Session:_switchStage(name)
	if name ~= "world" or self.stage == "world" then
		return
	end
	self.stage = "world"
	if self.landingProvisional then
		self:_refineLanding()
	end
	self.space:SetActive(false)
	self.lighting:World()
	self.world:SetActive(true)
end

function Session:_marker(m)
	local kind, args, mt = m.kind, m.args, m.t
	if Config.DEBUG then
		log(string.format("%.3f  %s", mt, m.name))
	end
	local screen = self.screen
	if kind == "bars" then
		screen:Bars(args[1] == "in", tonumber(args[2]) or 1, mt)
	elseif kind == "fade" then
		screen:Fade(args[1] == "to_black", tonumber(args[2]) or 1, mt)
	elseif kind == "flash" then
		screen:Flash(args[1] == "core" and self.color or WHITE, tonumber(args[2]) or 0.3, mt)
	elseif kind == "shake" then
		screen:Shake(tonumber(args[1]) or 0.5, tonumber(args[2]) or 0.5, mt)
	elseif kind == "impact" then
		screen:Impact(args[1], mt)
	elseif kind == "speedlines" then
		screen:SpeedLines(args[1] == "on", mt)
	elseif kind == "stage" then
		self:_switchStage(args[1])
	elseif kind == "sound" then
		self:_sound(args[1])
	elseif kind == "end" then
		self.endRequested = true
	end
	for _, stage in ipairs(self.stages) do
		stage:OnMarker(kind, args, mt)
	end
end

-- Frames -----------------------------------------------------------------------------------------------------
-- Everything for time t (markers up to t have fired).
function Session:Update(t, dt)
	local tl = self.timeline
	if self.stage ~= "world" and tl:stageAt(t) == "world" then
		self:_switchStage("world") -- in case the data has no stage:world marker
	end
	local ctx = self.ctx
	ctx.t = t
	local cam = self.camera
	local track = self.cameraTrack
	if track then
		local s = track:sample(t)
		local cf = Convert.cameraCF(ctx.origin(track.stage, t), s.pos, s.rot) * self.screen:ShakeOffset(t)
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Scriptable
		end
		cam.CFrame = cf
		cam.Focus = cf * CFrame.new(0, 0, -12)
		local fov = s.channels.fov
		if fov then
			cam.FieldOfView = math.clamp(fov, 1, 120)
		end
		ctx.cameraCF = cf
	else
		ctx.cameraCF = cam.CFrame
	end
	-- the character before the stage, so the stage sees this frame's hand (sword grip)
	local cs = tl:character(t)
	if cs then
		self.rig:Update(t, cs, self.origins.world)
	end
	local stage = self.stage == "world" and self.world or self.space
	stage:Update(t, dt)
	self.screen:Update(t, dt)
end

function Session:_frame(dt)
	local tl = self.timeline
	local t = math.min(self.t + dt, tl.duration)
	self.t = t
	self.cursor:advance(t, self.onMarker)
	if self.done then
		return
	end
	self:Update(t, dt)
	if self.done then
		return
	end
	if self.skipT and t >= self.skipT + SKIP_FADE + 0.05 then
		self:finish("skipped")
	elseif self.endRequested or t >= tl.duration then
		self:finish("done")
	end
end

function Session:_step(dt)
	if self.done then
		return
	end
	local ok, err = xpcall(self._frame, debug.traceback, self, math.min(dt, Config.MAX_FRAME_DT or 0.25))
	if not ok then
		warnf("error, stopping the cutscene: " .. tostring(err))
		self:finish("error")
	end
end

function Session:skip()
	if self.done or self.skipT then
		return
	end
	self.skipT = self.t
	self.screen:SetSkipHint(false)
	self.screen:Fade(true, SKIP_FADE, self.t)
end

function Session:abort(reason)
	if self.done then
		return
	end
	warnf("stopped: " .. reason)
	self:finish("aborted")
end

-- Ending -----------------------------------------------------------------------------------------------------
function Session:_cleanup(finalCF)
	try("render step", function()
		RunService:UnbindFromRenderStep(RENDER_STEP)
	end)
	for _, c in ipairs(self.connections) do
		c:Disconnect()
	end
	table.clear(self.connections)
	for _, stage in ipairs(self.stages or {}) do
		try("stage", stage.Destroy, stage)
	end
	if self.screen then
		try("screen", self.screen.Destroy, self.screen)
	end
	if self.rig then
		try("character", self.rig.Restore, self.rig, finalCF)
	end
	if self.lighting then
		try("lighting", self.lighting.Restore, self.lighting)
	end
	local saved = self.savedCamera
	if saved then
		try("camera", function()
			local cam = self.camera
			cam.CameraType = saved.CameraType
			local subject = saved.CameraSubject
			if not (subject and subject.Parent) then
				local c = self.player.Character
				subject = c and c:FindFirstChildOfClass("Humanoid")
			end
			if subject then
				cam.CameraSubject = subject
			end
			cam.FieldOfView = saved.FieldOfView
			cam.Focus = saved.Focus
		end)
	end
	if self.root then
		try("folder", self.root.Destroy, self.root)
	end
end

function Session:finish(reason)
	if self.done then
		return
	end
	self.done = true
	self.reason = reason
	local finalCF
	if reason ~= "aborted" then
		pcall(function()
			local tl = self.timeline
			local cs = tl and tl:character(tl.duration)
			if cs and self.rig and self.origins then
				finalCF = self.rig:RootCF(cs, self.origins.world)
			end
		end)
	end
	self:_cleanup(finalCF)
	if current == self then
		current = nil
	end
	local color = self.color
	notifyServer(color)
	finishedEvent:Fire(color)
	if self.onFinished then
		task.spawn(function()
			local ok, err = pcall(self.onFinished, color)
			if not ok then
				warnf("onFinished: " .. tostring(err))
			end
		end)
	end
	self.doneEvent:Fire(reason)
end

-- Public API -------------------------------------------------------------------------------------------------
function Intro.IsPlaying()
	return current ~= nil
end

function Intro.Play(options)
	if current then
		return
	end
	if not RunService:IsClient() or not Players.LocalPlayer then
		warnf("Play must be called from a LocalScript")
		return
	end
	options = options or {}
	local color = options.color
	local colorType = typeof(color)
	if colorType ~= "Color3" then
		warnf("Play needs options.color (a Color3); using Config.TEST_COLOR")
		color = Config.TEST_COLOR
	end
	local session = Session.new(color, options.onFinished)
	current = session
	local ok, err = xpcall(session.start, debug.traceback, session)
	if not ok then
		warnf("could not play the intro: " .. tostring(err))
		session:finish("error")
	end
	if not session.done then
		session.doneEvent.Event:Wait()
	end
	session.doneEvent:Destroy()
end

-- Studio play tests: replay with the test colour
if RunService:IsStudio() and RunService:IsClient() then
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Config.TEST_IN_STUDIO_KEY and not current then
			task.spawn(Intro.Play, { color = Config.TEST_COLOR })
		end
	end)
end

return Intro
]]></ProtectedString>
		</Properties>
		<Item class="ModuleScript" referent="RBX00000016">
			<Properties>
				<string name="Name">Assets</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Assets
	Client-side loader of the intro meshes (assets/IntroAssets.fbx, DESIGN §6).

	Import IntroAssets.fbx into Studio (Home > Import 3D), keep the model named
	"IntroAssets" and put it in ReplicatedStorage (Workspace also works, read
	only: it is never moved or changed, but with streaming it may not reach the
	client). Every mesh is "<Asset>__<Style>[_n]" (e.g. "Rift__Crack_01") and
	each asset has three marker meshes "<Asset>__Origin/__Up/__Front" that give
	its pivot, up, front and true size whatever axis/unit settings the importer
	used (same scheme as src/IslandMapGenerator/AssetLibrary.luau). Without the
	import every asset has a simple procedural stand-in built from parts, so the
	cutscene always works.

	Normalised models: pivot = the asset origin, front = -Z (LookVector), up = +Y,
	sizes in studs; asset-local offsets = Convert.fromBlender(x, y, z). Every part
	is anchored, CanCollide/CanTouch/CanQuery false, has the attributes "Style"
	(e.g. "Crack"), "Piece" (e.g. "Crack_01") and "BaseTransparency".

	    Assets.place(name, parent, cf?, tint?, blend?) -> Model   (never nil; import or stand-in)
	    Assets.template(name)        -> Model?   normalised imported template (nil = not imported)
	    Assets.imported(name)        -> boolean
	    Assets.fallback(name)        -> Model?   the procedural stand-in template
	    Assets.pieces(model, style?) -> { BasePart }  sorted by name (all parts when style is nil)
	    Assets.piece(model, pieceName) -> BasePart?    e.g. "Crack_01", "RiftView", "Blade"
	    Assets.styleOf(part)         -> string?
	    Assets.tintColor(style, tint, blend?) -> Color3  style colour blended toward the tint
	    Assets.recolor(model or {parts}, tint, blend?)   every tinted style (CoreGlow, CoreRing,
	                                                     CoreShell, Wave, Arc) toward the tint
	    Assets.setResonance(model or {parts}, tint, r)   Crystal: colourless glass (r 0) -> Neon tint (r 1)
	    Assets.setOpacity(model or {parts}, opacity)     transparency = 1 - (1 - base) * opacity
	    Assets.mover(model)          -> mover; mover:MoveTo(cf, scale?) moves (and uniformly scales)
	                                 all parts at once (BulkMoveTo)
	    Assets.part(parent, name, style, size, cf, shape?) -> Part  (styled, no collisions)
	    Assets.preload(names?)       yields: ContentProvider:PreloadAsync on the imported meshes
	    Assets.reset()               forget the cache (a new import is picked up)
	    Assets.STYLES, Assets.NAMES
]]

local Config = require(script.Parent.Config)

local Assets = {}

Assets.IMPORT_NAME = "IntroAssets"
Assets.NAMES = { "SpaceDome", "SoulCore", "ShatteredPlanet", "Rift", "ResonanceSword", "Shockwave", "SlashArc" }
local MARKER_LEN = 10 -- studs between the Origin and Up markers in Blender

local M = Enum.Material
local rgb = Color3.fromRGB
local TAU = math.pi * 2

--[[ style -> { colour, material, transparency?, reflectance?, glow? (Neon, no shadow),
	noShadow?, tint? (recoloured by Assets.recolor), tintBlend? (default blend) } ]]
local STYLES = {
	Void = { rgb(0, 0, 0), M.SmoothPlastic, noShadow = true },
	CoreGlow = { rgb(255, 255, 255), M.Neon, glow = true, tint = true },
	CoreRing = { rgb(255, 255, 255), M.Neon, glow = true, tint = true },
	CoreShell = { rgb(255, 255, 255), M.Glass, transparency = 0.35, noShadow = true, tint = true, tintBlend = 0.25 },
	Ocean = { rgb(28, 70, 140), M.SmoothPlastic },
	Land = { rgb(70, 120, 60), M.Grass },
	LandDry = { rgb(150, 120, 80), M.Sand },
	Ice = { rgb(230, 240, 250), M.Ice },
	Cloud = { rgb(245, 245, 250), M.SmoothPlastic, transparency = 0.15, noShadow = true },
	Crust = { rgb(70, 55, 50), M.Basalt },
	Magma = { rgb(255, 110, 30), M.Neon, glow = true },
	PlanetCore = { rgb(255, 220, 140), M.Neon, glow = true },
	Debris = { rgb(85, 75, 70), M.Basalt },
	Crack = { rgb(230, 240, 255), M.Neon, glow = true },
	Shard = { rgb(200, 220, 255), M.Glass, transparency = 0.3, reflectance = 0.3, noShadow = true },
	RiftEdge = { rgb(190, 140, 255), M.Neon, glow = true },
	RiftView = { rgb(255, 255, 255), M.SmoothPlastic, noShadow = true },
	Blade = { rgb(210, 215, 225), M.Metal, reflectance = 0.2 },
	Crystal = { rgb(225, 235, 245), M.Glass, transparency = 0.25, noShadow = true },
	Guard = { rgb(40, 40, 48), M.Metal },
	Gold = { rgb(214, 172, 74), M.Foil },
	Grip = { rgb(60, 40, 30), M.Fabric },
	Wave = { rgb(255, 255, 255), M.Neon, glow = true, tint = true, tintBlend = 0 },
	Arc = { rgb(255, 255, 255), M.Neon, glow = true, tint = true },
}
Assets.STYLES = STYLES

local library -- nil = not looked yet, false = nothing imported
local fallbacks = {}

local function findSource()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local source = ReplicatedStorage:FindFirstChild(Assets.IMPORT_NAME)
	if source then
		return source
	end
	return workspace:FindFirstChild(Assets.IMPORT_NAME)
end

function Assets.reset()
	library = nil
	fallbacks = {}
end

local function load()
	if library ~= nil then
		return library or nil
	end
	local source = findSource()
	if not source then
		library = false
		return nil
	end
	local assets = {}
	for _, d in ipairs(source:GetDescendants()) do
		if d:IsA("BasePart") then
			local asset, rest = string.match(d.Name, "^(.-)__(.+)$")
			if asset then
				local entry = assets[asset]
				if not entry then
					entry = { pieces = {}, markers = {} }
					assets[asset] = entry
				end
				if rest == "Origin" or rest == "Up" or rest == "Front" then
					entry.markers[rest] = d
				else
					local style = (string.gsub(rest, "_%d+$", ""))
					table.insert(entry.pieces, { part = d, style = style, piece = rest })
				end
			end
		end
	end
	library = { assets = assets, templates = {} }
	return library
end

-- Styling ---------------------------------------------------------------------------------------------
local function noCollide(p)
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
end

local function applyStyle(p, styleName)
	noCollide(p)
	local s = STYLES[styleName]
	if s then
		p.Color = s[1]
		p.Material = s[2]
		p.Transparency = s.transparency or 0
		p.Reflectance = s.reflectance or 0
		if s.glow or s.noShadow then
			p.CastShadow = false
		end
	end
	p:SetAttribute("Style", styleName)
	p:SetAttribute("BaseTransparency", p.Transparency)
end
Assets.applyStyle = applyStyle

function Assets.styleOf(part)
	return part:GetAttribute("Style")
end

function Assets.tintColor(style, tint, blend)
	local s = STYLES[style]
	if not s then
		return tint
	end
	blend = blend or s.tintBlend or 1
	return s[1]:Lerp(tint, math.clamp(blend, 0, 1))
end

local function partsOf(target)
	if type(target) ~= "table" then
		if target:IsA("BasePart") then
			return { target }
		end
		local list = {}
		for _, d in ipairs(target:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(list, d)
			end
		end
		return list
	end
	return target
end

function Assets.recolor(target, tint, blend)
	for _, p in ipairs(partsOf(target)) do
		local style = p:GetAttribute("Style")
		local s = style and STYLES[style]
		if s and s.tint then
			p.Color = Assets.tintColor(style, tint, blend)
		end
	end
end

local CRYSTAL = STYLES.Crystal
function Assets.setResonance(target, tint, r)
	r = math.clamp(r or 0, 0, 1)
	local color = CRYSTAL[1]:Lerp(tint, r)
	local material = r >= 0.5 and M.Neon or M.Glass
	local transparency = (CRYSTAL.transparency or 0) * (1 - r)
	for _, p in ipairs(partsOf(target)) do
		if p:GetAttribute("Style") == "Crystal" then
			p.Color = color
			if p.Material ~= material then
				p.Material = material
			end
			p.Transparency = transparency
		end
	end
end

function Assets.setOpacity(target, opacity)
	opacity = math.clamp(opacity or 1, 0, 1)
	for _, p in ipairs(partsOf(target)) do
		local base = p:GetAttribute("BaseTransparency") or 0
		p.Transparency = 1 - (1 - base) * opacity
	end
end

function Assets.pieces(model, style)
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and (style == nil or d:GetAttribute("Style") == style) then
			table.insert(list, d)
		end
	end
	table.sort(list, function(a, b)
		return a.Name < b.Name
	end)
	return list
end

function Assets.piece(model, pieceName)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("Piece") == pieceName then
			return d
		end
	end
	return nil
end

-- The face of a part whose normal is closest to a world direction.
local function faceToward(part, dir)
	local localDir = part.CFrame:VectorToObjectSpace(dir)
	local best, bestDot = Enum.NormalId.Top, -math.huge
	for _, id in ipairs(Enum.NormalId:GetEnumItems()) do
		local d = Vector3.FromNormalId(id):Dot(localDir)
		if d > bestDot then
			best, bestDot = id, d
		end
	end
	return best
end

-- RiftView: keep the imported texture; otherwise Config.RIFT_VIEW_IMAGE; otherwise a forest swirl.
local function fixRiftView(p, model)
	local hasTexture = p:FindFirstChildOfClass("SurfaceAppearance") ~= nil
	if p:IsA("MeshPart") and p.TextureID ~= "" then
		hasTexture = true
	end
	if hasTexture then
		return
	end
	local image = Config.RIFT_VIEW_IMAGE
	if image and image ~= "" then
		local ok = p:IsA("MeshPart") and pcall(function()
			p.TextureID = image
		end)
		if not ok then
			local decal = Instance.new("Decal")
			decal.Texture = image
			decal.Face = faceToward(p, Vector3.yAxis)
			decal.Parent = p
		end
		return
	end
	p.Color = rgb(64, 118, 70)
	p.Material = M.Grass
	-- a few flat discs on top (asset +Y is the viewing side): a green-blue swirl seen from high above
	local r = math.max(p.Size.X, p.Size.Y, p.Size.Z) / 2
	local ringColors = { rgb(46, 92, 54), rgb(96, 150, 80), rgb(60, 112, 170) }
	for k, color in ipairs(ringColors) do
		local d = r * (1 - k * 0.22) * 2
		local off = Vector3.new(math.cos(k * 2.1) * r * 0.12, 0.06 + 0.03 * k, math.sin(k * 2.1) * r * 0.12)
		local cf = CFrame.new(p.Position + off) * CFrame.Angles(0, 0, math.pi / 2)
		local ring = Assets.part(model, "Rift__RiftView_" .. (k + 1), "RiftView", Vector3.new(0.05, d, d), cf, Enum.PartType.Cylinder)
		ring.Color = color
		ring.Material = k == 3 and M.Glass or M.Grass
		ring:SetAttribute("Piece", "RiftView")
	end
end

-- Imported templates ----------------------------------------------------------------------------------
function Assets.template(name)
	local lib = load()
	if not lib then
		return nil
	end
	local cached = lib.templates[name]
	if cached ~= nil then
		return cached or nil
	end
	local entry = lib.assets[name]
	local mk = entry and entry.markers
	if not entry or not (mk.Origin and mk.Up and mk.Front) or #entry.pieces == 0 then
		if entry then
			warn("[IntroCutscene] Asset " .. name .. " is missing its marker meshes; using the stand-in")
		end
		lib.templates[name] = false
		return nil
	end
	local origin = mk.Origin.Position
	local upVector = mk.Up.Position - origin
	local scale = MARKER_LEN / upVector.Magnitude
	local up = upVector.Unit
	local front = mk.Front.Position - origin
	front = (front - up * front:Dot(up)).Unit
	local back = -front
	local frame = CFrame.fromMatrix(origin, up:Cross(back), up, back)
	local toLocal = frame:Inverse()

	local model = Instance.new("Model")
	model.Name = name
	for _, piece in ipairs(entry.pieces) do
		local p = piece.part:Clone()
		if p then
			local keepLook = piece.style == "RiftView"
			for _, child in ipairs(p:GetChildren()) do
				if not (keepLook and child:IsA("SurfaceAppearance")) then
					child:Destroy()
				end
			end
			local rel = toLocal * piece.part.CFrame
			p.Size = piece.part.Size * scale
			p.CFrame = CFrame.new(rel.Position * scale) * rel.Rotation
			applyStyle(p, piece.style)
			p:SetAttribute("Piece", piece.piece)
			p.Parent = model
			if keepLook then
				fixRiftView(p, model)
			end
		end
	end
	model.WorldPivot = CFrame.new()
	model:SetAttribute("Source", "import")
	lib.templates[name] = model
	return model
end

function Assets.imported(name)
	return Assets.template(name) ~= nil
end

-- Yields. Loads the imported meshes so they don't pop in (call from task.spawn).
function Assets.preload(names)
	local list = {}
	for _, name in ipairs(names or Assets.NAMES) do
		local t = Assets.template(name)
		if t then
			for _, p in ipairs(t:GetDescendants()) do
				if p:IsA("MeshPart") then
					table.insert(list, p)
				end
			end
		end
	end
	if #list > 0 then
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(list)
		end)
	end
end

-- Procedural stand-ins ----------------------------------------------------------------------------------
function Assets.part(parent, name, style, size, cf, shape)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	applyStyle(p, style)
	local piece = string.match(name, "__(.+)$")
	p:SetAttribute("Piece", piece or name)
	p.Parent = parent
	return p
end
local part = Assets.part

-- ring of n box segments, radius r, in the plane whose normal is the frame's +Y
local function ring(model, prefix, style, frame, r, n, thickness, width, numbered)
	local seg = TAU * r / n * 1.08
	for k = 1, n do
		local a = (k - 0.5) / n * TAU
		local cf = frame * CFrame.Angles(0, -a, 0) * CFrame.new(r, 0, 0)
		local name = numbered and string.format("%s_%02d", prefix, k) or prefix
		part(model, name, style, Vector3.new(width, thickness, seg), cf)
	end
end

local BUILDERS = {}

BUILDERS.SpaceDome = function(m)
	-- a black box of six slabs around the camera (parts can't be seen from inside a sphere)
	local R, S = 990, 2000
	local faces = {
		CFrame.new(R, 0, 0),
		CFrame.new(-R, 0, 0),
		CFrame.new(0, R, 0) * CFrame.Angles(0, 0, math.pi / 2),
		CFrame.new(0, -R, 0) * CFrame.Angles(0, 0, math.pi / 2),
		CFrame.new(0, 0, R) * CFrame.Angles(0, math.pi / 2, 0),
		CFrame.new(0, 0, -R) * CFrame.Angles(0, math.pi / 2, 0),
	}
	for k, cf in ipairs(faces) do
		part(m, "SpaceDome__Void_" .. k, "Void", Vector3.new(4, S, S), cf)
	end
end

BUILDERS.SoulCore = function(m)
	part(m, "SoulCore__CoreGlow", "CoreGlow", Vector3.new(1.6, 1.6, 1.6), CFrame.new(), Enum.PartType.Ball)
	part(m, "SoulCore__CoreShell", "CoreShell", Vector3.new(2.6, 2.6, 2.6), CFrame.new(), Enum.PartType.Ball)
	ring(m, "SoulCore__CoreRing", "CoreRing", CFrame.Angles(math.rad(70), 0, 0), 1.9, 18, 0.08, 0.08)
	ring(m, "SoulCore__CoreRing", "CoreRing", CFrame.Angles(0, 0, math.rad(-65)), 1.9, 18, 0.08, 0.08)
end

BUILDERS.ShatteredPlanet = function(m)
	local rng = Random.new(31)
	part(m, "ShatteredPlanet__Ocean", "Ocean", Vector3.new(640, 640, 640), CFrame.new(), Enum.PartType.Ball)
	for k = 1, 9 do
		local dir = rng:NextUnitVector()
		if dir.Z < -0.3 then
			dir = Vector3.new(dir.X, dir.Y, -dir.Z)
		end
		local d = rng:NextNumber(140, 230)
		local style = k % 3 == 0 and "LandDry" or "Land"
		part(m, "ShatteredPlanet__" .. style .. "_" .. k, style, Vector3.new(d, d, d), CFrame.new(dir * (320 - d * 0.47)), Enum.PartType.Ball)
	end
	part(m, "ShatteredPlanet__Ice_1", "Ice", Vector3.new(200, 200, 200), CFrame.new(0, 245, 0), Enum.PartType.Ball)
	part(m, "ShatteredPlanet__Ice_2", "Ice", Vector3.new(200, 200, 200), CFrame.new(0, -245, 0), Enum.PartType.Ball)
	-- the destroyed side (front, -Z): glowing fracture and crust bulging out of it
	part(m, "ShatteredPlanet__Crust", "Crust", Vector3.new(600, 600, 600), CFrame.new(0, 0, -50), Enum.PartType.Ball)
	part(m, "ShatteredPlanet__Magma", "Magma", Vector3.new(560, 560, 560), CFrame.new(0, 0, -95), Enum.PartType.Ball)
	part(m, "ShatteredPlanet__PlanetCore", "PlanetCore", Vector3.new(180, 180, 180), CFrame.new(0, 0, -300), Enum.PartType.Ball)
	for k = 1, 36 do
		local a = math.rad(-75 + 150 * (k - 1) / 35) + rng:NextNumber(-0.05, 0.05)
		local r = rng:NextNumber(380, 520)
		local pos = Vector3.new(math.sin(a) * r, rng:NextNumber(-60, 60), -math.cos(a) * r)
		local s = rng:NextNumber(6, 34)
		local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), 0)
		part(m, "ShatteredPlanet__Debris_" .. k, "Debris", Vector3.new(s, s * rng:NextNumber(0.5, 1), s * rng:NextNumber(0.6, 1.2)), cf)
	end
end

BUILDERS.Rift = function(m)
	local rng = Random.new(9)
	-- opening in the asset's XZ plane (Blender XY), facing +Y (Blender +Z)
	for k = 1, 14 do
		local r0 = (k - 1) / 14 * 11
		local len = rng:NextNumber(3, 5.5)
		local a = rng:NextNumber(0, TAU)
		local mid = r0 + len / 2
		local cf = CFrame.new(math.cos(a) * mid, 0.05, math.sin(a) * mid) * CFrame.Angles(0, -a + rng:NextNumber(-0.4, 0.4), 0)
		part(m, string.format("Rift__Crack_%02d", k), "Crack", Vector3.new(len, 0.08, 0.22), cf)
	end
	local k = 0
	for gx = 0, 3 do
		for gz = 0, 3 do
			k += 1
			local x, z = (gx - 1.5) * 6, (gz - 1.5) * 6
			local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, TAU), 0)
			local s = rng:NextNumber(4.5, 6.5)
			part(m, string.format("Rift__Shard_%02d", k), "Shard", Vector3.new(s, 0.15, s * rng:NextNumber(0.5, 0.9)), cf)
		end
	end
	ring(m, "Rift__RiftEdge", "RiftEdge", CFrame.new(), 14, 28, 0.35, 0.9)
	local view = part(m, "Rift__RiftView", "RiftView", Vector3.new(0.1, 27, 27), CFrame.new(0, -0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), Enum.PartType.Cylinder)
	fixRiftView(view, m)
end

BUILDERS.ResonanceSword = function(m)
	-- grip centre at the origin, blade along +Y, edges facing +-X
	part(m, "ResonanceSword__Blade", "Blade", Vector3.new(0.5, 3.9, 0.12), CFrame.new(0, 2.55, 0))
	part(m, "ResonanceSword__Blade_2", "Blade", Vector3.new(0.3, 0.3, 0.12), CFrame.new(0, 4.5, 0) * CFrame.Angles(0, 0, math.pi / 4))
	part(m, "ResonanceSword__Crystal", "Crystal", Vector3.new(0.14, 3.0, 0.16), CFrame.new(0, 2.35, 0))
	part(m, "ResonanceSword__Crystal_2", "Crystal", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, math.pi / 4))
	part(m, "ResonanceSword__Crystal_3", "Crystal", Vector3.new(0.26, 0.26, 0.26), CFrame.new(0, -0.6, 0) * CFrame.Angles(0, 0, math.pi / 4))
	part(m, "ResonanceSword__Guard", "Guard", Vector3.new(1.6, 0.22, 0.34), CFrame.new(0, 0.5, 0))
	part(m, "ResonanceSword__Gold", "Gold", Vector3.new(1.7, 0.07, 0.38), CFrame.new(0, 0.63, 0))
	part(m, "ResonanceSword__Grip", "Grip", Vector3.new(0.9, 0.24, 0.24), CFrame.Angles(0, 0, math.pi / 2), Enum.PartType.Cylinder)
	part(m, "ResonanceSword__Gold_2", "Gold", Vector3.new(0.34, 0.34, 0.34), CFrame.new(0, -0.55, 0), Enum.PartType.Ball)
end

BUILDERS.Shockwave = function(m)
	ring(m, "Shockwave__Wave", "Wave", CFrame.new(), 1, 32, 0.04, 0.12)
end

BUILDERS.SlashArc = function(m)
	local n = 16
	for k = 1, n do
		local u = (k - 0.5) / n
		local a = math.rad(-100 + 200 * u)
		local w = 0.15 + 0.85 * math.sin(u * math.pi)
		local cf = CFrame.Angles(0, -a, 0) * CFrame.new(5, 0, 0)
		part(m, "SlashArc__Arc", "Arc", Vector3.new(w, 0.05, TAU * 5 / 32 * 1.1), cf)
	end
end

function Assets.fallback(name)
	local cached = fallbacks[name]
	if cached then
		return cached
	end
	local build = BUILDERS[name]
	if not build then
		return nil
	end
	local m = Instance.new("Model")
	m.Name = name
	build(m)
	m.WorldPivot = CFrame.new()
	m:SetAttribute("Source", "fallback")
	fallbacks[name] = m
	return m
end

-- Placing -----------------------------------------------------------------------------------------------
function Assets.place(name, parent, cf, tint, blend)
	local t = Assets.template(name) or Assets.fallback(name)
	local m
	if t then
		m = t:Clone()
	else
		m = Instance.new("Model")
		m.Name = name
		part(m, name .. "__Missing", "Crack", Vector3.new(1, 1, 1), CFrame.new())
		m.WorldPivot = CFrame.new()
	end
	if tint then
		Assets.recolor(m, tint, blend)
	end
	m:PivotTo(cf or CFrame.new())
	m.Parent = parent
	return m
end

local bulkMoveWorks = true
local function bulkMove(parts, cframes)
	workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Moves every part of a model at once, keeping their offsets from the model's pivot.
-- mover:MoveTo(cf, scale?) also scales the model uniformly about its pivot (sizes and offsets,
-- relative to the model as it was when the mover was made; parts are only resized when the
-- scale changes).
function Assets.mover(model)
	local parts = Assets.pieces(model)
	local pivot = model:GetPivot()
	local offsets, cframes, sizes = {}, {}, {}
	for i, p in ipairs(parts) do
		offsets[i] = pivot:ToObjectSpace(p.CFrame)
		cframes[i] = p.CFrame
		sizes[i] = p.Size
	end
	local mover = { model = model, parts = parts, scale = 1 }
	local scaled -- offsets at the current scale (nil = scale 1)
	function mover:MoveTo(cf, scale)
		scale = scale or 1
		if math.abs(scale - mover.scale) > 1e-4 * math.max(scale, 1e-3) then
			mover.scale = scale
			local s = math.max(scale, 1e-3)
			if math.abs(s - 1) < 1e-6 then
				scaled = nil
			else
				scaled = scaled or {}
				for i = 1, #parts do
					local o = offsets[i]
					scaled[i] = o.Rotation + o.Position * s
				end
			end
			for i = 1, #parts do
				local sz = sizes[i] * s
				parts[i].Size = Vector3.new(math.max(sz.X, 0.001), math.max(sz.Y, 0.001), math.max(sz.Z, 0.001))
			end
		end
		local list = scaled or offsets
		for i = 1, #parts do
			cframes[i] = cf * list[i]
		end
		local ok = bulkMoveWorks and pcall(bulkMove, parts, cframes)
		if not ok then
			bulkMoveWorks = false -- (only when the engine refuses; then part by part from now on)
			for i = 1, #parts do
				parts[i].CFrame = cframes[i]
			end
		end
		model.WorldPivot = cf
	end
	return mover
end

return Assets
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000017">
			<Properties>
				<string name="Name">CharacterRig</string>
				<ProtectedString name="Source"><![CDATA[--[[
	CharacterRig
	Puts the player's real avatar into the cutscene (DESIGN §4, §7.2).

	    local rig = CharacterRig.new(player, character, folder)   -- folder holds the glow Highlight
	    rig:Takeover()           anchor the HumanoidRootPart, stop/block animations (Animate script
	                             off, playing tracks stopped, new ones stopped at once), controls off,
	                             tools unequipped, AutoRotate / state machine off
	    rig:SetColor(color)      soul core colour (light form glow)
	    rig:Update(t, cs, origin) cs = Timeline:character(t), origin = world stage CFrame:
	                             HRP CFrame, every Motor6D.Transform, visibility (`visible`) and
	                             form (`form`: 0 light -> 1 solid body); forward kinematics cached
	    rig:ApplyJoints()        re-applies this frame's Transforms; connected to
	                             RunService.PreSimulation (after the Animator) by init
	    rig:PartCFrame(part)     -> CFrame  where a character part is this frame (FK, exact even
	                             before the engine has solved the joints); part.CFrame otherwise
	    rig:GripCF()             -> CFrame  sword pivot in the right hand (§4.3)
	    rig:RootCF(cs, origin)   -> CFrame  HRP CFrame for a character sample (height offset incl.)
	    rig:SetHidden(hidden)    force hidden (true) / back to the data (false)
	    rig:IsAlive()            -> boolean
	    rig:Restore(finalCF?)    undo everything; with finalCF the character is left standing
	                             there (upright, unanchored)
	    rig.character, rig.humanoid, rig.root, rig.isR15, rig.animated, rig.heightOffset

	Bone axes are Roblox joint axes (§4.2), so a joint quaternion is the Motor6D
	Transform as is. Avatars of other sizes are lifted by
	(HipHeight + HRP.Size.Y / 2) - 3 along the stage's up so the feet land where
	the mannequin's do (§4.4). The game is R15 only: an R6 character is moved and
	hidden/shown like the root but not animated.
]]

local Convert = require(script.Parent.Convert)

local CharacterRig = {}
CharacterRig.__index = CharacterRig

local IDENTITY = CFrame.identity
local WHITE = Color3.new(1, 1, 1)

-- R15 Motor6Ds, parents first: { joint (= Motor6D name), part it moves (Part1), part it hangs on (Part0) }
local JOINTS = {
	{ "Root", "LowerTorso", "HumanoidRootPart" },
	{ "Waist", "UpperTorso", "LowerTorso" },
	{ "Neck", "Head", "UpperTorso" },
	{ "LeftShoulder", "LeftUpperArm", "UpperTorso" },
	{ "LeftElbow", "LeftLowerArm", "LeftUpperArm" },
	{ "LeftWrist", "LeftHand", "LeftLowerArm" },
	{ "RightShoulder", "RightUpperArm", "UpperTorso" },
	{ "RightElbow", "RightLowerArm", "RightUpperArm" },
	{ "RightWrist", "RightHand", "RightLowerArm" },
	{ "LeftHip", "LeftUpperLeg", "LowerTorso" },
	{ "LeftKnee", "LeftLowerLeg", "LeftUpperLeg" },
	{ "LeftAnkle", "LeftFoot", "LeftLowerLeg" },
	{ "RightHip", "RightUpperLeg", "LowerTorso" },
	{ "RightKnee", "RightLowerLeg", "RightUpperLeg" },
	{ "RightAnkle", "RightFoot", "RightLowerLeg" },
}
CharacterRig.JOINTS = JOINTS

local function findMotor(character, jointName, partName)
	local part = character:FindFirstChild(partName)
	local m = part and part:FindFirstChild(jointName)
	if m and m:IsA("Motor6D") then
		return m
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Motor6D") and d.Name == jointName then
			return d
		end
	end
	return nil
end

function CharacterRig.new(player, character, folder)
	local self = setmetatable({}, CharacterRig)
	self.player = player
	self.character = character
	self.folder = folder
	self.humanoid = character:FindFirstChildOfClass("Humanoid")
	assert(self.humanoid, "character has no Humanoid")
	self.root = character:FindFirstChild("HumanoidRootPart") or self.humanoid.RootPart
	assert(self.root, "character has no HumanoidRootPart")
	self.isR15 = self.humanoid.RigType == Enum.HumanoidRigType.R15
	self.color = WHITE
	self.active = false
	self.hidden = false
	self.connections = {}
	self.partCF = {}
	self.joints = {}
	self.attached = {}
	self.visuals = {}
	self.saved = {}
	if self.isR15 then
		for _, spec in ipairs(JOINTS) do
			local motor = findMotor(character, spec[1], spec[2])
			if motor and motor.Part0 and motor.Part1 then
				table.insert(self.joints, {
					name = spec[1],
					motor = motor,
					part0 = motor.Part0,
					part1 = motor.Part1,
					c0 = motor.C0,
					c1inv = motor.C1:Inverse(),
					transform = nil,
				})
			end
		end
	end
	self.animated = #self.joints > 0
	if self.isR15 then
		self.heightOffset = self.humanoid.HipHeight + self.root.Size.Y / 2 - 3.0
	else
		self.heightOffset = 0 -- an R6 root already sits 3 studs above the feet
	end
	return self
end

function CharacterRig:IsAlive()
	local hum = self.humanoid
	return hum ~= nil and hum.Parent ~= nil and hum.Health > 0 and self.root.Parent ~= nil and self.character:IsDescendantOf(workspace)
end

function CharacterRig:_controls()
	if self.controls == nil then
		self.controls = false
		pcall(function()
			local playerScripts = self.player:FindFirstChild("PlayerScripts") or self.player:WaitForChild("PlayerScripts", 5)
			local module = playerScripts and playerScripts:WaitForChild("PlayerModule", 5)
			if module then
				self.controls = require(module):GetControls()
			end
		end)
	end
	return self.controls or nil
end

-- Parts welded to a body part (accessory handles, ...) keep their offset from it.
function CharacterRig:_collectAttached()
	local body = {}
	body[self.root] = true
	for _, j in ipairs(self.joints) do
		body[j.part0] = true
		body[j.part1] = true
	end
	for _, d in ipairs(self.character:GetDescendants()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			local a, b = d.Part0, d.Part1
			local part, base
			if a and b then
				if body[a] and not body[b] then
					part, base = b, a
				elseif body[b] and not body[a] then
					part, base = a, b
				end
			end
			if part and base and part:IsDescendantOf(self.character) then
				table.insert(self.attached, { part = part, base = base, offset = base.CFrame:ToObjectSpace(part.CFrame) })
			end
		end
	end
end

function CharacterRig:Takeover()
	if self.active then
		return
	end
	self.active = true
	local hum, root, character, saved = self.humanoid, self.root, self.character, self.saved

	pcall(function()
		hum:UnequipTools()
	end)
	if hum.Sit then
		pcall(function()
			hum.Sit = false
		end)
	end

	local animate = character:FindFirstChild("Animate")
	if animate and animate:IsA("BaseScript") then
		saved.animate = animate
		saved.animateEnabled = animate.Enabled
		animate.Enabled = false
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
		table.insert(
			self.connections,
			animator.AnimationPlayed:Connect(function(track)
				if self.active then
					track:Stop(0)
				end
			end)
		)
	end

	saved.autoRotate = hum.AutoRotate
	hum.AutoRotate = false
	pcall(function()
		saved.evaluateStateMachine = hum.EvaluateStateMachine
		hum.EvaluateStateMachine = false
	end)
	saved.anchored = root.Anchored
	root.Anchored = true
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)

	self:_collectAttached()
	for _, d in ipairs(character:GetDescendants()) do
		if (d:IsA("BasePart") and d ~= root) or d:IsA("Decal") then
			table.insert(self.visuals, { d, d.LocalTransparencyModifier })
		end
	end

	local controls = self:_controls()
	if controls then
		pcall(function()
			controls:Disable()
		end)
	end

	local hl = Instance.new("Highlight")
	hl.Name = "IntroFormGlow"
	hl.Adornee = character
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.Enabled = false
	hl.Parent = self.folder or character
	self.highlight = hl
end

function CharacterRig:SetColor(color)
	self.color = color or WHITE
end

function CharacterRig:SetHidden(hidden)
	self.hidden = hidden and true or false
end

function CharacterRig:RootCF(cs, origin)
	return origin * CFrame.new(0, self.heightOffset, 0) * Convert.localCF(cs.root.pos, cs.root.rot)
end

function CharacterRig:_setLook(visible, form)
	local ltm = visible and (1 - form) * 0.75 or 1
	for _, v in ipairs(self.visuals) do
		v[1].LocalTransparencyModifier = ltm
	end
	local hl = self.highlight
	if hl then
		local glow = visible and form < 0.999
		hl.Enabled = glow
		if glow then
			hl.FillColor = self.color
			hl.FillTransparency = 0.1 + 0.9 * form
			hl.OutlineColor = self.color:Lerp(WHITE, 0.5)
			hl.OutlineTransparency = 0.2 + 0.8 * form
		end
	end
end

function CharacterRig:Update(t, cs, origin)
	if not self.active or not cs then
		return
	end
	local channels = cs.channels
	local visible = channels.visible
	if visible == nil then
		visible = 1
	end
	if t < cs.t0 - 1e-6 or self.hidden then
		visible = 0
	end
	local form = channels.form or 1

	local rootCF = self:RootCF(cs, origin)
	self.rootCF = rootCF
	self.root.CFrame = rootCF

	if self.animated then
		local partCF = self.partCF
		partCF[self.root] = rootCF
		local joints = cs.joints
		for _, j in ipairs(self.joints) do
			local q = joints[j.name]
			local tr = IDENTITY
			if q then
				tr = j.name == "Root" and Convert.jointCF(q, cs.rootLoc) or Convert.jointCF(q)
			end
			j.transform = tr
			j.motor.Transform = tr
			partCF[j.part1] = (partCF[j.part0] or j.part0.CFrame) * j.c0 * tr * j.c1inv
		end
		for _, a in ipairs(self.attached) do
			partCF[a.part] = (partCF[a.base] or a.base.CFrame) * a.offset
		end
	end
	self:_setLook(visible >= 0.5, form)
end

function CharacterRig:ApplyJoints()
	if not self.active then
		return
	end
	for _, j in ipairs(self.joints) do
		local tr = j.transform
		if tr then
			j.motor.Transform = tr
		end
	end
end

function CharacterRig:PartCFrame(part)
	return self.partCF[part] or part.CFrame
end

function CharacterRig:GripCF()
	local hand = self.character:FindFirstChild("RightHand")
	if hand then
		return Convert.grip(self:PartCFrame(hand))
	end
	local arm = self.character:FindFirstChild("Right Arm") -- R6
	if arm then
		return Convert.grip(self:PartCFrame(arm) * CFrame.new(0, -0.85, 0))
	end
	return Convert.grip(self.rootCF or self.root.CFrame)
end

function CharacterRig:Restore(finalCF)
	if not self.active then
		return
	end
	self.active = false
	for _, c in ipairs(self.connections) do
		c:Disconnect()
	end
	table.clear(self.connections)
	for _, j in ipairs(self.joints) do
		j.transform = nil
		pcall(function()
			j.motor.Transform = IDENTITY
		end)
	end
	for _, v in ipairs(self.visuals) do
		pcall(function()
			v[1].LocalTransparencyModifier = v[2]
		end)
	end
	table.clear(self.visuals)
	table.clear(self.attached)
	table.clear(self.partCF)
	if self.highlight then
		self.highlight:Destroy()
		self.highlight = nil
	end
	local hum, root, saved = self.humanoid, self.root, self.saved
	if finalCF and self:IsAlive() then
		-- upright, facing where the final pose faces
		local look = finalCF.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local pos = finalCF.Position
		pcall(function()
			root.CFrame = flat.Magnitude > 1e-3 and CFrame.lookAt(pos, pos + flat) or CFrame.new(pos)
		end)
	end
	pcall(function()
		root.Anchored = saved.anchored or false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)
	pcall(function()
		hum.AutoRotate = saved.autoRotate ~= false
	end)
	if saved.evaluateStateMachine ~= nil then
		pcall(function()
			hum.EvaluateStateMachine = saved.evaluateStateMachine
		end)
	end
	if saved.animate then
		pcall(function()
			saved.animate.Enabled = saved.animateEnabled
		end)
	end
	local controls = self:_controls()
	if controls then
		pcall(function()
			controls:Enable()
		end)
	end
end

return CharacterRig
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000018">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Config
	Settings of the intro cutscene "Awaken" (docs/intro/DESIGN.md §7.5).
]]

return {
	-- where the space stage is built (far past the world border, nothing else there)
	SPACE_ORIGIN = CFrame.new(0, 3000, 40000),
	-- "auto" = the Sylverune spawn circle (moved toward the hub), or a Vector3 on the ground
	LANDING = "auto",
	LANDING_OFFSET_TO_HUB = 14,
	-- trees within this distance of the landing point bend in the shockwave wind
	WIND_RADIUS = 320,
	-- the server script gives the player the real sword when the cutscene ends
	GIVE_SWORD = true,
	-- Studio play tests only: this key replays the intro with TEST_COLOR
	TEST_IN_STUDIO_KEY = Enum.KeyCode.F7,
	TEST_COLOR = Color3.fromRGB(120, 200, 255),
	-- optional "rbxassetid://..." image for the view through the rift (used when the import lost its texture)
	RIFT_VIEW_IMAGE = "",
	-- sound ids ("rbxassetid://..." or just the number) for the sound:<name> markers; "" = silent
	SOUNDS = {
		ignite = "",
		whoosh = "",
		crack = "",
		rift = "",
		impact = "",
		resonance = "",
		shockwave = "",
		wind = "",
		land = "",
	},
	-- let the player skip (Space / Enter / gamepad A / tap); shows a small hint
	ALLOW_SKIP = false,

	-- additions to DESIGN §7.5 ------------------------------------------------------------------
	-- longest frame step the cutscene clock takes (a long hitch slows the cutscene instead of
	-- jumping over whole shots; markers in between still fire in order)
	MAX_FRAME_DT = 0.25,
	-- hide the game's other ScreenGuis and the backpack / player list / health / emotes core GUI
	HIDE_GUI = true,
	-- print every marker as it fires (debugging)
	DEBUG = false,
}
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000019">
			<Properties>
				<string name="Name">Convert</string>
				<ProtectedString name="Source"><![CDATA[--[=[
	Convert
	Blender -> Roblox math of the intro (docs/intro/DESIGN.md §2, §4.2, §4.3).

	Blender is Z-up with the character facing +Y; Roblox is Y-up facing -Z.
	R(x, y, z) = (x, z, -y), i.e. C = [[1,0,0],[0,0,1],[0,-1,0]] and a Blender
	rotation Rbl becomes C·Rbl·Cᵀ. For a quaternion (w, x, y, z) that is simply
	(w, x, z, -y): conjugating by a proper rotation rotates the quaternion's axis.

	p and q below are the arrays Timeline samples return: p = { x, y, z },
	q = { w, x, y, z } (Blender world space of a stage).

	    Convert.pos(x, y, z)            -> Vector3       R(p), stage-local
	    Convert.posOf(p)                -> Vector3       same for an array
	    Convert.rotFromQuat(w, x, y, z) -> CFrame        rotation only, C·R·Cᵀ
	    Convert.cf(origin, p, q)        -> CFrame        origin * CFrame.new(R(p)) * Rrbx
	                                                     (objects whose local axes are Blender's
	                                                     own, e.g. CharacterRoot = the HRP)
	    Convert.assetCF(origin, p, q)   -> CFrame        cf(...) * CFrame.Angles(0, pi, 0): where an
	                                                     IntroAssets model's pivot goes (assets face -Y)
	    Convert.cameraCF(origin, p, q)  -> CFrame        cf(...) * CFrame.Angles(-pi/2, 0, 0): a Blender
	                                                     camera looks down its local -Z with +Y up, which
	                                                     is already Roblox's camera convention, so only the
	                                                     world part is converted
	    Convert.jointCF(q, loc?)        -> CFrame        Motor6D.Transform from a joint-space quaternion
	                                                     (+ Root location); no axis change (§4.2)
	    Convert.fromBlender(x, y, z)    -> Vector3       asset-local offset (-x, z, y) (asset library rule)
	    Convert.stageOrigin(position, towardHub) -> CFrame  world origin: Blender +Y points along towardHub
	    Convert.grip(handCF)            -> CFrame        sword pivot in the right hand (§4.3)
	    Convert.selfCheck()             -> ok, message   numeric check of all of the above
	    Convert.useMath(CFrame, Vector3) plain-Luau tests only: use a CFrame/Vector3 shim
]=]

local Convert = {}

-- Roblox's CFrame / Vector3 (plain-Luau tests hand in a shim with Convert.useMath)
local CF, V3 = CFrame, Vector3
local ASSET_TURN, CAMERA_FIX, GRIP

local function setup()
	ASSET_TURN = CF.Angles(0, math.pi, 0)
	CAMERA_FIX = CF.Angles(-math.pi / 2, 0, 0)
	GRIP = CF.new(0, -0.15, 0) * CF.Angles(-math.pi / 2, 0, 0)
	Convert.ASSET_TURN = ASSET_TURN
	Convert.CAMERA_FIX = CAMERA_FIX
	Convert.GRIP = GRIP
end

-- Tests outside Roblox: use these CFrame / Vector3 implementations.
function Convert.useMath(cframe, vector3)
	CF, V3 = cframe, vector3
	setup()
end

if CF then
	setup()
end

function Convert.pos(x, y, z)
	return V3.new(x, z, -y)
end

function Convert.posOf(p)
	return V3.new(p[1], p[3], -p[2])
end

function Convert.rotFromQuat(w, x, y, z)
	return CF.new(0, 0, 0, x, z, -y, w)
end

-- Stage-local CFrame (no origin) of a Blender position + quaternion.
function Convert.localCF(p, q)
	return CF.new(p[1], p[3], -p[2], q[2], q[4], -q[3], q[1])
end

function Convert.cf(origin, p, q)
	return origin * CF.new(p[1], p[3], -p[2], q[2], q[4], -q[3], q[1])
end

function Convert.assetCF(origin, p, q)
	return origin * CF.new(p[1], p[3], -p[2], q[2], q[4], -q[3], q[1]) * ASSET_TURN
end

function Convert.cameraCF(origin, p, q)
	return origin * CF.new(p[1], p[3], -p[2], q[2], q[4], -q[3], q[1]) * CAMERA_FIX
end

function Convert.jointCF(q, loc)
	if loc then
		return CF.new(loc[1], loc[2], loc[3], q[2], q[3], q[4], q[1])
	end
	return CF.new(0, 0, 0, q[2], q[3], q[4], q[1])
end

function Convert.fromBlender(x, y, z)
	return V3.new(-x, z, y)
end

-- Origin CFrame at `position` whose LookVector (= Blender +Y) points along towardHub (flattened).
function Convert.stageOrigin(position, towardHub)
	local flat = towardHub and V3.new(towardHub.X, 0, towardHub.Z)
	if not flat or flat.Magnitude < 1e-3 then
		return CF.new(position)
	end
	return CF.lookAt(position, position + flat.Unit)
end

function Convert.grip(handCF)
	return handCF * GRIP
end

-- Numeric self-check (runs anywhere CFrame exists; the unit test runs it against a shim).
function Convert.selfCheck()
	local problems = {}
	local function near(a, b, what)
		if (a - b).Magnitude > 1e-4 then
			table.insert(problems, string.format("%s: got (%.4f, %.4f, %.4f) want (%.4f, %.4f, %.4f)", what, a.X, a.Y, a.Z, b.X, b.Y, b.Z))
		end
	end
	local id = CF.new()
	-- positions: Blender +Y (forward) -> Roblox -Z, +Z (up) -> +Y
	near(Convert.pos(1, 2, 3), V3.new(1, 3, -2), "pos")
	-- an unrotated object faces Blender +Y = Roblox LookVector (-Z)
	local q0 = { 1, 0, 0, 0 }
	near(Convert.cf(id, { 0, 0, 0 }, q0).LookVector, V3.new(0, 0, -1), "identity look")
	-- 90 degrees about Blender +Z (counter-clockwise seen from above): +Y turns to -X
	local h = math.sqrt(0.5)
	local qz = { h, 0, 0, h }
	local cfz = Convert.cf(id, { 0, 0, 0 }, qz)
	near(cfz:VectorToWorldSpace(V3.new(0, 0, -1)), V3.new(-1, 0, 0), "yaw 90 forward")
	near(cfz:VectorToWorldSpace(V3.new(0, 1, 0)), V3.new(0, 1, 0), "yaw 90 up")
	-- 90 degrees about Blender +X: +Y (forward) turns to +Z (up)
	local qx = { h, h, 0, 0 }
	near(Convert.cf(id, { 0, 0, 0 }, qx).LookVector, V3.new(0, 1, 0), "pitch 90 forward")
	-- origin and offset compose
	local origin = CF.new(10, 20, 30) * CF.Angles(0, math.pi / 2, 0)
	near(Convert.cf(origin, { 0, 5, 0 }, q0).Position, origin * V3.new(0, 0, -5), "origin offset")
	-- assets: asset-local fromBlender offsets land where Blender has them
	local acf = Convert.assetCF(id, { 0, 0, 0 }, qz)
	local blenderPoint = V3.new(0, -1, 0) -- the asset's front (Blender -Y) rotated by qz -> Blender +X
	near(acf * Convert.fromBlender(blenderPoint.X, blenderPoint.Y, blenderPoint.Z), Convert.pos(1, 0, 0), "asset front")
	near(acf.LookVector, Convert.pos(1, 0, 0), "asset look = its front")
	-- camera: an unrotated Blender camera looks straight down
	near(Convert.cameraCF(id, { 0, 0, 0 }, q0).LookVector, V3.new(0, -1, 0), "camera identity look")
	near(Convert.cameraCF(id, { 0, 0, 0 }, q0).UpVector, V3.new(0, 0, -1), "camera identity up")
	-- camera rotated 90 degrees about Blender +X looks along Blender +Y = Roblox -Z, up Blender +Z
	near(Convert.cameraCF(id, { 0, 0, 0 }, qx).LookVector, V3.new(0, 0, -1), "camera level look")
	near(Convert.cameraCF(id, { 0, 0, 0 }, qx).UpVector, V3.new(0, 1, 0), "camera level up")
	-- joints: same numbers, no axis change (90 degrees about joint X tips +Y up to +Z back)
	near(Convert.jointCF(qx):VectorToWorldSpace(V3.new(0, 1, 0)), V3.new(0, 0, 1), "joint x")
	near(Convert.jointCF(q0, { 1, 2, 3 }).Position, V3.new(1, 2, 3), "joint loc")
	-- grip: the blade (asset +Y) points along the hand's -Z
	near(Convert.grip(id):VectorToWorldSpace(V3.new(0, 1, 0)), V3.new(0, 0, -1), "grip blade")
	near(Convert.grip(id).Position, V3.new(0, -0.15, 0), "grip offset")
	-- stage origin: LookVector toward the hub
	local o = Convert.stageOrigin(V3.new(100, 5, 0), V3.new(-100, 0, 0))
	near(o.LookVector, V3.new(-1, 0, 0), "stage origin look")
	near(Convert.cf(o, { 0, 10, 0 }, q0).Position, V3.new(90, 5, 0), "stage origin +Y toward hub")
	if #problems > 0 then
		return false, table.concat(problems, "; ")
	end
	return true, "ok"
end

return Convert
]]></ProtectedString>
